+/* Devices connected or removed while a program runs, and changes of the default
+ * devices, reach the program as on Windows: the driver reports that something
+ * changed (wait_device_change), the devices are listed again and each registered
+ * client hears what changed. Wine used to list them once, at start. */
+struct device_event
+{
+    enum { DEVICE_ADDED, DEVICE_STATE_CHANGED, DEFAULT_DEVICE_CHANGED } type;
+    EDataFlow flow;
+    ERole role;
+    DWORD state;
+    WCHAR *id;
+};
+
+struct device_events
+{
+    struct device_event *events;
+    UINT count, size;
+};
+
+static void add_device_event(struct device_events *events, int type, EDataFlow flow, ERole role,
+                             DWORD state, WCHAR *id)
+{
+    struct device_event *event;
+
+    if (events->count == events->size)
+    {
+        UINT size = events->size ? events->size * 2 : 16;
+        if (!(event = realloc(events->events, size * sizeof(*event))))
+        {
+            CoTaskMemFree(id);
+            return;
+        }
+        events->events = event;
+        events->size = size;
+    }
+    event = &events->events[events->count++];
+    event->type = type;
+    event->flow = flow;
+    event->role = role;
+    event->state = state;
+    event->id = id;
+}
+
+static WCHAR *device_id(MMDevice *device)
+{
+    WCHAR *id = NULL;
+    if (device) IMMDevice_GetId(&device->IMMDevice_iface, &id);
+    return id;
+}
+
+static WCHAR *default_device_id(EDataFlow flow, ERole role)
+{
+    IMMDevice *device;
+    WCHAR *id = NULL;
+
+    if (SUCCEEDED(MMDevEnum_GetDefaultAudioEndpoint(&enumerator.IMMDeviceEnumerator_iface, flow, role, &device)))
+    {
+        IMMDevice_GetId(device, &id);
+        IMMDevice_Release(device);
+    }
+    return id;
+}
+
+static void set_device_state(MMDevice *device, DWORD state)
+{
+    WCHAR guidstr[39];
+    HKEY key;
+
+    device->state = state;
+    StringFromGUID2(&device->devguid, guidstr, ARRAY_SIZE(guidstr));
+    if (!RegOpenKeyExW(device->flow == eRender ? key_render : key_capture, guidstr, 0,
+                       KEY_WRITE|KEY_WOW64_64KEY, &key))
+    {
+        RegSetValueExW(key, L"DeviceState", 0, REG_DWORD, (const BYTE *)&state, sizeof(state));
+        RegCloseKey(key);
+    }
+}
+
+/* Called with g_devices_lock held. */
+static void refresh_flow(EDataFlow flow, struct device_events *events)
+{
+    static const ERole roles[] = { eConsole, eMultimedia, eCommunications };
+    struct get_endpoint_ids_params params;
+    WCHAR *before[ARRAY_SIZE(roles)];
+    MMDevice *device, *def = NULL;
+    GUID *present;
+    UINT i, j;
+
+    for (i = 0; i < ARRAY_SIZE(roles); i++)
+        before[i] = default_device_id(flow, roles[i]);
+
+    params.flow = flow;
+    params.size = 1024;
+    params.endpoints = NULL;
+    do {
+        free(params.endpoints);
+        params.endpoints = malloc(params.size);
+        __wine_unix_call(drvs.module_unixlib, get_endpoint_ids, &params);
+    } while (params.result == HRESULT_FROM_WIN32(ERROR_INSUFFICIENT_BUFFER));
+
+    if (FAILED(params.result) || !(present = calloc(params.num ? params.num : 1, sizeof(*present))))
+    {
+        WARN("Unable to list devices: %08lx\n", params.result);
+        free(params.endpoints);
+        for (i = 0; i < ARRAY_SIZE(roles); i++)
+            CoTaskMemFree(before[i]);
+        return;
+    }
+
+    for (i = 0; i < params.num; i++)
+    {
+        const WCHAR *name = (WCHAR *)((char *)params.endpoints + params.endpoints[i].name);
+        const char *dev_name = (char *)params.endpoints + params.endpoints[i].device;
+        MMDevice *found = NULL;
+
+        get_device_guid(flow, dev_name, &present[i]);
+        LIST_FOR_EACH_ENTRY(device, &device_list, MMDevice, entry)
+        {
+            if (device->flow == flow && IsEqualGUID(&device->devguid, &present[i]))
+            {
+                found = device;
+                break;
+            }
+        }
+
+        if (!found || found->state != DEVICE_STATE_ACTIVE)
+        {
+            BOOL added = !found;
+
+            TRACE("%s device %s is now present\n", flow == eRender ? "Render" : "Capture", debugstr_w(name));
+            if (!(found = MMDevice_Create(name, &present[i], flow, DEVICE_STATE_ACTIVE, FALSE)))
+                continue;
+            set_format(found);
+            if (added)
+                add_device_event(events, DEVICE_ADDED, flow, 0, 0, device_id(found));
+            add_device_event(events, DEVICE_STATE_CHANGED, flow, 0, DEVICE_STATE_ACTIVE, device_id(found));
+        }
+        if (i == params.default_idx)
+            def = found;
+    }
+
+    LIST_FOR_EACH_ENTRY(device, &device_list, MMDevice, entry)
+    {
+        if (device->flow != flow || device->state != DEVICE_STATE_ACTIVE)
+            continue;
+        for (j = 0; j < params.num; j++)
+            if (IsEqualGUID(&device->devguid, &present[j]))
+                break;
+        if (j < params.num)
+            continue;
+        TRACE("%s device %s is no longer present\n", flow == eRender ? "Render" : "Capture",
+              debugstr_w(device->drv_id));
+        set_device_state(device, DEVICE_STATE_NOTPRESENT);
+        add_device_event(events, DEVICE_STATE_CHANGED, flow, 0, DEVICE_STATE_NOTPRESENT, device_id(device));
+    }
+
+    if (flow == eRender)
+        MMDevice_def_play = def;
+    else
+        MMDevice_def_rec = def;
+
+    for (i = 0; i < ARRAY_SIZE(roles); i++)
+    {
+        WCHAR *after = default_device_id(flow, roles[i]);
+
+        if ((!before[i] != !after) || (after && wcscmp(before[i], after)))
+        {
+            TRACE("Default %s device for role %u is now %s\n", flow == eRender ? "render" : "capture",
+                  roles[i], debugstr_w(after));
+            add_device_event(events, DEFAULT_DEVICE_CHANGED, flow, roles[i], 0, after);
+        }
+        else
+            CoTaskMemFree(after);
+        CoTaskMemFree(before[i]);
+    }
+
+    free(present);
+    free(params.endpoints);
+}
+
+static void refresh_devices(void)
+{
+    struct NotificationClientWrapper *wrapper, *next;
+    struct device_events events = { 0 };
+    UINT i;
+
+    EnterCriticalSection(&g_devices_lock);
+    refresh_flow(eRender, &events);
+    refresh_flow(eCapture, &events);
+    LeaveCriticalSection(&g_devices_lock);
+
+    EnterCriticalSection(&g_notif_lock);
+    for (i = 0; i < events.count; i++)
+    {
+        struct device_event *event = &events.events[i];
+
+        LIST_FOR_EACH_ENTRY_SAFE(wrapper, next, &g_notif_clients, struct NotificationClientWrapper, entry)
+        {
+            switch (event->type)
+            {
+            case DEVICE_ADDED:
+                IMMNotificationClient_OnDeviceAdded(wrapper->client, event->id);
+                break;
+            case DEVICE_STATE_CHANGED:
+                IMMNotificationClient_OnDeviceStateChanged(wrapper->client, event->id, event->state);
+                break;
+            case DEFAULT_DEVICE_CHANGED:
+                IMMNotificationClient_OnDefaultDeviceChanged(wrapper->client, event->flow, event->role, event->id);
+                break;
+            }
+        }
+    }
+    LeaveCriticalSection(&g_notif_lock);
+
+    for (i = 0; i < events.count; i++)
+        CoTaskMemFree(events.events[i].id);
+    free(events.events);
+}
+
+static DWORD WINAPI device_watch_proc(void *user)
+{
+    struct wait_device_change_params params = { 0 };
+
+    SetThreadDescription(GetCurrentThread(), L"wine_mmdevapi_devices");
+
+    for (;;)
+    {
+        params.result = E_NOTIMPL;
+        if (__wine_unix_call(drvs.module_unixlib, wait_device_change, &params) || FAILED(params.result))
+        {
+            WARN("The driver doesn't report device changes: %08lx\n", params.result);
+            return 0;
+        }
+        refresh_devices();
+    }
+}
+
+/* After the driver's devices are loaded. Only the Mac driver reports changes. */
+void start_device_watch(void)
+{
+    HANDLE thread;
+
+    if (wcscmp(drvs.module_name, L"winecoreaudio.drv"))
+        return;
+    if ((thread = CreateThread(NULL, 0, device_watch_proc, NULL, 0, NULL)))
+        CloseHandle(thread);
+    else
+        ERR("CreateThread failed: %lu\n", GetLastError());
+}
