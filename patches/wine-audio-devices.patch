+}
+
+static AudioDeviceID voice_microphone(AudioDeviceID default_id, const AudioDeviceID *devices, unsigned int count)
+{
+    const AudioObjectPropertyAddress addr =
+        { kAudioDevicePropertyTransportType, kAudioObjectPropertyScopeGlobal, kAudioObjectPropertyElementMain };
+    unsigned int i;
+
+    if (!device_is_bluetooth(default_id) || lid_closed())
+        return default_id;
+
+    for (i = 0; i < count; i++)
+    {
+        UInt32 transport = 0, size = sizeof(transport);
+
+        if (AudioObjectGetPropertyData(devices[i], &addr, 0, NULL, &size, &transport) == noErr &&
+            transport == kAudioDeviceTransportTypeBuiltIn && device_alive(devices[i]) &&
+            device_has_channels(devices[i], eCapture))
+        {
+            TRACE("Default microphone %u is Bluetooth; using the built-in microphone %u\n",
+                  (unsigned int)default_id, (unsigned int)devices[i]);
+            return devices[i];
+        }
+    }
+    return default_id;
+}
