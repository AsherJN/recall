+/* Voice chat with Bluetooth headphones: while anything records from a Bluetooth
+ * headset's microphone, macOS switches the headset to its hands-free profile, with
+ * low-quality mono sound both ways. So while the Mac's default microphone is a
+ * Bluetooth headset's and the Mac's own microphone can hear (lid open), Wine's
+ * default microphone is the Mac's own, also when the headset connects during play.
+ * A microphone a program chooses by name is used as chosen.
+ * WINECOREAUDIO_TEST_BLUETOOTH_UID names a device to treat as Bluetooth, for tests. */
+static BOOL device_is_bluetooth(AudioDeviceID device)
+{
+    const AudioObjectPropertyAddress addr =
+        { kAudioDevicePropertyTransportType, kAudioObjectPropertyScopeGlobal, kAudioObjectPropertyElementMain };
+    const char *test = getenv("WINECOREAUDIO_TEST_BLUETOOTH_UID");
+    UInt32 transport = 0, size = sizeof(transport);
+
+    if (test && *test)
+    {
+        const AudioObjectPropertyAddress uid_addr =
+            { kAudioDevicePropertyDeviceUID, kAudioObjectPropertyScopeGlobal, kAudioObjectPropertyElementMain };
+        CFStringRef uid = NULL;
+        char buffer[256];
+        BOOL match = FALSE;
+
+        size = sizeof(uid);
+        if (AudioObjectGetPropertyData(device, &uid_addr, 0, NULL, &size, &uid) == noErr && uid)
+        {
+            match = CFStringGetCString(uid, buffer, sizeof(buffer), kCFStringEncodingUTF8) && !strcmp(buffer, test);
+            CFRelease(uid);
+        }
+        if (match) return TRUE;
+        size = sizeof(transport);
+    }
+
+    if (AudioObjectGetPropertyData(device, &addr, 0, NULL, &size, &transport) != noErr)
+        return FALSE;
+    return transport == kAudioDeviceTransportTypeBluetooth || transport == kAudioDeviceTransportTypeBluetoothLE;
+}
