+static BOOL lid_closed(void)
+{
+    /* IOKit is loaded on first use: the driver isn't linked with it. */
+    static io_service_t (*pIOServiceGetMatchingService)(mach_port_t, CFDictionaryRef);
+    static CFMutableDictionaryRef (*pIOServiceMatching)(const char *);
+    static CFTypeRef (*pIORegistryEntryCreateCFProperty)(io_registry_entry_t, CFStringRef, CFAllocatorRef, IOOptionBits);
+    static kern_return_t (*pIOObjectRelease)(io_object_t);
+    static void *iokit;
+    io_service_t domain;
+    CFTypeRef value;
+    BOOL closed;
+
+    if (!iokit)
+    {
+        if (!(iokit = dlopen("/System/Library/Frameworks/IOKit.framework/IOKit", RTLD_LAZY | RTLD_LOCAL)))
+            return FALSE;
+        pIOServiceGetMatchingService = dlsym(iokit, "IOServiceGetMatchingService");
+        pIOServiceMatching = dlsym(iokit, "IOServiceMatching");
+        pIORegistryEntryCreateCFProperty = dlsym(iokit, "IORegistryEntryCreateCFProperty");
+        pIOObjectRelease = dlsym(iokit, "IOObjectRelease");
+    }
+    if (!pIOServiceGetMatchingService || !pIOServiceMatching || !pIORegistryEntryCreateCFProperty || !pIOObjectRelease)
+        return FALSE;
+
+    if (!(domain = pIOServiceGetMatchingService(MACH_PORT_NULL, pIOServiceMatching("IOPMrootDomain"))))
+        return FALSE;
+    value = pIORegistryEntryCreateCFProperty(domain, CFSTR("AppleClamshellState"), kCFAllocatorDefault, 0);
+    pIOObjectRelease(domain);
