+/* Device changes. Core Audio calls device_change_cb on its own threads whenever the
+ * device list or a default device changes; unix_wait_device_change, on mmdevapi's
+ * device watch thread, returns once such changes settle, and mmdevapi lists the
+ * devices again. A stream whose device is gone reports AUDCLNT_E_DEVICE_INVALIDATED,
+ * as on Windows, until its device comes back; only once mmdevapi has listed the
+ * devices again (device_listed_serial), so a program that reopens the default device
+ * at once gets the new one. */
+static pthread_mutex_t device_change_lock = PTHREAD_MUTEX_INITIALIZER;
+static pthread_cond_t device_change_cond = PTHREAD_COND_INITIALIZER;
+static UINT64 device_change_serial, device_listed_serial;
+static BOOL device_watch_started;
+
+static const AudioObjectPropertyAddress device_change_addresses[] =
+{
+    { kAudioHardwarePropertyDevices, kAudioObjectPropertyScopeGlobal, kAudioObjectPropertyElementMain },
+    { kAudioHardwarePropertyDefaultOutputDevice, kAudioObjectPropertyScopeGlobal, kAudioObjectPropertyElementMain },
+    { kAudioHardwarePropertyDefaultInputDevice, kAudioObjectPropertyScopeGlobal, kAudioObjectPropertyElementMain },
+};
+
+static OSStatus device_change_cb(AudioObjectID object, UInt32 count,
+                                 const AudioObjectPropertyAddress *addresses, void *user)
+{
+    pthread_mutex_lock(&device_change_lock);
+    __atomic_store_n(&device_change_serial, device_change_serial + 1, __ATOMIC_RELEASE);
+    pthread_cond_broadcast(&device_change_cond);
+    pthread_mutex_unlock(&device_change_lock);
+    return noErr;
+}
+
+static NTSTATUS unix_wait_device_change(void *args)
+{
+    struct wait_device_change_params *params = args;
+    const struct timespec quiet = { 0, 300000000 };
+    unsigned int i, waited;
+    UINT64 seen;
+    BOOL start;
+
+    pthread_mutex_lock(&device_change_lock);
+    start = !device_watch_started;
+    device_watch_started = TRUE;
+    pthread_mutex_unlock(&device_change_lock);
+
+    if (start)
+    {
+        for (i = 0; i < ARRAYSIZE(device_change_addresses); i++)
+            if (AudioObjectAddPropertyListener(kAudioObjectSystemObject, &device_change_addresses[i],
+                                               device_change_cb, NULL) != noErr)
+                WARN("Unable to watch audio device property %08x\n",
+                     (unsigned int)device_change_addresses[i].mSelector);
+        params->serial = __atomic_load_n(&device_change_serial, __ATOMIC_ACQUIRE);
+        params->result = S_FALSE;
+        return STATUS_SUCCESS;
+    }
+
+    /* mmdevapi has listed the devices for every change up to the serial it passes. */
+    __atomic_store_n(&device_listed_serial, params->serial, __ATOMIC_RELEASE);
+
+    pthread_mutex_lock(&device_change_lock);
+    while (device_change_serial == params->serial)
+        pthread_cond_wait(&device_change_cond, &device_change_lock);
+    /* A device that arrives changes the list first, then the defaults: wait until 0.3
+     * seconds pass without a change, for up to three seconds. */
+    for (waited = 0; waited < 10; waited++)
+    {
+        seen = device_change_serial;
+        pthread_cond_timedwait_relative_np(&device_change_cond, &device_change_lock, &quiet);
+        if (device_change_serial == seen)
+            break;
+    }
+    params->serial = device_change_serial;
+    pthread_mutex_unlock(&device_change_lock);
+
+    params->result = S_OK;
+    return STATUS_SUCCESS;
+}
+
+static BOOL device_alive(AudioDeviceID device)
+{
+    const AudioObjectPropertyAddress addr =
+        { kAudioDevicePropertyDeviceIsAlive, kAudioObjectPropertyScopeGlobal, kAudioObjectPropertyElementMain };
+    UInt32 alive = 0, size = sizeof(alive);
+
+    return device != kAudioObjectUnknown &&
+           AudioObjectGetPropertyData(device, &addr, 0, NULL, &size, &alive) == noErr && alive;
+}
+
+/* Called with the stream's lock held; asks Core Audio only after a device change. */
+static BOOL stream_device_gone(struct coreaudio_stream *stream)
+{
+    UINT64 serial = __atomic_load_n(&device_listed_serial, __ATOMIC_ACQUIRE);
+
+    if (serial != stream->device_serial)
+    {
+        stream->device_serial = serial;
+        stream->device_gone = !device_alive(stream->dev_id);
+        if (stream->device_gone)
+            TRACE("The device of stream %p is gone\n", stream);
+    }
+    return stream->device_gone;
+}
