+  /**
+  Stream output is emulated in the vertex shader: from a vertex shader, or from a geometry shader that
+  passes points through unchanged.
+  */
+  bool
+  CanEmulateStreamOutput(const void *pShaderBytecode, SIZE_T BytecodeLength) {
+    using namespace microsoft;
+    CDXBCParser parser;
+    if (parser.ReadDXBC(pShaderBytecode, BytecodeLength) != S_OK)
+      return false;
+    UINT blob = parser.FindNextMatchingBlob(DXBC_GenericShaderEx);
+    if (blob == DXBC_BLOB_NOT_FOUND)
+      blob = parser.FindNextMatchingBlob(DXBC_GenericShader);
+    if (blob == DXBC_BLOB_NOT_FOUND)
+      return false;
+    switch (DECODE_D3D10_SB_TOKENIZED_PROGRAM_TYPE(*(const UINT *)parser.GetBlob(blob))) {
+    case D3D10_SB_VERTEX_SHADER:
+      return true;
+    case D3D10_SB_GEOMETRY_SHADER: {
+      Com<ID3D11GeometryShader> shader;
+      if (FAILED(pipeline_cache_->AddGeometryShader(pShaderBytecode, BytecodeLength, &shader)))
+        return false;
+      auto &gs = com_cast<IMTLD3D11Shader>(shader.ptr())->GetManagedShader()->reflection().GeometryShader;
+      return gs.OutputIsInput && gs.Primitive == D3D10_SB_PRIMITIVE_POINT;
+    }
+    default:
+      return false;
+    }
+  }
