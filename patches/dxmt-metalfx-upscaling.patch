+bool
+adapter_luid(IUnknown *adapter, LUID *luid) {
+  IDXGIAdapter *dxgi = nullptr;
+  if (adapter) {
+    if (FAILED(adapter->QueryInterface(IID_PPV_ARGS(&dxgi))))
+      return false;
+  } else {
+    auto create = reinterpret_cast<HRESULT(WINAPI *)(REFIID, void **)>(
+        GetProcAddress(LoadLibraryA("dxgi.dll"), "CreateDXGIFactory1")
+    );
+    IDXGIFactory1 *factory = nullptr;
+    if (!create || FAILED(create(IID_PPV_ARGS(&factory))))
+      return false;
+    HRESULT hr = factory->EnumAdapters(0, &dxgi);
+    factory->Release();
+    if (FAILED(hr))
+      return false;
+  }
+  DXGI_ADAPTER_DESC desc;
+  HRESULT hr = dxgi->GetDesc(&desc);
+  dxgi->Release();
+  if (FAILED(hr))
+    return false;
+  *luid = desc.AdapterLuid;
+  return true;
+}
