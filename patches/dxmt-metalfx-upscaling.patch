+// Compiled from source the first time it is needed (by macOS, which needs no developer tools), so
+// that the build's precompiled library stays as it is.
+static const char kOffsetMotionVectorSource[] = R"(
+#include <metal_stdlib>
+using namespace metal;
+
+struct offset_mv_desc {
+  float2 scale;
+  float2 offset;
+  uint2 size;
+};
+
+[[kernel]] void cs_offset_mv(
+  uint2 pos [[thread_position_in_grid]],
+  constant offset_mv_desc& desc [[buffer(0)]],
+  texture2d<float, access::read> motion [[texture(0)]],
+  texture2d<float, access::write> offset [[texture(1)]]
+) {
+  if (pos.x >= desc.size.x || pos.y >= desc.size.y)
+    return;
+  offset.write(float4(motion.read(pos).xy * desc.scale + desc.offset, 0, 0), pos);
+}
+)";
+
+struct offset_mv_desc {
+  float scale_x;
+  float scale_y;
+  float offset_x;
+  float offset_y;
+  uint32_t width;
+  uint32_t height;
+};
+
+bool
+MTLFXMVScaleContext::dispatchOffset(
+    const Rc<Texture> &motion, TextureViewKey view_motion, const Rc<Texture> &offset, float scale_x,
+    float scale_y, float offset_x, float offset_y, uint32_t width, uint32_t height
+) {
+  if (!std::exchange(offset_mv_tried_, true)) {
+    WMT::Reference<WMT::Error> err;
+    auto library = device_.newLibraryWithSource(kOffsetMotionVectorSource, err);
+    if (library) {
+      auto cs = library.newFunction("cs_offset_mv");
+      pso_offset_mv_ = device_.newComputePipelineState(cs, err);
+    }
+    if (!pso_offset_mv_)
+      ERR("MetalFX: the motion vector offset pass did not compile; jittered motion vectors stay as they are");
+  }
+  if (!pso_offset_mv_)
+    return false;
+
+  ctx_.startComputePass(0);
+  auto tex_motion = ctx_.access(motion, view_motion, ResourceAccess::Read).texture;
+  auto tex_offset = ctx_.access(offset, offset->fullView, ResourceAccess::Write).texture;
+
+  auto &setpso = ctx_.encodeComputeCommand<wmtcmd_compute_setpso>();
+  setpso.type = WMTComputeCommandSetPSO;
+  setpso.pso = pso_offset_mv_;
+  setpso.threadgroup_size = {8, 8, 1};
+
+  auto &setmotion = ctx_.encodeComputeCommand<wmtcmd_compute_settexture>();
+  setmotion.type = WMTComputeCommandSetTexture;
+  setmotion.texture = tex_motion;
+  setmotion.index = 0;
+
+  auto &setoffset = ctx_.encodeComputeCommand<wmtcmd_compute_settexture>();
+  setoffset.type = WMTComputeCommandSetTexture;
+  setoffset.texture = tex_offset;
+  setoffset.index = 1;
+
+  offset_mv_desc desc{scale_x, scale_y, offset_x, offset_y, width, height};
+  auto &setdesc = ctx_.encodeComputeCommand<wmtcmd_compute_setbytes>();
+  setdesc.type = WMTComputeCommandSetBytes;
+  void *temp = ctx_.allocate_cpu_heap(sizeof(desc), 16);
+  memcpy(temp, &desc, sizeof(desc));
+  setdesc.bytes.set(temp);
+  setdesc.length = sizeof(desc);
+  setdesc.index = 0;
+
+  auto &dispatch = ctx_.encodeComputeCommand<wmtcmd_compute_dispatch>();
+  dispatch.type = WMTComputeCommandDispatchThreads;
+  dispatch.size = {width, height, 1};
+
+  ctx_.endPass();
+  return true;
+}
+
+// Sharpening after MetalFX (Recall's MetalFX upscaling setting), compiled at run time like the pass
+// above. The method is AMD FidelityFX RCAS (robust contrast-adaptive sharpening): each pixel gets a
+// negative lobe on its four neighbours, as strong as it can be without leaving the neighbours' range,
+// times `amount`. RCAS expects values from 0 to 1, and the game hands MetalFX HDR colour, so each
+// pixel is divided by 1 + its brightest channel (Reinhard) and the result scaled back by the centre
+// pixel's own factor: a lone bright highlight changes by as little as the rest of the picture.
+// Alpha is kept.
+static const char kSharpenSource[] = R"(
+#include <metal_stdlib>
+using namespace metal;
+
+struct sharpen_desc {
+  float amount;
+  uint width;
+  uint height;
+};
+
+static float3 compress(float3 c) {
+  c = max(c, 0.0f);
+  return c / (1.0f + max3(c.r, c.g, c.b));
+}
+
+[[kernel]] void cs_sharpen(
+  uint2 pos [[thread_position_in_grid]],
+  constant sharpen_desc& desc [[buffer(0)]],
+  texture2d<float, access::read> source [[texture(0)]],
+  texture2d<float, access::write> target [[texture(1)]]
+) {
+  if (pos.x >= desc.width || pos.y >= desc.height)
+    return;
+  uint2 last = uint2(desc.width - 1, desc.height - 1);
+  float4 center = source.read(pos);
+  float3 c = max(center.rgb, 0.0f);
+  float scale = 1.0f + max3(c.r, c.g, c.b);
+  float3 e = c / scale;
+  float3 b = compress(source.read(uint2(pos.x, pos.y > 0 ? pos.y - 1 : 0)).rgb);
+  float3 d = compress(source.read(uint2(pos.x > 0 ? pos.x - 1 : 0, pos.y)).rgb);
+  float3 f = compress(source.read(uint2(min(pos.x + 1, last.x), pos.y)).rgb);
+  float3 h = compress(source.read(uint2(pos.x, min(pos.y + 1, last.y))).rgb);
+  float3 lo = min(min(b, d), min(f, h));
+  float3 hi = max(max(b, d), max(f, h));
+  float3 hit_lo = min(lo, e) / max(4.0f * hi, 1.0e-6f);
+  float3 hit_hi = (1.0f - max(hi, e)) / min(4.0f * lo - 4.0f, -1.0e-6f);
+  float3 lobes = max(-hit_lo, hit_hi);
+  float lobe = max(-0.1875f, min(max3(lobes.r, lobes.g, lobes.b), 0.0f)) * desc.amount;
+  float3 sharp = (lobe * (b + d + f + h) + e) / (4.0f * lobe + 1.0f);
+  target.write(float4(sharp * scale, center.a), pos);
+}
+)";
+
+struct sharpen_desc {
+  float amount;
+  uint32_t width;
+  uint32_t height;
+};
+
+bool
+MTLFXMVScaleContext::sharpenAvailable() {
+  if (!std::exchange(sharpen_tried_, true)) {
+    WMT::Reference<WMT::Error> err;
+    auto library = device_.newLibraryWithSource(kSharpenSource, err);
+    if (library) {
+      auto cs = library.newFunction("cs_sharpen");
+      pso_sharpen_ = device_.newComputePipelineState(cs, err);
+    }
+    if (!pso_sharpen_)
+      ERR("MetalFX: the sharpening pass did not compile; the picture stays unsharpened");
+  }
+  return pso_sharpen_ != nullptr;
+}
+
+void
+MTLFXMVScaleContext::dispatchSharpen(
+    const Rc<Texture> &source, const Rc<Texture> &target, float amount, uint32_t width, uint32_t height
+) {
+  ctx_.startComputePass(0);
+  auto tex_source = ctx_.access(source, source->fullView, ResourceAccess::Read).texture;
+  auto tex_target = ctx_.access(target, target->fullView, ResourceAccess::Write).texture;
+
+  auto &setpso = ctx_.encodeComputeCommand<wmtcmd_compute_setpso>();
+  setpso.type = WMTComputeCommandSetPSO;
+  setpso.pso = pso_sharpen_;
+  setpso.threadgroup_size = {8, 8, 1};
+
+  auto &setsource = ctx_.encodeComputeCommand<wmtcmd_compute_settexture>();
+  setsource.type = WMTComputeCommandSetTexture;
+  setsource.texture = tex_source;
+  setsource.index = 0;
+
+  auto &settarget = ctx_.encodeComputeCommand<wmtcmd_compute_settexture>();
+  settarget.type = WMTComputeCommandSetTexture;
+  settarget.texture = tex_target;
+  settarget.index = 1;
+
+  sharpen_desc desc{amount, width, height};
+  auto &setdesc = ctx_.encodeComputeCommand<wmtcmd_compute_setbytes>();
+  setdesc.type = WMTComputeCommandSetBytes;
+  void *temp = ctx_.allocate_cpu_heap(sizeof(desc), 16);
+  memcpy(temp, &desc, sizeof(desc));
+  setdesc.bytes.set(temp);
+  setdesc.length = sizeof(desc);
+  setdesc.index = 0;
+
+  auto &dispatch = ctx_.encodeComputeCommand<wmtcmd_compute_dispatch>();
+  dispatch.type = WMTComputeCommandDispatchThreads;
+  dispatch.size = {width, height, 1};
+
+  ctx_.endPass();
+}
