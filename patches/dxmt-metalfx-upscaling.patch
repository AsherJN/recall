+namespace {
+
+constexpr HRESULT D3D12_UNAVAILABLE = (HRESULT)0x887A0004L; // DXGI_ERROR_UNSUPPORTED
+constexpr UINT HIGHEST_FEATURE_LEVEL = 0xc100;               // 12_1
+
+const GUID IID_ID3D12Object_ = {0xc4fec28f, 0x7966, 0x4e95, {0x9f, 0x94, 0xf4, 0x31, 0xcb, 0x56, 0xc3, 0xb8}};
+const GUID IID_ID3D12Device_ = {0x189819f1, 0x1db6, 0x4b57, {0xbe, 0x54, 0x18, 0x21, 0x33, 0x9b, 0x85, 0xf7}};
+
+struct NullDevice {
+  const void *const *vtbl;
+  LONG ref;
+  LUID luid;
+};
+
+HRESULT
+refuse(const char *method, void **out) {
+  WARN("d3d12: ", method, " refused (null device)");
+  if (out)
+    *out = nullptr;
+  return E_NOTIMPL;
+}
+
+// IUnknown and ID3D12Object
+
+HRESULT STDMETHODCALLTYPE
+QueryInterface(NullDevice *self, REFIID iid, void **out) {
+  if (!out)
+    return E_POINTER;
+  if (IsEqualGUID(iid, __uuidof(IUnknown)) || IsEqualGUID(iid, IID_ID3D12Object_) ||
+      IsEqualGUID(iid, IID_ID3D12Device_)) {
+    InterlockedIncrement(&self->ref);
+    *out = self;
+    return S_OK;
+  }
+  WARN("d3d12: QueryInterface ", iid, " -> E_NOINTERFACE");
+  *out = nullptr;
+  return E_NOINTERFACE;
+}
+
+ULONG STDMETHODCALLTYPE
+AddRef(NullDevice *self) {
+  return InterlockedIncrement(&self->ref);
+}
+
+ULONG STDMETHODCALLTYPE
+Release(NullDevice *self) {
+  ULONG ref = InterlockedDecrement(&self->ref);
+  if (!ref) {
+    WARN("d3d12: null device released");
+    HeapFree(GetProcessHeap(), 0, self);
+  }
+  return ref;
+}
