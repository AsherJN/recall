+  // Every parameter with its type and value, sorted by name, eight to a line (diagnostics; Wine
+  // raises an exception for a debug line over about 1000 bytes).
+  std::string
+  Describe() const {
+    std::map<std::string, std::string> sorted;
+    for (auto &[name, value] : values_)
+      sorted[name] = std::visit(
+          overloads{
+              [](unsigned long long v) { return "ull " + std::to_string(v); },
+              [](float v) { return "float " + std::to_string(v); },
+              [](double v) { return "double " + std::to_string(v); },
+              [](unsigned int v) { return "uint " + std::to_string(v); },
+              [](int v) { return "int " + std::to_string(v); },
+              [](void *v) { return std::string(v ? "pointer" : "null pointer"); },
+              [](ID3D11Resource *v) { return std::string(v ? "D3D11 resource" : "null D3D11 resource"); },
+              [](ID3D12Resource *v) { return std::string(v ? "D3D12 resource" : "null D3D12 resource"); }
+          },
+          value
+      );
+    std::string out;
+    unsigned count = 0;
+    for (auto &[name, value] : sorted)
+      out += name + " = " + value + (++count % 8 ? "; " : "\n");
