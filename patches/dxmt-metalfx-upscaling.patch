+HRESULT STDMETHODCALLTYPE
+CheckFeatureSupport(NullDevice *, UINT feature, void *data, UINT size) {
+  WARN("d3d12: CheckFeatureSupport ", feature, ", ", size, " bytes");
+  if (!data)
+    return E_INVALIDARG;
+  switch (feature) {
+  case 1:    // D3D12_FEATURE_ARCHITECTURE
+  case 16: { // D3D12_FEATURE_ARCHITECTURE1: one node, unified memory
+    if (size < 16)
+      return E_INVALIDARG;
+    auto fields = static_cast<UINT *>(data);
+    UINT node = fields[0];
+    std::memset(data, 0, size);
+    fields[0] = node;
+    fields[2] = TRUE; // UMA
+    fields[3] = TRUE; // CacheCoherentUMA
+    break;
+  }
+  case 2: { // D3D12_FEATURE_FEATURE_LEVELS: the highest requested level up to 12_1
+    struct FeatureLevels {
+      UINT count;
+      const UINT *requested;
+      UINT max_supported;
+    };
+    if (size != sizeof(FeatureLevels))
+      return E_INVALIDARG;
+    auto levels = static_cast<FeatureLevels *>(data);
+    UINT best = 0;
+    for (UINT i = 0; levels->requested && i < levels->count; i++)
+      if (levels->requested[i] <= HIGHEST_FEATURE_LEVEL && levels->requested[i] > best)
+        best = levels->requested[i];
+    if (!best)
+      return D3D12_UNAVAILABLE;
+    levels->max_supported = best;
+    break;
+  }
+  case 4: // D3D12_FEATURE_FORMAT_SUPPORT: keep the format, support nothing
+  case 6: // D3D12_FEATURE_FORMAT_INFO
+    if (size < 4)
+      return E_INVALIDARG;
+    std::memset(static_cast<char *>(data) + 4, 0, size - 4);
+    break;
+  case 5: // D3D12_FEATURE_MULTISAMPLE_QUALITY_LEVELS: keep format, count and flags
+    if (size < 12)
+      return E_INVALIDARG;
+    std::memset(static_cast<char *>(data) + 12, 0, size - 12);
+    break;
+  case 7: // D3D12_FEATURE_SHADER_MODEL: 5.1, Direct3D 12's minimum
+    if (size < 4)
+      return E_INVALIDARG;
+    *static_cast<UINT *>(data) = 0x51;
+    break;
+  case 12: // D3D12_FEATURE_ROOT_SIGNATURE: version 1.0
+    if (size < 4)
+      return E_INVALIDARG;
+    *static_cast<UINT *>(data) = 1;
+    break;
+  default: // every optional feature unsupported
+    std::memset(data, 0, size);
+    break;
+  }
+  return S_OK;
+}
