+NVNGX_API NVNGX_RESULT
+NVSDK_NGX_D3D12_GetCapabilityParameters(NVNGXParameter **out_params) {
+  WARN("NVSDK_NGX_D3D12_GetCapabilityParameters: nothing runs on Direct3D 12");
+  if (!out_params)
