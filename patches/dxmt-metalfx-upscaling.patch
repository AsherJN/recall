-// A d3d12.dll that loads but offers no Direct3D 12 device.
+// A d3d12.dll for DLSS sessions: it loads and offers only a "null" Direct3D 12 device.
 //
 // NVIDIA Streamline's sl.common.dll imports d3d12.dll even when the game renders with
-// Direct3D 11, so without any d3d12.dll Streamline (and with it DLSS) cannot load. The
-// runtime's own d3d12.dll is Apple's D3DMetal shim, which crashes next to DXMT's DXGI, so
-// launches disable it. This stand-in satisfies the import and fails every call the way a
-// system without Direct3D 12 would, so nothing can pick a D3D12 path.
+// Direct3D 11. It also builds a "DX11 on DX12" helper device and initialises NGX's Direct3D 12
+// side with it, and NGX then asks that device for its adapter (ID3D12Device::GetAdapterLuid):
+// without a device it reads through a null pointer. The runtime's own d3d12.dll is Apple's
+// D3DMetal shim, which crashes next to DXMT's DXGI, so launches without DLSS disable d3d12.
+//
+// The null device answers identity and capability questions (one node, the DXGI adapter's
+// LUID, no optional features) and refuses to create anything, so nothing can render through
+// it. It is never offered at feature level 12_2, which Overwatch's own Direct3D 12 mode needs.
+// Every call is logged to d3d12.log.
 
 #include <windows.h>
+#include <dxgi.h>
+
+#include <cstring>
+#include <utility>
