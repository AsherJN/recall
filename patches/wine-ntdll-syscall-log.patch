+/* WINE_IO_ERROR_LOG=<file> (diagnostics): every failed NtReadFile, with its status, errno,
+ * file, offset and length, to <file>.<pid>. For "TACT File read failed" before a game crash. */
+static void log_read_failure( HANDLE handle, int unix_fd, unsigned int status, int error,
+                              const LARGE_INTEGER *offset, ULONG length, BOOL async )
+{
+    static FILE *log;
+    static int initialized;
+    static pthread_mutex_t lock = PTHREAD_MUTEX_INITIALIZER;
+    char path[1024] = "?";
+    struct timeval now;
+
+    if (status == STATUS_PENDING || status == STATUS_END_OF_FILE || status == STATUS_BUFFER_OVERFLOW ||
+        status == STATUS_TIMEOUT || status == STATUS_PIPE_BROKEN)
+        return;
+    pthread_mutex_lock( &lock );
+    if (!initialized)
+    {
+        const char *value = getenv( "WINE_IO_ERROR_LOG" );
+        char name[1024];
+        initialized = 1;
+        if (value && *value)
+        {
+            snprintf( name, sizeof(name), "%s.%d", value, (int)getpid() );
+            if ((log = fopen( name, "a" ))) setvbuf( log, NULL, _IOLBF, 0 );
+        }
+    }
+    if (log)
+    {
+#ifdef F_GETPATH
+        if (unix_fd >= 0 && fcntl( unix_fd, F_GETPATH, path ) == -1) strcpy( path, "?" );
+#endif
+        gettimeofday( &now, NULL );
+        fprintf( log, "%lld.%03d NtReadFile handle=%p status=%#x errno=%d async=%d offset=%lld length=%u path=%s\n",
+                 (long long)now.tv_sec, (int)(now.tv_usec / 1000), handle, status, error, async,
+                 offset ? (long long)offset->QuadPart : -1LL, (unsigned int)length, path );
+    }
+    pthread_mutex_unlock( &lock );
+}
