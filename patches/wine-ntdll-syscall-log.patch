+#if defined(__APPLE__) && !defined(HAVE_WINE_PRELOADER)
+/* Recall: macOS turns Game Mode on only for a process whose executable is the main
+ * executable of an app bundle that declares itself a game. WINE_GAME_MODE lists, by file
+ * name and separated by commas, the programs that start from such a bundle: for
+ * Overwatch.exe, a copy of the loader at <dll_dir>/game-mode/Overwatch.app/Contents/MacOS/wine.
+ * argv[0] stays the usual loader's path; the copy finds ntdll.so through it (loader/main.c
+ * tries argv[0] after its own path). Any other program, or a missing bundle, starts as before. */
+static void game_mode_exec( char **argv, const char *image_path )
+{
+    const char *list = getenv( "WINE_GAME_MODE" ), *name = image_path, *p, *end;
+    size_t len;
+    char *path;
+
+    if (!list || !image_path || !dll_dir) return;
+    if ((p = strrchr( name, '\\' ))) name = p + 1;
+    if ((p = strrchr( name, '/' ))) name = p + 1;
+    len = strlen( name );
+    for (p = list; ; p = end + 1)
+    {
+        if (!(end = strchr( p, ',' ))) end = p + strlen( p );
+        if (end - p == len && len && !strncasecmp( p, name, len )) break;
+        if (!*end) return;
+    }
+    if (len > 4 && !strcasecmp( name + len - 4, ".exe" )) len -= 4;
+    if (asprintf( &path, "%s/game-mode/%.*s.app/Contents/MacOS/wine", dll_dir, (int)len, name ) < 0) return;
+    if (!access( path, X_OK )) execv( path, argv );
+    free( path );
+}
