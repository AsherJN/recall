+/* WINE_SYSCALL_LOG=<file> (diagnostics): count the process's system calls and the time
+ * spent in them through the dispatcher's trace path, and write the busiest every 100 ms
+ * with the process's BSD and Mach system call counts, page faults and context switches,
+ * signal and fault counters, virtual_mutex wait and hold times, the threads that used the
+ * most CPU and rarely used system calls. System calls that run longer than 30 ms without
+ * waiting on purpose get a line of their own. */
+#define SYSCALL_LOG_TABLES 2
+#define SYSCALL_LOG_DEPTH 8
+#define SYSCALL_LOG_ARGS 6
+#define SYSCALL_LOG_LONG_NS 30000000
+#define SYSCALL_LOG_THREADS 1024
+static LONG64 syscall_log_count[SYSCALL_LOG_TABLES][4096];
+static LONG64 syscall_log_time[SYSCALL_LOG_TABLES][4096];
+static FILE *syscall_log_file;
+static __thread UINT64 syscall_log_start[SYSCALL_LOG_DEPTH];
+static __thread ULONG_PTR syscall_log_args[SYSCALL_LOG_DEPTH][SYSCALL_LOG_ARGS];
+static __thread unsigned int syscall_log_depth;
+int wine_diag_enabled;
+LONG64 wine_diag_counts[DIAG_COUNTERS];
+struct wine_diag_lock_stats wine_diag_vm_lock;
+
+static const char * const wine_diag_names[DIAG_COUNTERS] =
+{
+    "segv", "pagefault", "raise", "xgetbv", "cetnop", "trap", "usr1",
+    "misreport", "wx", "exec", "guard", "writewatch", "unhandled", "mprotect", "mmap"
+};
+
+static UINT64 syscall_log_now_ns(void)
+{
+#ifdef __APPLE__
+    static mach_timebase_info_data_t timebase;
+    if (!timebase.denom) mach_timebase_info( &timebase );
+    return mach_absolute_time() * timebase.numer / timebase.denom;
+#else
+    struct timespec ts;
+    clock_gettime( CLOCK_MONOTONIC, &ts );
+    return ts.tv_sec * 1000000000ull + ts.tv_nsec;
+#endif
+}
+
+UINT64 wine_diag_now_ns(void)
+{
+    return syscall_log_now_ns();
+}
+
+static const char *syscall_log_name( UINT idx, UINT num, char *buffer, size_t size )
+{
+    const char **names = syscall_names[idx];
+    if (names && names[num]) return names[num];
+    snprintf( buffer, size, "%u:%03x", idx, num );
+    return buffer;
+}
+
+struct syscall_log_entry { UINT idx, num; LONG64 value; };
+
+static void syscall_log_top( struct syscall_log_entry *top, int count, UINT idx, UINT num, LONG64 value )
+{
+    int i, j;
+
+    for (i = 0; i < count && top[i].value >= value; i++);
+    if (i == count) return;
+    for (j = count - 1; j > i; j--) top[j] = top[j - 1];
+    top[i].idx = idx; top[i].num = num; top[i].value = value;
+}
+
+/* append to a line buffer without overflowing it */
+static void syscall_log_append( char *line, size_t size, size_t *pos, const char *format, ... )
+{
+    va_list args;
+    int len;
+
+    if (*pos >= size - 1) return;
+    va_start( args, format );
+    len = vsnprintf( line + *pos, size - *pos, format, args );
+    va_end( args );
+    if (len > 0) *pos = min( *pos + len, size - 1 );
+}
+
+static UINT64 syscall_log_exchange( UINT64 *value )
+{
+    return __atomic_exchange_n( value, 0, __ATOMIC_RELAXED );
+}
+
+#ifdef __APPLE__
+struct syscall_log_thread_info { UINT64 id, user, system; };
+struct syscall_log_busy { UINT64 id, user, system; char name[24]; };
+
+/* the threads that used the most CPU since the last call, and how many are running */
+static int syscall_log_threads( struct syscall_log_busy *busy, int count, int *running )
+{
+    static struct syscall_log_thread_info known[SYSCALL_LOG_THREADS];
+    thread_act_array_t list;
+    mach_msg_type_number_t n, i;
+    int found = 0;
+
+    *running = 0;
+    if (task_threads( mach_task_self(), &list, &n )) return 0;
+    for (i = 0; i < n; i++)
+    {
+        thread_identifier_info_data_t ident;
+        thread_extended_info_data_t info;
+        mach_msg_type_number_t ident_count = THREAD_IDENTIFIER_INFO_COUNT, info_count = THREAD_EXTENDED_INFO_COUNT;
+        UINT64 user, system;
+        unsigned int slot, probe;
+        int j, k;
+
+        if (!thread_info( list[i], THREAD_IDENTIFIER_INFO, (thread_info_t)&ident, &ident_count ) &&
+            !thread_info( list[i], THREAD_EXTENDED_INFO, (thread_info_t)&info, &info_count ))
+        {
+            if (info.pth_run_state == TH_STATE_RUNNING) ++*running;
+            slot = (unsigned int)(ident.thread_id * 0x9e3779b97f4a7c15ull >> 54) % SYSCALL_LOG_THREADS;
+            for (probe = 0; probe < SYSCALL_LOG_THREADS; probe++, slot = (slot + 1) % SYSCALL_LOG_THREADS)
+                if (!known[slot].id || known[slot].id == ident.thread_id) break;
+            user = info.pth_user_time;
+            system = info.pth_system_time;
+            if (probe < SYSCALL_LOG_THREADS)
+            {
+                UINT64 du = known[slot].id ? user - known[slot].user : 0;
+                UINT64 ds = known[slot].id ? system - known[slot].system : 0;
+                known[slot].id = ident.thread_id;
+                known[slot].user = user;
+                known[slot].system = system;
+                for (j = 0; j < found && busy[j].user + busy[j].system >= du + ds; j++);
+                if (j < count && du + ds)
+                {
+                    if (found < count) found++;
+                    for (k = found - 1; k > j; k--) busy[k] = busy[k - 1];
+                    busy[j].id = ident.thread_id;
+                    busy[j].user = du;
+                    busy[j].system = ds;
+                    snprintf( busy[j].name, sizeof(busy[j].name), "%s", info.pth_name[0] ? info.pth_name : "-" );
+                    for (k = 0; busy[j].name[k]; k++) if (busy[j].name[k] == ' ') busy[j].name[k] = '_';
+                }
+            }
+        }
+        mach_port_deallocate( mach_task_self(), list[i] );
+    }
+    vm_deallocate( mach_task_self(), (vm_address_t)list, n * sizeof(*list) );
+    return found;
+}
+#endif
+
+static void *syscall_log_thread( void *arg )
+{
+    static LONG64 last_count[SYSCALL_LOG_TABLES][4096], last_time[SYSCALL_LOG_TABLES][4096];
+    static LONG64 last_diag[DIAG_COUNTERS];
+    UINT64 last_bsd = 0, last_mach = 0, last_faults = 0, last_csw = 0, last_pageins = 0;
+    char name[32], line[4096];
+
+    for (;;)
+    {
+        struct syscall_log_entry by_count[6] = {{0}}, by_time[6] = {{0}}, rare[10] = {{0}};
+        LONG64 calls = 0, elapsed = 0, acquires;
+        UINT64 bsd = 0, mach = 0, faults = 0, csw = 0, pageins = 0, hold, wait, max_hold, max_wait;
+        const char *hold_func, *wait_func;
+        UINT idx, num;
+        struct timeval now;
+        size_t pos = 0;
+        int i, nrare = 0;
+#ifdef __APPLE__
+        struct syscall_log_busy busy[4];
+        int nbusy, running;
+        task_events_info_data_t events;
+        mach_msg_type_number_t size = TASK_EVENTS_INFO_COUNT;
+#endif
+
+        usleep( 100000 );
+        for (idx = 0; idx < SYSCALL_LOG_TABLES; idx++)
+            for (num = 0; num < 4096; num++)
+            {
+                LONG64 c = __atomic_load_n( &syscall_log_count[idx][num], __ATOMIC_RELAXED );
+                LONG64 t = __atomic_load_n( &syscall_log_time[idx][num], __ATOMIC_RELAXED );
+                LONG64 dc = c - last_count[idx][num], dt = t - last_time[idx][num];
+                last_count[idx][num] = c;
+                last_time[idx][num] = t;
+                if (!dc && !dt) continue;
+                calls += dc;
+                elapsed += dt;
+                syscall_log_top( by_count, 6, idx, num, dc );
+                syscall_log_top( by_time, 6, idx, num, dt );
+                /* rarely used calls, to catch one-off events (display changes, thread suspension...) */
+                if (dc && dc <= 3 && c <= 2000 && nrare < 10)
+                {
+                    rare[nrare].idx = idx; rare[nrare].num = num; rare[nrare].value = dc;
+                    nrare++;
+                }
+            }
+#ifdef __APPLE__
+        if (!task_info( mach_task_self(), TASK_EVENTS_INFO, (task_info_t)&events, &size ))
+        {
+            bsd = events.syscalls_unix - last_bsd;
+            mach = events.syscalls_mach - last_mach;
+            faults = events.faults - last_faults;
+            csw = events.csw - last_csw;
+            pageins = events.pageins - last_pageins;
+            last_bsd = events.syscalls_unix;
+            last_mach = events.syscalls_mach;
+            last_faults = events.faults;
+            last_csw = events.csw;
+            last_pageins = events.pageins;
+        }
+        nbusy = syscall_log_threads( busy, 4, &running );
+#endif
+        acquires = __atomic_exchange_n( &wine_diag_vm_lock.acquires, 0, __ATOMIC_RELAXED );
+        hold = syscall_log_exchange( &wine_diag_vm_lock.hold_ns );
+        wait = syscall_log_exchange( &wine_diag_vm_lock.wait_ns );
+        hold_func = wine_diag_vm_lock.max_hold_func;
+        wait_func = wine_diag_vm_lock.max_wait_func;
+        max_hold = syscall_log_exchange( &wine_diag_vm_lock.max_hold_ns );
+        max_wait = syscall_log_exchange( &wine_diag_vm_lock.max_wait_ns );
+        if (!calls && bsd < 1000) continue;
+
+        gettimeofday( &now, NULL );
+        syscall_log_append( line, sizeof(line), &pos, "%lld.%03d calls=%lld time_ms=%.1f bsd=%llu mach=%llu |",
+                            (long long)now.tv_sec, (int)(now.tv_usec / 1000), (long long)calls, elapsed / 1e6,
+                            (unsigned long long)bsd, (unsigned long long)mach );
+        for (i = 0; i < 6 && by_count[i].value; i++)
+            syscall_log_append( line, sizeof(line), &pos, " %s=%lld",
+                                syscall_log_name( by_count[i].idx, by_count[i].num, name, sizeof(name) ),
+                                (long long)by_count[i].value );
+        syscall_log_append( line, sizeof(line), &pos, " | ms:" );
+        for (i = 0; i < 6 && by_time[i].value; i++)
+            syscall_log_append( line, sizeof(line), &pos, " %s=%.1f",
+                                syscall_log_name( by_time[i].idx, by_time[i].num, name, sizeof(name) ),
+                                by_time[i].value / 1e6 );
+        syscall_log_append( line, sizeof(line), &pos, " | faults=%llu pageins=%llu csw=%llu",
+                            (unsigned long long)faults, (unsigned long long)pageins, (unsigned long long)csw );
+        for (i = 0; i < DIAG_COUNTERS; i++)
+        {
+            LONG64 value = __atomic_load_n( &wine_diag_counts[i], __ATOMIC_RELAXED );
+            if (value != last_diag[i])
+                syscall_log_append( line, sizeof(line), &pos, " %s=%lld", wine_diag_names[i], (long long)(value - last_diag[i]) );
+            last_diag[i] = value;
+        }
+        syscall_log_append( line, sizeof(line), &pos, " | vm: n=%lld hold=%.1f max=%.1f@%s wait=%.1f max=%.1f@%s",
+                            (long long)acquires, hold / 1e6, max_hold / 1e6, max_hold && hold_func ? hold_func : "-",
+                            wait / 1e6, max_wait / 1e6, max_wait && wait_func ? wait_func : "-" );
+#ifdef __APPLE__
+        syscall_log_append( line, sizeof(line), &pos, " | thr: run=%d", running );
+        for (i = 0; i < nbusy; i++)
+            syscall_log_append( line, sizeof(line), &pos, " %s#%04x=%.1f+%.1f", busy[i].name,
+                                (unsigned int)(busy[i].id & 0xffff), busy[i].user / 1e6, busy[i].system / 1e6 );
+#endif
+        if (nrare)
+        {
+            syscall_log_append( line, sizeof(line), &pos, " | rare:" );
+            for (i = 0; i < nrare; i++)
+                syscall_log_append( line, sizeof(line), &pos, " %s=%lld",
+                                    syscall_log_name( rare[i].idx, rare[i].num, name, sizeof(name) ),
+                                    (long long)rare[i].value );
+        }
+        syscall_log_append( line, sizeof(line), &pos, "\n" );
+        fputs( line, syscall_log_file );
+        fflush( syscall_log_file );
+    }
+    return NULL;
+}
+
+/* system calls that wait on purpose are expected to take long */
+static BOOL syscall_log_waits( const char *name )
+{
+    static const char * const waits[] = { "Wait", "Delay", "RemoveIoCompletion", "ReplyWaitReceive",
+                                          "NtUserGetMessage", "Yield" };
+    unsigned int i;
+
+    for (i = 0; i < ARRAY_SIZE(waits); i++) if (strstr( name, waits[i] )) return TRUE;
+    return FALSE;
+}
+
+static void syscall_log_long( UINT idx, UINT num, UINT64 elapsed, const ULONG_PTR *args, ULONG_PTR retval )
+{
+    char name_buffer[32], line[320];
+    const char *name = syscall_log_name( idx, num, name_buffer, sizeof(name_buffer) );
+    struct timeval now;
+
+    if (syscall_log_waits( name )) return;
+    gettimeofday( &now, NULL );
+    snprintf( line, sizeof(line), "%lld.%03d long %s ms=%.1f tid=%04x ret=%lx args=%lx,%lx,%lx,%lx,%lx,%lx\n",
+              (long long)now.tv_sec, (int)(now.tv_usec / 1000), name, elapsed / 1e6,
+              (unsigned int)HandleToULong( NtCurrentTeb()->ClientId.UniqueThread ), (unsigned long)retval,
+              (unsigned long)args[0], (unsigned long)args[1], (unsigned long)args[2],
+              (unsigned long)args[3], (unsigned long)args[4], (unsigned long)args[5] );
+    fputs( line, syscall_log_file );
+    fflush( syscall_log_file );
+}
+
+/* whether WINE_SYSCALL_LOG is set; starts the writer the first time */
+BOOL syscall_log_enabled(void)
+{
+    static int enabled = -1;
+    pthread_t thread;
+    char path[1024];
+    const char *value;
+
+    if (enabled != -1) return enabled;
+    enabled = 0;
+    if (!(value = getenv( "WINE_SYSCALL_LOG" )) || !*value) return FALSE;
+    /* one log per process */
+    snprintf( path, sizeof(path), "%s.%d", value, (int)getpid() );
+    if (!(syscall_log_file = fopen( path, "w" ))) return FALSE;
+    enabled = !pthread_create( &thread, NULL, syscall_log_thread, NULL );
+    wine_diag_enabled = enabled;
+    return enabled;
+}
