+// SHA-256 of a regular file of at most LIMIT bytes, read 1 MiB at a time so an
+// archive of any size costs no more memory than that. Its size goes to SIZE.
+static NSString *digestFile(NSString *path, uint64_t limit, uint64_t *size) {
+  int fd = open(path.fileSystemRepresentation, O_RDONLY | O_NOFOLLOW);
+  if (fd < 0) return nil;
+  struct stat st;
+  if (fstat(fd, &st) || !S_ISREG(st.st_mode) || st.st_size <= 0 || (uint64_t)st.st_size > limit) {
+    close(fd); return nil;
+  }
+  CC_SHA256_CTX context;
+  CC_SHA256_Init(&context);
+  unsigned char *buffer = malloc(1 << 20);
+  uint64_t total = 0;
+  BOOL failed = !buffer;
+  while (!failed && total < (uint64_t)st.st_size) {
+    ssize_t count = read(fd, buffer, 1 << 20);
+    if (count <= 0) { failed = YES; break; }
+    CC_SHA256_Update(&context, buffer, (CC_LONG)count);
+    total += count;
+  }
+  free(buffer); close(fd);
+  if (failed || total != (uint64_t)st.st_size) return nil;
+  unsigned char bytes[CC_SHA256_DIGEST_LENGTH];
+  CC_SHA256_Final(bytes, &context);
+  char result[65];
+  for (unsigned i = 0; i < sizeof(bytes); ++i) snprintf(result + i * 2, 3, "%02x", bytes[i]);
+  if (size) *size = total;
+  return [NSString stringWithUTF8String:result];
+}
