+// How much of the pack a game loads, from Recall's Shader memory setting: load.json
+// beside the pack ({"limit": "first"} or a number of MiB). Without it, all of it. A
+// game holds what it loads in memory (about the archives' size); archives are listed
+// slowest pipelines first, and "first" keeps only the first, as earlier versions loaded.
+static uint64_t packLoadBudget(BOOL *firstOnly) {
+  *firstOnly = NO;
+  const char *base = getenv("DXMT_PIPELINE_CACHE_PATH");
+  if (!base || base[0] != '/') return UINT64_MAX;
+  NSData *data = readBounded([[NSString stringWithUTF8String:base] stringByAppendingPathComponent:@"load.json"], 4096);
+  NSDictionary *setting = data ? [NSJSONSerialization JSONObjectWithData:data options:0 error:nil] : nil;
+  if (![setting isKindOfClass:NSDictionary.class]) return UINT64_MAX;
+  id limit = setting[@"limit"];
+  if ([limit isEqual:@"first"]) { *firstOnly = YES; return UINT64_MAX; }
+  if ([limit isKindOfClass:NSNumber.class] && [limit unsignedLongLongValue] > 0)
+    return MIN([limit unsignedLongLongValue], 1ull << 24) << 20;
+  return UINT64_MAX;
+}
