+  uint64_t blob_bytes_written_ = 0, blob_bytes_deduplicated_ = 0;
+
+  // Always tracked (objects without a GetDesc for their creation data).
+  std::unordered_map<const void *, ShaderInfo> shaders_;
+  std::unordered_map<const void *, LayoutInfo> layouts_;
+  std::unordered_map<RecordingContext *, uint32_t> deferred_contexts_; // -> creation flags
+
+  // Per recording.
+  uint32_t next_id_ = 1;
+  std::unordered_map<const void *, uint32_t> ids_;
+  std::unordered_map<uint32_t, ResourceInfo> resources_;
+  std::unordered_map<uint64_t, PendingMap> pending_maps_; // (resource ptr, sub)
+  std::unordered_map<uint32_t, std::vector<uint8_t>> shadows_;
+  std::vector<Readback> readback_queue_, readback_inflight_;
+  uint64_t readback_inflight_bytes_ = 0;
+  uint32_t backbuffer_id_ = 0;
+  ID3D11Texture2D *checkpoint_staging_ = nullptr;
+  std::unordered_map<std::string, uint64_t> warnings_;
+  uint64_t stream_records_ = 0, prologue_records_ = 0, readback_failures_ = 0, undefined_contents_ = 0;
+  uint64_t recording_started_ms_ = 0;
+
+  // Census (whole session).
+  std::array<std::atomic<uint64_t>, 256> census_ops_{};
+  std::array<std::atomic<uint64_t>, 6> census_map_bytes_{};
+  std::array<std::atomic<uint64_t>, 6> census_maps_{};
+  std::atomic<uint64_t> census_update_bytes_{0}, census_creates_{0}, census_deferred_calls_{0};
+  uint64_t census_last_ms_ = 0, census_last_present_ = 0;
+  void *census_file_ = nullptr;
+};
+
+class RecordingContext final : public ID3D11DeviceContext4 {
+public:
