+
+NVAPI_INTERFACE
+NvAPI_GPU_GetGPUType(NvPhysicalGpuHandle hPhysicalGpu, NV_GPU_TYPE *pGpuType) {
+  if (!hPhysicalGpu || !pGpuType)
+    return NVAPI_INVALID_ARGUMENT;
+  *pGpuType = NV_SYSTEM_TYPE_DGPU;
+  return NVAPI_OK;
+}
+
+NVAPI_INTERFACE
+NvAPI_GPU_GetGPUInfo(NvPhysicalGpuHandle hPhysicalGpu, NV_GPU_INFO *pGpuInfo) {
+  if (!hPhysicalGpu || !pGpuInfo)
+    return NVAPI_INVALID_ARGUMENT;
+  // NVIDIA GeForce RTX 4090, matching NvAPI_GPU_GetArchInfo
+  switch (pGpuInfo->version) {
+  case NV_GPU_INFO_VER1: {
+    auto info = (NV_GPU_INFO_V1 *)pGpuInfo;
+    info->bIsExternalGpu = 0;
+    info->reserved = 0;
+    break;
+  }
+  case NV_GPU_INFO_VER2: {
+    auto version = pGpuInfo->version;
+    memset(pGpuInfo, 0, sizeof(NV_GPU_INFO_V2));
+    pGpuInfo->version = version;
+    pGpuInfo->rayTracingCores = 128;
+    pGpuInfo->tensorCores = 512;
+    break;
+  }
+  default:
+    return NVAPI_INCOMPATIBLE_STRUCT_VERSION;
+  }
+  return NVAPI_OK;
+}
+
+NVAPI_INTERFACE
+NvAPI_GPU_GetVirtualizationInfo(NvPhysicalGpuHandle hPhysicalGpu, NV_GPU_VIRTUALIZATION_INFO *pVirtualizationInfo) {
+  if (!hPhysicalGpu || !pVirtualizationInfo)
+    return NVAPI_INVALID_ARGUMENT;
+  if (pVirtualizationInfo->version != NV_GPU_VIRTUALIZATION_INFO_VER1)
+    return NVAPI_INCOMPATIBLE_STRUCT_VERSION;
+  pVirtualizationInfo->virtualizationMode = NV_VIRTUALIZATION_MODE_NONE;
+  pVirtualizationInfo->reserved = 0;
+  return NVAPI_OK;
