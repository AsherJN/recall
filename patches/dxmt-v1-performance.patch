+  p.put(uav_start).put(nuav);
+  if (nuav != D3D11_KEEP_UNORDERED_ACCESS_VIEWS) {
+    for (UINT i = 0; i < nuav; i++)
+      p.put(ref_view(uav ? uav[i] : nullptr, Op::CreateUAV));
+    p.put(uint32_t(counts ? 1 : 0));
