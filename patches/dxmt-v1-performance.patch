diff --git a/src/d3d11/d3d11_recorder_format.hpp b/src/d3d11/d3d11_recorder_format.hpp
new file mode 100644
index 0000000..6f09f79
--- /dev/null
+++ b/src/d3d11/d3d11_recorder_format.hpp
@@ -0,0 +1,273 @@
+#pragma once
+
+// Recording format shared by the recorder (d3d11.dll) and the replayer
+// (dxmt-replay.exe). A recording is a directory:
+//   prologue.owr  objects that existed before recording started, in dependency
+//                 order, plus their contents at that moment (ResourceContent)
+//   stream.owr    every recorded call in order, including objects created
+//                 during the recording
+//   blobs.owb     deduplicated data referenced by BlobRef
+//   meta.json     summary written when the recording finishes
+// Both .owr files start with FileHeader, then records: RecordHeader + payload.
+// Payloads are the packed structs below followed by variable-length arrays.
+
+#include <cstdint>
+#include <cstring>
+
+namespace dxmt::owr {
+
+constexpr uint32_t kMagic = 0x3152574f; // "OWR1"
+constexpr uint32_t kVersion = 1;
+
+struct FileHeader {
+  uint32_t magic = kMagic;
+  uint32_t version = kVersion;
+  uint32_t feature_level = 0;
+  uint32_t device_flags = 0;
+  uint64_t reserved[6] = {};
+};
+
+enum class Op : uint16_t {
+  // creation (prologue or stream)
+  CreateBuffer = 1,
+  CreateTexture1D,
+  CreateTexture2D,
+  CreateTexture3D,
+  CreateSRV,
+  CreateUAV,
+  CreateRTV,
+  CreateDSV,
+  CreateShader,
+  CreateInputLayout,
+  CreateBlendState,
+  CreateDepthStencilState,
+  CreateRasterizerState,
+  CreateSamplerState,
+  CreateQuery,
+  CreateDeferredContext,
+  ResourceContent,
+  Backbuffer,
+
+  // context calls; RecordHeader::ctx names the context (0 = immediate)
+  SetShader = 64,
+  SetShaderResources,
+  SetSamplers,
+  SetConstantBuffers,
+  IASetInputLayout,
+  IASetVertexBuffers,
+  IASetIndexBuffer,
+  IASetPrimitiveTopology,
+  RSSetState,
+  RSSetViewports,
+  RSSetScissorRects,
+  OMSetRenderTargets,
+  OMSetRenderTargetsAndUAVs,
+  OMSetBlendState,
+  OMSetDepthStencilState,
+  SOSetTargets,
+  CSSetUnorderedAccessViews,
+  Draw,
+  DrawIndexed,
+  DrawInstanced,
+  DrawIndexedInstanced,
+  DrawAuto,
+  DrawInstancedIndirect,
+  DrawIndexedInstancedIndirect,
+  Dispatch,
+  DispatchIndirect,
+  Begin,
+  End,
+  SetPredication,
+  MapWrite,
+  MapRead,
+  UpdateSubresource,
+  CopyResource,
+  CopySubresourceRegion,
+  CopyStructureCount,
+  ClearRenderTargetView,
+  ClearUAVUint,
+  ClearUAVFloat,
+  ClearDepthStencilView,
+  ClearView,
+  GenerateMips,
+  SetResourceMinLOD,
+  ResolveSubresource,
+  DiscardResource,
+  DiscardView,
+  ClearState,
+  Flush,
+  ExecuteCommandList,
+  FinishCommandList,
+
+  // frame structure
+  Present = 200,
+  FrameCheckpoint,
+  Unsupported = 250,
+};
+
+struct RecordHeader {
+  uint16_t op;
+  uint16_t ctx;
+  uint32_t size; // payload bytes after this header
+};
+
+struct BlobRef {
+  uint64_t offset = 0;
+  uint32_t size = 0;
+  uint32_t reserved = 0;
+};
+
+// One subresource of initial data or content.
+struct SubData {
+  BlobRef blob;
+  uint32_t row_pitch = 0;
+  uint32_t depth_pitch = 0;
+};
+
+enum Stage : uint32_t { VS = 0, HS, DS, GS, PS, CS, StageCount };
+
+enum class MapKind : uint32_t {
+  Whole = 0,  // blob covers [0, blob.size); bytes [blob.size, full_size) are zero
+  Ranges = 1, // Range[count] follows; everything else unchanged
+  Rows = 2,   // texture rows: TextureRows follows
+};
+
+struct MapWritePayload {
+  uint32_t resource;
+  uint32_t subresource;
+  uint32_t map_type;
+  uint32_t map_flags;
+  uint32_t kind;
+  uint32_t full_size;
+  uint32_t count; // Ranges: number of Range entries
+  uint32_t reserved;
+};
+
+struct Range {
+  uint32_t offset;
+  uint32_t reserved;
+  BlobRef blob;
+};
+
+struct TextureRows {
+  uint32_t row_bytes;
+  uint32_t rows;   // rows per depth slice (block rows for compressed formats)
+  uint32_t depth;
+  uint32_t reserved;
+  BlobRef blob;    // packed: row_bytes * rows * depth
+};
+
+struct InputElement {
+  char semantic[64];
+  uint32_t semantic_index;
+  uint32_t format;
+  uint32_t input_slot;
+  uint32_t aligned_byte_offset;
+  uint32_t input_slot_class;
+  uint32_t instance_data_step_rate;
+};
+
+struct StreamOutElement {
+  char semantic[64];
+  uint32_t stream;
+  uint32_t semantic_index;
+  uint8_t start_component;
+  uint8_t component_count;
+  uint8_t output_slot;
+  uint8_t reserved;
+};
+
+struct CheckpointPayload {
+  uint64_t frame;
+  uint32_t width;
+  uint32_t height;
+  uint32_t format;
+  uint32_t row_bytes;
+  BlobRef pixels; // packed rows of row_bytes
+};
+
+inline const char *
+op_name(Op op) {
+  switch (op) {
+#define N(x) case Op::x: return #x;
+  N(CreateBuffer) N(CreateTexture1D) N(CreateTexture2D) N(CreateTexture3D) N(CreateSRV) N(CreateUAV)
+  N(CreateRTV) N(CreateDSV) N(CreateShader) N(CreateInputLayout) N(CreateBlendState)
+  N(CreateDepthStencilState) N(CreateRasterizerState) N(CreateSamplerState) N(CreateQuery)
+  N(CreateDeferredContext) N(ResourceContent) N(Backbuffer) N(SetShader) N(SetShaderResources)
+  N(SetSamplers) N(SetConstantBuffers) N(IASetInputLayout) N(IASetVertexBuffers) N(IASetIndexBuffer)
+  N(IASetPrimitiveTopology) N(RSSetState) N(RSSetViewports) N(RSSetScissorRects) N(OMSetRenderTargets)
+  N(OMSetRenderTargetsAndUAVs) N(OMSetBlendState) N(OMSetDepthStencilState) N(SOSetTargets)
+  N(CSSetUnorderedAccessViews) N(Draw) N(DrawIndexed) N(DrawInstanced) N(DrawIndexedInstanced)
+  N(DrawAuto) N(DrawInstancedIndirect) N(DrawIndexedInstancedIndirect) N(Dispatch) N(DispatchIndirect)
+  N(Begin) N(End) N(SetPredication) N(MapWrite) N(MapRead) N(UpdateSubresource) N(CopyResource)
+  N(CopySubresourceRegion) N(CopyStructureCount) N(ClearRenderTargetView) N(ClearUAVUint)
+  N(ClearUAVFloat) N(ClearDepthStencilView) N(ClearView) N(GenerateMips) N(SetResourceMinLOD)
+  N(ResolveSubresource) N(DiscardResource) N(DiscardView) N(ClearState) N(Flush)
+  N(ExecuteCommandList) N(FinishCommandList) N(Present) N(FrameCheckpoint) N(Unsupported)
+#undef N
+  }
+  return "?";
+}
+
+// Block geometry of a DXGI format: bytes per block and block width/height.
+// Returns false for formats the recorder cannot size (planar video formats).
+inline bool
+format_block(uint32_t format, uint32_t &bytes, uint32_t &bw, uint32_t &bh) {
+  bw = bh = 1;
+  switch (format) {
+  case 1: case 2: case 3: case 4: bytes = 16; return true;                          // R32G32B32A32
+  case 5: case 6: case 7: case 8: bytes = 12; return true;                          // R32G32B32
+  case 9: case 10: case 11: case 12: case 13: case 14: case 15: case 16: case 17: case 18:
+  case 19: case 20: case 21: case 22: bytes = 8; return true;                       // 64-bit
+  case 23: case 24: case 25: case 26: case 27: case 28: case 29: case 30: case 31: case 32:
+  case 33: case 34: case 35: case 36: case 37: case 38: case 39: case 40: case 41: case 42:
+  case 43: case 44: case 45: case 46: case 47: bytes = 4; return true;              // 32-bit
+  case 48: case 49: case 50: case 51: case 52: case 53: case 54: case 55: case 56: case 57:
+  case 58: case 59: bytes = 2; return true;                                          // 16-bit
+  case 60: case 61: case 62: case 63: case 64: case 65: bytes = 1; return true;     // 8-bit, A8
+  case 66: bytes = 1; bw = 8; return true;                                           // R1_UNORM
+  case 67: case 87: case 88: case 89: case 90: case 91: case 92: case 93:
+    bytes = 4; return true;                                                          // shared-exp, BGRA
+  case 68: case 69: bytes = 4; bw = 2; return true;                                  // R8G8_B8G8, G8R8_G8B8
+  case 70: case 71: case 72: case 79: case 80: case 81: bytes = 8; bw = bh = 4; return true;  // BC1, BC4
+  case 73: case 74: case 75: case 76: case 77: case 78: case 82: case 83: case 84:
+  case 94: case 95: case 96: case 97: case 98: case 99: bytes = 16; bw = bh = 4; return true; // BC2/3/5/6/7
+  case 85: case 86: case 115: bytes = 2; return true;                                // B5G6R5, B5G5R5A1, B4G4R4A4
+  default: return false;
+  }
+}
+
+// XXH64 (Yann Collet, BSD-2). Content hash for blob deduplication.
+inline uint64_t
+xxh64(const void *input, size_t len, uint64_t seed = 0) {
+  constexpr uint64_t P1 = 11400714785074694791ull, P2 = 14029467366897019727ull, P3 = 1609587929392839161ull,
+                     P4 = 9650029242287828579ull, P5 = 2870177450012600261ull;
+  auto rotl = [](uint64_t x, int r) { return (x << r) | (x >> (64 - r)); };
+  auto read64 = [](const uint8_t *p) { uint64_t v; std::memcpy(&v, p, 8); return v; };
+  auto read32 = [](const uint8_t *p) { uint32_t v; std::memcpy(&v, p, 4); return (uint64_t)v; };
+  auto round = [&](uint64_t acc, uint64_t lane) { acc += lane * P2; acc = rotl(acc, 31); return acc * P1; };
+  auto merge = [&](uint64_t acc, uint64_t val) { acc ^= round(0, val); return acc * P1 + P4; };
+  const uint8_t *p = (const uint8_t *)input, *end = p + len;
+  uint64_t h;
+  if (len >= 32) {
+    uint64_t v1 = seed + P1 + P2, v2 = seed + P2, v3 = seed, v4 = seed - P1;
+    const uint8_t *limit = end - 32;
+    do {
+      v1 = round(v1, read64(p)); v2 = round(v2, read64(p + 8));
+      v3 = round(v3, read64(p + 16)); v4 = round(v4, read64(p + 24));
+      p += 32;
+    } while (p <= limit);
+    h = rotl(v1, 1) + rotl(v2, 7) + rotl(v3, 12) + rotl(v4, 18);
+    h = merge(h, v1); h = merge(h, v2); h = merge(h, v3); h = merge(h, v4);
+  } else {
+    h = seed + P5;
+  }
+  h += (uint64_t)len;
+  while (p + 8 <= end) { h ^= round(0, read64(p)); h = rotl(h, 27) * P1 + P4; p += 8; }
+  if (p + 4 <= end) { h ^= read32(p) * P1; h = rotl(h, 23) * P2 + P3; p += 4; }
+  while (p < end) { h ^= (*p) * P5; h = rotl(h, 11) * P1; p++; }
+  h ^= h >> 33; h *= P2; h ^= h >> 29; h *= P3; h ^= h >> 32;
+  return h;
+}
+
+} // namespace dxmt::owr
