+template <typename Predicate>
+unsigned
+bench_count(const void *head, Predicate predicate) {
+  unsigned n = 0;
+  for (auto cmd = (const wmtcmd_base *)((const wmtcmd_base *)head)->next.ptr; cmd;
+       cmd = (const wmtcmd_base *)cmd->next.ptr)
+    n += predicate(cmd->type) ? 1 : 0;
