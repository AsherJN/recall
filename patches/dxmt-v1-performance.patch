+std::string
+bench_render_label(uint64_t frame, unsigned index, RenderEncoderData *data) {
+  char buf[96];
+  std::snprintf(buf, sizeof buf, "F%llu#%u R %ux%u", (unsigned long long)frame, index, data->render_target_width,
+                data->render_target_height);
+  std::string label = buf;
+  auto attachment = [&](const char *name, TextureViewRef &view, WMTLoadAction load, WMTStoreAction store) {
+    if (!view)
