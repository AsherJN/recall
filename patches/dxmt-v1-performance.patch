diff --git a/src/replay/nvngx_probe.cpp b/src/replay/nvngx_probe.cpp
new file mode 100644
index 0000000..ebbb4c0
--- /dev/null
+++ b/src/replay/nvngx_probe.cpp
@@ -0,0 +1,283 @@
+// Off-screen check of DXMT's DLSS-to-MetalFX path and of the upscaler's GPU cost.
+//
+// Loads nvngx.dll the way Overwatch's NGX SDK does (C:\windows\system32\_nvngx.dll,
+// then nvngx.dll), asks for DLSS's capability and optimal render sizes, creates the
+// feature for 1920x1200 output, and upscales synthetic frames for each quality mode.
+// Needs DXMT_ENABLE_NVEXT=1 (else nvngx.dll refuses to load) and DXMT_BENCH=1 (GPU
+// timing). Prints one line of JSON: "@@NVNGX {...}".
+
+#include <windows.h>
+#include <d3d11_1.h>
+#include <dxgi1_2.h>
+
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <string>
+#include <vector>
+
+#include "d3d11_interfaces.hpp"
+#include "nvngx.hpp"
+
+namespace {
+
+typedef NVNGX_RESULT (*PFN_Init)(unsigned long long, const wchar_t *, ID3D11Device *, const void *, unsigned int);
+typedef NVNGX_RESULT (*PFN_GetCapabilityParameters)(NVNGXParameter **);
+typedef NVNGX_RESULT (*PFN_AllocateParameters)(NVNGXParameter **);
+typedef NVNGX_RESULT (*PFN_DestroyParameters)(NVNGXParameter *);
+typedef NVNGX_RESULT (*PFN_CreateFeature)(ID3D11DeviceContext *, unsigned int, NVNGXParameter *, unsigned int **);
+typedef NVNGX_RESULT (*PFN_EvaluateFeature)(ID3D11DeviceContext *, const unsigned int *, NVNGXParameter *, void *);
+typedef NVNGX_RESULT (*PFN_ReleaseFeature)(unsigned int *);
+typedef NVNGX_RESULT (*PFN_OptimalSettings)(NVNGXParameter *);
+
+constexpr UINT kOutWidth = 1920, kOutHeight = 1200, kFrames = 240;
+std::string json;
+
+void
+fail(const char *what) {
+  std::printf("@@NVNGX {%s\"error\": \"%s\"}\n", json.c_str(), what);
+  std::fflush(stdout);
+  TerminateProcess(GetCurrentProcess(), 1);
+}
+
+float
+half_to_float(uint16_t h) {
+  uint32_t sign = (h >> 15) & 1, exponent = (h >> 10) & 31, mantissa = h & 1023;
+  float value = exponent == 0 ? std::ldexp(float(mantissa), -24)
+              : exponent == 31 ? INFINITY
+                               : std::ldexp(float(mantissa | 1024), int(exponent) - 25);
+  return sign ? -value : value;
+}
+
+ID3D11Texture2D *
+texture(ID3D11Device *device, UINT w, UINT h, DXGI_FORMAT format, UINT bind) {
+  D3D11_TEXTURE2D_DESC d = {};
+  d.Width = w;
+  d.Height = h;
+  d.MipLevels = 1;
+  d.ArraySize = 1;
+  d.Format = format;
+  d.SampleDesc.Count = 1;
+  d.Usage = D3D11_USAGE_DEFAULT;
+  d.BindFlags = bind;
+  ID3D11Texture2D *t = nullptr;
+  if (FAILED(device->CreateTexture2D(&d, nullptr, &t)))
+    fail("texture creation failed");
+  return t;
+}
+
+// Halton(2,3) jitter in pixels, centered.
+float
+halton(unsigned index, unsigned base) {
+  float f = 1, r = 0;
+  for (unsigned i = index + 1; i; i /= base) {
+    f /= base;
+    r += f * (i % base);
+  }
+  return r - 0.5f;
+}
+
+} // namespace
+
+int
+main() {
+  ID3D11Device *device = nullptr;
+  ID3D11DeviceContext *ctx = nullptr;
+  D3D_FEATURE_LEVEL level = D3D_FEATURE_LEVEL_11_1;
+  auto d3d11 = LoadLibraryA("d3d11.dll");
+  auto create_device = d3d11 ? (PFN_D3D11_CREATE_DEVICE)GetProcAddress(d3d11, "D3D11CreateDevice") : nullptr;
+  if (!create_device || FAILED(create_device(nullptr, D3D_DRIVER_TYPE_HARDWARE, nullptr, 0, &level, 1,
+                                             D3D11_SDK_VERSION, &device, nullptr, &ctx)))
+    fail("D3D11CreateDevice failed");
+
+  IDXGIDevice *dxgi = nullptr;
+  IDXGIAdapter *adapter = nullptr;
+  DXGI_ADAPTER_DESC adapter_desc = {};
+  if (SUCCEEDED(device->QueryInterface(__uuidof(IDXGIDevice), (void **)&dxgi)) &&
+      SUCCEEDED(dxgi->GetAdapter(&adapter)))
+    adapter->GetDesc(&adapter_desc);
+  char buf[256];
+  std::snprintf(buf, sizeof buf, "\"vendor_id\": \"0x%04x\", ", adapter_desc.VendorId);
+  json += buf;
+
+  IMTLD3D11Bench *bench = nullptr;
+  if (FAILED(device->QueryInterface(__uuidof(IMTLD3D11Bench), (void **)&bench)))
+    fail("no bench interface (DXMT build without the replay changes)");
+
+  // The game's SDK tries these two full paths; the bare name covers a prefix without placeholders.
+  const wchar_t *paths[] = {L"C:\\windows\\system32\\_nvngx.dll", L"C:\\windows\\system32\\nvngx.dll",
+                            L"nvngx.dll"};
+  const char *names[] = {"system32/_nvngx.dll", "system32/nvngx.dll", "nvngx.dll by name"};
+  HMODULE ngx = nullptr;
+  const char *loaded = "none";
+  for (int i = 0; i < 3 && !ngx; i++) {
+    ngx = LoadLibraryW(paths[i]);
+    if (ngx)
+      loaded = names[i];
+  }
+  std::snprintf(buf, sizeof buf, "\"loaded\": \"%s\", ", loaded);
+  json += buf;
+  if (!ngx)
+    fail("nvngx.dll did not load (is DXMT_ENABLE_NVEXT=1 set and nvngx.dll in the engine?)");
+
+  auto init = (PFN_Init)GetProcAddress(ngx, "NVSDK_NGX_D3D11_Init");
+  auto caps = (PFN_GetCapabilityParameters)GetProcAddress(ngx, "NVSDK_NGX_D3D11_GetCapabilityParameters");
+  auto allocate = (PFN_AllocateParameters)GetProcAddress(ngx, "NVSDK_NGX_D3D11_AllocateParameters");
+  auto destroy = (PFN_DestroyParameters)GetProcAddress(ngx, "NVSDK_NGX_D3D11_DestroyParameters");
+  auto create = (PFN_CreateFeature)GetProcAddress(ngx, "NVSDK_NGX_D3D11_CreateFeature");
+  auto evaluate = (PFN_EvaluateFeature)GetProcAddress(ngx, "NVSDK_NGX_D3D11_EvaluateFeature");
+  auto release = (PFN_ReleaseFeature)GetProcAddress(ngx, "NVSDK_NGX_D3D11_ReleaseFeature");
+  if (!init || !caps || !allocate || !destroy || !create || !evaluate || !release)
+    fail("nvngx.dll lacks an NGX entry point");
+  if (init(0x4f57, L"C:\\users\\Public", device, nullptr, 0x15) != NVNGX_RESULT_OK)
+    fail("NVSDK_NGX_D3D11_Init failed");
+
+  NVNGXParameter *capabilities = nullptr;
+  unsigned available = 0;
+  void *callback = nullptr;
+  if (caps(&capabilities) != NVNGX_RESULT_OK)
+    fail("GetCapabilityParameters failed");
+  capabilities->Get("SuperSampling.Available", &available);
+  capabilities->Get(NVNGX_Parameter_DLSSOptimalSettingsCallback, &callback);
+  std::snprintf(buf, sizeof buf, "\"dlss_available\": %u, \"modes\": [", available);
+  json += buf;
+  if (!available || !callback)
+    fail("DLSS not reported available");
+  auto optimal = (PFN_OptimalSettings)callback;
+
+  struct Mode {
+    const char *name;
+    NVNGX_PERFQUALITY value;
+  } modes[] = {{"quality", NVNGX_PERFQUALITY_MAXQUALITY},
+               {"balanced", NVNGX_PERFQUALITY_BALANCED},
+               {"performance", NVNGX_PERFQUALITY_MAXPERF}};
+
+  auto output = texture(device, kOutWidth, kOutHeight, DXGI_FORMAT_R16G16B16A16_FLOAT,
+                        D3D11_BIND_SHADER_RESOURCE | D3D11_BIND_RENDER_TARGET | D3D11_BIND_UNORDERED_ACCESS);
+  D3D11_TEXTURE2D_DESC staging_desc = {};
+  output->GetDesc(&staging_desc);
+  staging_desc.Usage = D3D11_USAGE_STAGING;
+  staging_desc.BindFlags = 0;
+  staging_desc.CPUAccessFlags = D3D11_CPU_ACCESS_READ;
+  ID3D11Texture2D *staging = nullptr;
+  if (FAILED(device->CreateTexture2D(&staging_desc, nullptr, &staging)))
+    fail("staging texture creation failed");
+
+  bool first_mode = true;
+  for (auto &mode : modes) {
+    NVNGXParameter *params = nullptr;
+    allocate(&params);
+    params->Set(NVNGX_Parameter_Width, kOutWidth);
+    params->Set(NVNGX_Parameter_Height, kOutHeight);
+    params->Set(NVNGX_Parameter_PerfQualityValue, (int)mode.value);
+    if (optimal(params) != NVNGX_RESULT_OK)
+      fail("optimal settings callback failed");
+    unsigned rw = 0, rh = 0;
+    params->Get(NVNGX_Parameter_OutWidth, &rw);
+    params->Get(NVNGX_Parameter_OutHeight, &rh);
+    destroy(params);
+
+    allocate(&params);
+    params->Set(NVNGX_Parameter_Width, rw);
+    params->Set(NVNGX_Parameter_Height, rh);
+    params->Set(NVNGX_Parameter_OutWidth, kOutWidth);
+    params->Set(NVNGX_Parameter_OutHeight, kOutHeight);
+    params->Set(NVNGX_Parameter_PerfQualityValue, (int)mode.value);
+    params->Set(NVNGX_Parameter_DLSS_Feature_Create_Flags, (int)(NVNGX_DLSS_FLAG_MV_LOWRES | NVNGX_DLSS_FLAG_DEPTH_INVERTED));
+    unsigned int *handle = nullptr;
+    NVNGX_RESULT created = create(ctx, NVNGX_FEATURE_SUPERSAMPLING, params, &handle);
+    destroy(params);
+    if (created != NVNGX_RESULT_OK)
+      fail("CreateFeature(DLSS) failed");
+
+    auto color = texture(device, rw, rh, DXGI_FORMAT_R16G16B16A16_FLOAT,
+                         D3D11_BIND_SHADER_RESOURCE | D3D11_BIND_RENDER_TARGET);
+    auto motion = texture(device, rw, rh, DXGI_FORMAT_R16G16_FLOAT, D3D11_BIND_SHADER_RESOURCE | D3D11_BIND_RENDER_TARGET);
+    auto depth = texture(device, rw, rh, DXGI_FORMAT_R32_TYPELESS, D3D11_BIND_SHADER_RESOURCE | D3D11_BIND_DEPTH_STENCIL);
+    ID3D11RenderTargetView *color_rtv = nullptr, *motion_rtv = nullptr;
+    ID3D11DepthStencilView *dsv = nullptr;
+    D3D11_DEPTH_STENCIL_VIEW_DESC dsv_desc = {};
+    dsv_desc.Format = DXGI_FORMAT_D32_FLOAT;
+    dsv_desc.ViewDimension = D3D11_DSV_DIMENSION_TEXTURE2D;
+    if (FAILED(device->CreateRenderTargetView(color, nullptr, &color_rtv)) ||
+        FAILED(device->CreateRenderTargetView(motion, nullptr, &motion_rtv)) ||
+        FAILED(device->CreateDepthStencilView(depth, &dsv_desc, &dsv)))
+      fail("view creation failed");
+
+    // Two passes over the same frames: clears alone, then clears plus the upscale.
+    double pass_ms[2] = {};
+    for (int pass = 0; pass < 2; pass++) {
+      std::vector<uint64_t> frames;
+      for (unsigned f = 0; f < kFrames; f++) {
+        float shade = 0.25f + 0.5f * (f % 8) / 8.0f;
+        const float c[4] = {shade, 0.5f, 1.0f - shade, 1.0f}, zero[4] = {};
+        ctx->ClearRenderTargetView(color_rtv, c);
+        ctx->ClearRenderTargetView(motion_rtv, zero);
+        ctx->ClearDepthStencilView(dsv, D3D11_CLEAR_DEPTH, 0.0f, 0);
+        if (pass == 1) {
+          allocate(&params);
+          params->Set(NVNGX_Parameter_Color, (ID3D11Resource *)color);
+          params->Set(NVNGX_Parameter_Output, (ID3D11Resource *)output);
+          params->Set(NVNGX_Parameter_Depth, (ID3D11Resource *)depth);
+          params->Set(NVNGX_Parameter_MotionVectors, (ID3D11Resource *)motion);
+          params->Set(NVNGX_Parameter_DLSS_Render_Subrect_Dimensions_Width, rw);
+          params->Set(NVNGX_Parameter_DLSS_Render_Subrect_Dimensions_Height, rh);
+          params->Set(NVNGX_Parameter_Jitter_Offset_X, halton(f % 16, 2));
+          params->Set(NVNGX_Parameter_Jitter_Offset_Y, halton(f % 16, 3));
+          params->Set(NVNGX_Parameter_Reset, f == 0 ? 1 : 0);
+          params->Set(NVNGX_Parameter_MV_Scale_X, 1.0f);
+          params->Set(NVNGX_Parameter_MV_Scale_Y, 1.0f);
+          if (std::getenv("PROBE_PRE_EXPOSURE"))
+            params->Set(NVNGX_Parameter_DLSS_Pre_Exposure, (float)std::atof(std::getenv("PROBE_PRE_EXPOSURE")));
+          if (evaluate(ctx, handle, params, nullptr) != NVNGX_RESULT_OK)
+            fail("EvaluateFeature failed");
+          destroy(params);
+        }
+        frames.push_back(bench->CurrentFrame());
+        bench->FrameBoundary();
+      }
+      bench->WaitIdle();
+      std::vector<double> active;
+      for (size_t i = 8; i < frames.size(); i++) { // skip scaler setup
+        MTL_BENCH_FRAME_TIMING t = {};
+        if (bench->QueryFrameTiming(frames[i], &t))
+          active.push_back(t.GpuActiveNs / 1e6);
+      }
+      if (active.empty())
+        fail("no GPU timing (is DXMT_BENCH=1 set?)");
+      std::sort(active.begin(), active.end());
+      pass_ms[pass] = active[active.size() / 2];
+    }
+
+    ctx->CopyResource(staging, output);
+    D3D11_MAPPED_SUBRESOURCE mapped = {};
+    float pixel[4] = {};
+    if (SUCCEEDED(ctx->Map(staging, 0, D3D11_MAP_READ, 0, &mapped))) {
+      auto row = (const uint16_t *)((const uint8_t *)mapped.pData + mapped.RowPitch * (kOutHeight / 2));
+      for (int k = 0; k < 4; k++)
+        pixel[k] = half_to_float(row[(kOutWidth / 2) * 4 + k]);
+      ctx->Unmap(staging, 0);
+    }
+    std::snprintf(buf, sizeof buf,
+                  "%s{\"mode\": \"%s\", \"render\": [%u, %u], \"clears_ms\": %.4f, \"clears_and_upscale_ms\": %.4f, "
+                  "\"upscale_ms\": %.4f, \"output_center\": [%.3f, %.3f, %.3f, %.3f]}",
+                  first_mode ? "" : ", ", mode.name, rw, rh, pass_ms[0], pass_ms[1], pass_ms[1] - pass_ms[0],
+                  pixel[0], pixel[1], pixel[2], pixel[3]);
+    json += buf;
+    first_mode = false;
+    release(handle);
+    color_rtv->Release();
+    motion_rtv->Release();
+    dsv->Release();
+    color->Release();
+    motion->Release();
+    depth->Release();
+  }
+  std::printf("@@NVNGX {%s]}\n", json.c_str());
+  std::fflush(stdout);
+  // DXMT's teardown can hang at exit (see the self-test); the result is already out.
+  TerminateProcess(GetCurrentProcess(), 0);
+  return 0;
+}
diff --git a/src/replay/replay.cpp b/src/replay/replay.cpp
new file mode 100644
index 0000000..9d63eda
--- /dev/null
+++ b/src/replay/replay.cpp
@@ -0,0 +1,1697 @@
+// dxmt-replay: plays a recording (d3d11_recorder_format.hpp) through the
+// system d3d11.dll off-screen and reports per-frame CPU and GPU time.
+//
+//   dxmt-replay <recording dir> [--loops N] [--warmup N] [--verify] [--dump DIR]
+//               [--json FILE] [--frames N] [--no-bench] [--serve]
+//               [--ballast-gpu GROUPS] [--ballast-cpu-us US]
+//
+// --serve runs the warmup loops, prints "@@READY {...}" on stdout, then runs one
+// timed loop per "loop" line read from stdin and answers each with
+// "@@LOOP {...}" (one JSON line); "warm N" replays the first N frames untimed
+// and answers "@@WARM {}"; "quit" or end of input stops it. The A/B harness uses
+// it to keep two builds loaded and alternate them loop by loop.
+// --ballast-* add fixed extra work to every frame (the harness's deliberate
+// slowdown): GROUPS compute threadgroups, or US microseconds of busy CPU.
+//
+// Present records become frame boundaries: with DXMT (IMTLD3D11Bench) the queue
+// does exactly what Present does minus the on-screen presentation; with any
+// other D3D11 implementation the context is flushed. GPU time needs DXMT and
+// DXMT_BENCH=1. --verify compares every frame checkpoint with the pixels
+// captured during the live recording.
+
+#include "d3d11_4.h"
+#include "d3dcompiler.h"
+#include "../d3d11/d3d11_recorder_format.hpp"
+#include "../d3d11/d3d11_interfaces.hpp"
+#include <windows.h>
+#include <tlhelp32.h>
+#include <algorithm>
+#include <atomic>
+#include <thread>
+#include <cmath>
+#include <cstdio>
+#include <cstring>
+#include <map>
+#include <string>
+#include <vector>
+
+using namespace dxmt::owr;
+
+namespace {
+
+// ---------------------------------------------------------------------------
+// Utilities.
+
+double
+now_us() {
+  static LARGE_INTEGER freq = []() {
+    LARGE_INTEGER f;
+    QueryPerformanceFrequency(&f);
+    return f;
+  }();
+  LARGE_INTEGER t;
+  QueryPerformanceCounter(&t);
+  return double(t.QuadPart) * 1e6 / double(freq.QuadPart);
+}
+
+struct MappedFile {
+  HANDLE file = INVALID_HANDLE_VALUE, mapping = nullptr;
+  const uint8_t *data = nullptr;
+  uint64_t size = 0;
+
+  bool open(const std::string &path) {
+    file = CreateFileA(path.c_str(), GENERIC_READ, FILE_SHARE_READ, nullptr, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL,
+                       nullptr);
+    if (file == INVALID_HANDLE_VALUE)
+      return false;
+    LARGE_INTEGER s;
+    GetFileSizeEx(file, &s);
+    size = s.QuadPart;
+    if (!size)
+      return true;
+    mapping = CreateFileMappingA(file, nullptr, PAGE_READONLY, 0, 0, nullptr);
+    if (!mapping)
+      return false;
+    data = (const uint8_t *)MapViewOfFile(mapping, FILE_MAP_READ, 0, 0, 0);
+    return data != nullptr;
+  }
+  ~MappedFile() {
+    if (data)
+      UnmapViewOfFile(data);
+    if (mapping)
+      CloseHandle(mapping);
+    if (file != INVALID_HANDLE_VALUE)
+      CloseHandle(file);
+  }
+};
+
+struct Reader {
+  const uint8_t *p, *end;
+  template <typename T> T get() {
+    T v{};
+    if (p + sizeof(T) <= end)
+      std::memcpy(&v, p, sizeof(T));
+    p += sizeof(T);
+    return v;
+  }
+  template <typename T> const T *array(size_t n) {
+    auto r = reinterpret_cast<const T *>(p);
+    p += sizeof(T) * n;
+    return r;
+  }
+  bool ok() const { return p <= end; }
+};
+
+struct Record {
+  Op op;
+  uint16_t ctx;
+  const uint8_t *payload;
+  uint32_t size;
+};
+
+std::vector<Record>
+parse(const MappedFile &file, FileHeader &header, bool &ok) {
+  std::vector<Record> out;
+  ok = file.size >= sizeof(FileHeader);
+  if (!ok)
+    return out;
+  std::memcpy(&header, file.data, sizeof header);
+  ok = header.magic == kMagic && header.version == kVersion;
+  const uint8_t *p = file.data + sizeof(FileHeader), *end = file.data + file.size;
+  while (ok && p + sizeof(RecordHeader) <= end) {
+    RecordHeader h;
+    std::memcpy(&h, p, sizeof h);
+    p += sizeof h;
+    if (p + h.size > end) {
+      ok = false;
+      break;
+    }
+    out.push_back({Op(h.op), h.ctx, p, h.size});
+    p += h.size;
+  }
+  return out;
+}
+
+// Uncompressed ("stored") PNG, RGB8.
+void
+write_png(const std::string &path, uint32_t w, uint32_t h, const std::vector<uint8_t> &rgb) {
+  static uint32_t table[256];
+  static bool init = false;
+  if (!init) {
+    for (uint32_t n = 0; n < 256; n++) {
+      uint32_t c = n;
+      for (int k = 0; k < 8; k++)
+        c = c & 1 ? 0xedb88320u ^ (c >> 1) : c >> 1;
+      table[n] = c;
+    }
+    init = true;
+  }
+  auto crc = [&](const uint8_t *d, size_t n, uint32_t c = 0xffffffffu) {
+    for (size_t i = 0; i < n; i++)
+      c = table[(c ^ d[i]) & 0xff] ^ (c >> 8);
+    return c;
+  };
+  std::vector<uint8_t> out = {0x89, 'P', 'N', 'G', 0x0d, 0x0a, 0x1a, 0x0a};
+  auto be32 = [&](std::vector<uint8_t> &v, uint32_t x) {
+    v.push_back(x >> 24);
+    v.push_back(x >> 16);
+    v.push_back(x >> 8);
+    v.push_back(x);
+  };
+  auto chunk = [&](const char *type, const std::vector<uint8_t> &data) {
+    be32(out, uint32_t(data.size()));
+    std::vector<uint8_t> td(type, type + 4);
+    td.insert(td.end(), data.begin(), data.end());
+    out.insert(out.end(), td.begin(), td.end());
+    be32(out, crc(td.data(), td.size()) ^ 0xffffffffu);
+  };
+  std::vector<uint8_t> ihdr;
+  be32(ihdr, w);
+  be32(ihdr, h);
+  ihdr.insert(ihdr.end(), {8, 2, 0, 0, 0});
+  chunk("IHDR", ihdr);
+  std::vector<uint8_t> raw;
+  raw.reserve(size_t(h) * (w * 3 + 1));
+  for (uint32_t y = 0; y < h; y++) {
+    raw.push_back(0);
+    raw.insert(raw.end(), rgb.begin() + size_t(y) * w * 3, rgb.begin() + size_t(y + 1) * w * 3);
+  }
+  std::vector<uint8_t> z = {0x78, 0x01};
+  uint32_t a = 1, b = 0;
+  for (auto byte : raw) {
+    a = (a + byte) % 65521;
+    b = (b + a) % 65521;
+  }
+  for (size_t off = 0; off < raw.size() || off == 0;) {
+    size_t len = std::min<size_t>(65535, raw.size() - off);
+    bool last = off + len >= raw.size();
+    z.push_back(last ? 1 : 0);
+    z.push_back(len & 0xff);
+    z.push_back(len >> 8);
+    z.push_back(~len & 0xff);
+    z.push_back((~len >> 8) & 0xff);
+    z.insert(z.end(), raw.begin() + off, raw.begin() + off + len);
+    off += len;
+    if (last)
+      break;
+  }
+  be32(z, (b << 16) | a);
+  chunk("IDAT", z);
+  chunk("IEND", {});
+  FILE *f = std::fopen(path.c_str(), "wb");
+  if (f) {
+    std::fwrite(out.data(), 1, out.size(), f);
+    std::fclose(f);
+  }
+}
+
+float
+half_to_float(uint16_t h) {
+  uint32_t sign = (h >> 15) & 1, exp = (h >> 10) & 0x1f, mant = h & 0x3ff;
+  float v = exp == 0 ? std::ldexp(float(mant), -24) : exp == 31 ? INFINITY : std::ldexp(float(mant | 0x400), int(exp) - 25);
+  return sign ? -v : v;
+}
+
+// Converts packed rows of a render target format to RGB8; false if unknown.
+bool
+to_rgb8(uint32_t format, uint32_t w, uint32_t h, uint32_t row_bytes, const uint8_t *src, std::vector<uint8_t> &rgb) {
+  rgb.resize(size_t(w) * h * 3);
+  for (uint32_t y = 0; y < h; y++) {
+    const uint8_t *row = src + size_t(y) * row_bytes;
+    uint8_t *o = rgb.data() + size_t(y) * w * 3;
+    for (uint32_t x = 0; x < w; x++, o += 3) {
+      switch (format) {
+      case DXGI_FORMAT_R8G8B8A8_UNORM:
+      case DXGI_FORMAT_R8G8B8A8_UNORM_SRGB:
+      case DXGI_FORMAT_R8G8B8A8_TYPELESS:
+        o[0] = row[x * 4], o[1] = row[x * 4 + 1], o[2] = row[x * 4 + 2];
+        break;
+      case DXGI_FORMAT_B8G8R8A8_UNORM:
+      case DXGI_FORMAT_B8G8R8A8_UNORM_SRGB:
+      case DXGI_FORMAT_B8G8R8X8_UNORM:
+      case DXGI_FORMAT_B8G8R8A8_TYPELESS:
+        o[0] = row[x * 4 + 2], o[1] = row[x * 4 + 1], o[2] = row[x * 4];
+        break;
+      case DXGI_FORMAT_R10G10B10A2_UNORM: {
+        uint32_t v;
+        std::memcpy(&v, row + x * 4, 4);
+        o[0] = (v & 0x3ff) >> 2, o[1] = ((v >> 10) & 0x3ff) >> 2, o[2] = ((v >> 20) & 0x3ff) >> 2;
+        break;
+      }
+      case DXGI_FORMAT_R16G16B16A16_FLOAT: {
+        uint16_t c[3];
+        std::memcpy(c, row + x * 8, 6);
+        for (int i = 0; i < 3; i++)
+          o[i] = uint8_t(std::clamp(half_to_float(c[i]), 0.0f, 1.0f) * 255.0f + 0.5f);
+        break;
+      }
+      default:
+        return false;
+      }
+    }
+  }
+  return true;
+}
+
+struct Stats {
+  double mean = 0, p50 = 0, p95 = 0, p99 = 0, max = 0;
+  size_t n = 0;
+};
+
+Stats
+stats(std::vector<double> v) {
+  Stats s;
+  if (v.empty())
+    return s;
+  std::sort(v.begin(), v.end());
+  s.n = v.size();
+  double sum = 0;
+  for (double x : v)
+    sum += x;
+  s.mean = sum / v.size();
+  auto at = [&](double q) { return v[std::min(v.size() - 1, size_t(q * (v.size() - 1) + 0.5))]; };
+  s.p50 = at(0.5);
+  s.p95 = at(0.95);
+  s.p99 = at(0.99);
+  s.max = v.back();
+  return s;
+}
+
+std::string
+json_stats(const Stats &s) {
+  char buf[256];
+  std::snprintf(buf, sizeof buf, "{\"mean\": %.4f, \"p50\": %.4f, \"p95\": %.4f, \"p99\": %.4f, \"max\": %.4f, \"n\": %zu}",
+                s.mean, s.p50, s.p95, s.p99, s.max, s.n);
+  return buf;
+}
+
+// ---------------------------------------------------------------------------
+// Replayer.
+
+struct Checkpoint {
+  uint64_t frame;
+  bool compared = false, exact = false;
+  uint64_t differing_pixels = 0;
+  uint32_t max_channel_diff = 0;
+  double psnr = 0;
+  uint64_t replayed_hash = 0; // XXH64 of the replayed pixels: equal across builds = identical frames
+};
+
+struct Options {
+  std::string dir, dump, json;
+  int loops = 1, warmup = 0;
+  uint64_t max_frames = 0;
+  bool verify = false, bench = true, serve = false;
+  uint32_t ballast_groups = 0;
+  double ballast_cpu_us = 0;
+  std::string sample_cpu; // CSV of sampled call stacks during the timed loops
+  int pause_after_prologue_ms = 0; // sleep between creating the recorded objects and the first frame
+};
+
+class Replayer {
+public:
+  Options opt;
+  MappedFile prologue_file, stream_file, blob_file;
+  FileHeader header{};
+  std::vector<Record> prologue, stream;
+  std::map<uint32_t, const Record *> contents;
+
+  ID3D11Device *device = nullptr;
+  ID3D11Device1 *device1 = nullptr;
+  ID3D11Device3 *device3 = nullptr;
+  ID3D11DeviceContext1 *imm = nullptr;
+  IMTLD3D11Bench *bench = nullptr;
+  std::vector<IUnknown *> objs;
+  std::vector<bool> created_in_stream;
+  std::map<uint16_t, ID3D11DeviceContext1 *> deferred;
+  uint32_t backbuffer = 0;
+  ID3D11Texture2D *readback = nullptr;
+  std::map<std::string, uint64_t> problems;
+  std::vector<Checkpoint> checkpoints;
+  uint64_t reads_still_drawing = 0;
+  std::vector<uint64_t> frame_hashes; // verify loop: XXH64 of every replayed frame
+  ID3D11Texture2D *frame_readback = nullptr;
+
+  // DXMT_REPLAY_DUMP_FRAMES=260,556 and DXMT_REPLAY_DUMP_DIR=<Windows path>: the verify loop
+  // writes those frames as PNG (to look at what differs between two builds).
+  void dump_frame(size_t index, const D3D11_TEXTURE2D_DESC &desc, uint32_t bytes, const D3D11_MAPPED_SUBRESOURCE &m) {
+    static const std::string frames = [] {
+      char value[1024];
+      DWORD n = GetEnvironmentVariableA("DXMT_REPLAY_DUMP_FRAMES", value, sizeof value);
+      return n && n < sizeof value ? "," + std::string(value, n) + "," : std::string();
+    }();
+    static const std::string dir = [] {
+      char value[1024];
+      DWORD n = GetEnvironmentVariableA("DXMT_REPLAY_DUMP_DIR", value, sizeof value);
+      return n && n < sizeof value ? std::string(value, n) : std::string();
+    }();
+    if (frames.empty() || dir.empty() || frames.find("," + std::to_string(index) + ",") == std::string::npos)
+      return;
+    size_t row = size_t(desc.Width) * bytes;
+    std::vector<uint8_t> raw(row * desc.Height), rgb;
+    for (uint32_t y = 0; y < desc.Height; y++)
+      std::memcpy(raw.data() + y * row, (const uint8_t *)m.pData + size_t(y) * m.RowPitch, row);
+    if (!to_rgb8(desc.Format, desc.Width, desc.Height, (uint32_t)row, raw.data(), rgb))
+      return;
+    char path[1200];
+    std::snprintf(path, sizeof path, "%s\\frame-%06zu-%lu.png", dir.c_str(), index, (unsigned long)GetCurrentProcessId());
+    write_png(path, desc.Width, desc.Height, rgb);
+  }
+
+  // Fingerprints the backbuffer after a frame's last call (verify loop only), so
+  // two builds can be shown to render every frame identically.
+  void fingerprint_frame() {
+    uint64_t hash = 0;
+    uint32_t bytes = 0, bw = 1, bh = 1;
+    D3D11_TEXTURE2D_DESC desc = {};
+    D3D11_MAPPED_SUBRESOURCE m;
+    auto bb = obj<ID3D11Texture2D>(backbuffer);
+    if (bb) {
+      bb->GetDesc(&desc);
+      if (!frame_readback) {
+        D3D11_TEXTURE2D_DESC d = {desc.Width, desc.Height, 1, 1, desc.Format, {1, 0}, D3D11_USAGE_STAGING, 0,
+                                  D3D11_CPU_ACCESS_READ, 0};
+        device->CreateTexture2D(&d, nullptr, &frame_readback);
+      }
+    }
+    if (bb && frame_readback && format_block(desc.Format, bytes, bw, bh) && bw == 1 && bh == 1) {
+      imm->CopySubresourceRegion(frame_readback, 0, 0, 0, 0, bb, 0, nullptr);
+      if (SUCCEEDED(imm->Map(frame_readback, 0, D3D11_MAP_READ, 0, &m))) {
+        for (uint32_t y = 0; y < desc.Height; y++)
+          hash = xxh64((const uint8_t *)m.pData + size_t(y) * m.RowPitch, size_t(desc.Width) * bytes, hash);
+        dump_frame(frame_hashes.size() + 1, desc, bytes, m);
+        imm->Unmap(frame_readback, 0);
+      }
+    }
+    frame_hashes.push_back(hash);
+  }
+
+  const uint8_t *blob(const BlobRef &b) {
+    if (!b.size)
+      return nullptr;
+    if (b.offset + b.size > blob_file.size) {
+      problems["blob out of range"]++;
+      return nullptr;
+    }
+    return blob_file.data + b.offset;
+  }
+
+  template <typename T = IUnknown> T *obj(uint32_t id) {
+    return id && id < objs.size() ? reinterpret_cast<T *>(objs[id]) : nullptr;
+  }
+
+  void set(uint32_t id, IUnknown *o, bool in_stream) {
+    if (id >= objs.size()) {
+      objs.resize(id + 1024, nullptr);
+      created_in_stream.resize(id + 1024, false);
+    }
+    if (objs[id])
+      objs[id]->Release();
+    objs[id] = o;
+    created_in_stream[id] = in_stream;
+  }
+
+  ID3D11DeviceContext1 *context(uint16_t ctx) {
+    if (!ctx)
+      return imm;
+    auto it = deferred.find(ctx);
+    if (it == deferred.end()) {
+      problems["call on unknown deferred context"]++;
+      return nullptr;
+    }
+    return it->second;
+  }
+
+  bool load() {
+    std::string base = opt.dir + "\\";
+    if (!prologue_file.open(base + "prologue.owr") || !stream_file.open(base + "stream.owr") ||
+        !blob_file.open(base + "blobs.owb")) {
+      std::fprintf(stderr, "Cannot open the recording files in %s\n", opt.dir.c_str());
+      return false;
+    }
+    bool ok1, ok2;
+    FileHeader h2;
+    prologue = parse(prologue_file, header, ok1);
+    stream = parse(stream_file, h2, ok2);
+    if (!ok1 || !ok2) {
+      std::fprintf(stderr, "Recording is truncated or has an unknown format\n");
+      return false;
+    }
+    for (auto &r : prologue)
+      if (r.op == Op::ResourceContent) {
+        Reader rd{r.payload, r.payload + r.size};
+        contents[rd.get<uint32_t>()] = &r;
+      }
+    return true;
+  }
+
+  bool create_device() {
+    auto module = LoadLibraryA("d3d11.dll");
+    auto create = module ? (PFN_D3D11_CREATE_DEVICE)GetProcAddress(module, "D3D11CreateDevice") : nullptr;
+    if (!create) {
+      std::fprintf(stderr, "d3d11.dll has no D3D11CreateDevice\n");
+      return false;
+    }
+    D3D_FEATURE_LEVEL level = D3D_FEATURE_LEVEL(header.feature_level ? header.feature_level : D3D_FEATURE_LEVEL_11_1);
+    UINT flags = header.device_flags & ~(D3D11_CREATE_DEVICE_DEBUG | D3D11_CREATE_DEVICE_DEBUGGABLE);
+    ID3D11DeviceContext *ctx = nullptr;
+    HRESULT hr = create(nullptr, D3D_DRIVER_TYPE_HARDWARE, nullptr, flags, &level, 1, D3D11_SDK_VERSION, &device,
+                        nullptr, &ctx);
+    if (FAILED(hr)) {
+      std::fprintf(stderr, "D3D11CreateDevice failed: 0x%08lx\n", hr);
+      return false;
+    }
+    device->QueryInterface(IID_PPV_ARGS(&device1));
+    device->QueryInterface(IID_PPV_ARGS(&device3));
+    ctx->QueryInterface(IID_PPV_ARGS(&imm));
+    ctx->Release();
+    if (opt.bench && FAILED(device->QueryInterface(__uuidof(IMTLD3D11Bench), (void **)&bench)))
+      bench = nullptr;
+    return device1 && imm;
+  }
+
+  // Initial data for a resource, from its own record or from ResourceContent.
+  bool initial_data(Reader &rd, uint32_t id, uint32_t subresources, std::vector<D3D11_SUBRESOURCE_DATA> &init) {
+    uint32_t count = rd.get<uint32_t>();
+    const SubData *subs = rd.array<SubData>(count);
+    if (!count) {
+      auto it = contents.find(id);
+      if (it == contents.end())
+        return false;
+      Reader cr{it->second->payload, it->second->payload + it->second->size};
+      cr.get<uint32_t>();
+      count = cr.get<uint32_t>();
+      subs = cr.array<SubData>(count);
+    }
+    if (!count || count != subresources)
+      return false;
+    init.resize(count);
+    for (uint32_t i = 0; i < count; i++) {
+      init[i].pSysMem = blob(subs[i].blob);
+      init[i].SysMemPitch = subs[i].row_pitch;
+      init[i].SysMemSlicePitch = subs[i].depth_pitch;
+      if (!init[i].pSysMem)
+        return false;
+    }
+    return true;
+  }
+
+  void create(const Record &r, bool in_stream) {
+    Reader rd{r.payload, r.payload + r.size};
+    uint32_t id = rd.get<uint32_t>();
+    std::vector<D3D11_SUBRESOURCE_DATA> init;
+    IUnknown *o = nullptr;
+    HRESULT hr = S_OK;
+    auto with_fallback = [&](auto &&make) {
+      hr = make(init.empty() ? nullptr : init.data());
+      if (FAILED(hr) && !init.empty()) {
+        problems["resource created without its content"]++;
+        hr = make(nullptr);
+      }
+    };
+    switch (r.op) {
+    case Op::CreateBuffer: {
+      auto d = rd.get<D3D11_BUFFER_DESC>();
+      initial_data(rd, id, 1, init);
+      with_fallback([&](const D3D11_SUBRESOURCE_DATA *data) {
+        return device->CreateBuffer(&d, data, (ID3D11Buffer **)&o);
+      });
+      break;
+    }
+    case Op::CreateTexture1D: {
+      auto d = rd.get<D3D11_TEXTURE1D_DESC>();
+      initial_data(rd, id, d.MipLevels * d.ArraySize, init);
+      with_fallback([&](const D3D11_SUBRESOURCE_DATA *data) {
+        return device->CreateTexture1D(&d, data, (ID3D11Texture1D **)&o);
+      });
+      break;
+    }
+    case Op::CreateTexture2D: {
+      auto d = rd.get<D3D11_TEXTURE2D_DESC>();
+      if (d.SampleDesc.Count <= 1)
+        initial_data(rd, id, d.MipLevels * d.ArraySize, init);
+      with_fallback([&](const D3D11_SUBRESOURCE_DATA *data) {
+        return device->CreateTexture2D(&d, data, (ID3D11Texture2D **)&o);
+      });
+      break;
+    }
+    case Op::CreateTexture3D: {
+      auto d = rd.get<D3D11_TEXTURE3D_DESC>();
+      initial_data(rd, id, d.MipLevels, init);
+      with_fallback([&](const D3D11_SUBRESOURCE_DATA *data) {
+        return device->CreateTexture3D(&d, data, (ID3D11Texture3D **)&o);
+      });
+      break;
+    }
+    case Op::CreateSRV: {
+      auto rid = rd.get<uint32_t>();
+      auto d = rd.get<D3D11_SHADER_RESOURCE_VIEW_DESC>();
+      hr = device->CreateShaderResourceView(obj<ID3D11Resource>(rid), &d, (ID3D11ShaderResourceView **)&o);
+      break;
+    }
+    case Op::CreateUAV: {
+      auto rid = rd.get<uint32_t>();
+      auto d = rd.get<D3D11_UNORDERED_ACCESS_VIEW_DESC>();
+      hr = device->CreateUnorderedAccessView(obj<ID3D11Resource>(rid), &d, (ID3D11UnorderedAccessView **)&o);
+      break;
+    }
+    case Op::CreateRTV: {
+      auto rid = rd.get<uint32_t>();
+      auto d = rd.get<D3D11_RENDER_TARGET_VIEW_DESC>();
+      hr = device->CreateRenderTargetView(obj<ID3D11Resource>(rid), &d, (ID3D11RenderTargetView **)&o);
+      break;
+    }
+    case Op::CreateDSV: {
+      auto rid = rd.get<uint32_t>();
+      auto d = rd.get<D3D11_DEPTH_STENCIL_VIEW_DESC>();
+      hr = device->CreateDepthStencilView(obj<ID3D11Resource>(rid), &d, (ID3D11DepthStencilView **)&o);
+      break;
+    }
+    case Op::CreateShader: {
+      auto stage = rd.get<uint32_t>();
+      auto bc = rd.get<BlobRef>();
+      auto so_count = rd.get<uint32_t>(), stride_count = rd.get<uint32_t>(), rasterized = rd.get<uint32_t>();
+      auto so = rd.array<StreamOutElement>(so_count);
+      auto strides = rd.array<uint32_t>(stride_count);
+      const void *code = blob(bc);
+      switch (stage) {
+      case VS: hr = device->CreateVertexShader(code, bc.size, nullptr, (ID3D11VertexShader **)&o); break;
+      case HS: hr = device->CreateHullShader(code, bc.size, nullptr, (ID3D11HullShader **)&o); break;
+      case DS: hr = device->CreateDomainShader(code, bc.size, nullptr, (ID3D11DomainShader **)&o); break;
+      case PS: hr = device->CreatePixelShader(code, bc.size, nullptr, (ID3D11PixelShader **)&o); break;
+      case CS: hr = device->CreateComputeShader(code, bc.size, nullptr, (ID3D11ComputeShader **)&o); break;
+      case GS:
+        if (so_count) {
+          std::vector<D3D11_SO_DECLARATION_ENTRY> decl(so_count);
+          for (uint32_t i = 0; i < so_count; i++)
+            decl[i] = {so[i].stream, so[i].semantic[0] ? so[i].semantic : nullptr, so[i].semantic_index,
+                       so[i].start_component, so[i].component_count, so[i].output_slot};
+          hr = device->CreateGeometryShaderWithStreamOutput(code, bc.size, decl.data(), so_count, strides,
+                                                            stride_count, rasterized, nullptr,
+                                                            (ID3D11GeometryShader **)&o);
+        } else {
+          hr = device->CreateGeometryShader(code, bc.size, nullptr, (ID3D11GeometryShader **)&o);
+        }
+        break;
+      default:
+        hr = E_INVALIDARG;
+      }
+      break;
+    }
+    case Op::CreateInputLayout: {
+      auto count = rd.get<uint32_t>();
+      auto bc = rd.get<BlobRef>();
+      auto elements = rd.array<InputElement>(count);
+      std::vector<D3D11_INPUT_ELEMENT_DESC> descs(count);
+      for (uint32_t i = 0; i < count; i++)
+        descs[i] = {elements[i].semantic, elements[i].semantic_index, DXGI_FORMAT(elements[i].format),
+                    elements[i].input_slot, elements[i].aligned_byte_offset,
+                    D3D11_INPUT_CLASSIFICATION(elements[i].input_slot_class), elements[i].instance_data_step_rate};
+      hr = device->CreateInputLayout(descs.data(), count, blob(bc), bc.size, (ID3D11InputLayout **)&o);
+      break;
+    }
+    case Op::CreateBlendState: {
+      auto d = rd.get<D3D11_BLEND_DESC1>();
+      hr = device1->CreateBlendState1(&d, (ID3D11BlendState1 **)&o);
+      break;
+    }
+    case Op::CreateDepthStencilState: {
+      auto d = rd.get<D3D11_DEPTH_STENCIL_DESC>();
+      hr = device->CreateDepthStencilState(&d, (ID3D11DepthStencilState **)&o);
+      break;
+    }
+    case Op::CreateRasterizerState: {
+      auto d = rd.get<D3D11_RASTERIZER_DESC2>();
+      if (device3) {
+        hr = device3->CreateRasterizerState2(&d, (ID3D11RasterizerState2 **)&o);
+      } else {
+        D3D11_RASTERIZER_DESC1 d1;
+        std::memcpy(&d1, &d, sizeof d1);
+        hr = device1->CreateRasterizerState1(&d1, (ID3D11RasterizerState1 **)&o);
+      }
+      break;
+    }
+    case Op::CreateSamplerState: {
+      auto d = rd.get<D3D11_SAMPLER_DESC>();
+      hr = device->CreateSamplerState(&d, (ID3D11SamplerState **)&o);
+      break;
+    }
+    case Op::CreateQuery: {
+      auto d = rd.get<D3D11_QUERY_DESC>();
+      auto predicate = rd.get<uint32_t>();
+      hr = predicate ? device->CreatePredicate(&d, (ID3D11Predicate **)&o)
+                     : device->CreateQuery(&d, (ID3D11Query **)&o);
+      break;
+    }
+    default:
+      return;
+    }
+    if (FAILED(hr) || !o) {
+      problems[std::string("create failed: ") + op_name(r.op)]++;
+      return;
+    }
+    set(id, o, in_stream);
+  }
+
+  template <typename T> std::vector<T *> objects(Reader &rd, uint32_t n) {
+    std::vector<T *> v(n);
+    for (uint32_t i = 0; i < n; i++)
+      v[i] = obj<T>(rd.get<uint32_t>());
+    return v;
+  }
+
+  void map_write(ID3D11DeviceContext1 *ctx, Reader &rd) {
+    auto head = rd.get<MapWritePayload>();
+    auto res = obj<ID3D11Resource>(head.resource);
+    if (!res) {
+      problems["map of unknown resource"]++;
+      return;
+    }
+    D3D11_MAPPED_SUBRESOURCE m;
+    if (FAILED(ctx->Map(res, head.subresource, D3D11_MAP(head.map_type), head.map_flags & ~D3D11_MAP_FLAG_DO_NOT_WAIT,
+                        &m))) {
+      problems["map failed"]++;
+      return;
+    }
+    auto dst = reinterpret_cast<uint8_t *>(m.pData);
+    switch (MapKind(head.kind)) {
+    case MapKind::Whole: {
+      auto b = rd.get<BlobRef>();
+      if (auto src = blob(b))
+        std::memcpy(dst, src, b.size);
+      if (head.full_size > b.size && head.map_type == D3D11_MAP_WRITE_DISCARD)
+        std::memset(dst + b.size, 0, head.full_size - b.size);
+      break;
+    }
+    case MapKind::Ranges: {
+      auto ranges = rd.array<Range>(head.count);
+      for (uint32_t i = 0; i < head.count; i++)
+        if (auto src = blob(ranges[i].blob))
+          std::memcpy(dst + ranges[i].offset, src, ranges[i].blob.size);
+      break;
+    }
+    case MapKind::Rows: {
+      auto t = rd.get<TextureRows>();
+      if (auto src = blob(t.blob))
+        for (uint32_t z = 0; z < t.depth; z++)
+          for (uint32_t y = 0; y < t.rows; y++)
+            std::memcpy(dst + size_t(z) * m.DepthPitch + size_t(y) * m.RowPitch,
+                        src + (size_t(z) * t.rows + y) * t.row_bytes, t.row_bytes);
+      break;
+    }
+    }
+    ctx->Unmap(res, head.subresource);
+  }
+
+  void compare_checkpoint(Reader &rd) {
+    auto cp = rd.get<CheckpointPayload>();
+    Checkpoint result{cp.frame};
+    auto bb = obj<ID3D11Texture2D>(backbuffer);
+    const uint8_t *live = blob(cp.pixels);
+    if (!bb || !live) {
+      problems["checkpoint without backbuffer or pixels"]++;
+      checkpoints.push_back(result);
+      return;
+    }
+    if (!readback) {
+      D3D11_TEXTURE2D_DESC d = {cp.width, cp.height, 1, 1, DXGI_FORMAT(cp.format), {1, 0}, D3D11_USAGE_STAGING, 0,
+                                D3D11_CPU_ACCESS_READ, 0};
+      if (FAILED(device->CreateTexture2D(&d, nullptr, &readback)))
+        return;
+    }
+    imm->CopyResource(readback, bb);
+    D3D11_MAPPED_SUBRESOURCE m;
+    if (FAILED(imm->Map(readback, 0, D3D11_MAP_READ, 0, &m)))
+      return;
+    std::vector<uint8_t> replayed(size_t(cp.row_bytes) * cp.height);
+    for (uint32_t y = 0; y < cp.height; y++)
+      std::memcpy(replayed.data() + size_t(y) * cp.row_bytes, (const uint8_t *)m.pData + size_t(y) * m.RowPitch,
+                  cp.row_bytes);
+    imm->Unmap(readback, 0);
+    result.compared = true;
+    result.exact = std::memcmp(replayed.data(), live, replayed.size()) == 0;
+    result.replayed_hash = xxh64(replayed.data(), replayed.size());
+    std::vector<uint8_t> a, b;
+    if (to_rgb8(cp.format, cp.width, cp.height, cp.row_bytes, live, a) &&
+        to_rgb8(cp.format, cp.width, cp.height, cp.row_bytes, replayed.data(), b)) {
+      double se = 0;
+      for (size_t i = 0; i < a.size(); i += 3) {
+        uint32_t d = 0;
+        for (int c = 0; c < 3; c++) {
+          int diff = std::abs(int(a[i + c]) - int(b[i + c]));
+          d = std::max<uint32_t>(d, diff);
+          se += double(diff) * diff;
+        }
+        result.differing_pixels += d != 0;
+        result.max_channel_diff = std::max(result.max_channel_diff, d);
+      }
+      double mse = se / double(a.size());
+      result.psnr = mse == 0 ? 99.0 : 10.0 * std::log10(255.0 * 255.0 / mse);
+      if (!opt.dump.empty()) {
+        char name[64];
+        std::snprintf(name, sizeof name, "\\frame-%06llu", (unsigned long long)cp.frame);
+        write_png(opt.dump + name + "-live.png", cp.width, cp.height, a);
+        write_png(opt.dump + name + "-replay.png", cp.width, cp.height, b);
+      }
+    }
+    checkpoints.push_back(result);
+  }
+
+  void execute(const Record &r, bool in_stream, bool verify) {
+    Reader rd{r.payload, r.payload + r.size};
+    if (r.op < Op::SetShader || r.op == Op::FinishCommandList) {
+      if (r.op == Op::CreateDeferredContext) {
+        uint32_t id = rd.get<uint32_t>(), flags = rd.get<uint32_t>();
+        ID3D11DeviceContext *ctx = nullptr;
+        ID3D11DeviceContext1 *ctx1 = nullptr;
+        if (SUCCEEDED(device->CreateDeferredContext(flags, &ctx))) {
+          ctx->QueryInterface(IID_PPV_ARGS(&ctx1));
+          ctx->Release();
+          if (deferred[uint16_t(id)])
+            deferred[uint16_t(id)]->Release();
+          deferred[uint16_t(id)] = ctx1;
+        }
+      } else if (r.op == Op::Backbuffer) {
+        backbuffer = rd.get<uint32_t>();
+      } else if (r.op == Op::FinishCommandList) {
+        auto ctx = context(r.ctx);
+        uint32_t restore = rd.get<uint32_t>(), id = rd.get<uint32_t>();
+        ID3D11CommandList *list = nullptr;
+        if (ctx && SUCCEEDED(ctx->FinishCommandList(restore, &list)))
+          set(id, list, true);
+      } else if (r.op != Op::ResourceContent) {
+        create(r, in_stream);
+      }
+      return;
+    }
+    if (r.op == Op::Present || r.op == Op::FrameCheckpoint) {
+      if (r.op == Op::FrameCheckpoint && verify)
+        compare_checkpoint(rd);
+      return;
+    }
+    auto ctx = context(r.ctx);
+    if (!ctx)
+      return;
+    switch (r.op) {
+    case Op::SetShader: {
+      auto stage = rd.get<uint32_t>();
+      auto s = obj<IUnknown>(rd.get<uint32_t>());
+      switch (stage) {
+      case VS: ctx->VSSetShader((ID3D11VertexShader *)s, nullptr, 0); break;
+      case HS: ctx->HSSetShader((ID3D11HullShader *)s, nullptr, 0); break;
+      case DS: ctx->DSSetShader((ID3D11DomainShader *)s, nullptr, 0); break;
+      case GS: ctx->GSSetShader((ID3D11GeometryShader *)s, nullptr, 0); break;
+      case PS: ctx->PSSetShader((ID3D11PixelShader *)s, nullptr, 0); break;
+      case CS: ctx->CSSetShader((ID3D11ComputeShader *)s, nullptr, 0); break;
+      }
+      break;
+    }
+    case Op::SetShaderResources: {
+      auto stage = rd.get<uint32_t>(), start = rd.get<uint32_t>(), n = rd.get<uint32_t>();
+      auto v = objects<ID3D11ShaderResourceView>(rd, n);
+      switch (stage) {
+      case VS: ctx->VSSetShaderResources(start, n, v.data()); break;
+      case HS: ctx->HSSetShaderResources(start, n, v.data()); break;
+      case DS: ctx->DSSetShaderResources(start, n, v.data()); break;
+      case GS: ctx->GSSetShaderResources(start, n, v.data()); break;
+      case PS: ctx->PSSetShaderResources(start, n, v.data()); break;
+      case CS: ctx->CSSetShaderResources(start, n, v.data()); break;
+      }
+      break;
+    }
+    case Op::SetSamplers: {
+      auto stage = rd.get<uint32_t>(), start = rd.get<uint32_t>(), n = rd.get<uint32_t>();
+      auto v = objects<ID3D11SamplerState>(rd, n);
+      switch (stage) {
+      case VS: ctx->VSSetSamplers(start, n, v.data()); break;
+      case HS: ctx->HSSetSamplers(start, n, v.data()); break;
+      case DS: ctx->DSSetSamplers(start, n, v.data()); break;
+      case GS: ctx->GSSetSamplers(start, n, v.data()); break;
+      case PS: ctx->PSSetSamplers(start, n, v.data()); break;
+      case CS: ctx->CSSetSamplers(start, n, v.data()); break;
+      }
+      break;
+    }
+    case Op::SetConstantBuffers: {
+      auto stage = rd.get<uint32_t>(), start = rd.get<uint32_t>(), n = rd.get<uint32_t>();
+      auto has_offsets = rd.get<uint32_t>();
+      auto v = objects<ID3D11Buffer>(rd, n);
+      const UINT *first = has_offsets ? rd.array<UINT>(n) : nullptr;
+      const UINT *num = has_offsets ? rd.array<UINT>(n) : nullptr;
+      switch (stage) {
+      case VS: ctx->VSSetConstantBuffers1(start, n, v.data(), first, num); break;
+      case HS: ctx->HSSetConstantBuffers1(start, n, v.data(), first, num); break;
+      case DS: ctx->DSSetConstantBuffers1(start, n, v.data(), first, num); break;
+      case GS: ctx->GSSetConstantBuffers1(start, n, v.data(), first, num); break;
+      case PS: ctx->PSSetConstantBuffers1(start, n, v.data(), first, num); break;
+      case CS: ctx->CSSetConstantBuffers1(start, n, v.data(), first, num); break;
+      }
+      break;
+    }
+    case Op::IASetInputLayout:
+      ctx->IASetInputLayout(obj<ID3D11InputLayout>(rd.get<uint32_t>()));
+      break;
+    case Op::IASetVertexBuffers: {
+      auto start = rd.get<uint32_t>(), n = rd.get<uint32_t>();
+      auto v = objects<ID3D11Buffer>(rd, n);
+      auto strides = rd.array<UINT>(n);
+      auto offsets = rd.array<UINT>(n);
+      ctx->IASetVertexBuffers(start, n, v.data(), strides, offsets);
+      break;
+    }
+    case Op::IASetIndexBuffer: {
+      auto b = obj<ID3D11Buffer>(rd.get<uint32_t>());
+      auto format = rd.get<uint32_t>(), offset = rd.get<uint32_t>();
+      ctx->IASetIndexBuffer(b, DXGI_FORMAT(format), offset);
+      break;
+    }
+    case Op::IASetPrimitiveTopology:
+      ctx->IASetPrimitiveTopology(D3D11_PRIMITIVE_TOPOLOGY(rd.get<uint32_t>()));
+      break;
+    case Op::RSSetState:
+      ctx->RSSetState(obj<ID3D11RasterizerState>(rd.get<uint32_t>()));
+      break;
+    case Op::RSSetViewports: {
+      auto n = rd.get<uint32_t>();
+      ctx->RSSetViewports(n, rd.array<D3D11_VIEWPORT>(n));
+      break;
+    }
+    case Op::RSSetScissorRects: {
+      auto n = rd.get<uint32_t>();
+      ctx->RSSetScissorRects(n, rd.array<D3D11_RECT>(n));
+      break;
+    }
+    case Op::OMSetRenderTargets: {
+      auto n = rd.get<uint32_t>();
+      auto v = objects<ID3D11RenderTargetView>(rd, n);
+      ctx->OMSetRenderTargets(n, v.data(), obj<ID3D11DepthStencilView>(rd.get<uint32_t>()));
+      break;
+    }
+    case Op::OMSetRenderTargetsAndUAVs: {
+      auto n = rd.get<uint32_t>();
+      std::vector<ID3D11RenderTargetView *> rtvs;
+      ID3D11DepthStencilView *dsv = nullptr;
+      if (n != D3D11_KEEP_RENDER_TARGETS_AND_DEPTH_STENCIL) {
+        rtvs = objects<ID3D11RenderTargetView>(rd, n);
+        dsv = obj<ID3D11DepthStencilView>(rd.get<uint32_t>());
+      }
+      auto uav_start = rd.get<uint32_t>(), nuav = rd.get<uint32_t>();
+      std::vector<ID3D11UnorderedAccessView *> uavs;
+      const UINT *counts = nullptr;
+      if (nuav != D3D11_KEEP_UNORDERED_ACCESS_VIEWS) {
+        uavs = objects<ID3D11UnorderedAccessView>(rd, nuav);
+        if (rd.get<uint32_t>())
+          counts = rd.array<UINT>(nuav);
+      }
+      ctx->OMSetRenderTargetsAndUnorderedAccessViews(n, rtvs.data(), dsv, uav_start, nuav, uavs.data(), counts);
+      break;
+    }
+    case Op::OMSetBlendState: {
+      auto s = obj<ID3D11BlendState>(rd.get<uint32_t>());
+      auto has_factor = rd.get<uint32_t>();
+      auto factor = rd.array<FLOAT>(4);
+      ctx->OMSetBlendState(s, has_factor ? factor : nullptr, rd.get<uint32_t>());
+      break;
+    }
+    case Op::OMSetDepthStencilState: {
+      auto s = obj<ID3D11DepthStencilState>(rd.get<uint32_t>());
+      ctx->OMSetDepthStencilState(s, rd.get<uint32_t>());
+      break;
+    }
+    case Op::SOSetTargets: {
+      auto n = rd.get<uint32_t>();
+      auto v = objects<ID3D11Buffer>(rd, n);
+      ctx->SOSetTargets(n, v.data(), rd.array<UINT>(n));
+      break;
+    }
+    case Op::CSSetUnorderedAccessViews: {
+      auto start = rd.get<uint32_t>(), n = rd.get<uint32_t>();
+      auto v = objects<ID3D11UnorderedAccessView>(rd, n);
+      const UINT *counts = rd.get<uint32_t>() ? rd.array<UINT>(n) : nullptr;
+      ctx->CSSetUnorderedAccessViews(start, n, v.data(), counts);
+      break;
+    }
+    case Op::Draw: {
+      auto a = rd.get<uint32_t>(), b = rd.get<uint32_t>();
+      ctx->Draw(a, b);
+      break;
+    }
+    case Op::DrawIndexed: {
+      auto a = rd.get<uint32_t>(), b = rd.get<uint32_t>();
+      ctx->DrawIndexed(a, b, rd.get<INT>());
+      break;
+    }
+    case Op::DrawInstanced: {
+      auto a = rd.get<uint32_t>(), b = rd.get<uint32_t>(), c = rd.get<uint32_t>(), d = rd.get<uint32_t>();
+      ctx->DrawInstanced(a, b, c, d);
+      break;
+    }
+    case Op::DrawIndexedInstanced: {
+      auto a = rd.get<uint32_t>(), b = rd.get<uint32_t>(), c = rd.get<uint32_t>();
+      auto d = rd.get<INT>();
+      ctx->DrawIndexedInstanced(a, b, c, d, rd.get<uint32_t>());
+      break;
+    }
+    case Op::DrawAuto:
+      ctx->DrawAuto();
+      break;
+    case Op::DrawInstancedIndirect: {
+      auto b = obj<ID3D11Buffer>(rd.get<uint32_t>());
+      ctx->DrawInstancedIndirect(b, rd.get<uint32_t>());
+      break;
+    }
+    case Op::DrawIndexedInstancedIndirect: {
+      auto b = obj<ID3D11Buffer>(rd.get<uint32_t>());
+      ctx->DrawIndexedInstancedIndirect(b, rd.get<uint32_t>());
+      break;
+    }
+    case Op::Dispatch: {
+      auto x = rd.get<uint32_t>(), y = rd.get<uint32_t>(), z = rd.get<uint32_t>();
+      ctx->Dispatch(x, y, z);
+      break;
+    }
+    case Op::DispatchIndirect: {
+      auto b = obj<ID3D11Buffer>(rd.get<uint32_t>());
+      ctx->DispatchIndirect(b, rd.get<uint32_t>());
+      break;
+    }
+    case Op::Begin:
+      if (auto q = obj<ID3D11Asynchronous>(rd.get<uint32_t>()))
+        ctx->Begin(q);
+      break;
+    case Op::End:
+      if (auto q = obj<ID3D11Asynchronous>(rd.get<uint32_t>()))
+        ctx->End(q);
+      break;
+    case Op::SetPredication: {
+      auto p = obj<ID3D11Predicate>(rd.get<uint32_t>());
+      ctx->SetPredication(p, rd.get<uint32_t>());
+      break;
+    }
+    case Op::MapWrite:
+      map_write(ctx, rd);
+      break;
+    case Op::MapRead: {
+      auto res = obj<ID3D11Resource>(rd.get<uint32_t>());
+      auto sub = rd.get<uint32_t>(), type = rd.get<uint32_t>(), flags = rd.get<uint32_t>();
+      D3D11_MAPPED_SUBRESOURCE m;
+      HRESULT hr = res ? ctx->Map(res, sub, D3D11_MAP(type), flags, &m) : E_INVALIDARG;
+      if (SUCCEEDED(hr))
+        ctx->Unmap(res, sub);
+      else if (hr == DXGI_ERROR_WAS_STILL_DRAWING)
+        reads_still_drawing++;
+      break;
+    }
+    case Op::UpdateSubresource: {
+      auto res = obj<ID3D11Resource>(rd.get<uint32_t>());
+      auto sub = rd.get<uint32_t>(), has_box = rd.get<uint32_t>();
+      auto box = rd.get<D3D11_BOX>();
+      auto row = rd.get<uint32_t>(), depth = rd.get<uint32_t>(), flags = rd.get<uint32_t>();
+      auto b = rd.get<BlobRef>();
+      if (res && blob(b))
+        ctx->UpdateSubresource1(res, sub, has_box ? &box : nullptr, blob(b), row, depth, flags);
+      break;
+    }
+    case Op::CopyResource: {
+      auto dst = obj<ID3D11Resource>(rd.get<uint32_t>());
+      auto src = obj<ID3D11Resource>(rd.get<uint32_t>());
+      if (dst && src)
+        ctx->CopyResource(dst, src);
+      break;
+    }
+    case Op::CopySubresourceRegion: {
+      auto dst = obj<ID3D11Resource>(rd.get<uint32_t>());
+      auto dsub = rd.get<uint32_t>(), x = rd.get<uint32_t>(), y = rd.get<uint32_t>(), z = rd.get<uint32_t>();
+      auto src = obj<ID3D11Resource>(rd.get<uint32_t>());
+      auto ssub = rd.get<uint32_t>(), has_box = rd.get<uint32_t>();
+      auto box = rd.get<D3D11_BOX>();
+      auto flags = rd.get<uint32_t>();
+      if (dst && src)
+        ctx->CopySubresourceRegion1(dst, dsub, x, y, z, src, ssub, has_box ? &box : nullptr, flags);
+      break;
+    }
+    case Op::CopyStructureCount: {
+      auto dst = obj<ID3D11Buffer>(rd.get<uint32_t>());
+      auto offset = rd.get<uint32_t>();
+      auto src = obj<ID3D11UnorderedAccessView>(rd.get<uint32_t>());
+      ctx->CopyStructureCount(dst, offset, src);
+      break;
+    }
+    case Op::ClearRenderTargetView: {
+      auto v = obj<ID3D11RenderTargetView>(rd.get<uint32_t>());
+      if (v)
+        ctx->ClearRenderTargetView(v, rd.array<FLOAT>(4));
+      break;
+    }
+    case Op::ClearUAVUint: {
+      auto v = obj<ID3D11UnorderedAccessView>(rd.get<uint32_t>());
+      if (v)
+        ctx->ClearUnorderedAccessViewUint(v, rd.array<UINT>(4));
+      break;
+    }
+    case Op::ClearUAVFloat: {
+      auto v = obj<ID3D11UnorderedAccessView>(rd.get<uint32_t>());
+      if (v)
+        ctx->ClearUnorderedAccessViewFloat(v, rd.array<FLOAT>(4));
+      break;
+    }
+    case Op::ClearDepthStencilView: {
+      auto v = obj<ID3D11DepthStencilView>(rd.get<uint32_t>());
+      auto flags = rd.get<uint32_t>();
+      auto depth = rd.get<FLOAT>();
+      auto stencil = rd.get<uint32_t>();
+      if (v)
+        ctx->ClearDepthStencilView(v, flags, depth, UINT8(stencil));
+      break;
+    }
+    case Op::ClearView: {
+      auto v = obj<ID3D11View>(rd.get<uint32_t>());
+      auto color = rd.array<FLOAT>(4);
+      auto n = rd.get<uint32_t>();
+      if (v)
+        ctx->ClearView(v, color, n ? rd.array<D3D11_RECT>(n) : nullptr, n);
+      break;
+    }
+    case Op::GenerateMips:
+      if (auto v = obj<ID3D11ShaderResourceView>(rd.get<uint32_t>()))
+        ctx->GenerateMips(v);
+      break;
+    case Op::SetResourceMinLOD: {
+      auto res = obj<ID3D11Resource>(rd.get<uint32_t>());
+      if (res)
+        ctx->SetResourceMinLOD(res, rd.get<FLOAT>());
+      break;
+    }
+    case Op::ResolveSubresource: {
+      auto dst = obj<ID3D11Resource>(rd.get<uint32_t>());
+      auto dsub = rd.get<uint32_t>();
+      auto src = obj<ID3D11Resource>(rd.get<uint32_t>());
+      auto ssub = rd.get<uint32_t>(), format = rd.get<uint32_t>();
+      if (dst && src)
+        ctx->ResolveSubresource(dst, dsub, src, ssub, DXGI_FORMAT(format));
+      break;
+    }
+    case Op::DiscardResource:
+      if (auto res = obj<ID3D11Resource>(rd.get<uint32_t>()))
+        ctx->DiscardResource(res);
+      break;
+    case Op::DiscardView: {
+      auto v = obj<ID3D11View>(rd.get<uint32_t>());
+      auto n = rd.get<uint32_t>();
+      if (v)
+        ctx->DiscardView1(v, n ? rd.array<D3D11_RECT>(n) : nullptr, n);
+      break;
+    }
+    case Op::ClearState:
+      ctx->ClearState();
+      break;
+    case Op::Flush:
+      ctx->Flush();
+      break;
+    case Op::ExecuteCommandList: {
+      auto list = obj<ID3D11CommandList>(rd.get<uint32_t>());
+      auto restore = rd.get<uint32_t>();
+      if (list)
+        ctx->ExecuteCommandList(list, restore);
+      else
+        problems["missing command list"]++;
+      break;
+    }
+    case Op::Unsupported: {
+      auto name = rd.array<char>(64);
+      problems[std::string("unsupported: ") + std::string(name, strnlen(name, 64))]++;
+      break;
+    }
+    default:
+      problems[std::string("unknown op ") + op_name(r.op)]++;
+      break;
+    }
+    if (!rd.ok())
+      problems[std::string("truncated ") + op_name(r.op)]++;
+  }
+
+  void release_stream_objects() {
+    for (size_t i = 0; i < objs.size(); i++)
+      if (objs[i] && created_in_stream[i]) {
+        objs[i]->Release();
+        objs[i] = nullptr;
+      }
+  }
+
+  ~Replayer() {
+    for (auto o : objs)
+      if (o)
+        o->Release();
+    for (auto &[id, ctx] : deferred)
+      if (ctx)
+        ctx->Release();
+    if (readback)
+      readback->Release();
+    if (frame_readback)
+      frame_readback->Release();
+    if (bench)
+      bench->Release();
+    if (imm)
+      imm->Release();
+    if (device3)
+      device3->Release();
+    if (device1)
+      device1->Release();
+    if (device)
+      device->Release();
+  }
+};
+
+struct LoopResult {
+  double wall_ms = 0, process_cpu_ms = 0;
+  double gpu_wall_ms = 0; // end of the first frame to end of the last (frames - 1 intervals)
+  uint64_t frames = 0;
+  std::vector<double> cpu_submit_ms, cpu_frame_ms, gpu_busy_ms, gpu_active_ms, gpu_span_ms, gpu_cmdbufs;
+  // Input delay proxy: from when the frame's first call could be issued (the previous
+  // boundary returned, after the frame latency wait) to the GPU finishing the frame.
+  // Tail: from the frame's boundary to the GPU finishing it.
+  std::vector<double> latency_ms, tail_ms;
+};
+
+// Fixed extra work per frame, so the A/B harness can prove it sees a small,
+// known slowdown. GPU: GROUPS threadgroups of 64 threads, each running two
+// dependent 1024-step multiply-add chains whose result feeds a store the
+// compiler cannot rule out (it compares against a value read from the buffer).
+// CPU: a busy wait on the replay thread before each frame boundary.
+struct Ballast {
+  uint32_t groups = 0;
+  double cpu_us = 0;
+  ID3D11ComputeShader *cs = nullptr;
+  ID3D11Buffer *buffer = nullptr;
+  ID3D11UnorderedAccessView *uav = nullptr;
+
+  bool init(ID3D11Device *device) {
+    if (!groups)
+      return true;
+    static const char kSource[] = R"(
+RWBuffer<float> sink : register(u0);
+[numthreads(64, 1, 1)] void ballast(uint3 id : SV_DispatchThreadID) {
+  float t = sink[0];
+  float a = 1.0 + id.x * 1e-7, b = 0.999, c = 2.0 + id.x * 1e-7, d = 0.998;
+  [loop] for (uint i = 0; i < 1024; i++) {
+    a = a * b + 1e-6;
+    b = b * 0.9999 + 1e-4;
+    c = c * d + 1e-6;
+    d = d * 0.9999 + 1e-4;
+  }
+  if (a + c == t)
+    sink[1 + (id.x & 62)] = a;
+}
+)";
+    typedef HRESULT(WINAPI * PFN_D3DCompile)(LPCVOID, SIZE_T, LPCSTR, const D3D_SHADER_MACRO *, ID3DInclude *,
+                                             LPCSTR, LPCSTR, UINT, UINT, ID3DBlob **, ID3DBlob **);
+    auto compiler = LoadLibraryA("d3dcompiler_47.dll");
+    auto compile = compiler ? (PFN_D3DCompile)GetProcAddress(compiler, "D3DCompile") : nullptr;
+    ID3DBlob *code = nullptr, *errors = nullptr;
+    if (!compile || FAILED(compile(kSource, sizeof kSource - 1, "ballast.hlsl", nullptr, nullptr, "ballast", "cs_5_0",
+                                   0, 0, &code, &errors))) {
+      std::fprintf(stderr, "Cannot compile the GPU ballast shader%s%s\n", errors ? ": " : "",
+                   errors ? (const char *)errors->GetBufferPointer() : "");
+      return false;
+    }
+    HRESULT hr = device->CreateComputeShader(code->GetBufferPointer(), code->GetBufferSize(), nullptr, &cs);
+    code->Release();
+    if (errors)
+      errors->Release();
+    D3D11_BUFFER_DESC bd = {};
+    bd.ByteWidth = 64 * sizeof(float);
+    bd.Usage = D3D11_USAGE_DEFAULT;
+    bd.BindFlags = D3D11_BIND_UNORDERED_ACCESS;
+    float zeros[64] = {};
+    D3D11_SUBRESOURCE_DATA init = {zeros, 0, 0};
+    D3D11_UNORDERED_ACCESS_VIEW_DESC ud = {};
+    ud.Format = DXGI_FORMAT_R32_FLOAT;
+    ud.ViewDimension = D3D11_UAV_DIMENSION_BUFFER;
+    ud.Buffer.NumElements = 64;
+    if (FAILED(hr) || FAILED(device->CreateBuffer(&bd, &init, &buffer)) ||
+        FAILED(device->CreateUnorderedAccessView(buffer, &ud, &uav))) {
+      std::fprintf(stderr, "Cannot create the GPU ballast\n");
+      return false;
+    }
+    groups = std::min<uint32_t>(groups, 65535);
+    return true;
+  }
+
+  // Runs after the frame's last recorded call. Leaves the game's compute state as it was.
+  void frame(ID3D11DeviceContext1 *ctx) {
+    if (groups) {
+      ID3D11ComputeShader *prev_cs = nullptr;
+      ID3D11UnorderedAccessView *prev_uav = nullptr;
+      ctx->CSGetShader(&prev_cs, nullptr, nullptr);
+      ctx->CSGetUnorderedAccessViews(0, 1, &prev_uav);
+      ctx->CSSetShader(cs, nullptr, 0);
+      ctx->CSSetUnorderedAccessViews(0, 1, &uav, nullptr);
+      ctx->Dispatch(groups, 1, 1);
+      ctx->CSSetShader(prev_cs, nullptr, 0);
+      ctx->CSSetUnorderedAccessViews(0, 1, &prev_uav, nullptr);
+      if (prev_cs)
+        prev_cs->Release();
+      if (prev_uav)
+        prev_uav->Release();
+    }
+    if (cpu_us > 0) {
+      double until = now_us() + cpu_us;
+      while (now_us() < until) {
+      }
+    }
+  }
+
+  ~Ballast() {
+    if (uav)
+      uav->Release();
+    if (buffer)
+      buffer->Release();
+    if (cs)
+      cs->Release();
+  }
+};
+
+// Statistical CPU profile of the replay thread and DXMT's named threads: every 4 ms each
+// is suspended, its context read and its stack unwound (Wine unwinds PE code; a thread
+// inside a unix call shows the PE frames that made the call). Rosetta hides the process
+// from Apple's profilers, so this is the way to see where DXMT's CPU time goes.
+struct CpuSampler {
+  std::atomic<bool> stop{false};
+  std::thread worker;
+  DWORD main_tid = 0;
+  std::map<std::pair<DWORD, std::vector<uint64_t>>, uint64_t> stacks;
+  std::map<DWORD, std::string> names;
+
+  void start() {
+    main_tid = GetCurrentThreadId();
+    worker = std::thread([this] { run(); });
+  }
+
+  std::vector<DWORD> targets() {
+    typedef HRESULT(WINAPI * PFN_GetThreadDescription)(HANDLE, PWSTR *);
+    static auto describe = (PFN_GetThreadDescription)GetProcAddress(GetModuleHandleA("kernelbase.dll"),
+                                                                    "GetThreadDescription");
+    std::vector<DWORD> out;
+    HANDLE snap = CreateToolhelp32Snapshot(TH32CS_SNAPTHREAD, 0);
+    THREADENTRY32 te = {sizeof te};
+    for (BOOL ok = Thread32First(snap, &te); ok; ok = Thread32Next(snap, &te)) {
+      if (te.th32OwnerProcessID != GetCurrentProcessId() || te.th32ThreadID == GetCurrentThreadId())
+        continue;
+      std::string name = te.th32ThreadID == main_tid ? "replay-main" : "";
+      if (name.empty() && describe) {
+        HANDLE t = OpenThread(THREAD_QUERY_LIMITED_INFORMATION, FALSE, te.th32ThreadID);
+        PWSTR text = nullptr;
+        if (t && SUCCEEDED(describe(t, &text)) && text) {
+          for (PWSTR c = text; *c; c++)
+            name += char(*c < 128 ? *c : '?');
+          LocalFree(text);
+        }
+        if (t)
+          CloseHandle(t);
+      }
+      if (name == "replay-main" || name.rfind("dxmt", 0) == 0) {
+        names[te.th32ThreadID] = name;
+        out.push_back(te.th32ThreadID);
+      }
+    }
+    CloseHandle(snap);
+    return out;
+  }
+
+  void run() {
+    auto threads = targets();
+    unsigned rounds = 0;
+    while (!stop.load()) {
+      if (++rounds % 250 == 0)
+        threads = targets();
+      for (DWORD tid : threads) {
+        HANDLE t = OpenThread(THREAD_SUSPEND_RESUME | THREAD_GET_CONTEXT | THREAD_QUERY_INFORMATION, FALSE, tid);
+        if (!t)
+          continue;
+        if (SuspendThread(t) != (DWORD)-1) {
+          CONTEXT ctx = {};
+          ctx.ContextFlags = CONTEXT_FULL;
+          std::vector<uint64_t> frames;
+          if (GetThreadContext(t, &ctx)) {
+            for (int depth = 0; depth < 24 && ctx.Rip; depth++) {
+              frames.push_back(ctx.Rip);
+              DWORD64 base = 0;
+              auto entry = RtlLookupFunctionEntry(ctx.Rip, &base, nullptr);
+              if (!entry)
+                break; // leaf or code without unwind data (unix side)
+              PVOID handler_data = nullptr;
+              DWORD64 frame = 0;
+              RtlVirtualUnwind(UNW_FLAG_NHANDLER, base, ctx.Rip, entry, &ctx, &handler_data, &frame, nullptr);
+            }
+          }
+          ResumeThread(t);
+          if (!frames.empty())
+            stacks[{tid, frames}]++;
+        }
+        CloseHandle(t);
+      }
+      Sleep(4);
+    }
+  }
+
+  static std::string where(uint64_t address) {
+    HMODULE module = nullptr;
+    if (!GetModuleHandleExA(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+                            (LPCSTR)address, &module) || !module) {
+      char buf[32];
+      std::snprintf(buf, sizeof buf, "?+0x%llx", (unsigned long long)address);
+      return buf;
+    }
+    char path[MAX_PATH] = {};
+    GetModuleFileNameA(module, path, MAX_PATH);
+    const char *base = std::strrchr(path, '\\');
+    char buf[MAX_PATH + 32];
+    std::snprintf(buf, sizeof buf, "%s+0x%llx", base ? base + 1 : path,
+                  (unsigned long long)(address - (uint64_t)module));
+    return buf;
+  }
+
+  void finish(const std::string &path) {
+    stop = true;
+    if (worker.joinable())
+      worker.join();
+    FILE *f = std::fopen(path.c_str(), "w");
+    if (!f)
+      return;
+    std::map<uint64_t, std::string> resolved;
+    std::fprintf(f, "thread,count,stack\n");
+    for (auto &[key, count] : stacks) {
+      std::string stack;
+      for (auto address : key.second) {
+        auto it = resolved.find(address);
+        if (it == resolved.end())
+          it = resolved.emplace(address, where(address)).first;
+        stack += (stack.empty() ? "" : ";") + it->second;
+      }
+      std::fprintf(f, "%s,%llu,%s\n", names[key.first].c_str(), (unsigned long long)count, stack.c_str());
+    }
+    std::fclose(f);
+  }
+};
+
+double
+process_cpu_ms() {
+  FILETIME created, exited, kernel, user;
+  if (!GetProcessTimes(GetCurrentProcess(), &created, &exited, &kernel, &user))
+    return 0;
+  auto ticks = [](const FILETIME &t) { return (uint64_t(t.dwHighDateTime) << 32) | t.dwLowDateTime; };
+  return (ticks(kernel) + ticks(user)) / 1e4; // 100 ns units
+}
+
+// One pass over the recorded frames (the first frame_limit of them, if nonzero).
+LoopResult
+run_loop(Replayer &rp, Ballast &ballast, bool verify, uint64_t frame_limit) {
+  LoopResult lr;
+  std::vector<uint64_t> gpu_frames;
+  double cpu_start = process_cpu_ms();
+  double loop_start = now_us(), frame_start = loop_start;
+  if (rp.bench)
+    gpu_frames.push_back(rp.bench->CurrentFrame());
+  for (auto &r : rp.stream) {
+    rp.execute(r, true, verify);
+    if (r.op != Op::Present)
+      continue;
+    if (verify)
+      rp.fingerprint_frame();
+    ballast.frame(rp.imm);
+    double submit_end = now_us();
+    if (rp.bench)
+      rp.bench->FrameBoundary();
+    else
+      rp.imm->Flush();
+    double end = now_us();
+    lr.cpu_submit_ms.push_back((submit_end - frame_start) / 1000.0);
+    lr.cpu_frame_ms.push_back((end - frame_start) / 1000.0);
+    frame_start = end;
+    lr.frames++;
+    if (rp.bench)
+      gpu_frames.push_back(rp.bench->CurrentFrame());
+    if (frame_limit && lr.frames >= frame_limit)
+      break;
+  }
+  if (rp.bench)
+    rp.bench->WaitIdle();
+  else
+    rp.imm->Flush();
+  lr.wall_ms = (now_us() - loop_start) / 1000.0;
+  lr.process_cpu_ms = process_cpu_ms() - cpu_start;
+  if (rp.bench) {
+    // The timeline runs from the end of the first frame to the end of the last:
+    // the first frame can include work queued while the loop was idle.
+    uint64_t first_end = 0, last_end = 0;
+    for (size_t i = 0; i + 1 < gpu_frames.size(); i++) {
+      MTL_BENCH_FRAME_TIMING t = {};
+      if (rp.bench->QueryFrameTiming(gpu_frames[i], &t)) {
+        uint64_t first = t.GpuFirstStartNs, last = t.GpuLastEndNs;
+        lr.gpu_busy_ms.push_back(t.GpuBusyNs / 1e6);
+        lr.gpu_active_ms.push_back(t.GpuActiveNs / 1e6);
+        lr.gpu_span_ms.push_back(last > first ? (last - first) / 1e6 : 0);
+        lr.gpu_cmdbufs.push_back(t.CommandBuffers);
+        lr.latency_ms.push_back(t.CpuStartNs && last > t.CpuStartNs ? (last - t.CpuStartNs) / 1e6 : 0);
+        lr.tail_ms.push_back(t.CpuEndNs && last > t.CpuEndNs ? (last - t.CpuEndNs) / 1e6 : 0);
+        if (!first_end)
+          first_end = last;
+        last_end = std::max<uint64_t>(last_end, last);
+      }
+    }
+    lr.gpu_wall_ms = last_end > first_end ? (last_end - first_end) / 1e6 : 0;
+  }
+  rp.release_stream_objects();
+  return lr;
+}
+
+std::string
+json_list(const std::vector<double> &v) {
+  std::string j = "[";
+  char buf[32];
+  for (size_t k = 0; k < v.size(); k++) {
+    std::snprintf(buf, sizeof buf, "%s%.4f", k ? "," : "", v[k]);
+    j += buf;
+  }
+  return j + "]";
+}
+
+// One loop as a single line of JSON.
+std::string
+loop_json(const LoopResult &lr) {
+  char head[512];
+  std::snprintf(head, sizeof head,
+                "{\"frames\": %llu, \"wall_ms\": %.4f, \"fps\": %.4f, \"gpu_wall_ms\": %.4f, \"process_cpu_ms\": %.4f",
+                (unsigned long long)lr.frames, lr.wall_ms, lr.frames * 1000.0 / std::max(lr.wall_ms, 1e-6),
+                lr.gpu_wall_ms, lr.process_cpu_ms);
+  return std::string(head) + ", \"cpu_submit_ms\": " + json_stats(stats(lr.cpu_submit_ms)) +
+         ", \"cpu_frame_ms\": " + json_stats(stats(lr.cpu_frame_ms)) +
+         ", \"gpu_busy_ms\": " + json_stats(stats(lr.gpu_busy_ms)) +
+         ", \"gpu_active_ms\": " + json_stats(stats(lr.gpu_active_ms)) +
+         ", \"gpu_span_ms\": " + json_stats(stats(lr.gpu_span_ms)) +
+         ", \"command_buffers_per_frame\": " + json_stats(stats(lr.gpu_cmdbufs)) +
+         ", \"latency_ms\": " + json_stats(stats(lr.latency_ms)) +
+         ", \"per_frame_latency_ms\": " + json_list(lr.latency_ms) +
+         ", \"per_frame_tail_ms\": " + json_list(lr.tail_ms) +
+         ", \"per_frame_gpu_active_ms\": " + json_list(lr.gpu_active_ms) +
+         ", \"per_frame_gpu_busy_ms\": " + json_list(lr.gpu_busy_ms) +
+         ", \"per_frame_cpu_submit_ms\": " + json_list(lr.cpu_submit_ms) +
+         ", \"per_frame_cpu_frame_ms\": " + json_list(lr.cpu_frame_ms) + "}";
+}
+
+std::string
+hashes_json(const std::vector<uint64_t> &hashes) {
+  std::string j = "[";
+  char buf[24];
+  for (size_t i = 0; i < hashes.size(); i++) {
+    std::snprintf(buf, sizeof buf, "%s\"%016llx\"", i ? "," : "", (unsigned long long)hashes[i]);
+    j += buf;
+  }
+  return j + "]";
+}
+
+std::string
+checkpoints_json(const std::vector<Checkpoint> &checkpoints) {
+  std::string j = "[";
+  for (size_t i = 0; i < checkpoints.size(); i++) {
+    auto &c = checkpoints[i];
+    char buf[320];
+    std::snprintf(buf, sizeof buf,
+                  "%s{\"frame\": %llu, \"compared\": %s, \"exact\": %s, \"differing_pixels\": %llu, "
+                  "\"max_channel_diff\": %u, \"psnr\": %.2f, \"replayed_hash\": \"%016llx\"}",
+                  i ? ", " : "", (unsigned long long)c.frame, c.compared ? "true" : "false",
+                  c.exact ? "true" : "false", (unsigned long long)c.differing_pixels, c.max_channel_diff, c.psnr,
+                  (unsigned long long)c.replayed_hash);
+    j += buf;
+  }
+  return j + "]";
+}
+
+void
+print_loop(const char *label, int index, const LoopResult &lr) {
+  auto cpu = stats(lr.cpu_frame_ms), gpu = stats(lr.gpu_active_ms);
+  std::fprintf(stderr, "%s %d: %llu frames in %.0f ms (%.1f FPS); CPU frame p50 %.3f ms; GPU active mean %.3f ms\n",
+               label, index, (unsigned long long)lr.frames, lr.wall_ms,
+               lr.frames * 1000.0 / std::max(lr.wall_ms, 1e-6), cpu.p50, gpu.mean);
+}
