+ID3D11Device5 *
+RecorderProxyFor(const void *real_device) {
+  if (!g_enabled.load(std::memory_order_relaxed))
+    return nullptr;
+  std::lock_guard<dxmt::mutex> lock(g_proxies_mutex);
+  auto it = g_proxies.find(real_device);
+  return it == g_proxies.end() ? nullptr : it->second;
+}
+
+void
+RecorderWrapNewDevice(MTLD3D11Device *real_device) {
+  auto rec = Recorder::Instance();
+  if (!rec)
+    return;
+  auto proxy = new RecordingDevice(rec, static_cast<ID3D11Device5 *>(real_device));
+  std::lock_guard<dxmt::mutex> lock(g_proxies_mutex);
+  g_proxies[static_cast<ID3D11Device5 *>(real_device)] = proxy;
+  g_enabled.store(true);
+}
+
+void
+RecorderOnPresent(const void *real_device, ID3D11Texture2D *backbuffer, UINT sync_interval, UINT flags) {
+  auto proxy = static_cast<RecordingDevice *>(RecorderProxyFor(real_device));
+  if (proxy)
+    Recorder::Instance()->OnPresent(proxy, backbuffer, sync_interval, flags);
+}
