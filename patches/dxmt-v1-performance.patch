+  std::vector<obj_handle_t> seen;
+  for (auto cmd = (const wmtcmd_base *)((const wmtcmd_base *)&data->cmd_head)->next.ptr; cmd && seen.size() < 4;
+       cmd = (const wmtcmd_base *)cmd->next.ptr) {
+    if (cmd->type != WMTRenderCommandSetPSO)
+      continue;
+    auto pso = ((const wmtcmd_render_setpso *)cmd)->pso;
+    if (std::find(seen.begin(), seen.end(), pso) != seen.end())
