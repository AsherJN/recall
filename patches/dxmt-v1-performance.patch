+#define REC_BEGIN(OP)                                                                                                  \
+  if (!enter(c, Op::OP))                                                                                               \
+    return;                                                                                                            \
+  std::lock_guard<dxmt::recursive_mutex> lock_(mutex_);                                                                \
+  ScopeExit issue_{[&]() {                                                                                             \
+    if (c->immediate())                                                                                                \
+      issue_readback_copies(c);                                                                                        \
+  }};                                                                                                                  \
+  Payload p;
