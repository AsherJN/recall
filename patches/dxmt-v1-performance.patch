+
+void
+Recorder::UpdateSubresource1(RecordingContext *c, ID3D11Resource *dst, UINT sub, const D3D11_BOX *box,
+                             const void *data, UINT row_pitch, UINT depth_pitch, UINT flags) {
+  REC_BEGIN(UpdateSubresource)
+  uint32_t id = ref_resource(dst);
+  auto &info = resources_[id];
+  D3D11_BOX b = box ? *box : D3D11_BOX{};
+  BlobRef ref;
+  uint32_t out_row = 0, out_depth = 0;
+  if (info.dim == D3D11_RESOURCE_DIMENSION_BUFFER) {
+    uint32_t size = box ? box->right - box->left : info.width;
+    ref = blob(data, size);
+    out_row = out_depth = size;
+    census_update_bytes_ += size;
+  } else {
+    uint32_t bytes, bw, bh, row_bytes, rows, depth;
+    if (data && format_block(info.format, bytes, bw, bh) && subresource_layout(info, sub, row_bytes, rows, depth)) {
+      if (box) {
+        row_bytes = (box->right - box->left + bw - 1) / bw * bytes;
+        rows = (box->bottom - box->top + bh - 1) / bh;
+        depth = box->back - box->front;
+      }
+      std::vector<uint8_t> packed(size_t(row_bytes) * rows * depth);
+      auto src = reinterpret_cast<const uint8_t *>(data);
+      for (uint32_t zz = 0; zz < depth; zz++)
+        for (uint32_t yy = 0; yy < rows; yy++)
+          std::memcpy(packed.data() + (size_t(zz) * rows + yy) * row_bytes,
+                      src + size_t(zz) * depth_pitch + size_t(yy) * row_pitch, row_bytes);
+      ref = blob(packed.data(), packed.size());
+      out_row = row_bytes;
+      out_depth = row_bytes * rows;
+      census_update_bytes_ += packed.size();
+    } else {
+      warnings_["UpdateSubresource with unsized format"]++;
+    }
+  }
+  p.put(id).put(sub).put(uint32_t(box ? 1 : 0)).put(b).put(out_row).put(out_depth).put(flags).put(ref);
+  emit(c, Op::UpdateSubresource, p.b);
+}
