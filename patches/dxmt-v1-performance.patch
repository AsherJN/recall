+RecordingContext::FinishCommandList(WINBOOL RestoreDeferredContextState, ID3D11CommandList **ppCommandList) {
+  HRESULT hr = real_->FinishCommandList(RestoreDeferredContextState, ppCommandList);
+  if (SUCCEEDED(hr) && ppCommandList && *ppCommandList)
+    rec_->OnFinishCommandList(this, RestoreDeferredContextState, *ppCommandList);
+  return hr;
+}
