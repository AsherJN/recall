+
+// Off-screen replay benchmarking (dxmt-replay.exe); not for applications. The
+// replayer and d3d11.dll come from the same build; a new GUID marks each change.
+// Times are host-clock nanoseconds (mach_absolute_time, the clock of Metal's GPU times).
+struct MTL_BENCH_FRAME_TIMING {
+  UINT64 GpuFirstStartNs;
+  UINT64 GpuLastEndNs;
+  UINT64 GpuBusyNs;   // sum of command buffer durations
+  UINT64 GpuActiveNs; // overlapping time counted once
+  UINT64 CpuStartNs;  // the previous FrameBoundary returned: the frame's first call could be issued
+  UINT64 CpuEndNs;    // this frame's FrameBoundary was called
+  UINT CommandBuffers;
+};
+
+DEFINE_COM_INTERFACE("1c7a9b37-926d-434a-9842-f6efb629d049", IMTLD3D11Bench)
+    : public IUnknown {
+  // Everything Present does to the command queue, without presenting.
+  virtual void STDMETHODCALLTYPE FrameBoundary() = 0;
+  // The frame the next FrameBoundary closes.
+  virtual UINT64 STDMETHODCALLTYPE CurrentFrame() = 0;
+  // Timing of a finished frame; needs DXMT_BENCH=1. FALSE when unknown.
+  virtual BOOL STDMETHODCALLTYPE QueryFrameTiming(UINT64 Frame, MTL_BENCH_FRAME_TIMING *pTiming) = 0;
+  // Blocks until all submitted work has finished on the GPU.
+  virtual void STDMETHODCALLTYPE WaitIdle() = 0;
+};
