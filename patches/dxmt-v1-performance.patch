+#define REC_SIMPLE(Name, Params, Puts)                                                                                 \
+  void Recorder::Name Params {                                                                                         \
+    REC_BEGIN(Name)                                                                                                    \
+    p Puts;                                                                                                            \
+    emit(c, Op::Name, p.b);                                                                                            \
+  }
+REC_SIMPLE(Draw, (RecordingContext * c, UINT count, UINT start), .put(count).put(start))
+REC_SIMPLE(DrawIndexed, (RecordingContext * c, UINT count, UINT start, INT base), .put(count).put(start).put(base))
+REC_SIMPLE(DrawInstanced, (RecordingContext * c, UINT count, UINT instances, UINT start, UINT start_instance),
+           .put(count).put(instances).put(start).put(start_instance))
+REC_SIMPLE(DrawIndexedInstanced,
+           (RecordingContext * c, UINT count, UINT instances, UINT start, INT base, UINT start_instance),
+           .put(count).put(instances).put(start).put(base).put(start_instance))
+REC_SIMPLE(DrawAuto, (RecordingContext * c), .b.reserve(0))
+REC_SIMPLE(DrawInstancedIndirect, (RecordingContext * c, ID3D11Buffer * b, UINT offset),
+           .put(ref_resource(b)).put(offset))
+REC_SIMPLE(DrawIndexedInstancedIndirect, (RecordingContext * c, ID3D11Buffer * b, UINT offset),
+           .put(ref_resource(b)).put(offset))
+REC_SIMPLE(Dispatch, (RecordingContext * c, UINT x, UINT y, UINT z), .put(x).put(y).put(z))
+REC_SIMPLE(DispatchIndirect, (RecordingContext * c, ID3D11Buffer * b, UINT offset), .put(ref_resource(b)).put(offset))
+REC_SIMPLE(Begin, (RecordingContext * c, ID3D11Asynchronous * async), .put(ref_async(async)))
+REC_SIMPLE(End, (RecordingContext * c, ID3D11Asynchronous * async), .put(ref_async(async)))
+REC_SIMPLE(SetPredication, (RecordingContext * c, ID3D11Predicate * pred, WINBOOL value),
+           .put(ref_async(pred)).put(uint32_t(value)))
+REC_SIMPLE(CopyResource, (RecordingContext * c, ID3D11Resource * dst, ID3D11Resource * src),
+           .put(ref_resource(dst)).put(ref_resource(src)))
+REC_SIMPLE(CopyStructureCount, (RecordingContext * c, ID3D11Buffer * dst, UINT offset, ID3D11UnorderedAccessView * src),
+           .put(ref_resource(dst)).put(offset).put(ref_view(src, Op::CreateUAV)))
+REC_SIMPLE(GenerateMips, (RecordingContext * c, ID3D11ShaderResourceView * srv), .put(ref_view(srv, Op::CreateSRV)))
+REC_SIMPLE(SetResourceMinLOD, (RecordingContext * c, ID3D11Resource * res, FLOAT lod),
+           .put(ref_resource(res)).put(lod))
+REC_SIMPLE(ResolveSubresource,
+           (RecordingContext * c, ID3D11Resource * dst, UINT dsub, ID3D11Resource * src, UINT ssub, DXGI_FORMAT format),
+           .put(ref_resource(dst)).put(dsub).put(ref_resource(src)).put(ssub).put(uint32_t(format)))
+REC_SIMPLE(DiscardResource, (RecordingContext * c, ID3D11Resource * res), .put(ref_resource(res)))
+REC_SIMPLE(ClearState, (RecordingContext * c), .b.reserve(0))
+REC_SIMPLE(Flush, (RecordingContext * c), .b.reserve(0))
+#undef REC_SIMPLE
