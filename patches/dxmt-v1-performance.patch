+  void pad_to(size_t alignment);
+  void close();
+  ~RecordFile() { close(); }
+
+private:
+  void writer();
+  void *handle_ = nullptr;
+  uint64_t size_ = 0;
+  std::vector<uint8_t> pending_;
+  std::deque<std::vector<uint8_t>> queue_;
+  size_t queued_bytes_ = 0;
+  dxmt::mutex mutex_;
+  dxmt::condition_variable wake_, drained_;
+  dxmt::thread thread_;
+  bool stop_ = false;
+};
