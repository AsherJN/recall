+} // namespace
+
+int
+main(int argc, char **argv) {
+  Options opt;
+  for (int i = 1; i < argc; i++) {
+    std::string a = argv[i];
+    auto next = [&]() { return i + 1 < argc ? std::string(argv[++i]) : std::string(); };
+    if (a == "--loops")
+      opt.loops = std::max(1, std::atoi(next().c_str()));
+    else if (a == "--warmup")
+      opt.warmup = std::max(0, std::atoi(next().c_str()));
+    else if (a == "--frames")
+      opt.max_frames = std::strtoull(next().c_str(), nullptr, 10);
+    else if (a == "--verify")
+      opt.verify = true;
+    else if (a == "--dump")
+      opt.dump = next();
+    else if (a == "--json")
+      opt.json = next();
+    else if (a == "--no-bench")
+      opt.bench = false;
+    else if (a == "--serve")
+      opt.serve = true;
+    else if (a == "--ballast-gpu")
+      opt.ballast_groups = uint32_t(std::strtoul(next().c_str(), nullptr, 10));
+    else if (a == "--ballast-cpu-us")
+      opt.ballast_cpu_us = std::max(0.0, std::atof(next().c_str()));
+    else if (a == "--sample-cpu")
+      opt.sample_cpu = next();
+    else if (a == "--pause-after-prologue")
+      opt.pause_after_prologue_ms = std::max(0, std::atoi(next().c_str()));
+    else if (opt.dir.empty())
+      opt.dir = a;
+    else {
+      std::fprintf(stderr, "Unknown argument %s\n", a.c_str());
+      return 2;
+    }
+  }
+  if (opt.dir.empty()) {
+    std::fprintf(stderr, "usage: dxmt-replay <recording dir> [--loops N] [--warmup N] [--frames N] [--verify] "
+                         "[--dump DIR] [--json FILE] [--no-bench] [--serve] [--ballast-gpu GROUPS] "
+                         "[--ballast-cpu-us US]\n");
+    return 2;
+  }
+  if (!opt.dump.empty())
+    CreateDirectoryA(opt.dump.c_str(), nullptr);
+
+  Replayer rp;
+  rp.opt = opt;
+  if (!rp.load() || !rp.create_device())
+    return 1;
+  Ballast ballast;
+  ballast.groups = opt.ballast_groups;
+  ballast.cpu_us = opt.ballast_cpu_us;
+  if (!ballast.init(rp.device))
+    return 1;
+
+  double t0 = now_us();
+  for (auto &r : rp.prologue)
+    rp.execute(r, false, false);
+  rp.imm->Flush();
+  double prologue_ms = (now_us() - t0) / 1000.0;
+  // Models a game that creates its shaders well before it draws with them (Overwatch
+  // creates them many frames ahead), so work started at creation has time to finish.
+  if (opt.pause_after_prologue_ms)
+    Sleep(opt.pause_after_prologue_ms);
+  uint64_t stream_frames = 0;
+  for (auto &r : rp.stream)
+    stream_frames += r.op == Op::Present;
+  std::fprintf(stderr, "Recording: %zu prologue records, %zu stream records, %llu frames; prologue replayed in %.0f ms%s\n",
+               rp.prologue.size(), rp.stream.size(), (unsigned long long)stream_frames, prologue_ms,
+               rp.bench ? "" : " (no DXMT bench interface: flush per frame, no GPU time)");
+  if (ballast.groups || ballast.cpu_us > 0)
+    std::fprintf(stderr, "Ballast per frame: %u GPU threadgroups, %.1f us CPU\n", ballast.groups, ballast.cpu_us);
+
+  std::vector<LoopResult> results;
+  CpuSampler sampler;
+  int total = opt.warmup + (opt.serve ? 0 : opt.loops);
+  for (int loop = 0; loop < total; loop++) {
+    bool timed = loop >= opt.warmup;
+    if (loop == opt.warmup && !opt.sample_cpu.empty() && !opt.serve)
+      sampler.start();
+    auto lr = run_loop(rp, ballast, opt.verify && loop == 0, opt.max_frames);
+    print_loop(timed ? "loop" : "warmup", timed ? loop - opt.warmup + 1 : loop + 1, lr);
+    if (timed)
+      results.push_back(std::move(lr));
+  }
+
+  if (opt.serve) {
+    std::printf("@@READY {\"prologue_ms\": %.1f, \"frames\": %llu, \"ballast_groups\": %u, \"ballast_cpu_us\": %.1f, "
+                "\"checkpoints\": %s, \"frame_hashes\": %s}\n",
+                prologue_ms, (unsigned long long)stream_frames, ballast.groups, ballast.cpu_us,
+                checkpoints_json(rp.checkpoints).c_str(), hashes_json(rp.frame_hashes).c_str());
+    std::fflush(stdout);
+    char line[256];
+    int served = 0;
+    while (std::fgets(line, sizeof line, stdin)) {
+      if (!std::strncmp(line, "quit", 4))
+        break;
+      if (!std::strncmp(line, "warm ", 5)) {
+        run_loop(rp, ballast, false, std::max<uint64_t>(1, std::strtoull(line + 5, nullptr, 10)));
+        std::printf("@@WARM {}\n");
+        std::fflush(stdout);
+        continue;
+      }
+      if (std::strncmp(line, "loop", 4))
+        continue;
+      auto lr = run_loop(rp, ballast, false, opt.max_frames);
+      print_loop("served", ++served, lr);
+      std::printf("@@LOOP %s\n", loop_json(lr).c_str());
+      std::fflush(stdout);
+      results.push_back(std::move(lr));
+    }
+  }
+
+  if (!opt.sample_cpu.empty() && !opt.serve)
+    sampler.finish(opt.sample_cpu);
+
+  uint64_t exact = 0, compared = 0;
+  for (auto &c : rp.checkpoints) {
+    compared += c.compared;
+    exact += c.exact;
+    std::fprintf(stderr, "checkpoint frame %llu: %s, %llu differing pixels, max channel diff %u, PSNR %.1f dB\n",
+                 (unsigned long long)c.frame, !c.compared ? "not compared" : c.exact ? "EXACT" : "differs",
+                 (unsigned long long)c.differing_pixels, c.max_channel_diff, c.psnr);
+  }
+  for (auto &[text, count] : rp.problems)
+    std::fprintf(stderr, "problem: %s (%llu)\n", text.c_str(), (unsigned long long)count);
+
+  if (!opt.json.empty()) {
+    std::string j = "{\n  \"recording\": \"";
+    for (char ch : opt.dir)
+      j += ch == '\\' ? std::string("\\\\") : std::string(1, ch);
+    char buf[256];
+    std::snprintf(buf, sizeof buf, ",\n  \"ballast_groups\": %u, \"ballast_cpu_us\": %.1f", ballast.groups,
+                  ballast.cpu_us);
+    j += "\",\n  \"bench_interface\": " + std::string(rp.bench ? "true" : "false") +
+         ",\n  \"prologue_ms\": " + std::to_string(prologue_ms) + buf + ",\n  \"loops\": [\n";
+    for (size_t i = 0; i < results.size(); i++)
+      j += "    " + loop_json(results[i]) + (i + 1 < results.size() ? ",\n" : "\n");
+    j += "  ],\n  \"checkpoints\": " + checkpoints_json(rp.checkpoints);
+    j += ",\n  \"frame_hashes\": " + hashes_json(rp.frame_hashes);
+    j += ",\n  \"checkpoints_exact\": " + std::to_string(exact) + ",\n  \"checkpoints_compared\": " +
+         std::to_string(compared) + ",\n  \"map_reads_still_drawing\": " + std::to_string(rp.reads_still_drawing) +
+         ",\n  \"problems\": {";
+    bool first = true;
+    for (auto &[text, count] : rp.problems) {
+      j += (first ? "\"" : ", \"") + text + "\": " + std::to_string(count);
+      first = false;
+    }
+    j += "}\n}\n";
+    FILE *f = std::fopen(opt.json.c_str(), "wb");
+    if (f) {
+      std::fwrite(j.data(), 1, j.size(), f);
+      std::fclose(f);
+    }
+  }
+  return opt.verify && compared && exact != compared ? 3 : 0;
+}
diff --git a/src/replay/selftest.cpp b/src/replay/selftest.cpp
new file mode 100644
index 0000000..d869407
--- /dev/null
+++ b/src/replay/selftest.cpp
@@ -0,0 +1,432 @@
+// dxmt-replay-selftest: a small deterministic D3D11 workload for proving the
+// recorder and replayer. Every frame depends on the previous ones (a history
+// texture blended across frames, a compute pass, a ring of instance data), so a
+// replay only matches the live frames if the recording captured the state at
+// its start. Content depends only on the frame index.
+//
+//   dxmt-replay-selftest [frames]   (default 40)
+//
+// Run it with DXMT_RECORD_DIR, DXMT_RECORD_START_FRAME and DXMT_RECORD_FRAMES.
+
+#include "d3d11_4.h"
+#include "d3dcompiler.h"
+#include <windows.h>
+#include <cmath>
+#include <cstdio>
+#include <cstring>
+#include <vector>
+
+namespace {
+
+const char *kShaders = R"(
+cbuffer PerDraw : register(b0) { float4 offset_scale; float4 tint; float frame; float3 pad; };
+Texture2D tex0 : register(t0);
+Texture2D tex1 : register(t1);
+Buffer<float> bars : register(t2);
+Texture2D copy_tex : register(t3);
+SamplerState samp : register(s0);
+
+struct VSIn { float2 pos : POSITION; float2 uv : TEXCOORD0; float4 inst : INSTANCE; };
+struct VSOut { float4 pos : SV_Position; float2 uv : TEXCOORD0; float4 color : COLOR0; };
+VSOut vs_scene(VSIn i) {
+  VSOut o;
+  float2 p = i.pos * offset_scale.zw + offset_scale.xy + i.inst.xy;
+  o.pos = float4(p, 0.5 + 0.1 * i.inst.z, 1);
+  o.uv = i.uv;
+  o.color = tint * i.inst.w;
+  return o;
+}
+float4 ps_scene(VSOut i) : SV_Target {
+  return tex0.Sample(samp, i.uv) * 0.6 + tex1.Sample(samp, i.uv * 2) * 0.4 * i.color + i.color * 0.1;
+}
+
+struct FSOut { float4 pos : SV_Position; float2 uv : TEXCOORD0; };
+FSOut vs_full(uint id : SV_VertexID) {
+  FSOut o;
+  float2 uv = float2((id << 1) & 2, id & 2);
+  o.pos = float4(uv * float2(2, -2) + float2(-1, 1), 0, 1);
+  o.uv = uv;
+  return o;
+}
+float4 ps_history(FSOut i) : SV_Target {
+  return lerp(tex0.Sample(samp, i.uv), tex1.Sample(samp, i.uv), 0.25);
+}
+float4 ps_final(FSOut i) : SV_Target {
+  float4 c = tex0.SampleLevel(samp, i.uv, 1.0 + 2.0 * i.uv.x);
+  uint index = min(63u, (uint)(i.uv.x * 64.0));
+  if (i.uv.y > 1.0 - bars[index] * 0.3)
+    c.rgb = float3(1.0 - c.r, c.g, 0.5);
+  c += copy_tex.Sample(samp, i.uv * 3.0) * 0.2;
+  return float4(c.rgb, 1.0);
+}
+
+cbuffer CSParams : register(b0) { float frame_cs; float3 pad_cs; };
+RWBuffer<float> out_bars : register(u0);
+[numthreads(64, 1, 1)] void cs_bars(uint3 id : SV_DispatchThreadID) {
+  out_bars[id.x] = frac(sin(id.x * 12.9898 + frame_cs * 0.1) * 43758.5453);
+}
+)";
+
+typedef HRESULT(WINAPI *PFN_D3DCompile)(LPCVOID, SIZE_T, LPCSTR, const D3D_SHADER_MACRO *, ID3DInclude *, LPCSTR,
+                                        LPCSTR, UINT, UINT, ID3DBlob **, ID3DBlob **);
+
+PFN_D3DCompile compile_fn;
+
+ID3DBlob *
+compile(const char *entry, const char *target) {
+  ID3DBlob *code = nullptr, *errors = nullptr;
+  HRESULT hr = compile_fn(kShaders, std::strlen(kShaders), "selftest.hlsl", nullptr, nullptr, entry, target, 0, 0,
+                          &code, &errors);
+  if (FAILED(hr)) {
+    std::fprintf(stderr, "compile %s failed: %s\n", entry, errors ? (const char *)errors->GetBufferPointer() : "?");
+    std::exit(1);
+  }
+  if (errors)
+    errors->Release();
+  return code;
+}
+
+void
+check(HRESULT hr, const char *what) {
+  if (FAILED(hr)) {
+    std::fprintf(stderr, "%s failed: 0x%08lx\n", what, hr);
+    std::exit(1);
+  }
+}
+
+struct PerDraw {
+  float offset_scale[4];
+  float tint[4];
+  float frame;
+  float pad[3];
+};
+
+template <typename T>
+void
+write_cb(ID3D11DeviceContext *ctx, ID3D11Buffer *cb, const T &value) {
+  D3D11_MAPPED_SUBRESOURCE m;
+  check(ctx->Map(cb, 0, D3D11_MAP_WRITE_DISCARD, 0, &m), "Map(DISCARD)");
+  std::memcpy(m.pData, &value, sizeof value);
+  ctx->Unmap(cb, 0);
+}
+
+// One BC1 block: two 5:6:5 endpoints and 2-bit indices.
+void
+bc1_block(uint8_t *out, uint16_t c0, uint16_t c1, uint32_t indices) {
+  std::memcpy(out, &c0, 2);
+  std::memcpy(out + 2, &c1, 2);
+  std::memcpy(out + 4, &indices, 4);
+}
+
+} // namespace
+
+int
+main(int argc, char **argv) {
+  int frames = argc > 1 ? std::atoi(argv[1]) : 40;
+  auto compiler = LoadLibraryA("d3dcompiler_47.dll");
+  compile_fn = compiler ? (PFN_D3DCompile)GetProcAddress(compiler, "D3DCompile") : nullptr;
+  if (!compile_fn) {
+    std::fprintf(stderr, "d3dcompiler_47.dll is missing\n");
+    return 1;
+  }
+
+  WNDCLASSEXA wc = {sizeof wc};
+  wc.lpfnWndProc = DefWindowProcA;
+  wc.hInstance = GetModuleHandleA(nullptr);
+  wc.lpszClassName = "dxmt-replay-selftest";
+  RegisterClassExA(&wc);
+  // Never shown: rendering and presentation work without the window on screen.
+  HWND hwnd = CreateWindowExA(0, wc.lpszClassName, "dxmt-replay selftest", WS_OVERLAPPEDWINDOW, 0, 0, 320, 240,
+                              nullptr, nullptr, wc.hInstance, nullptr);
+
+  auto d3d11 = LoadLibraryA("d3d11.dll");
+  auto create = (PFN_D3D11_CREATE_DEVICE_AND_SWAP_CHAIN)GetProcAddress(d3d11, "D3D11CreateDeviceAndSwapChain");
+  DXGI_SWAP_CHAIN_DESC scd = {};
+  scd.BufferDesc = {320, 240, {60, 1}, DXGI_FORMAT_R8G8B8A8_UNORM};
+  scd.SampleDesc = {1, 0};
+  scd.BufferUsage = DXGI_USAGE_RENDER_TARGET_OUTPUT;
+  scd.BufferCount = 2;
+  scd.OutputWindow = hwnd;
+  scd.Windowed = TRUE;
+  scd.SwapEffect = DXGI_SWAP_EFFECT_FLIP_DISCARD;
+  D3D_FEATURE_LEVEL level = D3D_FEATURE_LEVEL_11_1;
+  IDXGISwapChain *swapchain = nullptr;
+  ID3D11Device *device = nullptr;
+  ID3D11DeviceContext *ctx = nullptr;
+  check(create(nullptr, D3D_DRIVER_TYPE_HARDWARE, nullptr, 0, &level, 1, D3D11_SDK_VERSION, &scd, &swapchain, &device,
+               nullptr, &ctx),
+        "D3D11CreateDeviceAndSwapChain");
+
+  // Shaders and input layout.
+  auto vs_scene_code = compile("vs_scene", "vs_5_0");
+  ID3D11VertexShader *vs_scene, *vs_full;
+  ID3D11PixelShader *ps_scene, *ps_history, *ps_final;
+  ID3D11ComputeShader *cs_bars;
+  check(device->CreateVertexShader(vs_scene_code->GetBufferPointer(), vs_scene_code->GetBufferSize(), nullptr,
+                                   &vs_scene), "vs_scene");
+  auto code = compile("vs_full", "vs_5_0");
+  check(device->CreateVertexShader(code->GetBufferPointer(), code->GetBufferSize(), nullptr, &vs_full), "vs_full");
+  code = compile("ps_scene", "ps_5_0");
+  check(device->CreatePixelShader(code->GetBufferPointer(), code->GetBufferSize(), nullptr, &ps_scene), "ps_scene");
+  code = compile("ps_history", "ps_5_0");
+  check(device->CreatePixelShader(code->GetBufferPointer(), code->GetBufferSize(), nullptr, &ps_history), "ps_history");
+  code = compile("ps_final", "ps_5_0");
+  check(device->CreatePixelShader(code->GetBufferPointer(), code->GetBufferSize(), nullptr, &ps_final), "ps_final");
+  code = compile("cs_bars", "cs_5_0");
+  check(device->CreateComputeShader(code->GetBufferPointer(), code->GetBufferSize(), nullptr, &cs_bars), "cs_bars");
+  D3D11_INPUT_ELEMENT_DESC elements[] = {
+      {"POSITION", 0, DXGI_FORMAT_R32G32_FLOAT, 0, 0, D3D11_INPUT_PER_VERTEX_DATA, 0},
+      {"TEXCOORD", 0, DXGI_FORMAT_R32G32_FLOAT, 0, 8, D3D11_INPUT_PER_VERTEX_DATA, 0},
+      {"INSTANCE", 0, DXGI_FORMAT_R32G32B32A32_FLOAT, 1, 0, D3D11_INPUT_PER_INSTANCE_DATA, 1},
+  };
+  ID3D11InputLayout *layout;
+  check(device->CreateInputLayout(elements, 3, vs_scene_code->GetBufferPointer(), vs_scene_code->GetBufferSize(),
+                                  &layout), "CreateInputLayout");
+
+  // Buffers.
+  float quad[] = {-1, -1, 0, 1, -1, 1, 0, 0, 1, 1, 1, 0, 1, -1, 1, 1};
+  uint16_t indices[] = {0, 1, 2, 0, 2, 3};
+  ID3D11Buffer *vb, *ib, *instances, *cb, *cs_cb, *bars, *args;
+  D3D11_BUFFER_DESC bd = {sizeof quad, D3D11_USAGE_IMMUTABLE, D3D11_BIND_VERTEX_BUFFER};
+  D3D11_SUBRESOURCE_DATA init = {quad};
+  check(device->CreateBuffer(&bd, &init, &vb), "vb");
+  bd = {sizeof indices, D3D11_USAGE_DEFAULT, D3D11_BIND_INDEX_BUFFER};
+  check(device->CreateBuffer(&bd, nullptr, &ib), "ib");
+  ctx->UpdateSubresource(ib, 0, nullptr, indices, 0, 0);
+  bd = {256 * 16, D3D11_USAGE_DYNAMIC, D3D11_BIND_VERTEX_BUFFER, D3D11_CPU_ACCESS_WRITE};
+  check(device->CreateBuffer(&bd, nullptr, &instances), "instances");
+  bd = {sizeof(PerDraw), D3D11_USAGE_DYNAMIC, D3D11_BIND_CONSTANT_BUFFER, D3D11_CPU_ACCESS_WRITE};
+  check(device->CreateBuffer(&bd, nullptr, &cb), "cb");
+  check(device->CreateBuffer(&bd, nullptr, &cs_cb), "cs_cb");
+  bd = {64 * 4, D3D11_USAGE_DEFAULT, D3D11_BIND_UNORDERED_ACCESS | D3D11_BIND_SHADER_RESOURCE};
+  check(device->CreateBuffer(&bd, nullptr, &bars), "bars");
+  UINT args_data[5] = {6, 2, 0, 0, 0};
+  bd = {sizeof args_data, D3D11_USAGE_DEFAULT, 0, 0, D3D11_RESOURCE_MISC_DRAWINDIRECT_ARGS};
+  init = {args_data};
+  check(device->CreateBuffer(&bd, &init, &args), "args");
+  ID3D11ShaderResourceView *bars_srv;
+  ID3D11UnorderedAccessView *bars_uav;
+  D3D11_SHADER_RESOURCE_VIEW_DESC bars_srv_desc = {DXGI_FORMAT_R32_FLOAT, D3D11_SRV_DIMENSION_BUFFER};
+  bars_srv_desc.Buffer.NumElements = 64;
+  D3D11_UNORDERED_ACCESS_VIEW_DESC bars_uav_desc = {DXGI_FORMAT_R32_FLOAT, D3D11_UAV_DIMENSION_BUFFER};
+  bars_uav_desc.Buffer.NumElements = 64;
+  check(device->CreateShaderResourceView(bars, &bars_srv_desc, &bars_srv), "bars srv");
+  check(device->CreateUnorderedAccessView(bars, &bars_uav_desc, &bars_uav), "bars uav");
+
+  // Textures: mipmapped RGBA, compressed BC1, render targets, history ping-pong.
+  std::vector<uint32_t> texels(64 * 64);
+  std::vector<D3D11_SUBRESOURCE_DATA> mips;
+  std::vector<std::vector<uint32_t>> mip_data;
+  for (uint32_t level = 0, size = 64; size; level++, size >>= 1) {
+    mip_data.emplace_back(size * size);
+    for (uint32_t y = 0; y < size; y++)
+      for (uint32_t x = 0; x < size; x++)
+        mip_data.back()[y * size + x] = 0xff000000u | (((x * 4) ^ (y * 4)) & 0xff) | ((level * 40) << 8) |
+                                        (((x + y) * 3 & 0xff) << 16);
+  }
+  for (uint32_t level = 0, size = 64; size; level++, size >>= 1)
+    mips.push_back({mip_data[level].data(), size * 4, 0});
+  D3D11_TEXTURE2D_DESC td = {64, 64, 7, 1, DXGI_FORMAT_R8G8B8A8_UNORM, {1, 0}, D3D11_USAGE_DEFAULT,
+                             D3D11_BIND_SHADER_RESOURCE};
+  ID3D11Texture2D *tex0, *tex1, *scene, *depth, *history[2], *copy, *staging;
+  check(device->CreateTexture2D(&td, mips.data(), &tex0), "tex0");
+  std::vector<uint8_t> bc1(16 * 16 * 8);
+  for (uint32_t b = 0; b < 16 * 16; b++)
+    bc1_block(&bc1[b * 8], uint16_t(0xf800 | b), uint16_t(0x001f | (b << 5)), 0x1b1b1b1bu ^ (b * 0x01010101u));
+  td = {64, 64, 1, 1, DXGI_FORMAT_BC1_UNORM, {1, 0}, D3D11_USAGE_IMMUTABLE, D3D11_BIND_SHADER_RESOURCE};
+  init = {bc1.data(), 16 * 8, 0};
+  check(device->CreateTexture2D(&td, &init, &tex1), "tex1 (BC1)");
+  td = {128, 128, 1, 1, DXGI_FORMAT_R8G8B8A8_UNORM, {1, 0}, D3D11_USAGE_DEFAULT,
+        D3D11_BIND_RENDER_TARGET | D3D11_BIND_SHADER_RESOURCE};
+  check(device->CreateTexture2D(&td, nullptr, &scene), "scene");
+  td.MipLevels = 8;
+  td.MiscFlags = D3D11_RESOURCE_MISC_GENERATE_MIPS;
+  check(device->CreateTexture2D(&td, nullptr, &history[0]), "history0");
+  check(device->CreateTexture2D(&td, nullptr, &history[1]), "history1");
+  td = {128, 128, 1, 1, DXGI_FORMAT_D32_FLOAT, {1, 0}, D3D11_USAGE_DEFAULT, D3D11_BIND_DEPTH_STENCIL};
+  check(device->CreateTexture2D(&td, nullptr, &depth), "depth");
+  td = {64, 64, 1, 1, DXGI_FORMAT_R8G8B8A8_UNORM, {1, 0}, D3D11_USAGE_DEFAULT, D3D11_BIND_SHADER_RESOURCE};
+  check(device->CreateTexture2D(&td, nullptr, &copy), "copy");
+  td = {128, 128, 1, 1, DXGI_FORMAT_R8G8B8A8_UNORM, {1, 0}, D3D11_USAGE_STAGING, 0, D3D11_CPU_ACCESS_READ};
+  check(device->CreateTexture2D(&td, nullptr, &staging), "staging");
+
+  ID3D11ShaderResourceView *tex0_srv, *tex1_srv, *scene_srv, *history_srv[2], *copy_srv;
+  ID3D11RenderTargetView *scene_rtv, *history_rtv[2], *back_rtv;
+  ID3D11DepthStencilView *dsv;
+  check(device->CreateShaderResourceView(tex0, nullptr, &tex0_srv), "tex0 srv");
+  check(device->CreateShaderResourceView(tex1, nullptr, &tex1_srv), "tex1 srv");
+  check(device->CreateShaderResourceView(scene, nullptr, &scene_srv), "scene srv");
+  check(device->CreateShaderResourceView(copy, nullptr, &copy_srv), "copy srv");
+  check(device->CreateRenderTargetView(scene, nullptr, &scene_rtv), "scene rtv");
+  for (int i = 0; i < 2; i++) {
+    check(device->CreateShaderResourceView(history[i], nullptr, &history_srv[i]), "history srv");
+    check(device->CreateRenderTargetView(history[i], nullptr, &history_rtv[i]), "history rtv");
+  }
+  check(device->CreateDepthStencilView(depth, nullptr, &dsv), "dsv");
+  ID3D11Texture2D *back;
+  check(swapchain->GetBuffer(0, IID_PPV_ARGS(&back)), "GetBuffer");
+  check(device->CreateRenderTargetView(back, nullptr, &back_rtv), "back rtv");
+
+  // States.
+  D3D11_SAMPLER_DESC sd = {D3D11_FILTER_MIN_MAG_MIP_LINEAR, D3D11_TEXTURE_ADDRESS_WRAP, D3D11_TEXTURE_ADDRESS_WRAP,
+                           D3D11_TEXTURE_ADDRESS_WRAP, 0, 1, D3D11_COMPARISON_NEVER, {0, 0, 0, 0}, 0, D3D11_FLOAT32_MAX};
+  ID3D11SamplerState *sampler;
+  check(device->CreateSamplerState(&sd, &sampler), "sampler");
+  D3D11_BLEND_DESC blend = {};
+  blend.RenderTarget[0] = {TRUE, D3D11_BLEND_SRC_ALPHA, D3D11_BLEND_INV_SRC_ALPHA, D3D11_BLEND_OP_ADD,
+                           D3D11_BLEND_ONE, D3D11_BLEND_ZERO, D3D11_BLEND_OP_ADD, D3D11_COLOR_WRITE_ENABLE_ALL};
+  ID3D11BlendState *alpha;
+  check(device->CreateBlendState(&blend, &alpha), "blend");
+  D3D11_DEPTH_STENCIL_DESC dsd = {TRUE, D3D11_DEPTH_WRITE_MASK_ALL, D3D11_COMPARISON_LESS_EQUAL};
+  ID3D11DepthStencilState *depth_state;
+  check(device->CreateDepthStencilState(&dsd, &depth_state), "depth state");
+  D3D11_RASTERIZER_DESC rsd = {D3D11_FILL_SOLID, D3D11_CULL_NONE};
+  rsd.DepthClipEnable = TRUE;
+  ID3D11RasterizerState *raster;
+  check(device->CreateRasterizerState(&rsd, &raster), "raster");
+  D3D11_QUERY_DESC qd = {D3D11_QUERY_OCCLUSION};
+  ID3D11Query *occlusion;
+  check(device->CreateQuery(&qd, &occlusion), "query");
+  ID3D11DeviceContext *deferred;
+  check(device->CreateDeferredContext(0, &deferred), "deferred context");
+  ID3D11Buffer *deferred_cb;
+  bd = {sizeof(PerDraw), D3D11_USAGE_DYNAMIC, D3D11_BIND_CONSTANT_BUFFER, D3D11_CPU_ACCESS_WRITE};
+  check(device->CreateBuffer(&bd, nullptr, &deferred_cb), "deferred cb");
+
+  D3D11_VIEWPORT vp128 = {0, 0, 128, 128, 0, 1}, vp_back = {0, 0, 320, 240, 0, 1};
+  uint32_t ring = 0;
+  for (int f = 0; f < frames; f++) {
+    MSG msg;
+    while (PeekMessageA(&msg, nullptr, 0, 0, PM_REMOVE))
+      DispatchMessageA(&msg);
+    int cur = f & 1, prev = cur ^ 1;
+
+    // Compute: bars from the frame index.
+    float cs_params[4] = {float(f), 0, 0, 0};
+    write_cb(ctx, cs_cb, cs_params);
+    ctx->CSSetShader(cs_bars, nullptr, 0);
+    ctx->CSSetConstantBuffers(0, 1, &cs_cb);
+    ctx->CSSetUnorderedAccessViews(0, 1, &bars_uav, nullptr);
+    ctx->Dispatch(1, 1, 1);
+    ID3D11UnorderedAccessView *no_uav = nullptr;
+    ctx->CSSetUnorderedAccessViews(0, 1, &no_uav, nullptr);
+
+    // Scene pass.
+    float clear[4] = {0.1f + 0.01f * (f % 20), 0.2f, 0.3f, 1};
+    ctx->OMSetRenderTargets(1, &scene_rtv, dsv);
+    ctx->RSSetViewports(1, &vp128);
+    ctx->RSSetState(raster);
+    ctx->OMSetDepthStencilState(depth_state, 0);
+    ctx->ClearRenderTargetView(scene_rtv, clear);
+    ctx->ClearDepthStencilView(dsv, D3D11_CLEAR_DEPTH, 1.0f, 0);
+    ID3D11Buffer *vbs[2] = {vb, instances};
+    UINT strides[2] = {16, 16}, offsets[2] = {0, 0};
+    ctx->IASetInputLayout(layout);
+    ctx->IASetVertexBuffers(0, 2, vbs, strides, offsets);
+    ctx->IASetIndexBuffer(ib, DXGI_FORMAT_R16_UINT, 0);
+    ctx->IASetPrimitiveTopology(D3D11_PRIMITIVE_TOPOLOGY_TRIANGLELIST);
+    ctx->VSSetShader(vs_scene, nullptr, 0);
+    ctx->PSSetShader(ps_scene, nullptr, 0);
+    ID3D11ShaderResourceView *scene_srvs[2] = {tex0_srv, tex1_srv};
+    ctx->PSSetShaderResources(0, 2, scene_srvs);
+    ctx->PSSetSamplers(0, 1, &sampler);
+    ctx->VSSetConstantBuffers(0, 1, &cb);
+    ctx->PSSetConstantBuffers(0, 1, &cb);
+
+    // Instance ring: append 8 instances per frame, discard on wrap.
+    D3D11_MAPPED_SUBRESOURCE m;
+    bool wrap = ring + 8 > 256;
+    if (wrap)
+      ring = 0;
+    check(ctx->Map(instances, 0, wrap || f == 0 ? D3D11_MAP_WRITE_DISCARD : D3D11_MAP_WRITE_NO_OVERWRITE, 0, &m),
+          "Map(instances)");
+    auto inst = reinterpret_cast<float *>(m.pData) + ring * 4;
+    for (int i = 0; i < 8; i++) {
+      inst[i * 4 + 0] = 0.2f * std::sin(0.3f * f + i);
+      inst[i * 4 + 1] = 0.2f * std::cos(0.2f * f + i);
+      inst[i * 4 + 2] = 0.1f * i;
+      inst[i * 4 + 3] = 0.5f + 0.05f * i;
+    }
+    ctx->Unmap(instances, 0);
+    for (int d = 0; d < 4; d++) {
+      PerDraw pd = {{-0.5f + 0.3f * d, -0.4f + 0.02f * (f % 30), 0.25f, 0.25f},
+                    {1.0f - 0.2f * d, 0.3f + 0.1f * d, 0.5f, 1}, float(f), {}};
+      write_cb(ctx, cb, pd);
+      if (d == 3)
+        ctx->OMSetBlendState(alpha, nullptr, 0xffffffff);
+      ctx->DrawIndexedInstanced(6, 8, 0, 0, ring);
+    }
+    ctx->OMSetBlendState(nullptr, nullptr, 0xffffffff);
+    ring += 8;
+    ctx->Begin(occlusion);
+    ctx->DrawIndexedInstanced(6, 1, 0, 0, 0);
+    ctx->End(occlusion);
+    if (f % 16 == 5) {
+      ctx->UpdateSubresource(ib, 0, nullptr, indices, 0, 0);
+      UINT new_args[5] = {6, UINT(1 + f % 3), 0, 0, 0};
+      ctx->UpdateSubresource(args, 0, nullptr, new_args, 0, 0);
+    }
+    ctx->DrawIndexedInstancedIndirect(args, 0);
+
+    // Deferred context: one more quad through a command list.
+    PerDraw dpd = {{0.4f, 0.4f, 0.2f, 0.2f}, {0.2f, 1, 0.4f, 1}, float(f), {}};
+    write_cb(deferred, deferred_cb, dpd);
+    deferred->OMSetRenderTargets(1, &scene_rtv, dsv);
+    deferred->RSSetViewports(1, &vp128);
+    deferred->IASetInputLayout(layout);
+    deferred->IASetVertexBuffers(0, 2, vbs, strides, offsets);
+    deferred->IASetIndexBuffer(ib, DXGI_FORMAT_R16_UINT, 0);
+    deferred->IASetPrimitiveTopology(D3D11_PRIMITIVE_TOPOLOGY_TRIANGLELIST);
+    deferred->VSSetShader(vs_scene, nullptr, 0);
+    deferred->PSSetShader(ps_scene, nullptr, 0);
+    deferred->PSSetShaderResources(0, 2, scene_srvs);
+    deferred->PSSetSamplers(0, 1, &sampler);
+    deferred->VSSetConstantBuffers(0, 1, &deferred_cb);
+    deferred->PSSetConstantBuffers(0, 1, &deferred_cb);
+    deferred->DrawIndexedInstanced(6, 1, 0, 0, 0);
+    ID3D11CommandList *list = nullptr;
+    check(deferred->FinishCommandList(FALSE, &list), "FinishCommandList");
+    ctx->ExecuteCommandList(list, TRUE);
+    list->Release();
+
+    D3D11_BOX box = {32, 32, 0, 96, 96, 1};
+    ctx->CopySubresourceRegion(copy, 0, 0, 0, 0, scene, 0, &box);
+
+    // History: blend the previous history with this frame's scene.
+    ID3D11ShaderResourceView *none[4] = {};
+    ctx->PSSetShaderResources(0, 4, none);
+    ctx->OMSetRenderTargets(1, &history_rtv[cur], nullptr);
+    ctx->IASetInputLayout(nullptr);
+    ctx->VSSetShader(vs_full, nullptr, 0);
+    ctx->PSSetShader(ps_history, nullptr, 0);
+    ID3D11ShaderResourceView *history_in[2] = {history_srv[prev], scene_srv};
+    ctx->PSSetShaderResources(0, 2, history_in);
+    ctx->Draw(3, 0);
+    ctx->PSSetShaderResources(0, 4, none);
+    ctx->OMSetRenderTargets(0, nullptr, nullptr);
+    ctx->GenerateMips(history_srv[cur]);
+
+    // Final composite into the backbuffer.
+    ctx->OMSetRenderTargets(1, &back_rtv, nullptr);
+    ctx->RSSetViewports(1, &vp_back);
+    ctx->PSSetShader(ps_final, nullptr, 0);
+    ID3D11ShaderResourceView *final_in[4] = {history_srv[cur], nullptr, bars_srv, copy_srv};
+    ctx->PSSetShaderResources(0, 4, final_in);
+    ctx->Draw(3, 0);
+    ctx->PSSetShaderResources(0, 4, none);
+
+    if (f % 8 == 7) {
+      ctx->CopyResource(staging, scene);
+      if (SUCCEEDED(ctx->Map(staging, 0, D3D11_MAP_READ, 0, &m)))
+        ctx->Unmap(staging, 0);
+    }
+    check(swapchain->Present(0, 0), "Present");
+  }
+  ctx->ClearState();
+  ctx->Flush();
+  std::printf("selftest: %d frames presented\n", frames);
+  std::fflush(stdout);
+  // The recording is complete; skip library teardown, which is not under test.
+  TerminateProcess(GetCurrentProcess(), 0);
+  return 0;
+}
diff --git a/src/replay/sl_probe.cpp b/src/replay/sl_probe.cpp
new file mode 100644
index 0000000..5077c9e
--- /dev/null
+++ b/src/replay/sl_probe.cpp
@@ -0,0 +1,157 @@
+// Off-screen check of whether NVIDIA Streamline offers DLSS on DXMT.
+//
+// Overwatch reaches DLSS through Streamline (sl.interposer.dll and its plugins), which
+// decides from DXGI, NVAPI and NGX whether the GPU qualifies. This loads a Streamline
+// directory given on the command line (the game's own `_retail_\sl`, read only), creates
+// a D3D11 device on DXMT, and asks Streamline whether DLSS is supported and at which
+// render sizes. Streamline's log is printed as it arrives. Needs DXMT_ENABLE_NVEXT=1.
+// Prints one line of JSON: "@@SL {...}".
+//
+// streamline/ holds Streamline 2.4.15's public headers (MIT, see streamline/LICENSE.txt),
+// the version Overwatch ships.
+
+#include <windows.h>
+#include <d3d11.h>
+#include <dxgi.h>
+
+#include <cstdio>
+#include <cstring>
+#include <string>
+
+#include "streamline/sl.h"
+#include "streamline/sl_dlss.h"
+
+namespace {
+
+std::string json;
+
+void
+add(const char *key, const std::string &value, bool quote = true) {
+  json += "\"" + std::string(key) + "\": " + (quote ? "\"" + value + "\"" : value) + ", ";
+}
+
+void
+finish(const char *error) {
+  if (error)
+    add("error", error);
+  std::printf("@@SL {%s\"done\": true}\n", json.c_str());
+  std::fflush(stdout);
+  TerminateProcess(GetCurrentProcess(), error ? 1 : 0);
+}
+
+void
+log_message(sl::LogType type, const char *msg) {
+  std::printf("sl[%d] %s", int(type), msg);
+  size_t n = std::strlen(msg);
+  if (!n || msg[n - 1] != '\n')
+    std::printf("\n");
+  std::fflush(stdout);
+}
+
+template <typename T>
+T
+proc(HMODULE module, const char *name) {
+  auto f = reinterpret_cast<T>(GetProcAddress(module, name));
+  if (!f)
+    finish((std::string("missing export ") + name).c_str());
+  return f;
+}
+
+} // namespace
+
+int
+wmain(int argc, wchar_t **argv) {
+  if (argc < 2) {
+    std::printf("usage: dxmt-sl-probe <Streamline directory>\n");
+    return 2;
+  }
+  std::wstring dir = argv[1];
+  HMODULE interposer = LoadLibraryW((dir + L"\\sl.interposer.dll").c_str());
+  if (!interposer)
+    finish(("sl.interposer.dll failed to load, error " + std::to_string(GetLastError())).c_str());
+
+  auto slInit = proc<PFun_slInit *>(interposer, "slInit");
+  auto slSetD3DDevice = proc<PFun_slSetD3DDevice *>(interposer, "slSetD3DDevice");
+  auto slIsFeatureSupported = proc<PFun_slIsFeatureSupported *>(interposer, "slIsFeatureSupported");
+  auto slIsFeatureLoaded = proc<PFun_slIsFeatureLoaded *>(interposer, "slIsFeatureLoaded");
+  auto slGetFeatureRequirements = proc<PFun_slGetFeatureRequirements *>(interposer, "slGetFeatureRequirements");
+  auto slGetFeatureFunction = proc<PFun_slGetFeatureFunction *>(interposer, "slGetFeatureFunction");
+
+  const wchar_t *paths[] = {dir.c_str()};
+  sl::Feature features[] = {sl::kFeatureDLSS};
+  sl::Preferences pref{};
+  pref.logLevel = sl::LogLevel::eVerbose;
+  pref.logMessageCallback = log_message;
+  pref.pathsToPlugins = paths;
+  pref.numPathsToPlugins = 1;
+  pref.flags = sl::PreferenceFlags::eDisableCLStateTracking | sl::PreferenceFlags::eUseManualHooking;
+  pref.featuresToLoad = features;
+  pref.numFeaturesToLoad = 1;
+  pref.engine = sl::EngineType::eCustom;
+  pref.engineVersion = "1.0";
+  pref.projectId = "a0f57b54-1daf-4934-90ae-c4035c19df04";
+  pref.renderAPI = sl::RenderAPI::eD3D11;
+  sl::Result result = slInit(pref, sl::kSDKVersion);
+  add("init", std::to_string(int(result)), false);
+  if (result != sl::Result::eOk)
+    finish("slInit failed");
+
+  auto create_factory = proc<decltype(&CreateDXGIFactory1)>(LoadLibraryW(L"dxgi.dll"), "CreateDXGIFactory1");
+  auto create_device = proc<decltype(&D3D11CreateDevice)>(LoadLibraryW(L"d3d11.dll"), "D3D11CreateDevice");
+  IDXGIFactory1 *factory = nullptr;
+  IDXGIAdapter1 *adapter = nullptr;
+  DXGI_ADAPTER_DESC1 desc = {};
+  if (FAILED(create_factory(__uuidof(IDXGIFactory1), (void **)&factory)) ||
+      FAILED(factory->EnumAdapters1(0, &adapter)) || FAILED(adapter->GetDesc1(&desc)))
+    finish("no DXGI adapter");
+  char vendor[16];
+  std::snprintf(vendor, sizeof(vendor), "0x%04x", desc.VendorId);
+  add("vendor", vendor);
+
+  ID3D11Device *device = nullptr;
+  ID3D11DeviceContext *context = nullptr;
+  D3D_FEATURE_LEVEL level = D3D_FEATURE_LEVEL_11_1;
+  if (FAILED(create_device(adapter, D3D_DRIVER_TYPE_UNKNOWN, nullptr, 0, &level, 1, D3D11_SDK_VERSION, &device,
+                               nullptr, &context)))
+    finish("D3D11CreateDevice failed");
+  result = slSetD3DDevice(device);
+  add("set_device", std::to_string(int(result)), false);
+
+  bool loaded = false;
+  slIsFeatureLoaded(sl::kFeatureDLSS, loaded);
+  add("dlss_loaded", loaded ? "true" : "false", false);
+
+  sl::AdapterInfo info{};
+  info.deviceLUID = reinterpret_cast<uint8_t *>(&desc.AdapterLuid);
+  info.deviceLUIDSizeInBytes = sizeof(LUID);
+  result = slIsFeatureSupported(sl::kFeatureDLSS, info);
+  add("dlss_supported", std::to_string(int(result)), false);
+
+  sl::FeatureRequirements requirements{};
+  if (slGetFeatureRequirements(sl::kFeatureDLSS, requirements) == sl::Result::eOk) {
+    add("requirement_flags", std::to_string(uint32_t(requirements.flags)), false);
+    add("os_detected", requirements.osVersionDetected.toStr());
+    add("driver_detected", requirements.driverVersionDetected.toStr());
+    add("driver_required", requirements.driverVersionRequired.toStr());
+  }
+
+  void *function = nullptr;
+  if (slGetFeatureFunction(sl::kFeatureDLSS, "slDLSSGetOptimalSettings", function) == sl::Result::eOk && function) {
+    auto optimal = reinterpret_cast<PFun_slDLSSGetOptimalSettings *>(function);
+    std::string sizes = "{";
+    for (auto [mode, name] : {std::pair{sl::DLSSMode::eMaxQuality, "quality"},
+                              std::pair{sl::DLSSMode::eBalanced, "balanced"},
+                              std::pair{sl::DLSSMode::eMaxPerformance, "performance"}}) {
+      sl::DLSSOptions options{};
+      options.mode = mode;
+      options.outputWidth = 1920;
+      options.outputHeight = 1200;
+      sl::DLSSOptimalSettings settings{};
+      auto r = optimal(options, settings);
+      sizes += std::string(sizes.size() > 1 ? ", " : "") + "\"" + name + "\": \"" + std::to_string(int(r)) + " " +
+               std::to_string(settings.optimalRenderWidth) + "x" + std::to_string(settings.optimalRenderHeight) + "\"";
+    }
+    add("optimal", sizes + "}", false);
+  }
+  finish(nullptr);
+}
