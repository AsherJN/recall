diff --git a/src/d3d12stub/d3d12.cpp b/src/d3d12stub/d3d12.cpp
new file mode 100644
index 0000000..a900e8f
--- /dev/null
+++ b/src/d3d12stub/d3d12.cpp
@@ -0,0 +1,80 @@
+// A d3d12.dll that loads but offers no Direct3D 12 device.
+//
+// NVIDIA Streamline's sl.common.dll imports d3d12.dll even when the game renders with
+// Direct3D 11, so without any d3d12.dll Streamline (and with it DLSS) cannot load. The
+// runtime's own d3d12.dll is Apple's D3DMetal shim, which crashes next to DXMT's DXGI, so
+// launches disable it. This stand-in satisfies the import and fails every call the way a
+// system without Direct3D 12 would, so nothing can pick a D3D12 path.
+
+#include <windows.h>
+
+#define D3D12_UNAVAILABLE ((HRESULT)0x887A0004L) // DXGI_ERROR_UNSUPPORTED
+
+extern "C" {
+
+HRESULT WINAPI
+D3D12CreateDevice(IUnknown *adapter, UINT feature_level, REFIID iid, void **device) {
+  if (device)
+    *device = nullptr;
+  return D3D12_UNAVAILABLE;
+}
+
+HRESULT WINAPI
+D3D12GetDebugInterface(REFIID iid, void **debug) {
+  if (debug)
+    *debug = nullptr;
+  return E_NOINTERFACE;
+}
+
+HRESULT WINAPI
+D3D12GetInterface(REFCLSID clsid, REFIID iid, void **object) {
+  if (object)
+    *object = nullptr;
+  return E_NOINTERFACE;
+}
+
+HRESULT WINAPI
+D3D12EnableExperimentalFeatures(UINT count, const IID *iids, void *structs, UINT *sizes) {
+  return E_NOINTERFACE;
+}
+
+HRESULT WINAPI
+D3D12SerializeRootSignature(const void *desc, UINT version, void **blob, void **error_blob) {
+  if (blob)
+    *blob = nullptr;
+  if (error_blob)
+    *error_blob = nullptr;
+  return E_NOTIMPL;
+}
+
+HRESULT WINAPI
+D3D12SerializeVersionedRootSignature(const void *desc, void **blob, void **error_blob) {
+  if (blob)
+    *blob = nullptr;
+  if (error_blob)
+    *error_blob = nullptr;
+  return E_NOTIMPL;
+}
+
+HRESULT WINAPI
+D3D12CreateRootSignatureDeserializer(const void *data, SIZE_T size, REFIID iid, void **deserializer) {
+  if (deserializer)
+    *deserializer = nullptr;
+  return E_NOTIMPL;
+}
+
+HRESULT WINAPI
+D3D12CreateVersionedRootSignatureDeserializer(const void *data, SIZE_T size, REFIID iid, void **deserializer) {
+  if (deserializer)
+    *deserializer = nullptr;
+  return E_NOTIMPL;
+}
+
+BOOL WINAPI
+DllMain(HINSTANCE instance, DWORD reason, LPVOID reserved) {
+  if (reason == DLL_PROCESS_ATTACH)
+    DisableThreadLibraryCalls(instance);
+  return TRUE;
+}
+
+}
