+// ---------------------------------------------------------------------------
+// Files.
+
+namespace {
+constexpr size_t kChunkBytes = 8 << 20;
+constexpr size_t kMaxQueuedBytes = 768 << 20;
+} // namespace
+
+bool
+RecordFile::open(const std::wstring &path) {
+  close();
+  HANDLE h = CreateFileW(path.c_str(), GENERIC_WRITE, FILE_SHARE_READ, nullptr, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL,
+                         nullptr);
+  if (h == INVALID_HANDLE_VALUE)
+    return false;
+  handle_ = h;
+  size_ = 0;
+  stop_ = false;
+  pending_.clear();
+  pending_.reserve(kChunkBytes);
+  thread_ = dxmt::thread([this]() { writer(); });
+  return true;
+}
+
+uint64_t
+RecordFile::append(const void *data, size_t bytes) {
+  uint64_t offset = size_;
+  size_ += bytes;
+  auto p = reinterpret_cast<const uint8_t *>(data);
+  while (bytes) {
+    size_t take = std::min(bytes, kChunkBytes - pending_.size());
+    pending_.insert(pending_.end(), p, p + take);
+    p += take;
+    bytes -= take;
+    if (pending_.size() >= kChunkBytes) {
+      std::unique_lock<dxmt::mutex> lock(mutex_);
+      drained_.wait(lock, [&]() { return queued_bytes_ < kMaxQueuedBytes; });
+      queued_bytes_ += pending_.size();
+      queue_.push_back(std::move(pending_));
+      pending_ = {};
+      pending_.reserve(kChunkBytes);
+      wake_.notify_one();
+    }
+  }
+  return offset;
+}
+
+void
+RecordFile::pad_to(size_t alignment) {
+  static const uint8_t zeros[64] = {};
+  size_t pad = (alignment - size_ % alignment) % alignment;
+  if (pad)
+    append(zeros, pad);
+}
+
+void
+RecordFile::writer() {
+  for (;;) {
+    std::vector<uint8_t> chunk;
+    {
+      std::unique_lock<dxmt::mutex> lock(mutex_);
+      wake_.wait(lock, [&]() { return stop_ || !queue_.empty(); });
+      if (queue_.empty())
+        return;
+      chunk = std::move(queue_.front());
+      queue_.pop_front();
+    }
+    size_t done = 0;
+    while (done < chunk.size()) {
+      DWORD written = 0;
+      DWORD request = (DWORD)std::min<size_t>(chunk.size() - done, 64 << 20);
+      if (!WriteFile(handle_, chunk.data() + done, request, &written, nullptr) || !written) {
+        ERR("recorder: write failed (", GetLastError(), ")");
+        break;
+      }
+      done += written;
+    }
+    {
+      std::lock_guard<dxmt::mutex> lock(mutex_);
+      queued_bytes_ -= chunk.size();
+    }
+    drained_.notify_all();
+  }
+}
+
+void
+RecordFile::close() {
+  if (!handle_)
+    return;
+  {
+    std::lock_guard<dxmt::mutex> lock(mutex_);
+    if (!pending_.empty()) {
+      queued_bytes_ += pending_.size();
+      queue_.push_back(std::move(pending_));
+      pending_ = {};
+    }
+    stop_ = true;
+  }
+  wake_.notify_one();
+  thread_.join();
+  CloseHandle(handle_);
+  handle_ = nullptr;
+}
+
+// ---------------------------------------------------------------------------
+// Recorder: configuration and lifecycle.
+
+Recorder *
+Recorder::Instance() {
+  static Recorder *instance = []() -> Recorder * {
+    auto dir = env::getEnvVar("DXMT_RECORD_DIR");
+    if (dir.empty())
+      return nullptr;
+    // getExeBaseName() drops ".exe"; accept the setting with or without it.
+    auto exe = env::getEnvVar("DXMT_RECORD_EXE");
+    if (exe.size() > 4 && _stricmp(exe.c_str() + exe.size() - 4, ".exe") == 0)
+      exe.resize(exe.size() - 4);
+    if (!exe.empty() && _stricmp(exe.c_str(), env::getExeBaseName().c_str()) != 0)
+      return nullptr;
+    return new Recorder();
+  }();
+  return instance;
+}
+
+Recorder::Recorder() {
+  session_dir_ = widen(env::getEnvVar("DXMT_RECORD_DIR"));
+  while (!session_dir_.empty() && (session_dir_.back() == L'\\' || session_dir_.back() == L'/'))
+    session_dir_.pop_back();
+  frames_per_recording_ = std::max<uint64_t>(1, env_u64("DXMT_RECORD_FRAMES", 1800));
+  start_frame_ = env_u64("DXMT_RECORD_START_FRAME", 0);
+  checkpoint_interval_ = std::max<uint64_t>(1, env_u64("DXMT_RECORD_CHECKPOINT", 60));
+  max_blob_bytes_ = env_u64("DXMT_RECORD_MAX_GB", 24) << 30;
+  make_dirs(session_dir_);
+  census_file_ = CreateFileW((session_dir_ + L"\\census.jsonl").c_str(), FILE_APPEND_DATA, FILE_SHARE_READ, nullptr,
+                             OPEN_ALWAYS, FILE_ATTRIBUTE_NORMAL, nullptr);
+  if (census_file_ == INVALID_HANDLE_VALUE)
+    census_file_ = nullptr;
+  census_last_ms_ = GetTickCount64();
+  write_status("idle");
+  WARN("DXMT recorder enabled: ", narrow(session_dir_), " (", frames_per_recording_, " frames per recording)");
+}
+
+void
+Recorder::write_text(const std::wstring &path, const std::string &text) {
+  auto temp = path + L".tmp";
+  HANDLE h = CreateFileW(temp.c_str(), GENERIC_WRITE, 0, nullptr, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, nullptr);
+  if (h == INVALID_HANDLE_VALUE)
+    return;
+  DWORD written = 0;
+  WriteFile(h, text.data(), (DWORD)text.size(), &written, nullptr);
+  CloseHandle(h);
+  MoveFileExW(temp.c_str(), path.c_str(), MOVEFILE_REPLACE_EXISTING);
+}
+
+void
+Recorder::write_status(const char *state) {
+  char text[512];
+  std::snprintf(text, sizeof text,
+                "{\"state\": \"%s\", \"recording\": %u, \"frames\": %llu, \"target_frames\": %llu, "
+                "\"blob_bytes\": %llu, \"presents\": %llu, \"tick_ms\": %llu}\n",
+                state, recording_index_, (unsigned long long)recorded_frames_,
+                (unsigned long long)frames_per_recording_, (unsigned long long)blobs_.size(),
+                (unsigned long long)present_count_, (unsigned long long)GetTickCount64());
+  write_text(session_dir_ + L"\\status.json", text);
+}
+
+void
+Recorder::census_tick(bool force) {
+  auto now = GetTickCount64();
+  if (!census_file_ || (!force && now - census_last_ms_ < 1000))
+    return;
+  std::string line = "{\"tick_ms\": " + std::to_string(now) +
+                     ", \"interval_ms\": " + std::to_string(now - census_last_ms_) +
+                     ", \"presents\": " + std::to_string(present_count_ - census_last_present_) +
+                     ", \"state\": \"" +
+                     (state_ == State::Recording ? "recording" : state_ == State::Armed ? "armed" : "idle") +
+                     "\", \"ops\": {";
+  bool first = true;
+  for (size_t i = 0; i < census_ops_.size(); i++) {
+    auto n = census_ops_[i].exchange(0, std::memory_order_relaxed);
+    if (!n)
+      continue;
+    line += (first ? "\"" : ", \"") + std::string(op_name(Op(i))) + "\": " + std::to_string(n);
+    first = false;
+  }
+  static const char *map_names[6] = {"none", "read", "write", "read_write", "discard", "no_overwrite"};
+  line += "}, \"maps\": {";
+  for (size_t i = 1; i < 6; i++)
+    line += std::string(i > 1 ? ", \"" : "\"") + map_names[i] + "\": [" +
+            std::to_string(census_maps_[i].exchange(0)) + ", " + std::to_string(census_map_bytes_[i].exchange(0)) +
+            "]";
+  line += "}, \"update_bytes\": " + std::to_string(census_update_bytes_.exchange(0)) +
+          ", \"creates\": " + std::to_string(census_creates_.exchange(0)) +
+          ", \"deferred_calls\": " + std::to_string(census_deferred_calls_.exchange(0)) + "}\n";
+  DWORD written = 0;
+  WriteFile((HANDLE)census_file_, line.data(), (DWORD)line.size(), &written, nullptr);
+  census_last_ms_ = now;
+  census_last_present_ = present_count_;
+}
+
+bool
+Recorder::enter(RecordingContext *c, Op op) {
+  census_ops_[size_t(op) & 0xff].fetch_add(1, std::memory_order_relaxed);
+  if (!c->immediate()) {
+    census_deferred_calls_.fetch_add(1, std::memory_order_relaxed);
+    c->has_pending_calls.store(true, std::memory_order_relaxed);
+  }
+  auto state = state_.load(std::memory_order_acquire);
+  if (state == State::Idle)
+    return false;
+  if (state == State::Armed) {
+    if (!c->immediate())
+      return false;
+    std::lock_guard<dxmt::recursive_mutex> lock(mutex_);
+    if (state_ == State::Armed)
+      start_recording(c);
+  }
+  return c->immediate() || c->deferred_clean;
+}
+
+void
+Recorder::start_recording(RecordingContext *immediate) {
+  recording_index_++;
+  wchar_t name[32];
+  swprintf(name, 32, L"rec-%03u", recording_index_);
+  recording_dir_ = session_dir_ + L"\\" + name;
+  make_dirs(recording_dir_);
+  if (!prologue_.open(recording_dir_ + L"\\prologue.owr") || !stream_.open(recording_dir_ + L"\\stream.owr") ||
+      !blobs_.open(recording_dir_ + L"\\blobs.owb")) {
+    ERR("recorder: cannot create ", narrow(recording_dir_));
+    prologue_.close();
+    stream_.close();
+    blobs_.close();
+    state_ = State::Idle;
+    write_status("error");
+    return;
+  }
+  FileHeader header;
+  header.feature_level = immediate->device()->real()->GetFeatureLevel();
+  header.device_flags = immediate->device()->real()->GetCreationFlags();
+  prologue_.append(&header, sizeof header);
+  stream_.append(&header, sizeof header);
+  next_id_ = 1;
+  ids_.clear();
+  resources_.clear();
+  pending_maps_.clear();
+  shadows_.clear();
+  blob_index_.clear();
+  readback_queue_.clear();
+  readback_inflight_.clear();
+  readback_inflight_bytes_ = 0;
+  backbuffer_id_ = 0;
+  warnings_.clear();
+  stream_records_ = prologue_records_ = readback_failures_ = undefined_contents_ = 0;
+  blob_bytes_written_ = blob_bytes_deduplicated_ = 0;
+  recorded_frames_ = 0;
+  stop_requested_ = false;
+  recording_started_ms_ = GetTickCount64();
+  state_ = State::Recording;
+  for (auto &[ctx, flags] : deferred_contexts_) {
+    // A context in the middle of a command list cannot be recorded until it finishes it.
+    ctx->deferred_clean = !ctx->has_pending_calls.load(std::memory_order_relaxed);
+    ctx->deferred_records.clear();
+    Payload p;
+    p.put(uint32_t(ctx->id())).put(flags);
+    emit_prologue(Op::CreateDeferredContext, p.b);
+  }
+  write_status("recording");
+  WARN("recorder: recording ", narrow(recording_dir_));
+  capture_initial_state(immediate);
+}
+
+void
+Recorder::capture_initial_state(RecordingContext *imm) {
+  auto ctx = imm->real();
+  {
+    ID3D11InputLayout *layout = nullptr;
+    ctx->IAGetInputLayout(&layout);
+    IASetInputLayout(imm, layout);
+    if (layout)
+      layout->Release();
+  }
+  {
+    ID3D11Buffer *vbs[D3D11_IA_VERTEX_INPUT_RESOURCE_SLOT_COUNT] = {};
+    UINT strides[D3D11_IA_VERTEX_INPUT_RESOURCE_SLOT_COUNT] = {}, offsets[D3D11_IA_VERTEX_INPUT_RESOURCE_SLOT_COUNT] = {};
+    ctx->IAGetVertexBuffers(0, D3D11_IA_VERTEX_INPUT_RESOURCE_SLOT_COUNT, vbs, strides, offsets);
+    IASetVertexBuffers(imm, 0, D3D11_IA_VERTEX_INPUT_RESOURCE_SLOT_COUNT, vbs, strides, offsets);
+    for (auto b : vbs)
+      if (b)
+        b->Release();
+    ID3D11Buffer *ib = nullptr;
+    DXGI_FORMAT format = DXGI_FORMAT_UNKNOWN;
+    UINT offset = 0;
+    ctx->IAGetIndexBuffer(&ib, &format, &offset);
+    IASetIndexBuffer(imm, ib, format, offset);
+    if (ib)
+      ib->Release();
+    D3D11_PRIMITIVE_TOPOLOGY topology = D3D11_PRIMITIVE_TOPOLOGY_UNDEFINED;
+    ctx->IAGetPrimitiveTopology(&topology);
+    IASetPrimitiveTopology(imm, topology);
+  }
+  auto stage_state = [&](Stage stage, ID3D11DeviceChild *shader, auto get_cbs, auto get_srvs, auto get_samplers) {
+    set_shader(imm, stage, shader, nullptr, 0);
+    if (shader)
+      shader->Release();
+    ID3D11Buffer *cbs[D3D11_COMMONSHADER_CONSTANT_BUFFER_API_SLOT_COUNT] = {};
+    UINT first[D3D11_COMMONSHADER_CONSTANT_BUFFER_API_SLOT_COUNT] = {};
+    UINT num[D3D11_COMMONSHADER_CONSTANT_BUFFER_API_SLOT_COUNT] = {};
+    get_cbs(cbs, first, num);
+    set_cbs(imm, stage, 0, D3D11_COMMONSHADER_CONSTANT_BUFFER_API_SLOT_COUNT, cbs, first, num);
+    for (auto b : cbs)
+      if (b)
+        b->Release();
+    ID3D11ShaderResourceView *srvs[D3D11_COMMONSHADER_INPUT_RESOURCE_SLOT_COUNT] = {};
+    get_srvs(srvs);
+    set_srvs(imm, stage, 0, D3D11_COMMONSHADER_INPUT_RESOURCE_SLOT_COUNT, srvs);
+    for (auto v : srvs)
+      if (v)
+        v->Release();
+    ID3D11SamplerState *samplers[D3D11_COMMONSHADER_SAMPLER_SLOT_COUNT] = {};
+    get_samplers(samplers);
+    set_samplers(imm, stage, 0, D3D11_COMMONSHADER_SAMPLER_SLOT_COUNT, samplers);
+    for (auto s : samplers)
+      if (s)
+        s->Release();
+  };
+#define DXMT_CAPTURE_STAGE(S, Type)                                                                                    \
+  {                                                                                                                    \
+    Type *shader = nullptr;                                                                                            \
+    UINT instances = 0;                                                                                                \
+    ctx->S##GetShader(&shader, nullptr, &instances);                                                                   \
+    stage_state(                                                                                                       \
+        S, shader,                                                                                                     \
+        [&](ID3D11Buffer **b, UINT *f, UINT *n) {                                                                      \
+          ctx->S##GetConstantBuffers1(0, D3D11_COMMONSHADER_CONSTANT_BUFFER_API_SLOT_COUNT, b, f, n);                  \
+        },                                                                                                             \
+        [&](ID3D11ShaderResourceView **v) {                                                                            \
+          ctx->S##GetShaderResources(0, D3D11_COMMONSHADER_INPUT_RESOURCE_SLOT_COUNT, v);                              \
+        },                                                                                                             \
+        [&](ID3D11SamplerState **s) { ctx->S##GetSamplers(0, D3D11_COMMONSHADER_SAMPLER_SLOT_COUNT, s); }            \
+    );                                                                                                                 \
+  }
+  DXMT_CAPTURE_STAGE(VS, ID3D11VertexShader)
+  DXMT_CAPTURE_STAGE(HS, ID3D11HullShader)
+  DXMT_CAPTURE_STAGE(DS, ID3D11DomainShader)
+  DXMT_CAPTURE_STAGE(GS, ID3D11GeometryShader)
+  DXMT_CAPTURE_STAGE(PS, ID3D11PixelShader)
+  DXMT_CAPTURE_STAGE(CS, ID3D11ComputeShader)
+#undef DXMT_CAPTURE_STAGE
+  {
+    ID3D11UnorderedAccessView *uavs[D3D11_1_UAV_SLOT_COUNT] = {};
+    ctx->CSGetUnorderedAccessViews(0, D3D11_1_UAV_SLOT_COUNT, uavs);
+    UINT keep[D3D11_1_UAV_SLOT_COUNT];
+    std::fill(std::begin(keep), std::end(keep), UINT(-1));
+    CSSetUnorderedAccessViews(imm, 0, D3D11_1_UAV_SLOT_COUNT, uavs, keep);
+    for (auto u : uavs)
+      if (u)
+        u->Release();
+  }
+  {
+    ID3D11RenderTargetView *rtvs[D3D11_SIMULTANEOUS_RENDER_TARGET_COUNT] = {};
+    ID3D11DepthStencilView *dsv = nullptr;
+    ctx->OMGetRenderTargets(D3D11_SIMULTANEOUS_RENDER_TARGET_COUNT, rtvs, &dsv);
+    OMSetRenderTargets(imm, D3D11_SIMULTANEOUS_RENDER_TARGET_COUNT, rtvs, dsv);
+    for (auto v : rtvs)
+      if (v)
+        v->Release();
+    if (dsv)
+      dsv->Release();
+    ID3D11UnorderedAccessView *uavs[D3D11_1_UAV_SLOT_COUNT] = {};
+    ctx->OMGetRenderTargetsAndUnorderedAccessViews(0, nullptr, nullptr, 0, D3D11_1_UAV_SLOT_COUNT, uavs);
+    UINT first = D3D11_1_UAV_SLOT_COUNT;
+    for (UINT i = 0; i < D3D11_1_UAV_SLOT_COUNT; i++)
+      if (uavs[i] && first == D3D11_1_UAV_SLOT_COUNT)
+        first = i;
+    if (first < D3D11_1_UAV_SLOT_COUNT) {
+      UINT keep[D3D11_1_UAV_SLOT_COUNT];
+      std::fill(std::begin(keep), std::end(keep), UINT(-1));
+      OMSetRenderTargetsAndUnorderedAccessViews(
+          imm, D3D11_KEEP_RENDER_TARGETS_AND_DEPTH_STENCIL, nullptr, nullptr, first, D3D11_1_UAV_SLOT_COUNT - first,
+          uavs + first, keep
+      );
+    }
+    for (auto u : uavs)
+      if (u)
+        u->Release();
+    ID3D11BlendState *blend = nullptr;
+    FLOAT factor[4] = {};
+    UINT mask = 0;
+    ctx->OMGetBlendState(&blend, factor, &mask);
+    OMSetBlendState(imm, blend, factor, mask);
+    if (blend)
+      blend->Release();
+    ID3D11DepthStencilState *depth = nullptr;
+    UINT stencil_ref = 0;
+    ctx->OMGetDepthStencilState(&depth, &stencil_ref);
+    OMSetDepthStencilState(imm, depth, stencil_ref);
+    if (depth)
+      depth->Release();
+  }
+  {
+    ID3D11RasterizerState *rs = nullptr;
+    ctx->RSGetState(&rs);
+    RSSetState(imm, rs);
+    if (rs)
+      rs->Release();
+    D3D11_VIEWPORT viewports[D3D11_VIEWPORT_AND_SCISSORRECT_OBJECT_COUNT_PER_PIPELINE] = {};
+    UINT n = D3D11_VIEWPORT_AND_SCISSORRECT_OBJECT_COUNT_PER_PIPELINE;
+    ctx->RSGetViewports(&n, viewports);
+    RSSetViewports(imm, n, viewports);
+    D3D11_RECT rects[D3D11_VIEWPORT_AND_SCISSORRECT_OBJECT_COUNT_PER_PIPELINE] = {};
+    n = D3D11_VIEWPORT_AND_SCISSORRECT_OBJECT_COUNT_PER_PIPELINE;
+    ctx->RSGetScissorRects(&n, rects);
+    RSSetScissorRects(imm, n, rects);
+  }
+  {
+    ID3D11Buffer *so[D3D11_SO_BUFFER_SLOT_COUNT] = {};
+    ctx->SOGetTargets(D3D11_SO_BUFFER_SLOT_COUNT, so);
+    bool any = false;
+    for (auto b : so)
+      any |= !!b;
+    if (any) {
+      UINT offsets[D3D11_SO_BUFFER_SLOT_COUNT] = {};
+      SOSetTargets(imm, D3D11_SO_BUFFER_SLOT_COUNT, so, offsets);
+      warnings_["stream output bound at recording start (offsets assumed 0)"]++;
+    }
+    for (auto b : so)
+      if (b)
+        b->Release();
+    ID3D11Predicate *predicate = nullptr;
+    WINBOOL value = FALSE;
+    ctx->GetPredication(&predicate, &value);
+    if (predicate) {
+      SetPredication(imm, predicate, value);
+      predicate->Release();
+    }
+  }
+}
+
+void
+Recorder::finish_recording(RecordingContext *immediate, const char *reason) {
+  if (immediate) {
+    issue_readback_copies(immediate);
+    complete_readbacks(immediate);
+  }
+  for (auto &rb : readback_queue_)
+    if (rb.source)
+      rb.source->Release();
+  readback_queue_.clear();
+  for (auto &rb : readback_inflight_)
+    if (rb.staging)
+      rb.staging->Release();
+  readback_inflight_.clear();
+  if (checkpoint_staging_) {
+    checkpoint_staging_->Release();
+    checkpoint_staging_ = nullptr;
+  }
+  uint64_t prologue_bytes = prologue_.size(), stream_bytes = stream_.size(), blob_bytes = blobs_.size();
+  prologue_.close();
+  stream_.close();
+  blobs_.close();
+  state_ = State::Idle;
+
+  std::string warnings;
+  for (auto &[text, count] : warnings_)
+    warnings += (warnings.empty() ? "\"" : ", \"") + json_escape(text) + "\": " + std::to_string(count);
+  char head[1024];
+  std::snprintf(
+      head, sizeof head,
+      "{\n  \"recorder_version\": 1,\n  \"exe\": \"%s\",\n  \"finished_because\": \"%s\",\n  \"frames\": %llu,\n"
+      "  \"duration_ms\": %llu,\n  \"objects\": %u,\n  \"backbuffer_id\": %u,\n  \"stream_records\": %llu,\n"
+      "  \"prologue_records\": %llu,\n  \"stream_bytes\": %llu,\n  \"prologue_bytes\": %llu,\n  \"blob_bytes\": %llu,\n"
+      "  \"deduplicated_bytes\": %llu,\n  \"readback_failures\": %llu,\n  \"undefined_contents\": %llu,\n",
+      json_escape(env::getExeBaseName()).c_str(), reason, (unsigned long long)recorded_frames_,
+      (unsigned long long)(GetTickCount64() - recording_started_ms_), next_id_ - 1, backbuffer_id_,
+      (unsigned long long)stream_records_, (unsigned long long)prologue_records_, (unsigned long long)stream_bytes,
+      (unsigned long long)prologue_bytes, (unsigned long long)blob_bytes,
+      (unsigned long long)blob_bytes_deduplicated_, (unsigned long long)readback_failures_,
+      (unsigned long long)undefined_contents_
+  );
+  write_text(recording_dir_ + L"\\meta.json", std::string(head) + "  \"warnings\": {" + warnings + "}\n}\n");
+  write_status("finished");
+  census_tick(true);
+  WARN("recorder: finished ", narrow(recording_dir_), " (", reason, ", ", recorded_frames_, " frames)");
+  ids_.clear();
+  resources_.clear();
+  pending_maps_.clear();
+  shadows_.clear();
+  blob_index_.clear();
+}
+
+void
+Recorder::OnDeferredContextDestroyed(RecordingContext *ctx) {
+  std::lock_guard<dxmt::recursive_mutex> lock(mutex_);
+  deferred_contexts_.erase(ctx);
+}
+
+void
+Recorder::OnDeviceDestroyed(RecordingDevice *device) {
+  std::lock_guard<dxmt::recursive_mutex> lock(mutex_);
+  if (device != device_)
+    return;
+  if (state_ == State::Recording)
+    finish_recording(nullptr, "device destroyed");
+  state_ = State::Idle;
+  device_ = nullptr;
+}
+
+// ---------------------------------------------------------------------------
+// Records and blobs.
+
+void
+Recorder::emit(RecordingContext *c, Op op, const std::vector<uint8_t> &payload) {
+  RecordHeader header{uint16_t(op), c->id(), uint32_t(payload.size())};
+  if (c->immediate()) {
+    stream_.append(&header, sizeof header);
+    stream_.append(payload.data(), payload.size());
+    stream_records_++;
+  } else {
+    auto &buf = c->deferred_records;
+    auto h = reinterpret_cast<const uint8_t *>(&header);
+    buf.insert(buf.end(), h, h + sizeof header);
+    buf.insert(buf.end(), payload.begin(), payload.end());
+  }
+}
+
+void
+Recorder::emit_prologue(Op op, const std::vector<uint8_t> &payload) {
+  RecordHeader header{uint16_t(op), 0, uint32_t(payload.size())};
+  prologue_.append(&header, sizeof header);
+  prologue_.append(payload.data(), payload.size());
+  prologue_records_++;
+}
+
+BlobRef
+Recorder::blob(const void *data, size_t size) {
+  if (!size)
+    return {};
+  uint64_t hash = xxh64(data, size);
+  uint64_t key = hash ^ (uint64_t(size) * 0x9E3779B97F4A7C15ull);
+  auto it = blob_index_.find(key);
+  if (it != blob_index_.end() && it->second.size == size) {
+    blob_bytes_deduplicated_ += size;
+    return it->second;
+  }
+  blobs_.pad_to(16);
+  BlobRef ref{blobs_.append(data, size), uint32_t(size), 0};
+  blob_index_[key] = ref;
+  blob_bytes_written_ += size;
+  if (blobs_.size() > max_blob_bytes_)
+    stop_requested_ = true;
+  return ref;
+}
+
+void
+Recorder::unsupported(RecordingContext *c, const char *what) {
+  if (!enter(c, Op::Unsupported))
+    return;
+  std::lock_guard<dxmt::recursive_mutex> lock(mutex_);
+  warnings_[std::string("unsupported call: ") + what]++;
+  Payload p;
+  char name[64] = {};
+  std::strncpy(name, what, sizeof name - 1);
+  p.bytes(name, sizeof name);
+  emit(c, Op::Unsupported, p.b);
+}
+
+// ---------------------------------------------------------------------------
+// Object identity and snapshots.
+
+Recorder::ResourceInfo
+Recorder::describe(ID3D11Resource *res) {
+  ResourceInfo info;
+  res->GetType(&info.dim);
+  switch (info.dim) {
+  case D3D11_RESOURCE_DIMENSION_BUFFER: {
+    D3D11_BUFFER_DESC d;
+    static_cast<ID3D11Buffer *>(res)->GetDesc(&d);
+    info.width = d.ByteWidth;
+    info.bind = d.BindFlags;
+    info.usage = d.Usage;
+    break;
+  }
+  case D3D11_RESOURCE_DIMENSION_TEXTURE1D: {
+    D3D11_TEXTURE1D_DESC d;
+    static_cast<ID3D11Texture1D *>(res)->GetDesc(&d);
+    info.format = d.Format;
+    info.width = d.Width;
+    info.mips = d.MipLevels;
+    info.array = d.ArraySize;
+    info.bind = d.BindFlags;
+    info.usage = d.Usage;
+    break;
+  }
+  case D3D11_RESOURCE_DIMENSION_TEXTURE2D: {
+    D3D11_TEXTURE2D_DESC d;
+    static_cast<ID3D11Texture2D *>(res)->GetDesc(&d);
+    info.format = d.Format;
+    info.width = d.Width;
+    info.height = d.Height;
+    info.mips = d.MipLevels;
+    info.array = d.ArraySize;
+    info.samples = d.SampleDesc.Count;
+    info.bind = d.BindFlags;
+    info.usage = d.Usage;
+    break;
+  }
+  case D3D11_RESOURCE_DIMENSION_TEXTURE3D: {
+    D3D11_TEXTURE3D_DESC d;
+    static_cast<ID3D11Texture3D *>(res)->GetDesc(&d);
+    info.format = d.Format;
+    info.width = d.Width;
+    info.height = d.Height;
+    info.depth = d.Depth;
+    info.mips = d.MipLevels;
+    info.bind = d.BindFlags;
+    info.usage = d.Usage;
+    break;
+  }
+  default:
+    break;
+  }
+  return info;
+}
+
+bool
+Recorder::subresource_layout(const ResourceInfo &info, uint32_t sub, uint32_t &row_bytes, uint32_t &rows,
+                             uint32_t &depth) const {
+  if (info.dim == D3D11_RESOURCE_DIMENSION_BUFFER) {
+    row_bytes = info.width;
+    rows = depth = 1;
+    return true;
+  }
+  uint32_t bytes, bw, bh;
+  if (!format_block(info.format, bytes, bw, bh))
+    return false;
+  uint32_t mip = sub % std::max(1u, info.mips);
+  uint32_t w = std::max(1u, info.width >> mip), h = std::max(1u, info.height >> mip);
+  row_bytes = (w + bw - 1) / bw * bytes;
+  rows = (h + bh - 1) / bh;
+  depth = info.dim == D3D11_RESOURCE_DIMENSION_TEXTURE3D ? std::max(1u, info.depth >> mip) : 1;
+  return true;
+}
+
+void
+Recorder::emit_resource_create(Op op, uint32_t id, ID3D11Resource *res, const ResourceInfo &info,
+                               const D3D11_SUBRESOURCE_DATA *init, bool prologue) {
+  Payload p;
+  p.put(id);
+  uint32_t subresources = 1;
+  switch (info.dim) {
+  case D3D11_RESOURCE_DIMENSION_BUFFER: {
+    D3D11_BUFFER_DESC d;
+    static_cast<ID3D11Buffer *>(res)->GetDesc(&d);
+    p.put(d);
+    break;
+  }
+  case D3D11_RESOURCE_DIMENSION_TEXTURE1D: {
+    D3D11_TEXTURE1D_DESC d;
+    static_cast<ID3D11Texture1D *>(res)->GetDesc(&d);
+    p.put(d);
+    subresources = d.MipLevels * d.ArraySize;
+    break;
+  }
+  case D3D11_RESOURCE_DIMENSION_TEXTURE2D: {
+    D3D11_TEXTURE2D_DESC d;
+    static_cast<ID3D11Texture2D *>(res)->GetDesc(&d);
+    p.put(d);
+    subresources = d.MipLevels * d.ArraySize;
+    break;
+  }
+  case D3D11_RESOURCE_DIMENSION_TEXTURE3D: {
+    D3D11_TEXTURE3D_DESC d;
+    static_cast<ID3D11Texture3D *>(res)->GetDesc(&d);
+    p.put(d);
+    subresources = d.MipLevels;
+    break;
+  }
+  default:
+    break;
+  }
+  uint32_t count = init ? subresources : 0;
+  p.put(count);
+  std::vector<uint8_t> packed;
+  for (uint32_t s = 0; s < count; s++) {
+    uint32_t row_bytes, rows, depth;
+    SubData sd;
+    if (!init[s].pSysMem || !subresource_layout(info, s, row_bytes, rows, depth)) {
+      p.put(sd);
+      continue;
+    }
+    if (info.dim == D3D11_RESOURCE_DIMENSION_BUFFER) {
+      sd.blob = blob(init[s].pSysMem, info.width);
+      sd.row_pitch = sd.depth_pitch = info.width;
+    } else {
+      packed.resize(size_t(row_bytes) * rows * depth);
+      auto src = reinterpret_cast<const uint8_t *>(init[s].pSysMem);
+      for (uint32_t z = 0; z < depth; z++)
+        for (uint32_t y = 0; y < rows; y++)
+          std::memcpy(packed.data() + (size_t(z) * rows + y) * row_bytes,
+                      src + size_t(z) * init[s].SysMemSlicePitch + size_t(y) * init[s].SysMemPitch, row_bytes);
+      sd.blob = blob(packed.data(), packed.size());
+      sd.row_pitch = row_bytes;
+      sd.depth_pitch = row_bytes * rows;
+    }
+    p.put(sd);
+  }
+  if (prologue)
+    emit_prologue(op, p.b);
+  else
+    emit(device_->immediate(), op, p.b);
+}
+
+uint32_t
+Recorder::ref_resource(ID3D11Resource *res) {
+  if (!res)
+    return 0;
+  auto it = ids_.find(res);
+  if (it != ids_.end())
+    return it->second;
+  uint32_t id = next_id_++;
+  ids_[res] = id;
+  ResourceInfo info = describe(res);
+  info.id = id;
+  resources_[id] = info;
+  static const Op ops[] = {Op::Unsupported, Op::CreateBuffer, Op::CreateTexture1D, Op::CreateTexture2D,
+                           Op::CreateTexture3D};
+  emit_resource_create(ops[std::min<uint32_t>(info.dim, 4)], id, res, info, nullptr, true);
+  if (info.samples > 1) {
+    undefined_contents_++;
+    Payload p;
+    p.put(id).put(uint32_t(0));
+    emit_prologue(Op::ResourceContent, p.b);
+  } else {
+    readback_queue_.push_back({id, addref(res), nullptr, info});
+  }
+  return id;
+}
+
+void
+Recorder::emit_view_create(Op kind, uint32_t id, ID3D11View *view, uint32_t resource_id, bool prologue) {
+  Payload p;
+  p.put(id).put(resource_id);
+  switch (kind) {
+  case Op::CreateSRV: {
+    D3D11_SHADER_RESOURCE_VIEW_DESC d;
+    static_cast<ID3D11ShaderResourceView *>(view)->GetDesc(&d);
+    p.put(d);
+    break;
+  }
+  case Op::CreateUAV: {
+    D3D11_UNORDERED_ACCESS_VIEW_DESC d;
+    static_cast<ID3D11UnorderedAccessView *>(view)->GetDesc(&d);
+    p.put(d);
+    break;
+  }
+  case Op::CreateRTV: {
+    D3D11_RENDER_TARGET_VIEW_DESC d;
+    static_cast<ID3D11RenderTargetView *>(view)->GetDesc(&d);
+    p.put(d);
+    break;
+  }
+  case Op::CreateDSV: {
+    D3D11_DEPTH_STENCIL_VIEW_DESC d;
+    static_cast<ID3D11DepthStencilView *>(view)->GetDesc(&d);
+    p.put(d);
+    break;
+  }
+  default:
+    return;
+  }
+  if (prologue)
+    emit_prologue(kind, p.b);
+  else
+    emit(device_->immediate(), kind, p.b);
+}
+
+static Op
+view_kind(ID3D11View *view) {
+  void *probe = nullptr;
+  Op kind = Op::Unsupported;
+  if (SUCCEEDED(view->QueryInterface(__uuidof(ID3D11ShaderResourceView), &probe)))
+    kind = Op::CreateSRV;
+  else if (SUCCEEDED(view->QueryInterface(__uuidof(ID3D11UnorderedAccessView), &probe)))
+    kind = Op::CreateUAV;
+  else if (SUCCEEDED(view->QueryInterface(__uuidof(ID3D11RenderTargetView), &probe)))
+    kind = Op::CreateRTV;
+  else if (SUCCEEDED(view->QueryInterface(__uuidof(ID3D11DepthStencilView), &probe)))
+    kind = Op::CreateDSV;
+  if (probe)
+    static_cast<IUnknown *>(probe)->Release();
+  return kind;
+}
+
+uint32_t
+Recorder::ref_view(ID3D11View *view, Op kind) {
+  if (!view)
+    return 0;
+  auto it = ids_.find(view);
+  if (it != ids_.end())
+    return it->second;
+  if (kind == Op::Unsupported)
+    kind = view_kind(view);
+  ID3D11Resource *res = nullptr;
+  view->GetResource(&res);
+  uint32_t rid = ref_resource(res);
+  if (res)
+    res->Release();
+  uint32_t id = next_id_++;
+  ids_[view] = id;
+  emit_view_create(kind, id, view, rid, true);
+  return id;
+}
+
+void
+Recorder::emit_shader_create(uint32_t id, const ShaderInfo &info, bool prologue) {
+  Payload p;
+  p.put(id).put(info.stage).put(blob(info.bytecode->data(), info.bytecode->size()));
+  p.put(uint32_t(info.so.size())).put(uint32_t(info.strides.size())).put(info.rasterized_stream);
+  for (auto &e : info.so)
+    p.put(e);
+  for (auto s : info.strides)
+    p.put(s);
+  if (prologue)
+    emit_prologue(Op::CreateShader, p.b);
+  else
+    emit(device_->immediate(), Op::CreateShader, p.b);
+}
+
+uint32_t
+Recorder::ref_shader(ID3D11DeviceChild *shader) {
+  if (!shader)
+    return 0;
+  auto it = ids_.find(shader);
+  if (it != ids_.end())
+    return it->second;
+  auto info = shaders_.find(shader);
+  if (info == shaders_.end()) {
+    warnings_["shader created before the recorder was active"]++;
+    return 0;
+  }
+  uint32_t id = next_id_++;
+  ids_[shader] = id;
+  emit_shader_create(id, info->second, true);
+  return id;
+}
+
+void
+Recorder::emit_layout_create(uint32_t id, const LayoutInfo &info, bool prologue) {
+  Payload p;
+  p.put(id).put(uint32_t(info.elements.size())).put(blob(info.bytecode->data(), info.bytecode->size()));
+  for (auto &e : info.elements)
+    p.put(e);
+  if (prologue)
+    emit_prologue(Op::CreateInputLayout, p.b);
+  else
+    emit(device_->immediate(), Op::CreateInputLayout, p.b);
+}
+
+uint32_t
+Recorder::ref_layout(ID3D11InputLayout *layout) {
+  if (!layout)
+    return 0;
+  auto it = ids_.find(layout);
+  if (it != ids_.end())
+    return it->second;
+  auto info = layouts_.find(layout);
+  if (info == layouts_.end()) {
+    warnings_["input layout created before the recorder was active"]++;
+    return 0;
+  }
+  uint32_t id = next_id_++;
+  ids_[layout] = id;
+  emit_layout_create(id, info->second, true);
+  return id;
+}
+
+void
+Recorder::emit_state_create(uint32_t id, ID3D11DeviceChild *state, Op kind, bool prologue) {
+  Payload p;
+  p.put(id);
+  switch (kind) {
+  case Op::CreateBlendState: {
+    D3D11_BLEND_DESC1 d1 = {};
+    ID3D11BlendState1 *b1 = nullptr;
+    if (SUCCEEDED(state->QueryInterface(IID_PPV_ARGS(&b1)))) {
+      b1->GetDesc1(&d1);
+      b1->Release();
+    } else {
+      D3D11_BLEND_DESC d;
+      static_cast<ID3D11BlendState *>(state)->GetDesc(&d);
+      d1.AlphaToCoverageEnable = d.AlphaToCoverageEnable;
+      d1.IndependentBlendEnable = d.IndependentBlendEnable;
+      for (int i = 0; i < 8; i++) {
+        auto &s = d.RenderTarget[i];
+        d1.RenderTarget[i] = {s.BlendEnable,    FALSE,         s.SrcBlend,  s.DestBlend,
+                              s.BlendOp,        s.SrcBlendAlpha, s.DestBlendAlpha, s.BlendOpAlpha,
+                              D3D11_LOGIC_OP_NOOP, s.RenderTargetWriteMask};
+      }
+    }
+    p.put(d1);
+    break;
+  }
+  case Op::CreateDepthStencilState: {
+    D3D11_DEPTH_STENCIL_DESC d;
+    static_cast<ID3D11DepthStencilState *>(state)->GetDesc(&d);
+    p.put(d);
+    break;
+  }
+  case Op::CreateRasterizerState: {
+    D3D11_RASTERIZER_DESC2 d2 = {};
+    ID3D11RasterizerState2 *r2 = nullptr;
+    ID3D11RasterizerState1 *r1 = nullptr;
+    if (SUCCEEDED(state->QueryInterface(IID_PPV_ARGS(&r2)))) {
+      r2->GetDesc2(&d2);
+      r2->Release();
+    } else if (SUCCEEDED(state->QueryInterface(IID_PPV_ARGS(&r1)))) {
+      D3D11_RASTERIZER_DESC1 d1;
+      r1->GetDesc1(&d1);
+      r1->Release();
+      std::memcpy(&d2, &d1, sizeof d1);
+    } else {
+      D3D11_RASTERIZER_DESC d;
+      static_cast<ID3D11RasterizerState *>(state)->GetDesc(&d);
+      std::memcpy(&d2, &d, sizeof d);
+    }
+    p.put(d2);
+    break;
+  }
+  case Op::CreateSamplerState: {
+    D3D11_SAMPLER_DESC d;
+    static_cast<ID3D11SamplerState *>(state)->GetDesc(&d);
+    p.put(d);
+    break;
+  }
+  default:
+    return;
+  }
+  if (prologue)
+    emit_prologue(kind, p.b);
+  else
+    emit(device_->immediate(), kind, p.b);
+}
+
+uint32_t
+Recorder::ref_state(ID3D11DeviceChild *state, Op kind) {
+  if (!state)
+    return 0;
+  auto it = ids_.find(state);
+  if (it != ids_.end())
+    return it->second;
+  uint32_t id = next_id_++;
+  ids_[state] = id;
+  emit_state_create(id, state, kind, true);
+  return id;
+}
+
+uint32_t
+Recorder::ref_async(ID3D11Asynchronous *async) {
+  if (!async)
+    return 0;
+  auto it = ids_.find(async);
+  if (it != ids_.end())
+    return it->second;
+  ID3D11Query *query = nullptr;
+  if (FAILED(async->QueryInterface(IID_PPV_ARGS(&query)))) {
+    warnings_["counter objects are not recorded"]++;
+    return 0;
+  }
+  D3D11_QUERY_DESC desc;
+  query->GetDesc(&desc);
+  query->Release();
+  uint32_t id = next_id_++;
+  ids_[async] = id;
+  Payload p;
+  bool predicate = desc.Query == D3D11_QUERY_OCCLUSION_PREDICATE || desc.Query == D3D11_QUERY_SO_OVERFLOW_PREDICATE ||
+                   desc.Query == D3D11_QUERY_SO_OVERFLOW_PREDICATE_STREAM0 ||
+                   desc.Query == D3D11_QUERY_SO_OVERFLOW_PREDICATE_STREAM1 ||
+                   desc.Query == D3D11_QUERY_SO_OVERFLOW_PREDICATE_STREAM2 ||
+                   desc.Query == D3D11_QUERY_SO_OVERFLOW_PREDICATE_STREAM3;
+  p.put(id).put(desc).put(uint32_t(predicate));
+  emit_prologue(Op::CreateQuery, p.b);
+  return id;
+}
+
+// ---------------------------------------------------------------------------
+// Device notifications.
+
+void
+Recorder::OnCreateResource(ID3D11Resource *obj, const D3D11_SUBRESOURCE_DATA *init) {
+  census_creates_.fetch_add(1, std::memory_order_relaxed);
+  if (state_ != State::Recording)
+    return;
+  std::lock_guard<dxmt::recursive_mutex> lock(mutex_);
+  if (state_ != State::Recording || !device_)
+    return;
+  uint32_t id = next_id_++;
+  ids_[obj] = id;
+  ResourceInfo info = describe(obj);
+  info.id = id;
+  resources_[id] = info;
+  static const Op ops[] = {Op::Unsupported, Op::CreateBuffer, Op::CreateTexture1D, Op::CreateTexture2D,
+                           Op::CreateTexture3D};
+  emit_resource_create(ops[std::min<uint32_t>(info.dim, 4)], id, obj, info, init, false);
+}
+
+void
+Recorder::OnCreateView(ID3D11View *obj) {
+  census_creates_.fetch_add(1, std::memory_order_relaxed);
+  if (state_ != State::Recording)
+    return;
+  std::lock_guard<dxmt::recursive_mutex> lock(mutex_);
+  if (state_ != State::Recording || !device_)
+    return;
+  Op kind = view_kind(obj);
+  ID3D11Resource *res = nullptr;
+  obj->GetResource(&res);
+  uint32_t rid = ref_resource(res);
+  if (res)
+    res->Release();
+  uint32_t id = next_id_++;
+  ids_[obj] = id;
+  emit_view_create(kind, id, obj, rid, false);
+}
+
+void
+Recorder::OnCreateShader(ID3D11DeviceChild *obj, uint32_t stage, const void *bytecode, SIZE_T length,
+                         const D3D11_SO_DECLARATION_ENTRY *so, UINT so_count, const UINT *strides, UINT stride_count,
+                         UINT rasterized_stream) {
+  census_creates_.fetch_add(1, std::memory_order_relaxed);
+  std::lock_guard<dxmt::recursive_mutex> lock(mutex_);
+  ShaderInfo info;
+  info.stage = stage;
+  info.bytecode = std::make_shared<std::vector<uint8_t>>((const uint8_t *)bytecode, (const uint8_t *)bytecode + length);
+  for (UINT i = 0; i < so_count; i++) {
+    StreamOutElement e = {};
+    if (so[i].SemanticName)
+      std::strncpy(e.semantic, so[i].SemanticName, sizeof e.semantic - 1);
+    e.stream = so[i].Stream;
+    e.semantic_index = so[i].SemanticIndex;
+    e.start_component = so[i].StartComponent;
+    e.component_count = so[i].ComponentCount;
+    e.output_slot = so[i].OutputSlot;
+    info.so.push_back(e);
+  }
+  for (UINT i = 0; i < stride_count; i++)
+    info.strides.push_back(strides[i]);
+  info.rasterized_stream = rasterized_stream;
+  shaders_[obj] = info;
+  if (state_ == State::Recording && device_) {
+    uint32_t id = next_id_++;
+    ids_[obj] = id;
+    emit_shader_create(id, info, false);
+  }
+}
+
+void
+Recorder::OnCreateInputLayout(ID3D11InputLayout *obj, const D3D11_INPUT_ELEMENT_DESC *elements, UINT count,
+                              const void *bytecode, SIZE_T length) {
+  census_creates_.fetch_add(1, std::memory_order_relaxed);
+  std::lock_guard<dxmt::recursive_mutex> lock(mutex_);
+  LayoutInfo info;
+  for (UINT i = 0; i < count; i++) {
+    InputElement e = {};
+    if (elements[i].SemanticName)
+      std::strncpy(e.semantic, elements[i].SemanticName, sizeof e.semantic - 1);
+    e.semantic_index = elements[i].SemanticIndex;
+    e.format = elements[i].Format;
+    e.input_slot = elements[i].InputSlot;
+    e.aligned_byte_offset = elements[i].AlignedByteOffset;
+    e.input_slot_class = elements[i].InputSlotClass;
+    e.instance_data_step_rate = elements[i].InstanceDataStepRate;
+    info.elements.push_back(e);
+  }
+  info.bytecode = std::make_shared<std::vector<uint8_t>>((const uint8_t *)bytecode, (const uint8_t *)bytecode + length);
+  layouts_[obj] = info;
+  if (state_ == State::Recording && device_) {
+    uint32_t id = next_id_++;
+    ids_[obj] = id;
+    emit_layout_create(id, info, false);
+  }
+}
+
+void
+Recorder::OnCreateState(ID3D11DeviceChild *obj, Op kind) {
+  census_creates_.fetch_add(1, std::memory_order_relaxed);
+  if (state_ != State::Recording)
+    return;
+  std::lock_guard<dxmt::recursive_mutex> lock(mutex_);
+  if (state_ != State::Recording || !device_ || ids_.count(obj))
+    return;
+  uint32_t id = next_id_++;
+  ids_[obj] = id;
+  emit_state_create(id, obj, kind, false);
+}
+
+void
+Recorder::OnCreateQuery(ID3D11Query *obj, bool) {
+  census_creates_.fetch_add(1, std::memory_order_relaxed);
+  if (state_ != State::Recording)
+    return;
+  std::lock_guard<dxmt::recursive_mutex> lock(mutex_);
+  if (state_ != State::Recording || !device_)
+    return;
+  // Queries are rare and cheap: snapshot through the same path as pre-existing ones.
+  ref_async(obj);
+}
+
+void
+Recorder::OnCreateDeferredContext(RecordingContext *ctx, UINT flags) {
+  std::lock_guard<dxmt::recursive_mutex> lock(mutex_);
+  deferred_contexts_[ctx] = flags;
+  if (state_ == State::Recording && device_) {
+    Payload p;
+    p.put(uint32_t(ctx->id())).put(uint32_t(flags));
+    emit(device_->immediate(), Op::CreateDeferredContext, p.b);
+  }
+}
+
+// ---------------------------------------------------------------------------
+// Readbacks of pre-existing resources.
+
+void
+Recorder::issue_readback_copies(RecordingContext *imm) {
+  if (readback_queue_.empty())
+    return;
+  auto dev = imm->device()->real();
+  for (auto &rb : readback_queue_) {
+    ID3D11Resource *staging = nullptr;
+    HRESULT hr = E_FAIL;
+    auto &info = rb.info;
+    switch (info.dim) {
+    case D3D11_RESOURCE_DIMENSION_BUFFER: {
+      D3D11_BUFFER_DESC d = {info.width, D3D11_USAGE_STAGING, 0, D3D11_CPU_ACCESS_READ, 0, 0};
+      hr = dev->CreateBuffer(&d, nullptr, reinterpret_cast<ID3D11Buffer **>(&staging));
+      break;
+    }
+    case D3D11_RESOURCE_DIMENSION_TEXTURE1D: {
+      D3D11_TEXTURE1D_DESC d = {info.width, info.mips, info.array, DXGI_FORMAT(info.format), D3D11_USAGE_STAGING,
+                                0, D3D11_CPU_ACCESS_READ, 0};
+      hr = dev->CreateTexture1D(&d, nullptr, reinterpret_cast<ID3D11Texture1D **>(&staging));
+      break;
+    }
+    case D3D11_RESOURCE_DIMENSION_TEXTURE2D: {
+      D3D11_TEXTURE2D_DESC d = {info.width, info.height, info.mips, info.array, DXGI_FORMAT(info.format), {1, 0},
+                                D3D11_USAGE_STAGING, 0, D3D11_CPU_ACCESS_READ, 0};
+      hr = dev->CreateTexture2D(&d, nullptr, reinterpret_cast<ID3D11Texture2D **>(&staging));
+      break;
+    }
+    case D3D11_RESOURCE_DIMENSION_TEXTURE3D: {
+      D3D11_TEXTURE3D_DESC d = {info.width, info.height, info.depth, info.mips, DXGI_FORMAT(info.format),
+                                D3D11_USAGE_STAGING, 0, D3D11_CPU_ACCESS_READ, 0};
+      hr = dev->CreateTexture3D(&d, nullptr, reinterpret_cast<ID3D11Texture3D **>(&staging));
+      break;
+    }
+    default:
+      break;
+    }
+    if (FAILED(hr) || !staging) {
+      readback_failures_++;
+      warnings_["readback: staging creation failed"]++;
+      Payload p;
+      p.put(rb.id).put(uint32_t(0));
+      emit_prologue(Op::ResourceContent, p.b);
+      rb.source->Release();
+      continue;
+    }
+    imm->real()->CopyResource(staging, rb.source);
+    rb.source->Release();
+    rb.source = nullptr;
+    rb.staging = staging;
+    uint64_t bytes = info.width;
+    if (info.dim != D3D11_RESOURCE_DIMENSION_BUFFER) {
+      uint32_t bpb, bw, bh;
+      format_block(info.format, bpb, bw, bh);
+      bytes = uint64_t(info.width) * info.height * info.depth * info.array * std::max(1u, bpb / (bw * bh));
+    }
+    readback_inflight_bytes_ += bytes;
+    readback_inflight_.push_back(rb);
+  }
+  readback_queue_.clear();
+  if (readback_inflight_bytes_ > (256ull << 20))
+    complete_readbacks(imm);
+}
+
+void
+Recorder::complete_readbacks(RecordingContext *imm) {
+  std::vector<uint8_t> packed;
+  for (auto &rb : readback_inflight_) {
+    auto &info = rb.info;
+    uint32_t subresources = info.dim == D3D11_RESOURCE_DIMENSION_BUFFER    ? 1
+                            : info.dim == D3D11_RESOURCE_DIMENSION_TEXTURE3D ? info.mips
+                                                                             : info.mips * info.array;
+    Payload p;
+    p.put(rb.id).put(subresources);
+    bool failed = false;
+    for (uint32_t s = 0; s < subresources; s++) {
+      SubData sd;
+      uint32_t row_bytes, rows, depth;
+      D3D11_MAPPED_SUBRESOURCE m;
+      if (!subresource_layout(info, s, row_bytes, rows, depth) ||
+          FAILED(imm->real()->Map(rb.staging, s, D3D11_MAP_READ, 0, &m))) {
+        failed = true;
+        p.put(sd);
+        continue;
+      }
+      packed.resize(size_t(row_bytes) * rows * depth);
+      auto src = reinterpret_cast<const uint8_t *>(m.pData);
+      if (info.dim == D3D11_RESOURCE_DIMENSION_BUFFER) {
+        std::memcpy(packed.data(), src, row_bytes);
+      } else {
+        for (uint32_t z = 0; z < depth; z++)
+          for (uint32_t y = 0; y < rows; y++)
+            std::memcpy(packed.data() + (size_t(z) * rows + y) * row_bytes,
+                        src + size_t(z) * m.DepthPitch + size_t(y) * m.RowPitch, row_bytes);
+      }
+      imm->real()->Unmap(rb.staging, s);
+      sd.blob = blob(packed.data(), packed.size());
+      sd.row_pitch = row_bytes;
+      sd.depth_pitch = row_bytes * rows;
+      p.put(sd);
+    }
+    if (failed) {
+      readback_failures_++;
+      warnings_["readback: map failed"]++;
+    }
+    emit_prologue(Op::ResourceContent, p.b);
+    rb.staging->Release();
+  }
+  readback_inflight_.clear();
+  readback_inflight_bytes_ = 0;
+}
