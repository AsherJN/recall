diff --git a/tools/gen_recorder_proxy.py b/tools/gen_recorder_proxy.py
new file mode 100644
index 0000000..b418df9
--- /dev/null
+++ b/tools/gen_recorder_proxy.py
@@ -0,0 +1,153 @@
+#!/usr/bin/env python3
+"""Generate the recorder's pass-through device and context classes.
+
+Parses the C++ interface declarations of ID3D11Device..5 and
+ID3D11DeviceContext..4 from include/native/directx and writes
+src/d3d11/d3d11_recorder_proxy.gen.hpp. Every method forwards to the real DXMT
+object. Methods listed in RECORDED_* first call the recorder hook of the same
+name (declared in d3d11_recorder.hpp); methods in MANUAL_* are only declared
+here and defined by hand in d3d11_recorder.cpp.
+
+Run from the repository root of the DXMT tree: python3 tools/gen_recorder_proxy.py
+"""
+from pathlib import Path
+import re
+
+ROOT = Path(__file__).resolve().parents[1]
+HEADERS = [ROOT / 'include/native/directx' / n for n in
+           ('d3d11.h', 'd3d11_1.h', 'd3d11_2.h', 'd3d11_3.h', 'd3d11_4.h')]
+OUT = ROOT / 'src/d3d11/d3d11_recorder_proxy.gen.hpp'
+
+CONTEXT_CHAIN = ['ID3D11DeviceContext', 'ID3D11DeviceContext1', 'ID3D11DeviceContext2',
+                 'ID3D11DeviceContext3', 'ID3D11DeviceContext4']
+DEVICE_CHAIN = ['ID3D11Device', 'ID3D11Device1', 'ID3D11Device2', 'ID3D11Device3',
+                'ID3D11Device4', 'ID3D11Device5']
+
+STAGES = ('VS', 'HS', 'DS', 'GS', 'PS', 'CS')
+RECORDED_CONTEXT = {
+    *(f'{s}SetShader' for s in STAGES),
+    *(f'{s}SetShaderResources' for s in STAGES),
+    *(f'{s}SetSamplers' for s in STAGES),
+    *(f'{s}SetConstantBuffers' for s in STAGES),
+    *(f'{s}SetConstantBuffers1' for s in STAGES),
+    'IASetInputLayout', 'IASetVertexBuffers', 'IASetIndexBuffer', 'IASetPrimitiveTopology',
+    'RSSetState', 'RSSetViewports', 'RSSetScissorRects',
+    'OMSetRenderTargets', 'OMSetRenderTargetsAndUnorderedAccessViews', 'OMSetBlendState',
+    'OMSetDepthStencilState', 'SOSetTargets', 'CSSetUnorderedAccessViews',
+    'Draw', 'DrawIndexed', 'DrawInstanced', 'DrawIndexedInstanced', 'DrawAuto',
+    'DrawInstancedIndirect', 'DrawIndexedInstancedIndirect', 'Dispatch', 'DispatchIndirect',
+    'Begin', 'End', 'SetPredication',
+    'UpdateSubresource', 'UpdateSubresource1', 'CopyResource', 'CopySubresourceRegion',
+    'CopySubresourceRegion1', 'CopyStructureCount',
+    'ClearRenderTargetView', 'ClearUnorderedAccessViewUint', 'ClearUnorderedAccessViewFloat',
+    'ClearDepthStencilView', 'ClearView', 'GenerateMips', 'SetResourceMinLOD', 'ResolveSubresource',
+    'DiscardResource', 'DiscardView', 'DiscardView1', 'ClearState', 'Flush', 'ExecuteCommandList',
+    'SwapDeviceContextState', 'Signal', 'Wait', 'UpdateTileMappings', 'CopyTileMappings', 'CopyTiles',
+    'UpdateTiles', 'ResizeTilePool', 'TiledResourceBarrier',
+}
+MANUAL_CONTEXT = {'Map', 'Unmap', 'FinishCommandList', 'GetDevice'}
+
+RECORDED_DEVICE = set()
+MANUAL_DEVICE = {
+    'CreateBuffer', 'CreateTexture1D', 'CreateTexture2D', 'CreateTexture3D', 'CreateTexture2D1',
+    'CreateTexture3D1', 'CreateShaderResourceView', 'CreateShaderResourceView1',
+    'CreateUnorderedAccessView', 'CreateUnorderedAccessView1', 'CreateRenderTargetView',
+    'CreateRenderTargetView1', 'CreateDepthStencilView', 'CreateInputLayout', 'CreateVertexShader',
+    'CreateGeometryShader', 'CreateGeometryShaderWithStreamOutput', 'CreatePixelShader',
+    'CreateHullShader', 'CreateDomainShader', 'CreateComputeShader', 'CreateBlendState',
+    'CreateBlendState1', 'CreateDepthStencilState', 'CreateRasterizerState', 'CreateRasterizerState1',
+    'CreateRasterizerState2', 'CreateSamplerState', 'CreateQuery', 'CreateQuery1', 'CreatePredicate',
+    'CreateDeferredContext', 'CreateDeferredContext1', 'CreateDeferredContext2', 'CreateDeferredContext3',
+    'GetImmediateContext', 'GetImmediateContext1', 'GetImmediateContext2', 'GetImmediateContext3',
+}
+
+METHOD = re.compile(r'virtual\s+(.+?)\s+STDMETHODCALLTYPE\s+(\w+)\(\s*(.*?)\)\s*=\s*0;', re.S)
+
+
+def interface_body(text, name):
+    start = re.search(rf'^{name} : public \w+\s*\n{{', text, re.M)
+    if not start:
+        return None
+    depth, i = 0, start.end() - 1
+    while True:
+        if text[i] == '{':
+            depth += 1
+        elif text[i] == '}':
+            depth -= 1
+            if depth == 0:
+                return text[start.end():i]
+        i += 1
+
+
+def split_params(params):
+    params = ' '.join(params.split())
+    if not params or params == 'void':
+        return []
+    out, depth, cur = [], 0, ''
+    for ch in params:
+        if ch == ',' and depth == 0:
+            out.append(cur.strip())
+            cur = ''
+            continue
+        depth += ch in '([' and 1 or ch in ')]' and -1 or 0
+        cur += ch
+    out.append(cur.strip())
+    return out
+
+
+def param_name(decl):
+    return re.match(r'.*?(\w+)\s*(\[\w*\])?$', decl).group(1)
+
+
+def methods(chain):
+    texts = [h.read_text() for h in HEADERS]
+    seen, result = set(), []
+    for name in chain:
+        body = next(b for b in (interface_body(t, name) for t in texts) if b is not None)
+        for ret, method, params in METHOD.findall(body):
+            if method in seen:
+                continue
+            seen.add(method)
+            decls = split_params(params)
+            result.append((name, ' '.join(ret.split()), method, decls, [param_name(d) for d in decls]))
+    return result
+
+
+def emit(chain, recorded, manual, cls):
+    lines = []
+    for iface, ret, method, decls, names in methods(chain):
+        signature = f'{ret} STDMETHODCALLTYPE {method}({", ".join(decls)}) override'
+        if method in manual:
+            lines.append(f'  {signature};')
+            continue
+        call = f'real_->{method}({", ".join(names)})'
+        hook = f'    if (rec_->active()) rec_->{method}({", ".join(["this"] + names)});\n' if method in recorded else ''
+        body = f'    return {call};' if ret != 'void' else f'    {call};'
+        lines.append(f'  {signature} {{\n{hook}{body}\n  }}')
+    return '\n'.join(lines)
+
+
+def main():
+    context = emit(CONTEXT_CHAIN, RECORDED_CONTEXT, MANUAL_CONTEXT, 'RecordingContext')
+    device = emit(DEVICE_CHAIN, RECORDED_DEVICE, MANUAL_DEVICE, 'RecordingDevice')
+    missing = (RECORDED_CONTEXT | MANUAL_CONTEXT) - {m for _, _, m, _, _ in methods(CONTEXT_CHAIN)} - {'GetDevice'}
+    if missing:
+        raise SystemExit(f'Unknown context methods: {sorted(missing)}')
+    missing = MANUAL_DEVICE - {m for _, _, m, _, _ in methods(DEVICE_CHAIN)}
+    if missing:
+        raise SystemExit(f'Unknown device methods: {sorted(missing)}')
+    OUT.write_text(f'''// Generated by tools/gen_recorder_proxy.py; do not edit.
+// Pass-through bodies for RecordingContext and RecordingDevice (d3d11_recorder.hpp).
+#pragma once
+
+#define DXMT_RECORDING_CONTEXT_METHODS \\
+{context.replace(chr(10), ' \\' + chr(10))}
+
+#define DXMT_RECORDING_DEVICE_METHODS \\
+{device.replace(chr(10), ' \\' + chr(10))}
+''')
+    print(f'Wrote {OUT.relative_to(ROOT)}')
+
+
+if __name__ == '__main__':
+    main()
