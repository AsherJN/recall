+RecordingDevice::RecordingDevice(Recorder *rec, ID3D11Device5 *real) : rec_(rec), real_(real) {
+  refs_ = 0;
+  real_->AddRef();
+  ID3D11DeviceContext3 *ctx3 = nullptr;
+  real_->GetImmediateContext3(&ctx3);
+  ID3D11DeviceContext4 *ctx4 = nullptr;
+  ctx3->QueryInterface(IID_PPV_ARGS(&ctx4));
+  ctx3->Release();
+  immediate_ = new RecordingContext(rec, this, ctx4, 0, true);
+}
+
+RecordingDevice::~RecordingDevice() {
+  delete immediate_;
+  real_->Release();
+}
+
+HRESULT STDMETHODCALLTYPE
+RecordingDevice::QueryInterface(REFIID riid, void **ppvObject) {
+  if (!ppvObject)
+    return E_POINTER;
+  if (riid == __uuidof(ID3D11Device) || riid == __uuidof(ID3D11Device1) || riid == __uuidof(ID3D11Device2) ||
+      riid == __uuidof(ID3D11Device3) || riid == __uuidof(ID3D11Device4) || riid == __uuidof(ID3D11Device5)) {
+    *ppvObject = static_cast<ID3D11Device5 *>(this);
+    AddRef();
+    return S_OK;
+  }
+  return real_->QueryInterface(riid, ppvObject);
+}
+
+ULONG STDMETHODCALLTYPE
+RecordingDevice::AddRef() {
+  return ++refs_;
+}
+
+ULONG STDMETHODCALLTYPE
+RecordingDevice::Release() {
+  auto refs = --refs_;
+  if (!refs) {
+    {
+      std::lock_guard<dxmt::mutex> lock(g_proxies_mutex);
+      g_proxies.erase(real_);
+    }
+    rec_->OnDeviceDestroyed(this);
+    delete this;
+  }
+  return refs;
+}
