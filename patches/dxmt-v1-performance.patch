+    std::snprintf(buf, sizeof buf, " %s:%u:%c%c@%05x", name, (unsigned)view.texture().pixelFormat(), bench_load(load),
+                  bench_store(store), (unsigned)(((uintptr_t)view->allocation >> 4) & 0xfffff));
+    label += buf;
+  };
+  for (unsigned i = 0; i < data->colors.size(); i++) {
+    char name[4] = {'c', char('0' + i), 0};
+    attachment(name, data->colors[i].attachment, data->colors[i].load_action, data->colors[i].store_action);
+  }
+  attachment("d", data->depth.attachment, data->depth.load_action, data->depth.store_action);
+  attachment("s", data->stencil.attachment, data->stencil.load_action, data->stencil.store_action);
+  unsigned draws = bench_count(&data->cmd_head, [](uint16_t type) {
+    return (type >= WMTRenderCommandDraw && type <= WMTRenderCommandDrawMeshThreadgroupsIndirect) ||
+           (type >= WMTRenderCommandDXMTGeometryDraw && type <= WMTRenderCommandDXMTGeometryDrawIndexedIndirect) ||
