+void
+Recorder::ExecuteCommandList(RecordingContext *c, ID3D11CommandList *list, WINBOOL restore) {
+  REC_BEGIN(ExecuteCommandList)
+  uint32_t id = 0;
+  auto it = ids_.find(list);
+  if (it != ids_.end())
+    id = it->second;
+  else
+    warnings_["command list recorded before the recording started"]++;
+  p.put(id).put(uint32_t(restore));
+  emit(c, Op::ExecuteCommandList, p.b);
+}
+
+void
+Recorder::OnFinishCommandList(RecordingContext *c, WINBOOL restore, ID3D11CommandList *list) {
+  census_ops_[size_t(Op::FinishCommandList)].fetch_add(1, std::memory_order_relaxed);
+  c->has_pending_calls.store(false, std::memory_order_relaxed);
+  if (state_ != State::Recording)
+    return;
+  std::lock_guard<dxmt::recursive_mutex> lock(mutex_);
+  if (!c->deferred_clean) {
+    c->deferred_clean = true;
+    c->deferred_records.clear();
+    return;
+  }
+  // The deferred context's calls go into the stream now, followed by the list.
+  stream_.append(c->deferred_records.data(), c->deferred_records.size());
+  c->deferred_records.clear();
+  uint32_t id = next_id_++;
+  ids_[list] = id;
+  Payload p;
+  p.put(uint32_t(restore)).put(id);
+  RecordHeader header{uint16_t(Op::FinishCommandList), c->id(), uint32_t(p.b.size())};
+  stream_.append(&header, sizeof header);
+  stream_.append(p.b.data(), p.b.size());
+  stream_records_++;
+}
+
+// ---------------------------------------------------------------------------
+// Map and Unmap.
+
+void
+Recorder::BeforeMap(RecordingContext *c, ID3D11Resource *res) {
+  if (!enter(c, Op::MapWrite))
+    return;
+  std::lock_guard<dxmt::recursive_mutex> lock(mutex_);
+  ref_resource(res);
+  if (c->immediate())
+    issue_readback_copies(c);
+}
+
+void
+Recorder::OnMap(RecordingContext *c, ID3D11Resource *res, UINT sub, D3D11_MAP type, UINT flags,
+                D3D11_MAPPED_SUBRESOURCE *mapped) {
+  census_maps_[std::min<uint32_t>(type, 5)].fetch_add(1, std::memory_order_relaxed);
+  if (state_ != State::Recording || (!c->immediate() && !c->deferred_clean))
+    return;
+  std::lock_guard<dxmt::recursive_mutex> lock(mutex_);
+  auto it = ids_.find(res);
+  if (it == ids_.end())
+    return;
+  auto &info = resources_[it->second];
+  if (type == D3D11_MAP_READ) {
+    Payload p;
+    p.put(it->second).put(sub).put(uint32_t(type)).put(flags);
+    emit(c, Op::MapRead, p.b);
+    return;
+  }
+  PendingMap pm = {};
+  pm.id = it->second;
+  pm.sub = sub;
+  pm.type = type;
+  pm.flags = flags;
+  pm.data = reinterpret_cast<uint8_t *>(mapped->pData);
+  pm.row_pitch = mapped->RowPitch;
+  pm.depth_pitch = mapped->DepthPitch;
+  pm.buffer = info.dim == D3D11_RESOURCE_DIMENSION_BUFFER;
+  if (pm.buffer) {
+    pm.size = info.width;
+    census_map_bytes_[std::min<uint32_t>(type, 5)].fetch_add(pm.size, std::memory_order_relaxed);
+  } else if (!subresource_layout(info, sub, pm.row_bytes, pm.rows, pm.depth)) {
+    warnings_["map of unsized texture format"]++;
+    return;
+  }
+  // Discarded memory is undefined: zero it so unwritten bytes deduplicate and
+  // trailing zeros can be trimmed.
+  if (type == D3D11_MAP_WRITE_DISCARD) {
+    if (pm.buffer) {
+      std::memset(pm.data, 0, pm.size);
+    } else {
+      for (uint32_t z = 0; z < pm.depth; z++)
+        for (uint32_t y = 0; y < pm.rows; y++)
+          std::memset(pm.data + size_t(z) * pm.depth_pitch + size_t(y) * pm.row_pitch, 0, pm.row_bytes);
+    }
+  }
+  pending_maps_[map_key(res, sub)] = pm;
+}
+
+void
+Recorder::OnUnmap(RecordingContext *c, ID3D11Resource *res, UINT sub) {
+  if (state_ != State::Recording)
+    return;
+  std::lock_guard<dxmt::recursive_mutex> lock(mutex_);
+  auto it = pending_maps_.find(map_key(res, sub));
+  if (it == pending_maps_.end())
+    return;
+  PendingMap pm = it->second;
+  pending_maps_.erase(it);
+  Payload p;
+  MapWritePayload head = {pm.id, pm.sub, pm.type, pm.flags, uint32_t(MapKind::Whole), pm.size, 0, 0};
+  if (!pm.buffer) {
+    head.kind = uint32_t(MapKind::Rows);
+    std::vector<uint8_t> packed(size_t(pm.row_bytes) * pm.rows * pm.depth);
+    for (uint32_t z = 0; z < pm.depth; z++)
+      for (uint32_t y = 0; y < pm.rows; y++)
+        std::memcpy(packed.data() + (size_t(z) * pm.rows + y) * pm.row_bytes,
+                    pm.data + size_t(z) * pm.depth_pitch + size_t(y) * pm.row_pitch, pm.row_bytes);
+    TextureRows rows = {pm.row_bytes, pm.rows, pm.depth, 0, blob(packed.data(), packed.size())};
+    p.put(head).put(rows);
+    emit(c, Op::MapWrite, p.b);
+    return;
+  }
+  auto shadow = shadows_.find(pm.id);
+  if (pm.type == D3D11_MAP_WRITE_NO_OVERWRITE && shadow != shadows_.end() && shadow->second.size() == pm.size) {
+    // Only the changed ranges, compared in 64-byte blocks; gaps under 256 bytes merge.
+    auto &old = shadow->second;
+    std::vector<std::pair<uint32_t, uint32_t>> ranges;
+    constexpr uint32_t kBlock = 64, kGap = 256;
+    uint32_t i = 0;
+    while (i < pm.size) {
+      uint32_t len = std::min(kBlock, pm.size - i);
+      if (std::memcmp(pm.data + i, old.data() + i, len) == 0) {
+        i += len;
+        continue;
+      }
+      uint32_t start = i, end = i + len, gap = 0;
+      i += len;
+      while (i < pm.size && gap < kGap) {
+        uint32_t l = std::min(kBlock, pm.size - i);
+        if (std::memcmp(pm.data + i, old.data() + i, l) != 0) {
+          end = i + l;
+          gap = 0;
+        } else {
+          gap += l;
+        }
+        i += l;
+      }
+      ranges.push_back({start, end});
+    }
+    head.kind = uint32_t(MapKind::Ranges);
+    head.count = uint32_t(ranges.size());
+    p.put(head);
+    for (auto [start, end] : ranges) {
+      Range r = {start, 0, blob(pm.data + start, end - start)};
+      p.put(r);
+      std::memcpy(old.data() + start, pm.data + start, end - start);
+    }
+    emit(c, Op::MapWrite, p.b);
+    return;
+  }
+  uint32_t len = pm.size;
+  if (pm.type == D3D11_MAP_WRITE_DISCARD)
+    while (len && pm.data[len - 1] == 0)
+      len--;
+  p.put(head).put(blob(pm.data, len));
+  emit(c, Op::MapWrite, p.b);
+  if (pm.type == D3D11_MAP_WRITE_NO_OVERWRITE || shadow != shadows_.end())
+    shadows_[pm.id].assign(pm.data, pm.data + pm.size);
+}
+
+// ---------------------------------------------------------------------------
+// Frames.
+
+void
+Recorder::write_checkpoint(RecordingContext *imm, ID3D11Texture2D *backbuffer) {
+  D3D11_TEXTURE2D_DESC d;
+  backbuffer->GetDesc(&d);
+  uint32_t bytes, bw, bh;
+  if (d.SampleDesc.Count > 1 || !format_block(d.Format, bytes, bw, bh))
+    return;
+  if (!checkpoint_staging_) {
+    D3D11_TEXTURE2D_DESC s = {d.Width, d.Height, 1, 1, d.Format, {1, 0}, D3D11_USAGE_STAGING, 0,
+                              D3D11_CPU_ACCESS_READ, 0};
+    if (FAILED(imm->device()->real()->CreateTexture2D(&s, nullptr, &checkpoint_staging_)))
+      return;
+  }
+  imm->real()->CopyResource(checkpoint_staging_, backbuffer);
+  D3D11_MAPPED_SUBRESOURCE m;
+  if (FAILED(imm->real()->Map(checkpoint_staging_, 0, D3D11_MAP_READ, 0, &m)))
+    return;
+  uint32_t row_bytes = d.Width * bytes;
+  std::vector<uint8_t> packed(size_t(row_bytes) * d.Height);
+  for (uint32_t y = 0; y < d.Height; y++)
+    std::memcpy(packed.data() + size_t(y) * row_bytes, (const uint8_t *)m.pData + size_t(y) * m.RowPitch, row_bytes);
+  imm->real()->Unmap(checkpoint_staging_, 0);
+  CheckpointPayload cp = {recorded_frames_, d.Width, d.Height, uint32_t(d.Format), row_bytes,
+                          blob(packed.data(), packed.size())};
+  Payload p;
+  p.put(cp);
+  emit(imm, Op::FrameCheckpoint, p.b);
+}
+
+void
+Recorder::OnPresent(RecordingDevice *device, ID3D11Texture2D *backbuffer, UINT sync, UINT flags) {
+  std::lock_guard<dxmt::recursive_mutex> lock(mutex_);
+  if (!device_)
+    device_ = device;
+  if (device != device_)
+    return;
+  present_count_++;
+  census_tick(false);
+  auto imm = device->immediate();
+  // Control-Alt-B. Wine's Mac driver sends Command as Alt and ignores Option, so
+  // on a Mac this is Control-Command-B.
+  bool keys = (GetAsyncKeyState(VK_CONTROL) & 0x8000) && (GetAsyncKeyState(VK_MENU) & 0x8000) &&
+              (GetAsyncKeyState('B') & 0x8000);
+  bool pressed = keys && !hotkey_down_;
+  hotkey_down_ = keys;
+
+  if (state_ == State::Recording) {
+    uint32_t bb = ref_resource(backbuffer);
+    if (!backbuffer_id_) {
+      backbuffer_id_ = bb;
+      Payload p;
+      p.put(bb);
+      emit_prologue(Op::Backbuffer, p.b);
+    }
+    issue_readback_copies(imm);
+    recorded_frames_++;
+    if (recorded_frames_ <= 3 || recorded_frames_ % checkpoint_interval_ == 0)
+      write_checkpoint(imm, backbuffer);
+    Payload p;
+    p.put(sync).put(flags).put(uint64_t(recorded_frames_));
+    emit(imm, Op::Present, p.b);
+    complete_readbacks(imm);
+    if (pressed)
+      finish_recording(imm, "hotkey");
+    else if (stop_requested_)
+      finish_recording(imm, "size limit");
+    else if (recorded_frames_ >= frames_per_recording_)
+      finish_recording(imm, "frame count");
+    else if (recorded_frames_ % 30 == 0)
+      write_status("recording");
+    return;
+  }
+  if (state_ == State::Idle && (pressed || (start_frame_ && present_count_ == start_frame_))) {
+    state_ = State::Armed;
+    write_status("armed");
+  }
+}
+
+} // namespace dxmt
