+static HRESULT stream_enumerate_transforms(IMFMediaType *input_type, IMFMediaType *output_type, BOOL use_encoder,
+        BOOL match_input, IMFAttributes *attributes, IMFActivate ***activates, UINT32 *count)
+{
+    UINT32 flags = MFT_ENUM_FLAG_SYNCMFT | MFT_ENUM_FLAG_LOCALMFT | MFT_ENUM_FLAG_SORTANDFILTER;
+    UINT32 disable_converters = 0, use_hardware = 0;
+    MFT_REGISTER_TYPE_INFO input_info, output_info;
+    GUID category;
+    HRESULT hr;
+
+    *activates = NULL;
+    *count = 0;
+    if (attributes)
+    {
+        IMFAttributes_GetUINT32(attributes, &MF_READWRITE_DISABLE_CONVERTERS, &disable_converters);
+        IMFAttributes_GetUINT32(attributes, &MF_READWRITE_ENABLE_HARDWARE_TRANSFORMS, &use_hardware);
+    }
+    if (use_hardware) flags |= MFT_ENUM_FLAG_HARDWARE;
+    if (!use_encoder && disable_converters) return MF_E_TOPO_CODEC_NOT_FOUND;
+
+    if (FAILED(hr = IMFMediaType_GetMajorType(input_type, &input_info.guidMajorType))
+            || FAILED(hr = IMFMediaType_GetGUID(input_type, &MF_MT_SUBTYPE, &input_info.guidSubtype))
+            || FAILED(hr = IMFMediaType_GetMajorType(output_type, &output_info.guidMajorType))
+            || FAILED(hr = IMFMediaType_GetGUID(output_type, &MF_MT_SUBTYPE, &output_info.guidSubtype)))
+        return hr;
+
+    if (IsEqualGUID(&output_info.guidMajorType, &MFMediaType_Video))
+        category = use_encoder ? MFT_CATEGORY_VIDEO_ENCODER : MFT_CATEGORY_VIDEO_PROCESSOR;
+    else if (IsEqualGUID(&output_info.guidMajorType, &MFMediaType_Audio))
+        category = use_encoder ? MFT_CATEGORY_AUDIO_ENCODER : MFT_CATEGORY_AUDIO_EFFECT;
+    else
+        return MF_E_TOPO_CODEC_NOT_FOUND;
+
+    if (FAILED(hr = MFTEnumEx(category, flags, match_input ? &input_info : NULL, &output_info, activates, count)))
+        return hr;
+    return *count ? S_OK : MF_E_TOPO_CODEC_NOT_FOUND;
+}
+
+static void release_activates(IMFActivate **activates, UINT32 count)
+{
+    UINT32 i;
+
+    for (i = 0; i < count; ++i)
+        IMFActivate_Release(activates[i]);
+    CoTaskMemFree(activates);
+}
+
+/* Output first, as encoders need; input first for transforms that ask for that. */
+static HRESULT transform_set_types(IMFTransform *transform, IMFMediaType *input_type, IMFMediaType *output_type)
+{
+    HRESULT hr;
+
+    if (SUCCEEDED(hr = IMFTransform_SetOutputType(transform, 0, output_type, 0)))
+    {
+        if (SUCCEEDED(hr = IMFTransform_SetInputType(transform, 0, input_type, 0)))
+            return hr;
+        IMFTransform_SetOutputType(transform, 0, NULL, 0);
+    }
+    if (SUCCEEDED(hr = IMFTransform_SetInputType(transform, 0, input_type, 0))
+            && SUCCEEDED(hr = IMFTransform_SetOutputType(transform, 0, output_type, 0)))
+        return hr;
+    IMFTransform_SetInputType(transform, 0, NULL, 0);
+    return hr;
+}
+
+static HRESULT stream_create_converter(struct stream *stream, IMFMediaType *input_type, IMFMediaType *output_type,
+        IMFAttributes *attributes)
+{
+    IMFActivate **activates;
+    IMFTransform *transform;
+    UINT32 count, i;
+    HRESULT hr;
+
+    if (FAILED(hr = stream_enumerate_transforms(input_type, output_type, FALSE, TRUE, attributes, &activates, &count)))
+        return hr;
+    for (i = 0; i < count; ++i)
+    {
+        if (FAILED(IMFActivate_ActivateObject(activates[i], &IID_IMFTransform, (void **)&transform)))
+            continue;
+        if (SUCCEEDED(hr = transform_set_types(transform, input_type, output_type)))
+        {
+            TRACE("Created converter %p.\n", transform);
+            stream->converter = transform;
+            break;
+        }
+        IMFTransform_Release(transform);
+        IMFActivate_ShutdownObject(activates[i]);
+    }
+    release_activates(activates, count);
+    return stream->converter ? S_OK : MF_E_TOPO_CODEC_NOT_FOUND;
+}
+
+/* A converter alone when the stream takes uncompressed data; otherwise an encoder,
+ * taking the input as it is or after a converter. */
+static HRESULT stream_create_transforms(struct stream *stream, IMFMediaType *input_type, IMFMediaType *output_type,
+        IMFAttributes *attributes)
+{
+    IMFMediaType *encoder_input;
+    IMFActivate **activates;
+    IMFTransform *transform;
+    UINT32 count, i;
+    DWORD index;
+    HRESULT hr;
+
+    if (SUCCEEDED(stream_create_converter(stream, input_type, output_type, attributes)))
+        return S_OK;
+
+    if (FAILED(hr = stream_enumerate_transforms(input_type, output_type, TRUE, FALSE, attributes, &activates, &count)))
+    {
+        WARN("No encoder for %s, hr %#lx.\n", debugstr_guid(&stream->major_type), hr);
+        return hr;
+    }
+    for (i = 0; i < count && !stream->encoder; ++i)
+    {
+        if (FAILED(IMFActivate_ActivateObject(activates[i], &IID_IMFTransform, (void **)&transform)))
+            continue;
+        if (SUCCEEDED(transform_set_types(transform, input_type, output_type)))
+        {
+            stream->encoder = transform;
+            break;
+        }
+        if (SUCCEEDED(IMFTransform_SetOutputType(transform, 0, output_type, 0)))
+        {
+            for (index = 0; !stream->encoder
+                    && SUCCEEDED(IMFTransform_GetInputAvailableType(transform, 0, index, &encoder_input)); ++index)
+            {
+                if (SUCCEEDED(IMFTransform_SetInputType(transform, 0, encoder_input, 0))
+                        && SUCCEEDED(stream_create_converter(stream, input_type, encoder_input, attributes)))
+                    stream->encoder = transform;
+                IMFMediaType_Release(encoder_input);
+            }
+        }
+        if (!stream->encoder)
+        {
+            IMFTransform_Release(transform);
+            IMFActivate_ShutdownObject(activates[i]);
+        }
+    }
+    release_activates(activates, count);
+    if (!stream->encoder) return MF_E_TOPO_CODEC_NOT_FOUND;
+    TRACE("Created encoder %p.\n", stream->encoder);
+    return S_OK;
+}
