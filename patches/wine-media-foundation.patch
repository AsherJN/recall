+/* Takes every sample a transform has ready and passes each one on. */
+static HRESULT stream_pull(struct stream *stream, unsigned int stage)
+{
+    IMFTransform *transforms[2], *transform;
+    MFT_OUTPUT_DATA_BUFFER output;
+    MFT_OUTPUT_STREAM_INFO info;
+    IMFMediaBuffer *buffer;
+    IMFMediaType *type;
+    DWORD status;
+    HRESULT hr;
+
+    stream_transforms(stream, transforms);
+    transform = transforms[stage];
+    for (;;)
+    {
+        if (FAILED(hr = IMFTransform_GetOutputStreamInfo(transform, 0, &info))) return hr;
+        memset(&output, 0, sizeof(output));
+        if (!(info.dwFlags & (MFT_OUTPUT_STREAM_PROVIDES_SAMPLES | MFT_OUTPUT_STREAM_CAN_PROVIDE_SAMPLES)))
+        {
+            if (FAILED(hr = MFCreateAlignedMemoryBuffer(max(info.cbSize, 1),
+                    info.cbAlignment ? info.cbAlignment - 1 : 0, &buffer)))
+                return hr;
+            if (SUCCEEDED(hr = MFCreateSample(&output.pSample)))
+                hr = IMFSample_AddBuffer(output.pSample, buffer);
+            IMFMediaBuffer_Release(buffer);
+            if (FAILED(hr))
+            {
+                if (output.pSample) IMFSample_Release(output.pSample);
+                return hr;
+            }
+        }
+
+        status = 0;
+        hr = IMFTransform_ProcessOutput(transform, 0, 1, &output, &status);
+        if (output.pEvents) IMFCollection_Release(output.pEvents);
+        if (hr == MF_E_TRANSFORM_STREAM_CHANGE)
+        {
+            if (output.pSample) IMFSample_Release(output.pSample);
+            if (FAILED(hr = IMFTransform_GetOutputAvailableType(transform, 0, 0, &type))) return hr;
+            hr = IMFTransform_SetOutputType(transform, 0, type, 0);
+            IMFMediaType_Release(type);
+            if (FAILED(hr)) return hr;
+            continue;
+        }
+        if (FAILED(hr))
+        {
+            if (output.pSample) IMFSample_Release(output.pSample);
+            return hr == MF_E_TRANSFORM_NEED_MORE_INPUT ? S_OK : hr;
+        }
+        hr = output.pSample ? stream_push(stream, stage + 1, output.pSample) : S_OK;
+        if (output.pSample) IMFSample_Release(output.pSample);
+        if (FAILED(hr)) return hr;
+    }
+}
+
+/* Feeds a sample to a stage of the stream's transforms; past the last one it waits for the sink. */
+static HRESULT stream_push(struct stream *stream, unsigned int stage, IMFSample *sample)
+{
+    IMFTransform *transforms[2];
+    unsigned int count = stream_transforms(stream, transforms);
+    HRESULT hr;
+
+    if (stage >= count) return stream_queue_sample(stream, sample);
+
+    hr = IMFTransform_ProcessInput(transforms[stage], 0, sample, 0);
+    if (hr == MF_E_NOTACCEPTING)
+    {
+        if (FAILED(hr = stream_pull(stream, stage))) return hr;
+        hr = IMFTransform_ProcessInput(transforms[stage], 0, sample, 0);
+    }
+    if (FAILED(hr))
+    {
+        WARN("Transform %p did not take a sample, hr %#lx.\n", transforms[stage], hr);
+        return hr;
+    }
+    return stream_pull(stream, stage);
+}
+
+/* Has each transform give up what it holds, in order. */
+static HRESULT stream_drain(struct stream *stream)
+{
+    IMFTransform *transforms[2];
+    unsigned int count = stream_transforms(stream, transforms), i;
+    HRESULT hr = S_OK;
+
+    for (i = 0; i < count && SUCCEEDED(hr); ++i)
+    {
+        IMFTransform_ProcessMessage(transforms[i], MFT_MESSAGE_NOTIFY_END_OF_STREAM, 0);
+        if (SUCCEEDED(hr = IMFTransform_ProcessMessage(transforms[i], MFT_MESSAGE_COMMAND_DRAIN, 0)))
+            hr = stream_pull(stream, i);
+    }
+    return hr;
+}
+
+static HRESULT sink_writer_encode_sample(struct sink_writer *writer, struct stream *stream, IMFSample *sample)
+{
+    return stream_push(stream, 0, sample);
+}
