+/* Encoding parameters given with the input type go to the encoder's ICodecAPI, as on Windows. */
+static void transform_apply_parameters(IMFTransform *transform, IMFAttributes *parameters)
+{
+    ICodecAPI *codec_api;
+    PROPVARIANT value;
+    VARIANT variant;
+    UINT32 count, i;
+    GUID key;
+
+    if (!transform || !parameters || FAILED(IMFTransform_QueryInterface(transform, &IID_ICodecAPI, (void **)&codec_api)))
+        return;
+    if (SUCCEEDED(IMFAttributes_GetCount(parameters, &count)))
+    {
+        for (i = 0; i < count; ++i)
+        {
+            PropVariantInit(&value);
+            if (FAILED(IMFAttributes_GetItemByIndex(parameters, i, &key, &value))) continue;
+            memset(&variant, 0, sizeof(variant));
+            switch (value.vt)
+            {
+                case VT_UI4: V_VT(&variant) = VT_UI4; V_UI4(&variant) = value.ulVal; break;
+                case VT_UI8: V_VT(&variant) = VT_UI8; V_UI8(&variant) = value.uhVal.QuadPart; break;
+                case VT_R8: V_VT(&variant) = VT_R8; V_R8(&variant) = value.dblVal; break;
+                default: V_VT(&variant) = VT_EMPTY; break;
+            }
+            if (V_VT(&variant) != VT_EMPTY && FAILED(ICodecAPI_SetValue(codec_api, &key, &variant)))
+                WARN("Encoder did not take %s.\n", debugstr_guid(&key));
+            PropVariantClear(&value);
+        }
+    }
+    ICodecAPI_Release(codec_api);
+}
