diff --git a/dlls/winemacmf/main.c b/dlls/winemacmf/main.c
new file mode 100644
index 0000000..ce1fceb
--- /dev/null
+++ b/dlls/winemacmf/main.c
@@ -0,0 +1,211 @@
+/*
+ * Media Foundation encoders and MPEG-4 writer on macOS frameworks
+ *
+ * The engine is built without GStreamer, which Wine's own H.264 encoder and
+ * MPEG-4 sink need, and Wine has no AAC encoder. These take their places on
+ * the Mac's own video and audio frameworks, so programs can save MP4 files:
+ * Overwatch saves its highlights this way.
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include "winemacmf_private.h"
+
+#include "rpcproxy.h"
+#include "wmcodecdsp.h"
+
+#include "initguid.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(macmf);
+
+/* The classes mfh264enc.dll and mfmp4srcsnk.dll create for their own. */
+const GUID CLSID_macmf_h264_encoder = {0x6c34de69,0x4670,0x46cd,{0x8c,0xb4,0x1f,0x2f,0xa1,0xdf,0xfb,0x65}};
+const GUID CLSID_macmf_mpeg4_sink_factory = {0x5d5407d9,0xc6ca,0x4770,{0xa7,0xcc,0x27,0xc0,0xcb,0x8a,0x76,0x27}};
+
+static BOOL unix_ready;
+
+BOOL WINAPI DllMain(HINSTANCE instance, DWORD reason, void *reserved)
+{
+    if (reason == DLL_PROCESS_ATTACH)
+    {
+        NTSTATUS status;
+
+        DisableThreadLibraryCalls(instance);
+        if ((status = __wine_init_unix_call()))
+            ERR("Failed to load the macOS media library, status %#lx.\n", status);
+        else
+            unix_ready = TRUE;
+    }
+    return TRUE;
+}
+
+struct class_factory
+{
+    IClassFactory IClassFactory_iface;
+    HRESULT (*create)(REFIID riid, void **out);
+};
+
+static struct class_factory *impl_from_IClassFactory(IClassFactory *iface)
+{
+    return CONTAINING_RECORD(iface, struct class_factory, IClassFactory_iface);
+}
+
+static HRESULT WINAPI class_factory_QueryInterface(IClassFactory *iface, REFIID riid, void **out)
+{
+    if (IsEqualGUID(riid, &IID_IClassFactory) || IsEqualGUID(riid, &IID_IUnknown))
+    {
+        *out = iface;
+        IClassFactory_AddRef(iface);
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI class_factory_AddRef(IClassFactory *iface)
+{
+    return 2;
+}
+
+static ULONG WINAPI class_factory_Release(IClassFactory *iface)
+{
+    return 1;
+}
+
+static HRESULT WINAPI class_factory_CreateInstance(IClassFactory *iface, IUnknown *outer, REFIID riid, void **out)
+{
+    struct class_factory *factory = impl_from_IClassFactory(iface);
+
+    TRACE("%p, %p, %s, %p.\n", iface, outer, debugstr_guid(riid), out);
+
+    *out = NULL;
+    if (outer) return CLASS_E_NOAGGREGATION;
+    if (!unix_ready) return E_FAIL;
+    return factory->create(riid, out);
+}
+
+static HRESULT WINAPI class_factory_LockServer(IClassFactory *iface, BOOL lock)
+{
+    return S_OK;
+}
+
+static const IClassFactoryVtbl class_factory_vtbl =
+{
+    class_factory_QueryInterface,
+    class_factory_AddRef,
+    class_factory_Release,
+    class_factory_CreateInstance,
+    class_factory_LockServer,
+};
+
+static struct class_factory h264_encoder_factory = {{&class_factory_vtbl}, h264_encoder_create};
+static struct class_factory aac_encoder_factory = {{&class_factory_vtbl}, aac_encoder_create};
+static struct class_factory mpeg4_sink_factory = {{&class_factory_vtbl}, mpeg4_sink_factory_create};
+
+HRESULT WINAPI DllGetClassObject(REFCLSID clsid, REFIID riid, void **out)
+{
+    struct class_factory *factory;
+
+    TRACE("%s, %s, %p.\n", debugstr_guid(clsid), debugstr_guid(riid), out);
+
+    if (IsEqualGUID(clsid, &CLSID_macmf_h264_encoder))
+        factory = &h264_encoder_factory;
+    else if (IsEqualGUID(clsid, &CLSID_AACMFTEncoder))
+        factory = &aac_encoder_factory;
+    else if (IsEqualGUID(clsid, &CLSID_macmf_mpeg4_sink_factory))
+        factory = &mpeg4_sink_factory;
+    else
+    {
+        *out = NULL;
+        FIXME("Unknown class %s.\n", debugstr_guid(clsid));
+        return CLASS_E_CLASSNOTAVAILABLE;
+    }
+    return IClassFactory_QueryInterface(&factory->IClassFactory_iface, riid, out);
+}
+
+HRESULT WINAPI DllCanUnloadNow(void)
+{
+    return S_FALSE;
+}
+
+HRESULT WINAPI DllRegisterServer(void)
+{
+    MFT_REGISTER_TYPE_INFO aac_encoder_inputs[] =
+    {
+        {MFMediaType_Audio, MFAudioFormat_PCM},
+        {MFMediaType_Audio, MFAudioFormat_Float},
+    };
+    MFT_REGISTER_TYPE_INFO aac_encoder_outputs[] =
+    {
+        {MFMediaType_Audio, MFAudioFormat_AAC},
+    };
+    HRESULT hr;
+
+    TRACE(".\n");
+
+    if (FAILED(hr = __wine_register_resources()))
+        return hr;
+    if (FAILED(hr = MFTRegister(CLSID_AACMFTEncoder, MFT_CATEGORY_AUDIO_ENCODER,
+            (WCHAR *)L"Microsoft AAC Audio Encoder MFT", MFT_ENUM_FLAG_SYNCMFT,
+            ARRAY_SIZE(aac_encoder_inputs), aac_encoder_inputs,
+            ARRAY_SIZE(aac_encoder_outputs), aac_encoder_outputs, NULL)))
+        return hr;
+    return S_OK;
+}
+
+HRESULT WINAPI DllUnregisterServer(void)
+{
+    HRESULT hr;
+
+    TRACE(".\n");
+
+    if (FAILED(hr = __wine_unregister_resources()))
+        return hr;
+    MFTUnregister(CLSID_AACMFTEncoder);
+    return S_OK;
+}
+
+HRESULT media_type_copy(IMFMediaType *source, IMFMediaType **copy)
+{
+    HRESULT hr;
+
+    if (FAILED(hr = MFCreateMediaType(copy)))
+        return hr;
+    if (FAILED(hr = IMFMediaType_CopyAllItems(source, (IMFAttributes *)*copy)))
+    {
+        IMFMediaType_Release(*copy);
+        *copy = NULL;
+    }
+    return hr;
+}
+
+HRESULT sample_create(DWORD size, IMFSample **sample)
+{
+    IMFMediaBuffer *buffer;
+    HRESULT hr;
+
+    if (FAILED(hr = MFCreateMemoryBuffer(size, &buffer)))
+        return hr;
+    if (SUCCEEDED(hr = MFCreateSample(sample)))
+    {
+        if (FAILED(hr = IMFSample_AddBuffer(*sample, buffer)))
+        {
+            IMFSample_Release(*sample);
+            *sample = NULL;
+        }
+    }
+    IMFMediaBuffer_Release(buffer);
+    return hr;
+}
diff --git a/dlls/winemacmf/mpeg4_sink.c b/dlls/winemacmf/mpeg4_sink.c
new file mode 100644
index 0000000..ede55bf
--- /dev/null
+++ b/dlls/winemacmf/mpeg4_sink.c
@@ -0,0 +1,1155 @@
+/*
+ * MPEG-4 media sink on AVFoundation's writer
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include "winemacmf_private.h"
+
+#include "wine/mfinternal.h"
+
+#include "initguid.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(macmf);
+
+DEFINE_GUID(MFSampleExtension_DecodeTimestamp_sink, 0x73a954d4, 0x09e2, 0x4861, 0xbe, 0xfc, 0x94, 0xbd, 0x97, 0xc0, 0x8e, 0x6e);
+
+#define MAX_STREAMS 8
+/* Sample requests kept open per stream, so the writer never waits on the sink. */
+#define REQUESTS_AHEAD 4
+
+enum stream_kind
+{
+    STREAM_H264,
+    STREAM_AAC,
+};
+
+struct mpeg4_sink;
+
+struct mpeg4_stream
+{
+    IMFStreamSink IMFStreamSink_iface;
+    IMFMediaTypeHandler IMFMediaTypeHandler_iface;
+    LONG refcount;
+
+    struct mpeg4_sink *sink;
+    IMFMediaEventQueue *event_queue;
+    IMFMediaType *type;
+    DWORD id;
+    enum stream_kind kind;
+    UINT32 track;
+    UINT64 written;
+};
+
+enum sink_state
+{
+    SINK_STOPPED,
+    SINK_STARTED,
+    SINK_FINALIZING,
+    SINK_FINALIZED,
+};
+
+struct mpeg4_sink
+{
+    IMFFinalizableMediaSink IMFFinalizableMediaSink_iface;
+    IMFClockStateSink IMFClockStateSink_iface;
+    IMFAsyncCallback finalize_callback;
+    LONG refcount;
+
+    CRITICAL_SECTION cs;
+    BOOL shutdown;
+    BOOL fixed_streams;
+    enum sink_state state;
+    IMFByteStream *bytestream;
+    IMFPresentationClock *clock;
+    struct mpeg4_stream *streams[MAX_STREAMS];
+    DWORD stream_count;
+    macmf_handle muxer;
+};
+
+struct sink_class_factory
+{
+    IMFSinkClassFactory IMFSinkClassFactory_iface;
+    LONG refcount;
+};
+
+static struct mpeg4_stream *impl_from_IMFStreamSink(IMFStreamSink *iface)
+{
+    return CONTAINING_RECORD(iface, struct mpeg4_stream, IMFStreamSink_iface);
+}
+
+static struct mpeg4_stream *impl_from_IMFMediaTypeHandler(IMFMediaTypeHandler *iface)
+{
+    return CONTAINING_RECORD(iface, struct mpeg4_stream, IMFMediaTypeHandler_iface);
+}
+
+static struct mpeg4_sink *impl_from_IMFFinalizableMediaSink(IMFFinalizableMediaSink *iface)
+{
