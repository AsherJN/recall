+static HRESULT WINAPI type_handler_IsMediaTypeSupported(IMFMediaTypeHandler *iface, IMFMediaType *type,
+        IMFMediaType **closest)
+{
+    struct mpeg4_stream *stream = impl_from_IMFMediaTypeHandler(iface);
+    enum stream_kind kind;
+    HRESULT hr;
+
+    TRACE("iface %p, type %p, closest %p.\n", iface, type, closest);
+
+    if (closest) *closest = NULL;
+    if (!type) return E_POINTER;
+    if (FAILED(hr = stream_kind_from_type(type, &kind))) return hr;
+    return kind == stream->kind ? S_OK : MF_E_INVALIDMEDIATYPE;
+}
