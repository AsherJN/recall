+    if (IsEqualIID(riid, &IID_IMFStreamSink) || IsEqualIID(riid, &IID_IMFMediaEventGenerator)
+            || IsEqualIID(riid, &IID_IUnknown))
+        *out = &stream->IMFStreamSink_iface;
+    else if (IsEqualIID(riid, &IID_IMFMediaTypeHandler))
+        *out = &stream->IMFMediaTypeHandler_iface;
+    else
+    {
