+static HRESULT WINAPI codec_api_QueryInterface(ICodecAPI *iface, REFIID iid, void **out)
+{
+    struct h264_encoder *encoder = impl_from_ICodecAPI(iface);
+    return IMFTransform_QueryInterface(&encoder->IMFTransform_iface, iid, out);
+}
+
+static ULONG WINAPI codec_api_AddRef(ICodecAPI *iface)
+{
+    struct h264_encoder *encoder = impl_from_ICodecAPI(iface);
+    return IMFTransform_AddRef(&encoder->IMFTransform_iface);
+}
+
+static ULONG WINAPI codec_api_Release(ICodecAPI *iface)
+{
+    struct h264_encoder *encoder = impl_from_ICodecAPI(iface);
+    return IMFTransform_Release(&encoder->IMFTransform_iface);
+}
+
+/* The properties Overwatch and other recorders set on Windows' encoder. */
+static UINT32 *codec_value(struct h264_encoder *encoder, const GUID *api)
+{
+    if (IsEqualGUID(api, &CODECAPI_AVEncCommonRateControlMode)) return &encoder->rate_control;
+    if (IsEqualGUID(api, &CODECAPI_AVEncCommonMeanBitRate)) return &encoder->bitrate;
+    if (IsEqualGUID(api, &CODECAPI_AVEncCommonMaxBitRate)) return &encoder->max_bitrate;
+    if (IsEqualGUID(api, &CODECAPI_AVEncCommonQuality)) return &encoder->quality;
+    if (IsEqualGUID(api, &CODECAPI_AVEncCommonQualityVsSpeed)) return &encoder->quality_vs_speed;
+    if (IsEqualGUID(api, &CODECAPI_AVEncMPVGOPSize)) return &encoder->gop_size;
+    if (IsEqualGUID(api, &CODECAPI_AVEncMPVDefaultBPictureCount)) return &encoder->b_frames;
+    if (IsEqualGUID(api, &CODECAPI_AVLowLatencyMode)) return &encoder->low_latency;
+    if (IsEqualGUID(api, &CODECAPI_AVEncCommonLowLatency)) return &encoder->low_latency;
+    if (IsEqualGUID(api, &CODECAPI_AVEncMPVProfile)) return &encoder->profile;
+    if (IsEqualGUID(api, &CODECAPI_AVEncMPVLevel)) return &encoder->level;
+    if (IsEqualGUID(api, &CODECAPI_AVEncAdaptiveMode)) return &encoder->adaptive_mode;
+    if (IsEqualGUID(api, &CODECAPI_AVEncNumWorkerThreads)) return &encoder->worker_threads;
+    if (IsEqualGUID(api, &CODECAPI_AVEncH264CABACEnable)) return &encoder->cabac;
+    return NULL;
+}
+
+static HRESULT WINAPI codec_api_IsSupported(ICodecAPI *iface, const GUID *api)
+{
+    struct h264_encoder *encoder = impl_from_ICodecAPI(iface);
+
+    TRACE("iface %p, api %s.\n", iface, debugstr_guid(api));
+
+    if (codec_value(encoder, api) || IsEqualGUID(api, &CODECAPI_AVEncVideoForceKeyFrame)) return S_OK;
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI codec_api_IsModifiable(ICodecAPI *iface, const GUID *api)
+{
+    return codec_api_IsSupported(iface, api);
+}
+
+static HRESULT WINAPI codec_api_GetParameterRange(ICodecAPI *iface, const GUID *api, VARIANT *min,
+        VARIANT *max, VARIANT *delta)
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI codec_api_GetParameterValues(ICodecAPI *iface, const GUID *api, VARIANT **values, ULONG *count)
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI codec_api_GetDefaultValue(ICodecAPI *iface, const GUID *api, VARIANT *value)
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI codec_api_GetValue(ICodecAPI *iface, const GUID *api, VARIANT *value)
+{
+    struct h264_encoder *encoder = impl_from_ICodecAPI(iface);
+    UINT32 *field;
+
+    TRACE("iface %p, api %s, value %p.\n", iface, debugstr_guid(api), value);
+
+    EnterCriticalSection(&encoder->cs);
+    if (!(field = codec_value(encoder, api)))
+    {
+        LeaveCriticalSection(&encoder->cs);
+        return E_NOTIMPL;
+    }
+    if (IsEqualGUID(api, &CODECAPI_AVLowLatencyMode) || IsEqualGUID(api, &CODECAPI_AVEncCommonLowLatency)
+            || IsEqualGUID(api, &CODECAPI_AVEncH264CABACEnable))
+    {
+        V_VT(value) = VT_BOOL;
+        V_BOOL(value) = *field ? VARIANT_TRUE : VARIANT_FALSE;
+    }
+    else
+    {
+        V_VT(value) = VT_UI4;
+        V_UI4(value) = *field;
+    }
+    LeaveCriticalSection(&encoder->cs);
+    return S_OK;
+}
+
+static BOOL variant_to_uint(const VARIANT *value, UINT32 *out)
+{
+    switch (V_VT(value))
+    {
+        case VT_UI4: case VT_UINT: *out = V_UI4(value); return TRUE;
+        case VT_I4: case VT_INT: *out = V_I4(value) < 0 ? 0 : V_I4(value); return TRUE;
+        case VT_UI8: *out = (UINT32)min(V_UI8(value), 0xffffffff); return TRUE;
+        case VT_I8: *out = V_I8(value) < 0 ? 0 : (UINT32)min(V_I8(value), 0xffffffff); return TRUE;
+        case VT_UI2: *out = V_UI2(value); return TRUE;
+        case VT_I2: *out = V_I2(value) < 0 ? 0 : V_I2(value); return TRUE;
+        case VT_UI1: *out = V_UI1(value); return TRUE;
+        case VT_BOOL: *out = V_BOOL(value) ? 1 : 0; return TRUE;
+        case VT_R8: *out = V_R8(value) < 0 ? 0 : (UINT32)V_R8(value); return TRUE;
+        default: return FALSE;
+    }
+}
+
+static HRESULT WINAPI codec_api_SetValue(ICodecAPI *iface, const GUID *api, VARIANT *value)
+{
+    struct h264_encoder *encoder = impl_from_ICodecAPI(iface);
+    struct video_encoder_bitrate_params params;
+    UINT32 *field, number;
+
+    TRACE("iface %p, api %s, value %p (vt %u).\n", iface, debugstr_guid(api), value, value ? V_VT(value) : 0);
+
+    if (!value) return E_POINTER;
+    if (!variant_to_uint(value, &number))
+    {
+        WARN("Unsupported value type %u for %s.\n", V_VT(value), debugstr_guid(api));
+        return E_INVALIDARG;
+    }
+
+    EnterCriticalSection(&encoder->cs);
+    if (IsEqualGUID(api, &CODECAPI_AVEncVideoForceKeyFrame))
+        encoder->force_keyframe = !!number;
+    else if ((field = codec_value(encoder, api)))
+    {
+        *field = number;
+        TRACE("Set %s to %u.\n", debugstr_guid(api), number);
+        /* Bitrates also apply to a session already running. */
+        if (encoder->handle && (field == &encoder->bitrate || field == &encoder->max_bitrate))
+        {
+            params.handle = encoder->handle;
+            params.bitrate = encoder->bitrate;
+            params.max_bitrate = encoder->max_bitrate;
+            UNIX_CALL(video_encoder_set_bitrate, &params);
+        }
+    }
+    else
+        /* Windows' encoder has more knobs; accepting them keeps programs going. */
+        FIXME("Ignoring %s = %u.\n", debugstr_guid(api), number);
+    LeaveCriticalSection(&encoder->cs);
+    return S_OK;
+}
+
+static HRESULT WINAPI codec_api_RegisterForEvent(ICodecAPI *iface, const GUID *api, LONG_PTR userData)
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI codec_api_UnregisterForEvent(ICodecAPI *iface, const GUID *api)
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI codec_api_SetAllDefaults(ICodecAPI *iface)
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI codec_api_SetValueWithNotify(ICodecAPI *iface, const GUID *api, VARIANT *value,
+        GUID **param, ULONG *count)
+{
+    if (param) *param = NULL;
+    if (count) *count = 0;
+    return codec_api_SetValue(iface, api, value);
+}
+
+static HRESULT WINAPI codec_api_SetAllDefaultsWithNotify(ICodecAPI *iface, GUID **param, ULONG *count)
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI codec_api_GetAllSettings(ICodecAPI *iface, IStream *stream)
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI codec_api_SetAllSettings(ICodecAPI *iface, IStream *stream)
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI codec_api_SetAllSettingsWithNotify(ICodecAPI *iface, IStream *stream, GUID **param, ULONG *count)
+{
+    return E_NOTIMPL;
+}
+
+static const ICodecAPIVtbl codec_api_vtbl =
+{
+    codec_api_QueryInterface,
+    codec_api_AddRef,
+    codec_api_Release,
+    codec_api_IsSupported,
+    codec_api_IsModifiable,
+    codec_api_GetParameterRange,
+    codec_api_GetParameterValues,
+    codec_api_GetDefaultValue,
+    codec_api_GetValue,
+    codec_api_SetValue,
+    codec_api_RegisterForEvent,
+    codec_api_UnregisterForEvent,
+    codec_api_SetAllDefaults,
+    codec_api_SetValueWithNotify,
+    codec_api_SetAllDefaultsWithNotify,
+    codec_api_GetAllSettings,
+    codec_api_SetAllSettings,
+    codec_api_SetAllSettingsWithNotify,
+};
+
+HRESULT h264_encoder_create(REFIID riid, void **out)
+{
+    struct h264_encoder *encoder;
+    HRESULT hr;
+
+    TRACE("riid %s, out %p.\n", debugstr_guid(riid), out);
+
+    if (!(encoder = calloc(1, sizeof(*encoder)))) return E_OUTOFMEMORY;
+    encoder->IMFTransform_iface.lpVtbl = &transform_vtbl;
+    encoder->ICodecAPI_iface.lpVtbl = &codec_api_vtbl;
+    encoder->refcount = 1;
+    encoder->rate_num = 30;
+    encoder->rate_den = 1;
+    encoder->rate_control = eAVEncCommonRateControlMode_CBR;
+    encoder->quality = 70;
+    encoder->cabac = 1;
+    InitializeCriticalSection(&encoder->cs);
+
+    if (FAILED(hr = MFCreateAttributes(&encoder->attributes, 4))
+            || FAILED(hr = IMFAttributes_SetUINT32(encoder->attributes, &MFT_ENCODER_SUPPORTS_CONFIG_EVENT, TRUE))
+            || FAILED(hr = IMFAttributes_SetUINT32(encoder->attributes, &MF_SA_D3D_AWARE, FALSE)))
+    {
+        if (encoder->attributes) IMFAttributes_Release(encoder->attributes);
+        DeleteCriticalSection(&encoder->cs);
+        free(encoder);
+        return hr;
+    }
+
+    hr = IMFTransform_QueryInterface(&encoder->IMFTransform_iface, riid, out);
+    IMFTransform_Release(&encoder->IMFTransform_iface);
+    return hr;
+}
