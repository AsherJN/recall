+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include "winemacmf_private.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(macmf);
+
+#define AAC_FRAMES 1024
+/* Gaps in the input longer than this are filled with silence to keep sync. */
+#define GAP_TOLERANCE (MF_UNITS / 50)
+#define GAP_LIMIT (10 * (LONGLONG)MF_UNITS)
+
+static const UINT32 aac_rates[] = {96000, 88200, 64000, 48000, 44100, 32000, 24000, 22050, 16000, 12000, 11025, 8000};
+/* The average rates, in bytes per second, Windows' encoder offers. */
+static const UINT32 output_byte_rates[] = {24000, 20000, 16000, 12000};
+
+struct aac_encoder
+{
+    IMFTransform IMFTransform_iface;
+    LONG refcount;
+
+    CRITICAL_SECTION cs;
+    IMFAttributes *attributes;
+    IMFMediaType *input_type;
+    IMFMediaType *output_type;
+
+    UINT32 input_rate;
+    UINT32 channels;
+    UINT32 format;
+    UINT32 block;
+    UINT32 output_rate;
+    UINT32 bitrate;
+
+    macmf_handle handle;
+    UINT32 priming;
+    BOOL have_first;
+    LONGLONG first_time;
+    UINT64 frames_in;
+    UINT64 packets_out;
+    BOOL draining;
+};
+
+static struct aac_encoder *impl_from_IMFTransform(IMFTransform *iface)
+{
+    return CONTAINING_RECORD(iface, struct aac_encoder, IMFTransform_iface);
+}
+
+static BOOL is_aac_rate(UINT32 rate)
+{
+    unsigned int i;
+
+    for (i = 0; i < ARRAY_SIZE(aac_rates); ++i)
+        if (aac_rates[i] == rate) return TRUE;
+    return FALSE;
+}
+
+static BOOL is_channel_count(UINT32 channels)
+{
+    return channels == 1 || channels == 2 || channels == 6 || channels == 8;
+}
+
+/* AudioSpecificConfig for AAC-LC, and the HEAACWAVEINFO tail Windows puts before it. */
+static UINT32 aac_user_data(UINT32 rate, UINT32 channels, BYTE *data)
+{
+    unsigned int index;
+
+    for (index = 0; index < ARRAY_SIZE(aac_rates); ++index)
+        if (aac_rates[index] == rate) break;
+    memset(data, 0, 12);
+    data[2] = 0x29;             /* wAudioProfileLevelIndication: AAC profile, level 2 */
+    data[12] = (2 << 3) | (index >> 1);
+    data[13] = ((index & 1) << 7) | ((channels == 8 ? 7 : channels) << 3);
+    return 14;
+}
+
+static void encoder_destroy_session(struct aac_encoder *encoder)
+{
+    if (!encoder->handle) return;
+    UNIX_CALL(audio_encoder_destroy, &encoder->handle);
+    encoder->handle = 0;
+    encoder->have_first = FALSE;
+    encoder->frames_in = encoder->packets_out = 0;
+}
+
+static HRESULT encoder_create_session(struct aac_encoder *encoder)
+{
+    struct audio_encoder_create_params params = {0};
+    NTSTATUS status;
+
+    if (encoder->handle) return S_OK;
+    params.input_rate = encoder->input_rate;
+    params.channels = encoder->channels;
+    params.format = encoder->format;
+    params.output_rate = encoder->output_rate;
+    params.bitrate = encoder->bitrate;
+    if ((status = UNIX_CALL(audio_encoder_create, &params)))
+    {
+        ERR("Failed to create the AAC encoder, status %#lx.\n", status);
+        return E_FAIL;
+    }
+    encoder->handle = params.handle;
+    encoder->priming = params.priming;
+    encoder->have_first = FALSE;
+    encoder->frames_in = encoder->packets_out = 0;
+    TRACE("Created encoder %#I64x, %u Hz -> %u Hz, %u channels, priming %u.\n", encoder->handle,
+            encoder->input_rate, encoder->output_rate, encoder->channels, encoder->priming);
+    return S_OK;
+}
+
+static HRESULT WINAPI transform_QueryInterface(IMFTransform *iface, REFIID iid, void **out)
+{
+    struct aac_encoder *encoder = impl_from_IMFTransform(iface);
+
+    TRACE("iface %p, iid %s, out %p.\n", iface, debugstr_guid(iid), out);
+
+    if (IsEqualGUID(iid, &IID_IUnknown) || IsEqualGUID(iid, &IID_IMFTransform))
+    {
+        IMFTransform_AddRef((*out = &encoder->IMFTransform_iface));
+        return S_OK;
+    }
+    *out = NULL;
+    WARN("%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid(iid));
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI transform_AddRef(IMFTransform *iface)
+{
+    struct aac_encoder *encoder = impl_from_IMFTransform(iface);
+    return InterlockedIncrement(&encoder->refcount);
+}
+
+static ULONG WINAPI transform_Release(IMFTransform *iface)
+{
+    struct aac_encoder *encoder = impl_from_IMFTransform(iface);
+    ULONG refcount = InterlockedDecrement(&encoder->refcount);
+
+    if (!refcount)
+    {
+        encoder_destroy_session(encoder);
+        if (encoder->input_type) IMFMediaType_Release(encoder->input_type);
+        if (encoder->output_type) IMFMediaType_Release(encoder->output_type);
+        IMFAttributes_Release(encoder->attributes);
+        DeleteCriticalSection(&encoder->cs);
+        free(encoder);
+    }
+    return refcount;
+}
+
+static HRESULT WINAPI transform_GetStreamLimits(IMFTransform *iface, DWORD *input_minimum,
+        DWORD *input_maximum, DWORD *output_minimum, DWORD *output_maximum)
+{
+    *input_minimum = *input_maximum = *output_minimum = *output_maximum = 1;
+    return S_OK;
+}
+
+static HRESULT WINAPI transform_GetStreamCount(IMFTransform *iface, DWORD *inputs, DWORD *outputs)
+{
+    *inputs = *outputs = 1;
+    return S_OK;
+}
+
+static HRESULT WINAPI transform_GetStreamIDs(IMFTransform *iface, DWORD input_size, DWORD *inputs,
+        DWORD output_size, DWORD *outputs)
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI transform_GetInputStreamInfo(IMFTransform *iface, DWORD id, MFT_INPUT_STREAM_INFO *info)
+{
+    struct aac_encoder *encoder = impl_from_IMFTransform(iface);
+
+    if (id) return MF_E_INVALIDSTREAMNUMBER;
+    memset(info, 0, sizeof(*info));
+    EnterCriticalSection(&encoder->cs);
+    info->cbAlignment = 1;
+    info->cbSize = encoder->block;
+    LeaveCriticalSection(&encoder->cs);
+    return S_OK;
+}
+
+static HRESULT WINAPI transform_GetOutputStreamInfo(IMFTransform *iface, DWORD id, MFT_OUTPUT_STREAM_INFO *info)
+{
+    struct aac_encoder *encoder = impl_from_IMFTransform(iface);
+
+    if (id) return MF_E_INVALIDSTREAMNUMBER;
+    memset(info, 0, sizeof(*info));
+    info->dwFlags = MFT_OUTPUT_STREAM_WHOLE_SAMPLES | MFT_OUTPUT_STREAM_SINGLE_SAMPLE_PER_BUFFER
+            | MFT_OUTPUT_STREAM_CAN_PROVIDE_SAMPLES;
+    EnterCriticalSection(&encoder->cs);
+    /* An AAC-LC frame holds at most 6144 bits per channel. */
+    info->cbSize = 768 * max(encoder->channels, 2);
+    LeaveCriticalSection(&encoder->cs);
+    return S_OK;
+}
+
+static HRESULT WINAPI transform_GetAttributes(IMFTransform *iface, IMFAttributes **attributes)
+{
+    struct aac_encoder *encoder = impl_from_IMFTransform(iface);
+
+    if (!attributes) return E_POINTER;
+    IMFAttributes_AddRef((*attributes = encoder->attributes));
+    return S_OK;
+}
+
+static HRESULT WINAPI transform_GetInputStreamAttributes(IMFTransform *iface, DWORD id, IMFAttributes **attributes)
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI transform_GetOutputStreamAttributes(IMFTransform *iface, DWORD id, IMFAttributes **attributes)
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI transform_DeleteInputStream(IMFTransform *iface, DWORD id)
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI transform_AddInputStreams(IMFTransform *iface, DWORD streams, DWORD *ids)
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT create_pcm_type(const GUID *subtype, UINT32 bits, UINT32 rate, UINT32 channels, IMFMediaType **out)
+{
+    IMFMediaType *type;
+    HRESULT hr;
+
+    if (FAILED(hr = MFCreateMediaType(&type))) return hr;
+    IMFMediaType_SetGUID(type, &MF_MT_MAJOR_TYPE, &MFMediaType_Audio);
+    IMFMediaType_SetGUID(type, &MF_MT_SUBTYPE, subtype);
+    IMFMediaType_SetUINT32(type, &MF_MT_AUDIO_BITS_PER_SAMPLE, bits);
+    IMFMediaType_SetUINT32(type, &MF_MT_AUDIO_SAMPLES_PER_SECOND, rate);
+    IMFMediaType_SetUINT32(type, &MF_MT_AUDIO_NUM_CHANNELS, channels);
+    IMFMediaType_SetUINT32(type, &MF_MT_AUDIO_BLOCK_ALIGNMENT, bits / 8 * channels);
+    IMFMediaType_SetUINT32(type, &MF_MT_AUDIO_AVG_BYTES_PER_SECOND, bits / 8 * channels * rate);
+    IMFMediaType_SetUINT32(type, &MF_MT_ALL_SAMPLES_INDEPENDENT, 1);
+    *out = type;
+    return S_OK;
+}
+
+static HRESULT create_aac_type(UINT32 rate, UINT32 channels, UINT32 byte_rate, IMFMediaType **out)
+{
+    IMFMediaType *type;
+    BYTE user_data[16];
+    HRESULT hr;
+
+    if (FAILED(hr = MFCreateMediaType(&type))) return hr;
+    IMFMediaType_SetGUID(type, &MF_MT_MAJOR_TYPE, &MFMediaType_Audio);
+    IMFMediaType_SetGUID(type, &MF_MT_SUBTYPE, &MFAudioFormat_AAC);
+    IMFMediaType_SetUINT32(type, &MF_MT_AUDIO_BITS_PER_SAMPLE, 16);
+    IMFMediaType_SetUINT32(type, &MF_MT_AUDIO_SAMPLES_PER_SECOND, rate);
+    IMFMediaType_SetUINT32(type, &MF_MT_AUDIO_NUM_CHANNELS, channels);
+    IMFMediaType_SetUINT32(type, &MF_MT_AUDIO_AVG_BYTES_PER_SECOND, byte_rate);
+    IMFMediaType_SetUINT32(type, &MF_MT_AUDIO_BLOCK_ALIGNMENT, 1);
+    IMFMediaType_SetUINT32(type, &MF_MT_AAC_PAYLOAD_TYPE, 0);
+    IMFMediaType_SetUINT32(type, &MF_MT_AAC_AUDIO_PROFILE_LEVEL_INDICATION, 0x29);
+    IMFMediaType_SetBlob(type, &MF_MT_USER_DATA, user_data, aac_user_data(rate, channels, user_data));
+    *out = type;
+    return S_OK;
+}
+
+static HRESULT WINAPI transform_GetInputAvailableType(IMFTransform *iface, DWORD id, DWORD index, IMFMediaType **type)
+{
+    struct aac_encoder *encoder = impl_from_IMFTransform(iface);
+    UINT32 rate = 48000, channels = 2;
+    HRESULT hr;
+
+    if (id) return MF_E_INVALIDSTREAMNUMBER;
+    *type = NULL;
+    if (index >= 2) return MF_E_NO_MORE_TYPES;
+    EnterCriticalSection(&encoder->cs);
+    if (encoder->output_type)
+    {
+        rate = encoder->output_rate;
+        channels = encoder->channels;
+    }
+    hr = index ? create_pcm_type(&MFAudioFormat_Float, 32, rate, channels, type)
+            : create_pcm_type(&MFAudioFormat_PCM, 16, rate, channels, type);
+    LeaveCriticalSection(&encoder->cs);
+    return hr;
+}
+
+static HRESULT WINAPI transform_GetOutputAvailableType(IMFTransform *iface, DWORD id, DWORD index, IMFMediaType **type)
+{
+    struct aac_encoder *encoder = impl_from_IMFTransform(iface);
+    UINT32 rate = 48000, channels = 2;
+    HRESULT hr;
+
+    if (id) return MF_E_INVALIDSTREAMNUMBER;
+    *type = NULL;
+    if (index >= ARRAY_SIZE(output_byte_rates)) return MF_E_NO_MORE_TYPES;
+    EnterCriticalSection(&encoder->cs);
+    if (encoder->input_type)
+    {
+        rate = is_aac_rate(encoder->input_rate) ? encoder->input_rate : 48000;
+        channels = encoder->channels;
+    }
+    hr = create_aac_type(rate, channels, output_byte_rates[index] * max(channels, 2) / 2, type);
+    LeaveCriticalSection(&encoder->cs);
+    return hr;
+}
+
+static HRESULT WINAPI transform_SetInputType(IMFTransform *iface, DWORD id, IMFMediaType *type, DWORD flags)
+{
+    struct aac_encoder *encoder = impl_from_IMFTransform(iface);
+    UINT32 bits, rate, channels, format;
+    GUID major, subtype;
+    HRESULT hr = S_OK;
+
+    TRACE("iface %p, id %#lx, type %p, flags %#lx.\n", iface, id, type, flags);
+
+    if (id) return MF_E_INVALIDSTREAMNUMBER;
+    EnterCriticalSection(&encoder->cs);
+
+    if (!type)
+    {
+        if (!(flags & MFT_SET_TYPE_TEST_ONLY))
+        {
+            if (encoder->input_type) IMFMediaType_Release(encoder->input_type);
+            encoder->input_type = NULL;
+            encoder_destroy_session(encoder);
+        }
+        goto done;
+    }
+    if (FAILED(IMFMediaType_GetGUID(type, &MF_MT_MAJOR_TYPE, &major))
+            || FAILED(IMFMediaType_GetGUID(type, &MF_MT_SUBTYPE, &subtype)))
+    {
+        hr = E_INVALIDARG;
+        goto done;
+    }
+    if (!IsEqualGUID(&major, &MFMediaType_Audio)
+            || FAILED(IMFMediaType_GetUINT32(type, &MF_MT_AUDIO_SAMPLES_PER_SECOND, &rate))
+            || FAILED(IMFMediaType_GetUINT32(type, &MF_MT_AUDIO_NUM_CHANNELS, &channels))
+            || !is_channel_count(channels) || rate < 8000 || rate > 192000)
+    {
+        hr = MF_E_INVALIDMEDIATYPE;
+        goto done;
+    }
+    if (FAILED(IMFMediaType_GetUINT32(type, &MF_MT_AUDIO_BITS_PER_SAMPLE, &bits)))
+        bits = IsEqualGUID(&subtype, &MFAudioFormat_Float) ? 32 : 16;
+    if (IsEqualGUID(&subtype, &MFAudioFormat_Float) && bits == 32) format = MACMF_AUDIO_F32;
+    else if (IsEqualGUID(&subtype, &MFAudioFormat_PCM) && bits == 16) format = MACMF_AUDIO_S16;
+    else if (IsEqualGUID(&subtype, &MFAudioFormat_PCM) && bits == 24) format = MACMF_AUDIO_S24;
+    else if (IsEqualGUID(&subtype, &MFAudioFormat_PCM) && bits == 32) format = MACMF_AUDIO_S32;
+    else
+    {
+        hr = MF_E_INVALIDMEDIATYPE;
+        goto done;
+    }
+    if (encoder->output_type && channels != encoder->channels)
+    {
+        hr = MF_E_INVALIDMEDIATYPE;
+        goto done;
+    }
+    if (flags & MFT_SET_TYPE_TEST_ONLY) goto done;
+
+    if (encoder->input_type) IMFMediaType_Release(encoder->input_type);
+    IMFMediaType_AddRef((encoder->input_type = type));
+    encoder_destroy_session(encoder);
+    encoder->input_rate = rate;
+    encoder->channels = channels;
+    encoder->format = format;
+    encoder->block = bits / 8 * channels;
+    TRACE("Input %s, %u bits, %u Hz, %u channels.\n", debugstr_guid(&subtype), bits, rate, channels);
+
+done:
+    LeaveCriticalSection(&encoder->cs);
+    return hr;
+}
+
+static HRESULT WINAPI transform_SetOutputType(IMFTransform *iface, DWORD id, IMFMediaType *type, DWORD flags)
+{
+    struct aac_encoder *encoder = impl_from_IMFTransform(iface);
+    UINT32 rate, channels, byte_rate = 0, payload = 0;
+    GUID major, subtype;
+    HRESULT hr = S_OK;
+
+    TRACE("iface %p, id %#lx, type %p, flags %#lx.\n", iface, id, type, flags);
+
+    if (id) return MF_E_INVALIDSTREAMNUMBER;
+    EnterCriticalSection(&encoder->cs);
+
+    if (!type)
+    {
+        if (!(flags & MFT_SET_TYPE_TEST_ONLY))
+        {
+            if (encoder->output_type) IMFMediaType_Release(encoder->output_type);
+            encoder->output_type = NULL;
+            encoder_destroy_session(encoder);
+        }
+        goto done;
+    }
+    if (FAILED(IMFMediaType_GetGUID(type, &MF_MT_MAJOR_TYPE, &major))
+            || FAILED(IMFMediaType_GetGUID(type, &MF_MT_SUBTYPE, &subtype)))
+    {
+        hr = E_INVALIDARG;
+        goto done;
+    }
+    IMFMediaType_GetUINT32(type, &MF_MT_AAC_PAYLOAD_TYPE, &payload);
+    if (!IsEqualGUID(&major, &MFMediaType_Audio) || !IsEqualGUID(&subtype, &MFAudioFormat_AAC) || payload
+            || FAILED(IMFMediaType_GetUINT32(type, &MF_MT_AUDIO_SAMPLES_PER_SECOND, &rate))
+            || FAILED(IMFMediaType_GetUINT32(type, &MF_MT_AUDIO_NUM_CHANNELS, &channels))
+            || !is_aac_rate(rate) || !is_channel_count(channels)
+            || (encoder->input_type && channels != encoder->channels))
+    {
+        hr = MF_E_INVALIDMEDIATYPE;
+        goto done;
+    }
+    if (flags & MFT_SET_TYPE_TEST_ONLY) goto done;
+
+    IMFMediaType_GetUINT32(type, &MF_MT_AUDIO_AVG_BYTES_PER_SECOND, &byte_rate);
+    if (encoder->output_type) IMFMediaType_Release(encoder->output_type);
+    /* Keep the caller's type, completed the way Windows' encoder completes it. */
+    if (FAILED(hr = media_type_copy(type, &encoder->output_type))) goto done;
+    {
+        BYTE user_data[16];
+        IMFMediaType_SetUINT32(encoder->output_type, &MF_MT_AUDIO_BLOCK_ALIGNMENT, 1);
+        IMFMediaType_SetUINT32(encoder->output_type, &MF_MT_AUDIO_BITS_PER_SAMPLE, 16);
+        IMFMediaType_SetUINT32(encoder->output_type, &MF_MT_AAC_PAYLOAD_TYPE, 0);
+        IMFMediaType_SetUINT32(encoder->output_type, &MF_MT_AAC_AUDIO_PROFILE_LEVEL_INDICATION, 0x29);
+        IMFMediaType_SetBlob(encoder->output_type, &MF_MT_USER_DATA, user_data,
+                aac_user_data(rate, channels, user_data));
+    }
+    encoder_destroy_session(encoder);
+    encoder->output_rate = rate;
+    encoder->channels = channels;
+    encoder->bitrate = byte_rate * 8;
+    TRACE("Output %u Hz, %u channels, %u bit/s.\n", rate, channels, encoder->bitrate);
+
+done:
+    LeaveCriticalSection(&encoder->cs);
+    return hr;
+}
+
+static HRESULT WINAPI transform_GetInputCurrentType(IMFTransform *iface, DWORD id, IMFMediaType **type)
+{
+    struct aac_encoder *encoder = impl_from_IMFTransform(iface);
+    HRESULT hr;
+
+    if (id) return MF_E_INVALIDSTREAMNUMBER;
+    EnterCriticalSection(&encoder->cs);
+    hr = encoder->input_type ? media_type_copy(encoder->input_type, type) : MF_E_TRANSFORM_TYPE_NOT_SET;
+    LeaveCriticalSection(&encoder->cs);
+    return hr;
+}
+
+static HRESULT WINAPI transform_GetOutputCurrentType(IMFTransform *iface, DWORD id, IMFMediaType **type)
+{
+    struct aac_encoder *encoder = impl_from_IMFTransform(iface);
+    HRESULT hr;
+
+    if (id) return MF_E_INVALIDSTREAMNUMBER;
+    EnterCriticalSection(&encoder->cs);
+    hr = encoder->output_type ? media_type_copy(encoder->output_type, type) : MF_E_TRANSFORM_TYPE_NOT_SET;
+    LeaveCriticalSection(&encoder->cs);
+    return hr;
+}
+
+static HRESULT WINAPI transform_GetInputStatus(IMFTransform *iface, DWORD id, DWORD *flags)
+{
+    struct aac_encoder *encoder = impl_from_IMFTransform(iface);
+    HRESULT hr = S_OK;
+
+    if (id) return MF_E_INVALIDSTREAMNUMBER;
+    EnterCriticalSection(&encoder->cs);
+    if (!encoder->input_type || !encoder->output_type) hr = MF_E_TRANSFORM_TYPE_NOT_SET;
+    else *flags = MFT_INPUT_STATUS_ACCEPT_DATA;
+    LeaveCriticalSection(&encoder->cs);
+    return hr;
+}
+
+static HRESULT WINAPI transform_GetOutputStatus(IMFTransform *iface, DWORD *flags)
+{
+    struct aac_encoder *encoder = impl_from_IMFTransform(iface);
+    struct packet_params params = {0};
+
+    *flags = 0;
+    EnterCriticalSection(&encoder->cs);
+    if (encoder->handle)
+    {
+        params.handle = encoder->handle;
+        if (UNIX_CALL(audio_encoder_read, &params) == STATUS_BUFFER_TOO_SMALL)
+            *flags = MFT_OUTPUT_STATUS_SAMPLE_READY;
+    }
+    LeaveCriticalSection(&encoder->cs);
+    return S_OK;
+}
+
+static HRESULT WINAPI transform_SetOutputBounds(IMFTransform *iface, LONGLONG lower, LONGLONG upper)
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI transform_ProcessEvent(IMFTransform *iface, DWORD id, IMFMediaEvent *event)
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI transform_ProcessMessage(IMFTransform *iface, MFT_MESSAGE_TYPE message, ULONG_PTR param)
+{
+    struct aac_encoder *encoder = impl_from_IMFTransform(iface);
+    HRESULT hr = S_OK;
+
+    TRACE("iface %p, message %#x, param %#Ix.\n", iface, message, param);
+
+    EnterCriticalSection(&encoder->cs);
+    switch (message)
+    {
+        case MFT_MESSAGE_SET_D3D_MANAGER:
+            hr = param ? E_NOTIMPL : S_OK;
+            break;
+
+        case MFT_MESSAGE_COMMAND_FLUSH:
+            if (encoder->handle) UNIX_CALL(audio_encoder_flush, &encoder->handle);
+            encoder->have_first = FALSE;
+            encoder->frames_in = encoder->packets_out = 0;
+            encoder->draining = FALSE;
+            break;
+
+        case MFT_MESSAGE_COMMAND_DRAIN:
+            if (encoder->handle && UNIX_CALL(audio_encoder_drain, &encoder->handle)) hr = E_FAIL;
+            encoder->draining = TRUE;
+            break;
+
+        case MFT_MESSAGE_NOTIFY_BEGIN_STREAMING:
+        case MFT_MESSAGE_NOTIFY_START_OF_STREAM:
+            if (encoder->input_type && encoder->output_type) hr = encoder_create_session(encoder);
+            break;
+
+        default:
+            break;
+    }
+    LeaveCriticalSection(&encoder->cs);
+    return hr;
+}
+
+static HRESULT encode_silence(struct aac_encoder *encoder, UINT64 frames)
+{
+    struct audio_encoder_encode_params params = {0};
+    UINT64 chunk = min(frames, (UINT64)encoder->input_rate);
+    BYTE *zeros;
+
+    if (!(zeros = calloc(chunk, encoder->block))) return E_OUTOFMEMORY;
+    params.handle = encoder->handle;
+    params.data = (UINT_PTR)zeros;
+    while (frames)
+    {
+        UINT64 count = min(frames, chunk);
+
+        params.size = (UINT32)(count * encoder->block);
+        if (UNIX_CALL(audio_encoder_encode, &params)) break;
+        encoder->frames_in += count;
+        frames -= count;
+    }
+    free(zeros);
+    return frames ? E_FAIL : S_OK;
+}
+
+static HRESULT WINAPI transform_ProcessInput(IMFTransform *iface, DWORD id, IMFSample *sample, DWORD flags)
+{
+    struct aac_encoder *encoder = impl_from_IMFTransform(iface);
+    struct audio_encoder_encode_params params = {0};
+    IMFMediaBuffer *buffer = NULL;
+    LONGLONG time, expected;
+    DWORD length;
+    BYTE *data;
+    HRESULT hr;
+
+    TRACE("iface %p, id %#lx, sample %p, flags %#lx.\n", iface, id, sample, flags);
+
+    if (id) return MF_E_INVALIDSTREAMNUMBER;
+    if (!sample) return E_POINTER;
+
+    EnterCriticalSection(&encoder->cs);
+    if (!encoder->input_type || !encoder->output_type)
+    {
+        hr = MF_E_TRANSFORM_TYPE_NOT_SET;
+        goto done;
+    }
+    if (FAILED(hr = encoder_create_session(encoder))) goto done;
+    encoder->draining = FALSE;
+
+    expected = encoder->first_time + (LONGLONG)(encoder->frames_in * MF_UNITS / encoder->input_rate);
+    if (FAILED(IMFSample_GetSampleTime(sample, &time))) time = encoder->have_first ? expected : 0;
+    if (!encoder->have_first)
+    {
+        encoder->have_first = TRUE;
+        encoder->first_time = time;
+    }
+    else if (time - expected > GAP_TOLERANCE && time - expected < GAP_LIMIT)
+    {
+        /* Keep the sound in step with the picture across a gap in the input. */
+        TRACE("Filling a %I64d gap with silence.\n", time - expected);
+        encode_silence(encoder, (time - expected) * encoder->input_rate / MF_UNITS);
+    }
+
+    if (FAILED(hr = IMFSample_ConvertToContiguousBuffer(sample, &buffer))) goto done;
+    if (FAILED(hr = IMFMediaBuffer_Lock(buffer, &data, NULL, &length))) goto done;
+    length -= length % encoder->block;
+    params.handle = encoder->handle;
+    params.data = (UINT_PTR)data;
+    params.size = length;
+    if (length && UNIX_CALL(audio_encoder_encode, &params))
+        hr = E_FAIL;
+    else
+        encoder->frames_in += length / encoder->block;
+    IMFMediaBuffer_Unlock(buffer);
+
+done:
+    if (buffer) IMFMediaBuffer_Release(buffer);
+    LeaveCriticalSection(&encoder->cs);
+    return hr;
+}
+
+static HRESULT WINAPI transform_ProcessOutput(IMFTransform *iface, DWORD flags, DWORD count,
+        MFT_OUTPUT_DATA_BUFFER *samples, DWORD *status)
+{
+    struct aac_encoder *encoder = impl_from_IMFTransform(iface);
+    struct packet_params params = {0};
+    LONGLONG start, frames, total;
+    IMFMediaBuffer *buffer = NULL;
+    IMFSample *sample = NULL;
+    DWORD capacity;
+    NTSTATUS ret;
+    BYTE *data;
+    HRESULT hr;
+
+    TRACE("iface %p, flags %#lx, count %lu, samples %p, status %p.\n", iface, flags, count, samples, status);
+
+    if (count != 1) return E_INVALIDARG;
+    *status = samples->dwStatus = 0;
+    samples->pEvents = NULL;
+
+    EnterCriticalSection(&encoder->cs);
+    if (!encoder->input_type || !encoder->output_type)
+    {
+        hr = MF_E_TRANSFORM_TYPE_NOT_SET;
+        goto done;
+    }
+    if (!encoder->handle)
+    {
+        hr = MF_E_TRANSFORM_NEED_MORE_INPUT;
+        goto done;
+    }
+    params.handle = encoder->handle;
+    ret = UNIX_CALL(audio_encoder_read, &params);
+    if (ret == STATUS_PENDING)
+    {
+        encoder->draining = FALSE;
+        hr = MF_E_TRANSFORM_NEED_MORE_INPUT;
+        goto done;
+    }
+    if (ret != STATUS_BUFFER_TOO_SMALL)
+    {
+        hr = E_FAIL;
+        goto done;
+    }
+
+    if ((sample = samples->pSample)) IMFSample_AddRef(sample);
+    else if (FAILED(hr = sample_create(params.size, &sample))) goto done;
+    if (FAILED(hr = IMFSample_ConvertToContiguousBuffer(sample, &buffer))) goto done;
+    if (FAILED(hr = IMFMediaBuffer_Lock(buffer, &data, &capacity, NULL))) goto done;
+    if (capacity < params.size)
+    {
+        IMFMediaBuffer_Unlock(buffer);
+        hr = MF_E_BUFFERTOOSMALL;
+        goto done;
+    }
+    params.data = (UINT_PTR)data;
+    params.capacity = capacity;
+    ret = UNIX_CALL(audio_encoder_read, &params);
+    IMFMediaBuffer_Unlock(buffer);
+    if (ret)
+    {
+        hr = E_FAIL;
+        goto done;
+    }
+    IMFMediaBuffer_SetCurrentLength(buffer, params.size);
+
+    /* Frame k holds the output from k * 1024 - priming onwards, in the input's timeline;
+     * the first ones are the encoder's priming, which the MPEG-4 file trims. */
+    start = (LONGLONG)encoder->packets_out * AAC_FRAMES - encoder->priming;
+    total = (LONGLONG)(encoder->frames_in * encoder->output_rate / encoder->input_rate);
+    frames = AAC_FRAMES;
+    if (encoder->draining && start + frames > total) frames = max(total - start, 0);
+    IMFSample_SetSampleTime(sample, encoder->first_time + start * MF_UNITS / (LONGLONG)encoder->output_rate);
+    IMFSample_SetSampleDuration(sample, frames * MF_UNITS / (LONGLONG)encoder->output_rate);
+    IMFSample_SetUINT32(sample, &MFSampleExtension_CleanPoint, 1);
+    encoder->packets_out++;
+
+    if (!samples->pSample) IMFSample_AddRef((samples->pSample = sample));
+    hr = S_OK;
+
+done:
+    if (buffer) IMFMediaBuffer_Release(buffer);
+    if (sample) IMFSample_Release(sample);
+    LeaveCriticalSection(&encoder->cs);
+    return hr;
+}
+
+static const IMFTransformVtbl transform_vtbl =
+{
+    transform_QueryInterface,
+    transform_AddRef,
+    transform_Release,
+    transform_GetStreamLimits,
+    transform_GetStreamCount,
+    transform_GetStreamIDs,
+    transform_GetInputStreamInfo,
+    transform_GetOutputStreamInfo,
+    transform_GetAttributes,
+    transform_GetInputStreamAttributes,
+    transform_GetOutputStreamAttributes,
+    transform_DeleteInputStream,
+    transform_AddInputStreams,
+    transform_GetInputAvailableType,
+    transform_GetOutputAvailableType,
+    transform_SetInputType,
+    transform_SetOutputType,
+    transform_GetInputCurrentType,
+    transform_GetOutputCurrentType,
+    transform_GetInputStatus,
+    transform_GetOutputStatus,
+    transform_SetOutputBounds,
+    transform_ProcessEvent,
+    transform_ProcessMessage,
+    transform_ProcessInput,
+    transform_ProcessOutput,
+};
+
+HRESULT aac_encoder_create(REFIID riid, void **out)
+{
+    struct aac_encoder *encoder;
+    HRESULT hr;
+
+    TRACE("riid %s, out %p.\n", debugstr_guid(riid), out);
+
+    if (!(encoder = calloc(1, sizeof(*encoder)))) return E_OUTOFMEMORY;
+    encoder->IMFTransform_iface.lpVtbl = &transform_vtbl;
+    encoder->refcount = 1;
+    InitializeCriticalSection(&encoder->cs);
+    if (FAILED(hr = MFCreateAttributes(&encoder->attributes, 1)))
+    {
+        DeleteCriticalSection(&encoder->cs);
+        free(encoder);
+        return hr;
+    }
+    hr = IMFTransform_QueryInterface(&encoder->IMFTransform_iface, riid, out);
+    IMFTransform_Release(&encoder->IMFTransform_iface);
+    return hr;
+}
