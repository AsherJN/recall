+static HRESULT create_input_type(struct h264_encoder *encoder, const GUID *subtype, IMFMediaType **out)
+{
+    IMFMediaType *type;
+    UINT64 value;
+    HRESULT hr;
+
+    if (FAILED(hr = MFCreateMediaType(&type))) return hr;
+    IMFMediaType_SetGUID(type, &MF_MT_MAJOR_TYPE, &MFMediaType_Video);
+    IMFMediaType_SetGUID(type, &MF_MT_SUBTYPE, subtype);
+    IMFMediaType_SetUINT64(type, &MF_MT_FRAME_SIZE, (UINT64)encoder->width << 32 | encoder->height);
+    IMFMediaType_SetUINT64(type, &MF_MT_FRAME_RATE, (UINT64)encoder->rate_num << 32 | encoder->rate_den);
+    IMFMediaType_SetUINT32(type, &MF_MT_INTERLACE_MODE, MFVideoInterlace_Progressive);
+    if (FAILED(IMFMediaType_GetUINT64(encoder->output_type, &MF_MT_PIXEL_ASPECT_RATIO, &value)))
+        value = (UINT64)1 << 32 | 1;
+    IMFMediaType_SetUINT64(type, &MF_MT_PIXEL_ASPECT_RATIO, value);
+    IMFMediaType_SetUINT32(type, &MF_MT_DEFAULT_STRIDE, (UINT32)default_stride(subtype, encoder->width));
+    IMFMediaType_SetUINT32(type, &MF_MT_ALL_SAMPLES_INDEPENDENT, 1);
+    *out = type;
+    return S_OK;
+}
+
+static HRESULT WINAPI transform_GetInputAvailableType(IMFTransform *iface, DWORD id, DWORD index, IMFMediaType **type)
+{
+    struct h264_encoder *encoder = impl_from_IMFTransform(iface);
+    HRESULT hr;
+
+    TRACE("iface %p, id %#lx, index %#lx, type %p.\n", iface, id, index, type);
+
+    if (id) return MF_E_INVALIDSTREAMNUMBER;
+    *type = NULL;
+    EnterCriticalSection(&encoder->cs);
+    if (!encoder->output_type) hr = MF_E_TRANSFORM_TYPE_NOT_SET;
+    else if (index >= ARRAY_SIZE(input_types)) hr = MF_E_NO_MORE_TYPES;
+    else hr = create_input_type(encoder, input_types[index], type);
+    LeaveCriticalSection(&encoder->cs);
+    return hr;
+}
+
+static HRESULT WINAPI transform_GetOutputAvailableType(IMFTransform *iface, DWORD id, DWORD index, IMFMediaType **type)
+{
+    struct h264_encoder *encoder = impl_from_IMFTransform(iface);
+    HRESULT hr = S_OK;
+
+    TRACE("iface %p, id %#lx, index %#lx, type %p.\n", iface, id, index, type);
+
+    if (id) return MF_E_INVALIDSTREAMNUMBER;
+    if (index) return MF_E_NO_MORE_TYPES;
+    EnterCriticalSection(&encoder->cs);
+    if (encoder->output_type) hr = media_type_copy(encoder->output_type, type);
+    else if (SUCCEEDED(hr = MFCreateMediaType(type)))
+    {
+        IMFMediaType_SetGUID(*type, &MF_MT_MAJOR_TYPE, &MFMediaType_Video);
+        IMFMediaType_SetGUID(*type, &MF_MT_SUBTYPE, &MFVideoFormat_H264);
+    }
+    LeaveCriticalSection(&encoder->cs);
+    return hr;
+}
+
+static BOOL is_input_subtype(const GUID *subtype)
+{
+    unsigned int i;
+
+    for (i = 0; i < ARRAY_SIZE(input_types); ++i)
+        if (IsEqualGUID(subtype, input_types[i])) return TRUE;
+    return FALSE;
+}
+
+static HRESULT WINAPI transform_SetInputType(IMFTransform *iface, DWORD id, IMFMediaType *type, DWORD flags)
+{
+    struct h264_encoder *encoder = impl_from_IMFTransform(iface);
+    UINT32 width, height, value;
+    GUID major, subtype;
+    UINT64 size, rate;
+    HRESULT hr = S_OK;
+
+    TRACE("iface %p, id %#lx, type %p, flags %#lx.\n", iface, id, type, flags);
+
+    if (id) return MF_E_INVALIDSTREAMNUMBER;
+
+    EnterCriticalSection(&encoder->cs);
+
+    if (!type)
+    {
+        if (!(flags & MFT_SET_TYPE_TEST_ONLY))
+        {
+            if (encoder->input_type) IMFMediaType_Release(encoder->input_type);
+            encoder->input_type = NULL;
+            encoder_destroy_session(encoder);
+        }
+        goto done;
+    }
+    if (!encoder->output_type)
+    {
+        hr = MF_E_TRANSFORM_TYPE_NOT_SET;
+        goto done;
+    }
+    if (FAILED(IMFMediaType_GetGUID(type, &MF_MT_MAJOR_TYPE, &major))
+            || FAILED(IMFMediaType_GetGUID(type, &MF_MT_SUBTYPE, &subtype)))
+    {
+        hr = E_INVALIDARG;
+        goto done;
+    }
+    if (!IsEqualGUID(&major, &MFMediaType_Video) || !is_input_subtype(&subtype)
+            || FAILED(IMFMediaType_GetUINT64(type, &MF_MT_FRAME_SIZE, &size)))
+    {
+        hr = MF_E_INVALIDMEDIATYPE;
+        goto done;
+    }
+    width = size >> 32;
+    height = (UINT32)size;
+    if (width != encoder->width || height != encoder->height)
+    {
+        WARN("Input is %ux%u, output %ux%u.\n", width, height, encoder->width, encoder->height);
+        hr = MF_E_INVALIDMEDIATYPE;
+        goto done;
+    }
+    if (flags & MFT_SET_TYPE_TEST_ONLY) goto done;
+
+    if (encoder->input_type) IMFMediaType_Release(encoder->input_type);
+    IMFMediaType_AddRef((encoder->input_type = type));
+    encoder_destroy_session(encoder);
+
+    encoder->format = format_from_subtype(&subtype);
+    if (FAILED(IMFMediaType_GetUINT32(type, &MF_MT_DEFAULT_STRIDE, &value)) || !value)
+        value = (UINT32)default_stride(&subtype, encoder->width);
+    encoder->stride = (INT32)value;
+    if (SUCCEEDED(IMFMediaType_GetUINT64(type, &MF_MT_FRAME_RATE, &rate)) && (rate >> 32) && (UINT32)rate)
+    {
+        encoder->rate_num = rate >> 32;
+        encoder->rate_den = (UINT32)rate;
+    }
+    encoder->bt601 = SUCCEEDED(IMFMediaType_GetUINT32(type, &MF_MT_YUV_MATRIX, &value))
+            && value == MFVideoTransferMatrix_BT601;
+    encoder->full_range = SUCCEEDED(IMFMediaType_GetUINT32(type, &MF_MT_VIDEO_NOMINAL_RANGE, &value))
+            && value == MFNominalRange_0_255;
+    TRACE("Input %s, stride %d, %u/%u fps.\n", debugstr_guid(&subtype), encoder->stride,
+            encoder->rate_num, encoder->rate_den);
+
+done:
+    LeaveCriticalSection(&encoder->cs);
+    return hr;
+}
+
+static HRESULT WINAPI transform_SetOutputType(IMFTransform *iface, DWORD id, IMFMediaType *type, DWORD flags)
+{
+    struct h264_encoder *encoder = impl_from_IMFTransform(iface);
+    GUID major, subtype;
+    UINT64 size, rate;
+    HRESULT hr = S_OK;
+    UINT32 value;
+
+    TRACE("iface %p, id %#lx, type %p, flags %#lx.\n", iface, id, type, flags);
+
+    if (id) return MF_E_INVALIDSTREAMNUMBER;
+
+    EnterCriticalSection(&encoder->cs);
+
+    if (!type)
+    {
+        if (!(flags & MFT_SET_TYPE_TEST_ONLY))
+        {
+            if (encoder->input_type) IMFMediaType_Release(encoder->input_type);
+            if (encoder->output_type) IMFMediaType_Release(encoder->output_type);
+            encoder->input_type = encoder->output_type = NULL;
+            encoder_destroy_session(encoder);
+        }
+        goto done;
+    }
+    if (FAILED(IMFMediaType_GetGUID(type, &MF_MT_MAJOR_TYPE, &major))
+            || FAILED(IMFMediaType_GetGUID(type, &MF_MT_SUBTYPE, &subtype)))
+    {
+        hr = E_INVALIDARG;
+        goto done;
+    }
+    if (!IsEqualGUID(&major, &MFMediaType_Video) || !IsEqualGUID(&subtype, &MFVideoFormat_H264)
+            || FAILED(IMFMediaType_GetUINT64(type, &MF_MT_FRAME_SIZE, &size)) || !(size >> 32) || !(UINT32)size)
+    {
+        hr = MF_E_INVALIDMEDIATYPE;
+        goto done;
+    }
+    if (flags & MFT_SET_TYPE_TEST_ONLY) goto done;
+
+    /* As on Windows, a new output type clears the input type. */
+    if (encoder->input_type) IMFMediaType_Release(encoder->input_type);
+    encoder->input_type = NULL;
+    if (encoder->output_type) IMFMediaType_Release(encoder->output_type);
+    IMFMediaType_AddRef((encoder->output_type = type));
+    encoder_destroy_session(encoder);
+
+    encoder->width = size >> 32;
+    encoder->height = (UINT32)size;
+    if (SUCCEEDED(IMFMediaType_GetUINT64(type, &MF_MT_FRAME_RATE, &rate)) && (rate >> 32) && (UINT32)rate)
+    {
+        encoder->rate_num = rate >> 32;
+        encoder->rate_den = (UINT32)rate;
+    }
+    else
+    {
+        encoder->rate_num = 30;
+        encoder->rate_den = 1;
+    }
+    if (SUCCEEDED(IMFMediaType_GetUINT32(type, &MF_MT_MPEG2_PROFILE, &value)) && value) encoder->profile = value;
+    if (SUCCEEDED(IMFMediaType_GetUINT32(type, &MF_MT_MPEG2_LEVEL, &value)) && value) encoder->level = value;
+    if (SUCCEEDED(IMFMediaType_GetUINT32(type, &MF_MT_MAX_KEYFRAME_SPACING, &value)) && value)
+        encoder->gop_size = value;
+    TRACE("Output %ux%u at %u/%u fps, profile %u.\n", encoder->width, encoder->height,
+            encoder->rate_num, encoder->rate_den, encoder->profile);
+
+done:
+    LeaveCriticalSection(&encoder->cs);
+    return hr;
+}
+
+static HRESULT WINAPI transform_GetInputCurrentType(IMFTransform *iface, DWORD id, IMFMediaType **type)
+{
+    struct h264_encoder *encoder = impl_from_IMFTransform(iface);
