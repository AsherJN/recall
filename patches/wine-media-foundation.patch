+#ifndef __WINE_WINEMACMF_COCOA_H
+#define __WINE_WINEMACMF_COCOA_H
+
+#include <stdint.h>
+
+/* Results of the read calls. */
+#define MACMF_OK           0
+#define MACMF_NONE         1    /* nothing queued */
+#define MACMF_TOO_SMALL    2    /* size set, packet kept */
+#define MACMF_ERROR      (-1)
+
+struct macmf_video_settings
+{
+    uint32_t width;
+    uint32_t height;
+    uint32_t frame_rate_num;
+    uint32_t frame_rate_den;
+    uint32_t format;
+    uint32_t bitrate;
+    uint32_t max_bitrate;
+    uint32_t quality;
+    uint32_t profile;
+    uint32_t gop_size;
+    uint32_t b_frames;
+    uint32_t low_latency;
+    uint32_t bt601;
+    uint32_t full_range;
+};
+
+struct macmf_packet_info
+{
+    uint32_t size;
+    int64_t time;
+    int64_t decode_time;
+    int64_t duration;
+    int keyframe;
+};
+
+/* Logging goes through Wine's debug channel (unixlib.c). */
+extern void macmf_log_error(const char *message);
+extern void macmf_log_trace(const char *message);
+
+extern void *macmf_video_encoder_create(const struct macmf_video_settings *settings);
