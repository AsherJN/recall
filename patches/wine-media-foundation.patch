+/* What kind of stream a media type describes, if the sink can write it. */
+static HRESULT stream_kind_from_type(IMFMediaType *type, enum stream_kind *kind)
+{
+    GUID major, subtype;
+    UINT64 size;
+    UINT32 value;
+
+    if (FAILED(IMFMediaType_GetGUID(type, &MF_MT_MAJOR_TYPE, &major))
+            || FAILED(IMFMediaType_GetGUID(type, &MF_MT_SUBTYPE, &subtype)))
+        return MF_E_INVALIDMEDIATYPE;
+    if (IsEqualGUID(&major, &MFMediaType_Video)
+            && (IsEqualGUID(&subtype, &MFVideoFormat_H264) || IsEqualGUID(&subtype, &MFVideoFormat_H264_ES)))
+    {
+        if (FAILED(IMFMediaType_GetUINT64(type, &MF_MT_FRAME_SIZE, &size)) || !(size >> 32) || !(UINT32)size)
+            return MF_E_INVALIDMEDIATYPE;
+        *kind = STREAM_H264;
+        return S_OK;
+    }
+    if (IsEqualGUID(&major, &MFMediaType_Audio) && IsEqualGUID(&subtype, &MFAudioFormat_AAC))
+    {
+        if (FAILED(IMFMediaType_GetUINT32(type, &MF_MT_AUDIO_SAMPLES_PER_SECOND, &value)) || !value
+                || FAILED(IMFMediaType_GetUINT32(type, &MF_MT_AUDIO_NUM_CHANNELS, &value)) || !value)
+            return MF_E_INVALIDMEDIATYPE;
+        if (SUCCEEDED(IMFMediaType_GetUINT32(type, &MF_MT_AAC_PAYLOAD_TYPE, &value)) && value)
+            return MF_E_INVALIDMEDIATYPE;
+        *kind = STREAM_AAC;
+        return S_OK;
+    }
+    return MF_E_INVALIDMEDIATYPE;
+}
