+
+#include "winemacmf_private.h"
+
+#include "initguid.h"
+
+#include "codecapi.h"
+#include "icodecapi.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(macmf);
+
+/* Properties Windows' encoder has that Wine's codecapi.h lacks. */
+DEFINE_GUID(CODECAPI_AVLowLatencyMode, 0x9c27891a, 0xed7a, 0x40e1, 0x88, 0xe8, 0xb2, 0x27, 0x27, 0xa0, 0x24, 0xee);
+DEFINE_GUID(CODECAPI_AVEncMPVProfile, 0xdabb534a, 0x1d99, 0x4284, 0x97, 0x5a, 0xd9, 0x0e, 0x22, 0x39, 0xba, 0xa1);
+DEFINE_GUID(CODECAPI_AVEncMPVLevel, 0x6ee40c40, 0xa60c, 0x41ef, 0x8f, 0x50, 0x37, 0xc2, 0x24, 0x9e, 0x2c, 0xb3);
+DEFINE_GUID(CODECAPI_AVEncAdaptiveMode, 0x4419b185, 0xda1f, 0x4f53, 0xbc, 0x76, 0x09, 0x7d, 0x0c, 0x1e, 0xfb, 0x1e);
+DEFINE_GUID(CODECAPI_AVEncNumWorkerThreads, 0xb0c8bf60, 0x16f7, 0x4951, 0xa3, 0x0b, 0x1d, 0xb1, 0x60, 0x92, 0x93, 0xd6);
+/* The decode time of a sample whose frames were reordered. */
+DEFINE_GUID(MFSampleExtension_DecodeTimestamp_macmf, 0x73a954d4, 0x09e2, 0x4861, 0xbe, 0xfc, 0x94, 0xbd, 0x97, 0xc0, 0x8e, 0x6e);
+
+static const GUID *const input_types[] =
+{
+    &MFVideoFormat_NV12,
+    &MFVideoFormat_IYUV,
+    &MFVideoFormat_I420,
+    &MFVideoFormat_YV12,
+    &MFVideoFormat_YUY2,
+    /* Windows' encoder takes YUV only and the sink writer adds a color converter
+     * for RGB; Wine's converter needs GStreamer, so RGB comes straight here. */
+    &MFVideoFormat_RGB32,
+    &MFVideoFormat_ARGB32,
+};
+
+struct h264_encoder
+{
+    IMFTransform IMFTransform_iface;
+    ICodecAPI ICodecAPI_iface;
+    LONG refcount;
+
+    CRITICAL_SECTION cs;
+    IMFAttributes *attributes;
+    IMFMediaType *input_type;
+    IMFMediaType *output_type;
+
+    UINT32 width;
+    UINT32 height;
+    UINT32 rate_num;
+    UINT32 rate_den;
+    UINT32 format;
+    INT32 stride;
+    BOOL bt601;
+    BOOL full_range;
+
+    /* ICodecAPI values; zero means the encoder's choice. */
+    UINT32 rate_control;
+    UINT32 bitrate;
+    UINT32 max_bitrate;
+    UINT32 quality;
+    UINT32 quality_vs_speed;
+    UINT32 gop_size;
+    UINT32 b_frames;
+    UINT32 low_latency;
+    UINT32 profile;
+    UINT32 level;
+    UINT32 adaptive_mode;
+    UINT32 worker_threads;
+    UINT32 cabac;
+    BOOL force_keyframe;
+
+    macmf_handle handle;
+    INT64 next_time;
+    BOOL draining;
+};
+
+static struct h264_encoder *impl_from_IMFTransform(IMFTransform *iface)
+{
+    return CONTAINING_RECORD(iface, struct h264_encoder, IMFTransform_iface);
+}
+
+static struct h264_encoder *impl_from_ICodecAPI(ICodecAPI *iface)
+{
+    return CONTAINING_RECORD(iface, struct h264_encoder, ICodecAPI_iface);
+}
+
+static void encoder_destroy_session(struct h264_encoder *encoder)
+{
+    if (!encoder->handle) return;
+    UNIX_CALL(video_encoder_destroy, &encoder->handle);
+    encoder->handle = 0;
+}
+
+static UINT32 format_from_subtype(const GUID *subtype)
+{
+    if (IsEqualGUID(subtype, &MFVideoFormat_RGB32) || IsEqualGUID(subtype, &MFVideoFormat_ARGB32))
+        return MACMF_VIDEO_BGRA;
+    if (IsEqualGUID(subtype, &MFVideoFormat_NV12)) return MACMF_VIDEO_NV12;
+    if (IsEqualGUID(subtype, &MFVideoFormat_YV12)) return MACMF_VIDEO_YV12;
+    if (IsEqualGUID(subtype, &MFVideoFormat_YUY2)) return MACMF_VIDEO_YUY2;
+    return MACMF_VIDEO_I420;
+}
+
+/* Bytes per row a frame of this format has when nothing says otherwise. */
+static INT32 minimum_stride(UINT32 format, UINT32 width)
+{
+    switch (format)
+    {
+        case MACMF_VIDEO_BGRA: return width * 4;
+        case MACMF_VIDEO_YUY2: return ((width + 1) & ~1) * 2;
+        default: return width;
+    }
+}
+
+/* The stride a type without MF_MT_DEFAULT_STRIDE means, as on Windows: what
+ * MFGetStrideForBitmapInfoHeader gives, which is negative (bottom-up) for RGB. */
+static INT32 default_stride(const GUID *subtype, UINT32 width)
+{
+    LONG stride;
+
+    if (FAILED(MFGetStrideForBitmapInfoHeader(subtype->Data1, width, &stride)) || !stride)
+        stride = minimum_stride(format_from_subtype(subtype), width);
+    return stride;
+}
+
+/* Rows the whole frame spans, in units of the first plane's stride. */
+static UINT64 frame_rows(UINT32 format, UINT32 height)
+{
+    switch (format)
+    {
+        case MACMF_VIDEO_BGRA:
+        case MACMF_VIDEO_YUY2: return height;
+        default: return height + (height + 1) / 2;
+    }
+}
+
+static HRESULT encoder_create_session(struct h264_encoder *encoder)
+{
+    struct video_encoder_create_params params = {0};
+    UINT32 bitrate = encoder->bitrate;
+    NTSTATUS status;
+
+    if (encoder->handle) return S_OK;
+    if (!bitrate && encoder->output_type)
+        IMFMediaType_GetUINT32(encoder->output_type, &MF_MT_AVG_BITRATE, &bitrate);
+
+    params.width = encoder->width;
+    params.height = encoder->height;
+    params.frame_rate_num = encoder->rate_num;
+    params.frame_rate_den = encoder->rate_den;
+    params.format = encoder->format;
+    params.bitrate = encoder->rate_control == eAVEncCommonRateControlMode_Quality ? 0 : bitrate;
+    params.max_bitrate = encoder->rate_control == eAVEncCommonRateControlMode_PeakConstrainedVBR
+            || encoder->rate_control == eAVEncCommonRateControlMode_CBR ? max(encoder->max_bitrate, bitrate) : 0;
+    params.quality = encoder->rate_control == eAVEncCommonRateControlMode_Quality ? max(encoder->quality, 1) : 0;
+    params.profile = encoder->profile;
+    params.gop_size = encoder->gop_size;
+    params.b_frames = encoder->b_frames;
+    params.low_latency = encoder->low_latency;
+    params.bt601 = encoder->bt601;
+    params.full_range = encoder->full_range;
+
+    if ((status = UNIX_CALL(video_encoder_create, &params)))
+    {
+        ERR("Failed to create the H.264 encoder, status %#lx.\n", status);
+        return E_FAIL;
+    }
+    encoder->handle = params.handle;
+    TRACE("Created encoder %#I64x for %ux%u.\n", encoder->handle, encoder->width, encoder->height);
+    return S_OK;
+}
+
+static HRESULT WINAPI transform_QueryInterface(IMFTransform *iface, REFIID iid, void **out)
+{
+    struct h264_encoder *encoder = impl_from_IMFTransform(iface);
+
+    TRACE("iface %p, iid %s, out %p.\n", iface, debugstr_guid(iid), out);
+
+    if (IsEqualGUID(iid, &IID_IUnknown) || IsEqualGUID(iid, &IID_IMFTransform))
+        *out = &encoder->IMFTransform_iface;
+    else if (IsEqualGUID(iid, &IID_ICodecAPI))
+        *out = &encoder->ICodecAPI_iface;
+    else
+    {
+        *out = NULL;
+        WARN("%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid(iid));
+        return E_NOINTERFACE;
+    }
+    IUnknown_AddRef((IUnknown *)*out);
+    return S_OK;
+}
+
+static ULONG WINAPI transform_AddRef(IMFTransform *iface)
+{
+    struct h264_encoder *encoder = impl_from_IMFTransform(iface);
+    ULONG refcount = InterlockedIncrement(&encoder->refcount);
+
+    TRACE("iface %p increasing refcount to %lu.\n", encoder, refcount);
+    return refcount;
+}
+
+static ULONG WINAPI transform_Release(IMFTransform *iface)
+{
+    struct h264_encoder *encoder = impl_from_IMFTransform(iface);
+    ULONG refcount = InterlockedDecrement(&encoder->refcount);
+
+    TRACE("iface %p decreasing refcount to %lu.\n", encoder, refcount);
+
+    if (!refcount)
+    {
+        encoder_destroy_session(encoder);
+        if (encoder->input_type) IMFMediaType_Release(encoder->input_type);
+        if (encoder->output_type) IMFMediaType_Release(encoder->output_type);
+        IMFAttributes_Release(encoder->attributes);
+        DeleteCriticalSection(&encoder->cs);
+        free(encoder);
+    }
+    return refcount;
+}
+
+static HRESULT WINAPI transform_GetStreamLimits(IMFTransform *iface, DWORD *input_minimum,
+        DWORD *input_maximum, DWORD *output_minimum, DWORD *output_maximum)
+{
+    *input_minimum = *input_maximum = *output_minimum = *output_maximum = 1;
+    return S_OK;
+}
+
+static HRESULT WINAPI transform_GetStreamCount(IMFTransform *iface, DWORD *inputs, DWORD *outputs)
+{
+    *inputs = *outputs = 1;
+    return S_OK;
+}
