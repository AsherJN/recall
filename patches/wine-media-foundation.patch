+extern int macmf_video_encoder_drain(void *encoder);
+extern void macmf_video_encoder_flush(void *encoder);
+extern int macmf_video_encoder_read(void *encoder, uint8_t *data, uint32_t capacity,
+        struct macmf_packet_info *info);
+extern int macmf_video_encoder_config(void *encoder, uint8_t *data, uint32_t capacity, uint32_t *size);
+
+extern void *macmf_audio_encoder_create(uint32_t input_rate, uint32_t channels, uint32_t format,
+        uint32_t output_rate, uint32_t bitrate, uint32_t *priming, uint8_t *config, uint32_t *config_size);
+extern void macmf_audio_encoder_destroy(void *encoder);
+extern int macmf_audio_encoder_encode(void *encoder, const uint8_t *data, uint32_t size);
