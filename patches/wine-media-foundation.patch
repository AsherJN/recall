+DEFINE_GUID(MFSampleExtension_DecodeTimestamp_sink, 0x73a954d4, 0x09e2, 0x4861, 0xbe, 0xfc, 0x94, 0xbd, 0x97, 0xc0, 0x8e, 0x6e);
+
+#define MAX_STREAMS 8
+/* Sample requests kept open per stream, so the writer never waits on the sink. The sink
+ * takes each sample at once; the requests reach the writer through the standard work queue,
+ * so many open ones keep samples flowing while that queue is held up. */
+#define REQUESTS_AHEAD 64
+
+enum stream_kind
+{
+    STREAM_H264,
+    STREAM_AAC,
+};
+
+struct mpeg4_sink;
+
+struct mpeg4_stream
+{
+    IMFStreamSink IMFStreamSink_iface;
+    IMFMediaTypeHandler IMFMediaTypeHandler_iface;
+    LONG refcount;
+
+    struct mpeg4_sink *sink;
+    IMFMediaEventQueue *event_queue;
+    IMFMediaType *type;
+    DWORD id;
+    enum stream_kind kind;
+    UINT32 track;           /* NO_TRACK when the file leaves the stream out */
+    UINT64 written;
+    UINT64 refused;
+};
+
+#define NO_TRACK (~0u)
+
+enum sink_state
+{
+    SINK_STOPPED,
+    SINK_STARTED,
+    SINK_FINALIZING,
+    SINK_FINALIZED,
+};
+
+struct mpeg4_sink
+{
+    IMFFinalizableMediaSink IMFFinalizableMediaSink_iface;
+    IMFClockStateSink IMFClockStateSink_iface;
+    LONG refcount;
+
+    CRITICAL_SECTION cs;
+    BOOL shutdown;
+    BOOL fixed_streams;
+    enum sink_state state;
+    IMFByteStream *bytestream;
+    IMFPresentationClock *clock;
+    struct mpeg4_stream *streams[MAX_STREAMS];
+    DWORD stream_count;
+    macmf_handle muxer;
+};
+
+struct sink_class_factory
+{
+    IMFSinkClassFactory IMFSinkClassFactory_iface;
+    LONG refcount;
+};
+
+static struct mpeg4_stream *impl_from_IMFStreamSink(IMFStreamSink *iface)
+{
+    return CONTAINING_RECORD(iface, struct mpeg4_stream, IMFStreamSink_iface);
+}
+
+static struct mpeg4_stream *impl_from_IMFMediaTypeHandler(IMFMediaTypeHandler *iface)
+{
+    return CONTAINING_RECORD(iface, struct mpeg4_stream, IMFMediaTypeHandler_iface);
+}
+
+static struct mpeg4_sink *impl_from_IMFFinalizableMediaSink(IMFFinalizableMediaSink *iface)
+{
+    return CONTAINING_RECORD(iface, struct mpeg4_sink, IMFFinalizableMediaSink_iface);
+}
+
+static struct mpeg4_sink *impl_from_IMFClockStateSink(IMFClockStateSink *iface)
+{
+    return CONTAINING_RECORD(iface, struct mpeg4_sink, IMFClockStateSink_iface);
+}
+
+/* What kind of stream a media type describes, if the sink can write it. */
+static HRESULT stream_kind_from_type(IMFMediaType *type, enum stream_kind *kind)
+{
+    GUID major, subtype;
+    UINT64 size;
+    UINT32 value;
+
+    if (FAILED(IMFMediaType_GetGUID(type, &MF_MT_MAJOR_TYPE, &major))
+            || FAILED(IMFMediaType_GetGUID(type, &MF_MT_SUBTYPE, &subtype)))
+        return MF_E_INVALIDMEDIATYPE;
+    if (IsEqualGUID(&major, &MFMediaType_Video)
+            && (IsEqualGUID(&subtype, &MFVideoFormat_H264) || IsEqualGUID(&subtype, &MFVideoFormat_H264_ES)))
+    {
+        if (FAILED(IMFMediaType_GetUINT64(type, &MF_MT_FRAME_SIZE, &size)) || !(size >> 32) || !(UINT32)size)
+            return MF_E_INVALIDMEDIATYPE;
+        *kind = STREAM_H264;
+        return S_OK;
+    }
+    if (IsEqualGUID(&major, &MFMediaType_Audio) && IsEqualGUID(&subtype, &MFAudioFormat_AAC))
+    {
+        if (FAILED(IMFMediaType_GetUINT32(type, &MF_MT_AUDIO_SAMPLES_PER_SECOND, &value)) || !value
+                || FAILED(IMFMediaType_GetUINT32(type, &MF_MT_AUDIO_NUM_CHANNELS, &value)) || !value)
+            return MF_E_INVALIDMEDIATYPE;
+        if (SUCCEEDED(IMFMediaType_GetUINT32(type, &MF_MT_AAC_PAYLOAD_TYPE, &value)) && value)
+            return MF_E_INVALIDMEDIATYPE;
+        *kind = STREAM_AAC;
+        return S_OK;
+    }
+    return MF_E_INVALIDMEDIATYPE;
+}
+
+static HRESULT WINAPI stream_QueryInterface(IMFStreamSink *iface, REFIID riid, void **out)
+{
+    struct mpeg4_stream *stream = impl_from_IMFStreamSink(iface);
+
+    TRACE("iface %p, riid %s, out %p.\n", iface, debugstr_guid(riid), out);
+
+    if (IsEqualIID(riid, &IID_IMFStreamSink) || IsEqualIID(riid, &IID_IMFMediaEventGenerator)
+            || IsEqualIID(riid, &IID_IUnknown))
+        *out = &stream->IMFStreamSink_iface;
+    else if (IsEqualIID(riid, &IID_IMFMediaTypeHandler))
+        *out = &stream->IMFMediaTypeHandler_iface;
+    else
+    {
+        WARN("Unsupported %s.\n", debugstr_guid(riid));
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    IUnknown_AddRef((IUnknown *)*out);
+    return S_OK;
+}
+
+static ULONG WINAPI stream_AddRef(IMFStreamSink *iface)
+{
+    struct mpeg4_stream *stream = impl_from_IMFStreamSink(iface);
+    return InterlockedIncrement(&stream->refcount);
+}
+
+static ULONG WINAPI stream_Release(IMFStreamSink *iface)
+{
+    struct mpeg4_stream *stream = impl_from_IMFStreamSink(iface);
+    ULONG refcount = InterlockedDecrement(&stream->refcount);
+
+    if (!refcount)
+    {
+        if (stream->event_queue) IMFMediaEventQueue_Release(stream->event_queue);
+        if (stream->type) IMFMediaType_Release(stream->type);
+        if (stream->sink) IMFFinalizableMediaSink_Release(&stream->sink->IMFFinalizableMediaSink_iface);
+        free(stream);
+    }
+    return refcount;
+}
+
+static HRESULT WINAPI stream_GetEvent(IMFStreamSink *iface, DWORD flags, IMFMediaEvent **event)
+{
+    struct mpeg4_stream *stream = impl_from_IMFStreamSink(iface);
+    return IMFMediaEventQueue_GetEvent(stream->event_queue, flags, event);
+}
+
+static HRESULT WINAPI stream_BeginGetEvent(IMFStreamSink *iface, IMFAsyncCallback *callback, IUnknown *state)
+{
+    struct mpeg4_stream *stream = impl_from_IMFStreamSink(iface);
+    return IMFMediaEventQueue_BeginGetEvent(stream->event_queue, callback, state);
+}
+
+static HRESULT WINAPI stream_EndGetEvent(IMFStreamSink *iface, IMFAsyncResult *result, IMFMediaEvent **event)
+{
+    struct mpeg4_stream *stream = impl_from_IMFStreamSink(iface);
+    return IMFMediaEventQueue_EndGetEvent(stream->event_queue, result, event);
+}
+
+static HRESULT WINAPI stream_QueueEvent(IMFStreamSink *iface, MediaEventType type, REFGUID ext_type,
+        HRESULT status, const PROPVARIANT *value)
+{
+    struct mpeg4_stream *stream = impl_from_IMFStreamSink(iface);
+    return IMFMediaEventQueue_QueueEventParamVar(stream->event_queue, type, ext_type, status, value);
+}
+
+static HRESULT WINAPI stream_GetMediaSink(IMFStreamSink *iface, IMFMediaSink **sink)
+{
+    struct mpeg4_stream *stream = impl_from_IMFStreamSink(iface);
+    HRESULT hr = S_OK;
+
+    EnterCriticalSection(&stream->sink->cs);
+    if (stream->sink->shutdown) hr = MF_E_STREAMSINK_REMOVED;
+    else IMFMediaSink_AddRef((*sink = (IMFMediaSink *)&stream->sink->IMFFinalizableMediaSink_iface));
+    LeaveCriticalSection(&stream->sink->cs);
+    return hr;
+}
+
+static HRESULT WINAPI stream_GetIdentifier(IMFStreamSink *iface, DWORD *id)
+{
+    struct mpeg4_stream *stream = impl_from_IMFStreamSink(iface);
+    HRESULT hr = S_OK;
+
+    EnterCriticalSection(&stream->sink->cs);
+    if (stream->sink->shutdown) hr = MF_E_STREAMSINK_REMOVED;
+    else *id = stream->id;
+    LeaveCriticalSection(&stream->sink->cs);
+    return hr;
+}
+
+static HRESULT WINAPI stream_GetMediaTypeHandler(IMFStreamSink *iface, IMFMediaTypeHandler **handler)
+{
+    struct mpeg4_stream *stream = impl_from_IMFStreamSink(iface);
+
+    if (!handler) return E_POINTER;
+    IMFMediaTypeHandler_AddRef((*handler = &stream->IMFMediaTypeHandler_iface));
+    return S_OK;
+}
+
+static BOOL buffer_has_idr(const BYTE *data, DWORD size)
+{
+    DWORD i;
+
+    for (i = 0; i + 3 < size; ++i)
+        if (!data[i] && !data[i + 1] && data[i + 2] == 1 && (data[i + 3] & 0x1f) == 5) return TRUE;
+    return FALSE;
+}
+
+static HRESULT WINAPI stream_ProcessSample(IMFStreamSink *iface, IMFSample *sample)
+{
+    struct mpeg4_stream *stream = impl_from_IMFStreamSink(iface);
+    struct mpeg4_sink *sink = stream->sink;
+    struct muxer_write_params params = {0};
+    IMFMediaBuffer *buffer = NULL;
+    LONGLONG time, duration;
+    UINT32 clean_point;
+    UINT64 decode_time;
+    DWORD length;
+    BYTE *data;
+    HRESULT hr;
+
+    TRACE("iface %p, sample %p.\n", iface, sample);
+
+    if (!sample) return E_POINTER;
+
+    EnterCriticalSection(&sink->cs);
+    if (sink->shutdown)
+    {
+        hr = MF_E_STREAMSINK_REMOVED;
+        goto done;
+    }
+    if (sink->state != SINK_STARTED || !sink->muxer)
+    {
+        hr = MF_E_INVALIDREQUEST;
+        goto done;
+    }
+    if (stream->track == NO_TRACK) goto request;
+    if (FAILED(hr = IMFSample_GetSampleTime(sample, &time))) goto done;
+    if (FAILED(IMFSample_GetSampleDuration(sample, &duration))) duration = 0;
+    if (FAILED(hr = IMFSample_ConvertToContiguousBuffer(sample, &buffer))) goto done;
+    if (FAILED(hr = IMFMediaBuffer_Lock(buffer, &data, NULL, &length))) goto done;
+
+    params.handle = sink->muxer;
+    params.track = stream->track;
+    params.data = (UINT_PTR)data;
+    params.size = length;
+    params.time = time;
+    params.duration = duration;
+    if (SUCCEEDED(IMFSample_GetUINT64(sample, &MFSampleExtension_DecodeTimestamp_sink, &decode_time)))
+        params.decode_time = (INT64)decode_time;
+    else
+        params.decode_time = stream->kind == STREAM_AAC ? time : (INT64)((UINT64)1 << 63);
+    if (SUCCEEDED(IMFSample_GetUINT32(sample, &MFSampleExtension_CleanPoint, &clean_point)))
+        params.keyframe = !!clean_point;
+    else
+        params.keyframe = stream->kind == STREAM_AAC || buffer_has_idr(data, length);
+
+    /* One sample the writer cannot take costs that sample, not the file. */
+    if (length && UNIX_CALL(muxer_write, &params) && !stream->refused++)
+        ERR("The MPEG-4 writer left out sample %I64u of stream %lu; the file keeps the rest.\n",
+                stream->written, stream->id);
+    IMFMediaBuffer_Unlock(buffer);
+    stream->written++;
+
+request:
+    hr = IMFMediaEventQueue_QueueEventParamVar(stream->event_queue, MEStreamSinkRequestSample,
+            &GUID_NULL, S_OK, NULL);
+
+done:
+    if (buffer) IMFMediaBuffer_Release(buffer);
+    LeaveCriticalSection(&sink->cs);
+    return hr;
+}
+
+static HRESULT WINAPI stream_PlaceMarker(IMFStreamSink *iface, MFSTREAMSINK_MARKER_TYPE type,
+        const PROPVARIANT *value, const PROPVARIANT *context)
+{
+    struct mpeg4_stream *stream = impl_from_IMFStreamSink(iface);
+    HRESULT hr;
+
+    TRACE("iface %p, type %d, value %p, context %p.\n", iface, type, value, context);
+
+    EnterCriticalSection(&stream->sink->cs);
+    if (stream->sink->shutdown) hr = MF_E_STREAMSINK_REMOVED;
+    else hr = IMFMediaEventQueue_QueueEventParamVar(stream->event_queue, MEStreamSinkMarker, &GUID_NULL, S_OK,
+            context);
+    LeaveCriticalSection(&stream->sink->cs);
+    return hr;
+}
+
+static HRESULT WINAPI stream_Flush(IMFStreamSink *iface)
+{
+    struct mpeg4_stream *stream = impl_from_IMFStreamSink(iface);
+    HRESULT hr = S_OK;
+
+    TRACE("iface %p.\n", iface);
+
+    EnterCriticalSection(&stream->sink->cs);
+    if (stream->sink->shutdown) hr = MF_E_STREAMSINK_REMOVED;
+    LeaveCriticalSection(&stream->sink->cs);
+    return hr;
+}
+
+static const IMFStreamSinkVtbl stream_vtbl =
+{
+    stream_QueryInterface,
+    stream_AddRef,
+    stream_Release,
+    stream_GetEvent,
+    stream_BeginGetEvent,
+    stream_EndGetEvent,
+    stream_QueueEvent,
+    stream_GetMediaSink,
+    stream_GetIdentifier,
+    stream_GetMediaTypeHandler,
+    stream_ProcessSample,
+    stream_PlaceMarker,
+    stream_Flush,
+};
+
+static HRESULT WINAPI type_handler_QueryInterface(IMFMediaTypeHandler *iface, REFIID riid, void **out)
+{
+    struct mpeg4_stream *stream = impl_from_IMFMediaTypeHandler(iface);
+    return IMFStreamSink_QueryInterface(&stream->IMFStreamSink_iface, riid, out);
+}
+
+static ULONG WINAPI type_handler_AddRef(IMFMediaTypeHandler *iface)
+{
+    struct mpeg4_stream *stream = impl_from_IMFMediaTypeHandler(iface);
+    return IMFStreamSink_AddRef(&stream->IMFStreamSink_iface);
+}
+
+static ULONG WINAPI type_handler_Release(IMFMediaTypeHandler *iface)
+{
+    struct mpeg4_stream *stream = impl_from_IMFMediaTypeHandler(iface);
+    return IMFStreamSink_Release(&stream->IMFStreamSink_iface);
+}
+
+static HRESULT WINAPI type_handler_IsMediaTypeSupported(IMFMediaTypeHandler *iface, IMFMediaType *type,
+        IMFMediaType **closest)
+{
+    struct mpeg4_stream *stream = impl_from_IMFMediaTypeHandler(iface);
+    enum stream_kind kind;
+    HRESULT hr;
+
+    TRACE("iface %p, type %p, closest %p.\n", iface, type, closest);
+
+    if (closest) *closest = NULL;
+    if (!type) return E_POINTER;
+    if (FAILED(hr = stream_kind_from_type(type, &kind))) return hr;
+    return kind == stream->kind ? S_OK : MF_E_INVALIDMEDIATYPE;
+}
+
+static HRESULT WINAPI type_handler_GetMediaTypeCount(IMFMediaTypeHandler *iface, DWORD *count)
+{
+    *count = 1;
+    return S_OK;
+}
+
+static HRESULT WINAPI type_handler_GetMediaTypeByIndex(IMFMediaTypeHandler *iface, DWORD index, IMFMediaType **type)
+{
+    struct mpeg4_stream *stream = impl_from_IMFMediaTypeHandler(iface);
+    HRESULT hr;
+
+    if (index) return MF_E_NO_MORE_TYPES;
+    EnterCriticalSection(&stream->sink->cs);
+    hr = media_type_copy(stream->type, type);
+    LeaveCriticalSection(&stream->sink->cs);
+    return hr;
+}
+
+static HRESULT WINAPI type_handler_SetCurrentMediaType(IMFMediaTypeHandler *iface, IMFMediaType *type)
+{
+    struct mpeg4_stream *stream = impl_from_IMFMediaTypeHandler(iface);
+    enum stream_kind kind;
+    IMFMediaType *copy;
+    HRESULT hr;
+
+    TRACE("iface %p, type %p.\n", iface, type);
+
+    if (!type) return E_POINTER;
+    if (FAILED(hr = stream_kind_from_type(type, &kind))) return hr;
+    if (kind != stream->kind) return MF_E_INVALIDMEDIATYPE;
+
+    EnterCriticalSection(&stream->sink->cs);
+    if (stream->sink->state != SINK_STOPPED) hr = MF_E_INVALIDREQUEST;
+    else if (SUCCEEDED(hr = media_type_copy(type, &copy)))
+    {
+        IMFMediaType_Release(stream->type);
+        stream->type = copy;
+    }
+    LeaveCriticalSection(&stream->sink->cs);
+    return hr;
+}
+
+static HRESULT WINAPI type_handler_GetCurrentMediaType(IMFMediaTypeHandler *iface, IMFMediaType **type)
+{
+    struct mpeg4_stream *stream = impl_from_IMFMediaTypeHandler(iface);
+
+    if (!type) return E_POINTER;
+    EnterCriticalSection(&stream->sink->cs);
+    IMFMediaType_AddRef((*type = stream->type));
+    LeaveCriticalSection(&stream->sink->cs);
+    return S_OK;
+}
+
+static HRESULT WINAPI type_handler_GetMajorType(IMFMediaTypeHandler *iface, GUID *type)
+{
+    struct mpeg4_stream *stream = impl_from_IMFMediaTypeHandler(iface);
+
+    if (!type) return E_POINTER;
+    *type = stream->kind == STREAM_H264 ? MFMediaType_Video : MFMediaType_Audio;
+    return S_OK;
+}
+
+static const IMFMediaTypeHandlerVtbl type_handler_vtbl =
+{
+    type_handler_QueryInterface,
+    type_handler_AddRef,
+    type_handler_Release,
+    type_handler_IsMediaTypeSupported,
+    type_handler_GetMediaTypeCount,
+    type_handler_GetMediaTypeByIndex,
+    type_handler_SetCurrentMediaType,
+    type_handler_GetCurrentMediaType,
+    type_handler_GetMajorType,
+};
+
+static HRESULT stream_create(struct mpeg4_sink *sink, DWORD id, IMFMediaType *type, struct mpeg4_stream **out)
+{
+    struct mpeg4_stream *stream;
+    enum stream_kind kind;
+    HRESULT hr;
+
+    if (FAILED(hr = stream_kind_from_type(type, &kind))) return hr;
+    if (!(stream = calloc(1, sizeof(*stream)))) return E_OUTOFMEMORY;
+    stream->IMFStreamSink_iface.lpVtbl = &stream_vtbl;
+    stream->IMFMediaTypeHandler_iface.lpVtbl = &type_handler_vtbl;
+    stream->refcount = 1;
+    stream->id = id;
+    stream->kind = kind;
+    if (FAILED(hr = MFCreateEventQueue(&stream->event_queue))
+            || FAILED(hr = media_type_copy(type, &stream->type)))
+    {
+        IMFStreamSink_Release(&stream->IMFStreamSink_iface);
+        return hr;
+    }
+    IMFFinalizableMediaSink_AddRef(&sink->IMFFinalizableMediaSink_iface);
+    stream->sink = sink;
+    *out = stream;
+    return S_OK;
+}
+
+static struct mpeg4_stream *sink_find_stream(struct mpeg4_sink *sink, DWORD id)
+{
+    DWORD i;
+
+    for (i = 0; i < sink->stream_count; ++i)
+        if (sink->streams[i]->id == id) return sink->streams[i];
+    return NULL;
+}
+
+static HRESULT WINAPI sink_QueryInterface(IMFFinalizableMediaSink *iface, REFIID riid, void **out)
+{
+    struct mpeg4_sink *sink = impl_from_IMFFinalizableMediaSink(iface);
+
+    TRACE("iface %p, riid %s, out %p.\n", iface, debugstr_guid(riid), out);
+
+    if (IsEqualIID(riid, &IID_IMFFinalizableMediaSink) || IsEqualIID(riid, &IID_IMFMediaSink)
+            || IsEqualIID(riid, &IID_IUnknown))
+        *out = &sink->IMFFinalizableMediaSink_iface;
+    else if (IsEqualIID(riid, &IID_IMFClockStateSink))
+        *out = &sink->IMFClockStateSink_iface;
+    else
+    {
+        WARN("Unsupported %s.\n", debugstr_guid(riid));
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    IUnknown_AddRef((IUnknown *)*out);
+    return S_OK;
+}
+
+static ULONG WINAPI sink_AddRef(IMFFinalizableMediaSink *iface)
+{
+    struct mpeg4_sink *sink = impl_from_IMFFinalizableMediaSink(iface);
+    return InterlockedIncrement(&sink->refcount);
+}
+
+static ULONG WINAPI sink_Release(IMFFinalizableMediaSink *iface)
+{
+    struct mpeg4_sink *sink = impl_from_IMFFinalizableMediaSink(iface);
+    ULONG refcount = InterlockedDecrement(&sink->refcount);
+
+    if (!refcount)
+    {
+        if (sink->muxer) UNIX_CALL(muxer_destroy, &sink->muxer);
+        if (sink->bytestream) IMFByteStream_Release(sink->bytestream);
+        if (sink->clock) IMFPresentationClock_Release(sink->clock);
+        DeleteCriticalSection(&sink->cs);
+        free(sink);
+    }
+    return refcount;
+}
+
+static HRESULT WINAPI sink_GetCharacteristics(IMFFinalizableMediaSink *iface, DWORD *flags)
+{
+    struct mpeg4_sink *sink = impl_from_IMFFinalizableMediaSink(iface);
+    HRESULT hr = S_OK;
+
+    EnterCriticalSection(&sink->cs);
+    if (sink->shutdown) hr = MF_E_SHUTDOWN;
+    else *flags = MEDIASINK_RATELESS | (sink->fixed_streams ? MEDIASINK_FIXED_STREAMS : 0);
+    LeaveCriticalSection(&sink->cs);
+    return hr;
+}
+
+static HRESULT WINAPI sink_AddStreamSink(IMFFinalizableMediaSink *iface, DWORD id, IMFMediaType *type,
+        IMFStreamSink **out)
+{
+    struct mpeg4_sink *sink = impl_from_IMFFinalizableMediaSink(iface);
+    struct mpeg4_stream *stream;
+    HRESULT hr;
+
+    TRACE("iface %p, id %#lx, type %p, out %p.\n", iface, id, type, out);
+
+    if (!type) return E_INVALIDARG;
+
+    EnterCriticalSection(&sink->cs);
+    if (sink->shutdown) hr = MF_E_SHUTDOWN;
+    else if (sink->fixed_streams) hr = MF_E_STREAMSINKS_FIXED;
+    else if (sink_find_stream(sink, id)) hr = MF_E_STREAMSINK_EXISTS;
+    else if (sink->stream_count == MAX_STREAMS || sink->state != SINK_STOPPED) hr = MF_E_INVALIDREQUEST;
+    else if (SUCCEEDED(hr = stream_create(sink, id, type, &stream)))
+    {
+        sink->streams[sink->stream_count++] = stream;
+        if (out) IMFStreamSink_AddRef((*out = &stream->IMFStreamSink_iface));
+    }
+    LeaveCriticalSection(&sink->cs);
+    return hr;
+}
+
+static HRESULT WINAPI sink_RemoveStreamSink(IMFFinalizableMediaSink *iface, DWORD id)
+{
+    struct mpeg4_sink *sink = impl_from_IMFFinalizableMediaSink(iface);
+    HRESULT hr = MF_E_INVALIDSTREAMNUMBER;
+    DWORD i;
+
+    TRACE("iface %p, id %#lx.\n", iface, id);
+
+    EnterCriticalSection(&sink->cs);
+    if (sink->shutdown) hr = MF_E_SHUTDOWN;
+    else if (sink->fixed_streams) hr = MF_E_STREAMSINKS_FIXED;
+    else if (sink->state != SINK_STOPPED) hr = MF_E_INVALIDREQUEST;
+    else
+    {
+        for (i = 0; i < sink->stream_count; ++i)
+        {
+            if (sink->streams[i]->id != id) continue;
+            IMFMediaEventQueue_Shutdown(sink->streams[i]->event_queue);
+            IMFStreamSink_Release(&sink->streams[i]->IMFStreamSink_iface);
+            memmove(&sink->streams[i], &sink->streams[i + 1], (sink->stream_count - i - 1) * sizeof(*sink->streams));
+            sink->stream_count--;
+            hr = S_OK;
+            break;
+        }
+    }
+    LeaveCriticalSection(&sink->cs);
+    return hr;
+}
+
+static HRESULT WINAPI sink_GetStreamSinkCount(IMFFinalizableMediaSink *iface, DWORD *count)
+{
+    struct mpeg4_sink *sink = impl_from_IMFFinalizableMediaSink(iface);
+    HRESULT hr = S_OK;
+
+    if (!count) return E_POINTER;
+    EnterCriticalSection(&sink->cs);
+    if (sink->shutdown) hr = MF_E_SHUTDOWN;
+    else *count = sink->stream_count;
+    LeaveCriticalSection(&sink->cs);
+    return hr;
+}
+
+static HRESULT WINAPI sink_GetStreamSinkByIndex(IMFFinalizableMediaSink *iface, DWORD index, IMFStreamSink **out)
+{
+    struct mpeg4_sink *sink = impl_from_IMFFinalizableMediaSink(iface);
+    HRESULT hr = S_OK;
+
+    if (!out) return E_POINTER;
+    EnterCriticalSection(&sink->cs);
+    if (sink->shutdown) hr = MF_E_SHUTDOWN;
+    else if (index >= sink->stream_count) hr = MF_E_INVALIDINDEX;
+    else IMFStreamSink_AddRef((*out = &sink->streams[index]->IMFStreamSink_iface));
+    LeaveCriticalSection(&sink->cs);
+    return hr;
+}
+
+static HRESULT WINAPI sink_GetStreamSinkById(IMFFinalizableMediaSink *iface, DWORD id, IMFStreamSink **out)
+{
+    struct mpeg4_sink *sink = impl_from_IMFFinalizableMediaSink(iface);
+    struct mpeg4_stream *stream;
+    HRESULT hr = S_OK;
+
+    if (!out) return E_POINTER;
+    EnterCriticalSection(&sink->cs);
+    if (sink->shutdown) hr = MF_E_SHUTDOWN;
+    else if (!(stream = sink_find_stream(sink, id))) hr = MF_E_INVALIDSTREAMNUMBER;
+    else IMFStreamSink_AddRef((*out = &stream->IMFStreamSink_iface));
+    LeaveCriticalSection(&sink->cs);
+    return hr;
+}
