+static HRESULT stream_create(struct mpeg4_sink *sink, DWORD id, IMFMediaType *type, struct mpeg4_stream **out)
+{
+    struct mpeg4_stream *stream;
+    enum stream_kind kind;
+    HRESULT hr;
+
+    if (FAILED(hr = stream_kind_from_type(type, &kind))) return hr;
+    if (!(stream = calloc(1, sizeof(*stream)))) return E_OUTOFMEMORY;
+    stream->IMFStreamSink_iface.lpVtbl = &stream_vtbl;
+    stream->IMFMediaTypeHandler_iface.lpVtbl = &type_handler_vtbl;
+    stream->refcount = 1;
+    stream->id = id;
+    stream->kind = kind;
+    if (FAILED(hr = MFCreateEventQueue(&stream->event_queue))
+            || FAILED(hr = media_type_copy(type, &stream->type)))
+    {
+        IMFStreamSink_Release(&stream->IMFStreamSink_iface);
+        return hr;
+    }
+    IMFFinalizableMediaSink_AddRef(&sink->IMFFinalizableMediaSink_iface);
+    stream->sink = sink;
+    *out = stream;
+    return S_OK;
+}
+
+static struct mpeg4_stream *sink_find_stream(struct mpeg4_sink *sink, DWORD id)
+{
+    DWORD i;
+
+    for (i = 0; i < sink->stream_count; ++i)
+        if (sink->streams[i]->id == id) return sink->streams[i];
+    return NULL;
+}
+
+static HRESULT WINAPI sink_QueryInterface(IMFFinalizableMediaSink *iface, REFIID riid, void **out)
+{
+    struct mpeg4_sink *sink = impl_from_IMFFinalizableMediaSink(iface);
+
+    TRACE("iface %p, riid %s, out %p.\n", iface, debugstr_guid(riid), out);
+
+    if (IsEqualIID(riid, &IID_IMFFinalizableMediaSink) || IsEqualIID(riid, &IID_IMFMediaSink)
+            || IsEqualIID(riid, &IID_IUnknown))
+        *out = &sink->IMFFinalizableMediaSink_iface;
+    else if (IsEqualIID(riid, &IID_IMFClockStateSink))
+        *out = &sink->IMFClockStateSink_iface;
+    else
+    {
+        WARN("Unsupported %s.\n", debugstr_guid(riid));
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    IUnknown_AddRef((IUnknown *)*out);
+    return S_OK;
+}
+
+static ULONG WINAPI sink_AddRef(IMFFinalizableMediaSink *iface)
+{
+    struct mpeg4_sink *sink = impl_from_IMFFinalizableMediaSink(iface);
+    return InterlockedIncrement(&sink->refcount);
+}
+
+static ULONG WINAPI sink_Release(IMFFinalizableMediaSink *iface)
+{
+    struct mpeg4_sink *sink = impl_from_IMFFinalizableMediaSink(iface);
+    ULONG refcount = InterlockedDecrement(&sink->refcount);
+
+    if (!refcount)
+    {
+        if (sink->muxer) UNIX_CALL(muxer_destroy, &sink->muxer);
+        if (sink->bytestream) IMFByteStream_Release(sink->bytestream);
+        if (sink->clock) IMFPresentationClock_Release(sink->clock);
+        DeleteCriticalSection(&sink->cs);
+        free(sink);
+    }
+    return refcount;
+}
+
+static HRESULT WINAPI sink_GetCharacteristics(IMFFinalizableMediaSink *iface, DWORD *flags)
+{
+    struct mpeg4_sink *sink = impl_from_IMFFinalizableMediaSink(iface);
+    HRESULT hr = S_OK;
+
+    EnterCriticalSection(&sink->cs);
+    if (sink->shutdown) hr = MF_E_SHUTDOWN;
+    else *flags = MEDIASINK_RATELESS | (sink->fixed_streams ? MEDIASINK_FIXED_STREAMS : 0);
+    LeaveCriticalSection(&sink->cs);
+    return hr;
+}
+
+static HRESULT WINAPI sink_AddStreamSink(IMFFinalizableMediaSink *iface, DWORD id, IMFMediaType *type,
+        IMFStreamSink **out)
+{
+    struct mpeg4_sink *sink = impl_from_IMFFinalizableMediaSink(iface);
+    struct mpeg4_stream *stream;
+    HRESULT hr;
+
+    TRACE("iface %p, id %#lx, type %p, out %p.\n", iface, id, type, out);
+
+    if (!type) return E_INVALIDARG;
+
+    EnterCriticalSection(&sink->cs);
+    if (sink->shutdown) hr = MF_E_SHUTDOWN;
+    else if (sink->fixed_streams) hr = MF_E_STREAMSINKS_FIXED;
+    else if (sink_find_stream(sink, id)) hr = MF_E_STREAMSINK_EXISTS;
+    else if (sink->stream_count == MAX_STREAMS || sink->state != SINK_STOPPED) hr = MF_E_INVALIDREQUEST;
+    else if (SUCCEEDED(hr = stream_create(sink, id, type, &stream)))
+    {
+        sink->streams[sink->stream_count++] = stream;
+        if (out) IMFStreamSink_AddRef((*out = &stream->IMFStreamSink_iface));
+    }
+    LeaveCriticalSection(&sink->cs);
+    return hr;
+}
+
+static HRESULT WINAPI sink_RemoveStreamSink(IMFFinalizableMediaSink *iface, DWORD id)
+{
+    struct mpeg4_sink *sink = impl_from_IMFFinalizableMediaSink(iface);
+    HRESULT hr = MF_E_INVALIDSTREAMNUMBER;
+    DWORD i;
+
+    TRACE("iface %p, id %#lx.\n", iface, id);
+
+    EnterCriticalSection(&sink->cs);
+    if (sink->shutdown) hr = MF_E_SHUTDOWN;
+    else if (sink->fixed_streams) hr = MF_E_STREAMSINKS_FIXED;
+    else if (sink->state != SINK_STOPPED) hr = MF_E_INVALIDREQUEST;
+    else
+    {
+        for (i = 0; i < sink->stream_count; ++i)
+        {
+            if (sink->streams[i]->id != id) continue;
+            IMFMediaEventQueue_Shutdown(sink->streams[i]->event_queue);
+            IMFStreamSink_Release(&sink->streams[i]->IMFStreamSink_iface);
+            memmove(&sink->streams[i], &sink->streams[i + 1], (sink->stream_count - i - 1) * sizeof(*sink->streams));
+            sink->stream_count--;
+            hr = S_OK;
+            break;
+        }
+    }
+    LeaveCriticalSection(&sink->cs);
+    return hr;
+}
+
+static HRESULT WINAPI sink_GetStreamSinkCount(IMFFinalizableMediaSink *iface, DWORD *count)
+{
+    struct mpeg4_sink *sink = impl_from_IMFFinalizableMediaSink(iface);
+    HRESULT hr = S_OK;
+
+    if (!count) return E_POINTER;
+    EnterCriticalSection(&sink->cs);
+    if (sink->shutdown) hr = MF_E_SHUTDOWN;
+    else *count = sink->stream_count;
+    LeaveCriticalSection(&sink->cs);
+    return hr;
+}
+
+static HRESULT WINAPI sink_GetStreamSinkByIndex(IMFFinalizableMediaSink *iface, DWORD index, IMFStreamSink **out)
+{
+    struct mpeg4_sink *sink = impl_from_IMFFinalizableMediaSink(iface);
+    HRESULT hr = S_OK;
+
+    if (!out) return E_POINTER;
+    EnterCriticalSection(&sink->cs);
+    if (sink->shutdown) hr = MF_E_SHUTDOWN;
+    else if (index >= sink->stream_count) hr = MF_E_INVALIDINDEX;
+    else IMFStreamSink_AddRef((*out = &sink->streams[index]->IMFStreamSink_iface));
+    LeaveCriticalSection(&sink->cs);
+    return hr;
+}
+
+static HRESULT WINAPI sink_GetStreamSinkById(IMFFinalizableMediaSink *iface, DWORD id, IMFStreamSink **out)
+{
+    struct mpeg4_sink *sink = impl_from_IMFFinalizableMediaSink(iface);
+    struct mpeg4_stream *stream;
+    HRESULT hr = S_OK;
+
+    if (!out) return E_POINTER;
+    EnterCriticalSection(&sink->cs);
+    if (sink->shutdown) hr = MF_E_SHUTDOWN;
+    else if (!(stream = sink_find_stream(sink, id))) hr = MF_E_INVALIDSTREAMNUMBER;
+    else IMFStreamSink_AddRef((*out = &stream->IMFStreamSink_iface));
+    LeaveCriticalSection(&sink->cs);
+    return hr;
+}
+
+static HRESULT WINAPI sink_SetPresentationClock(IMFFinalizableMediaSink *iface, IMFPresentationClock *clock)
+{
+    struct mpeg4_sink *sink = impl_from_IMFFinalizableMediaSink(iface);
+    HRESULT hr = S_OK;
+
+    TRACE("iface %p, clock %p.\n", iface, clock);
+
+    EnterCriticalSection(&sink->cs);
+    if (sink->shutdown) hr = MF_E_SHUTDOWN;
+    else
+    {
+        if (sink->clock)
+        {
+            IMFPresentationClock_RemoveClockStateSink(sink->clock, &sink->IMFClockStateSink_iface);
+            IMFPresentationClock_Release(sink->clock);
+        }
+        if ((sink->clock = clock))
+        {
+            IMFPresentationClock_AddRef(clock);
+            IMFPresentationClock_AddClockStateSink(clock, &sink->IMFClockStateSink_iface);
+        }
+    }
+    LeaveCriticalSection(&sink->cs);
+    return hr;
+}
+
+static HRESULT WINAPI sink_GetPresentationClock(IMFFinalizableMediaSink *iface, IMFPresentationClock **clock)
+{
+    struct mpeg4_sink *sink = impl_from_IMFFinalizableMediaSink(iface);
+    HRESULT hr = S_OK;
+
+    if (!clock) return E_POINTER;
+    EnterCriticalSection(&sink->cs);
+    if (sink->shutdown) hr = MF_E_SHUTDOWN;
+    else if (!sink->clock) hr = MF_E_NO_CLOCK;
+    else IMFPresentationClock_AddRef((*clock = sink->clock));
+    LeaveCriticalSection(&sink->cs);
+    return hr;
+}
+
+static HRESULT WINAPI sink_Shutdown(IMFFinalizableMediaSink *iface)
+{
+    struct mpeg4_sink *sink = impl_from_IMFFinalizableMediaSink(iface);
+    struct mpeg4_stream *streams[MAX_STREAMS];
+    DWORD count, i;
+
+    TRACE("iface %p.\n", iface);
+
+    EnterCriticalSection(&sink->cs);
+    if (sink->shutdown)
+    {
+        LeaveCriticalSection(&sink->cs);
+        return MF_E_SHUTDOWN;
+    }
+    sink->shutdown = TRUE;
+    count = sink->stream_count;
+    memcpy(streams, sink->streams, count * sizeof(*streams));
+    sink->stream_count = 0;
+    if (sink->clock)
+    {
+        IMFPresentationClock_RemoveClockStateSink(sink->clock, &sink->IMFClockStateSink_iface);
+        IMFPresentationClock_Release(sink->clock);
+        sink->clock = NULL;
+    }
+    if (sink->muxer)
+    {
+        UNIX_CALL(muxer_destroy, &sink->muxer);
+        sink->muxer = 0;
+    }
+    if (sink->bytestream)
+    {
+        IMFByteStream_Close(sink->bytestream);
+        IMFByteStream_Release(sink->bytestream);
+        sink->bytestream = NULL;
+    }
+    LeaveCriticalSection(&sink->cs);
+
+    for (i = 0; i < count; ++i)
+    {
+        IMFMediaEventQueue_Shutdown(streams[i]->event_queue);
+        IMFStreamSink_Release(&streams[i]->IMFStreamSink_iface);
+    }
+    return S_OK;
+}
+
+/* Writes the finished file into the client's byte stream. */
+static HRESULT sink_copy_output(struct mpeg4_sink *sink)
+{
+    struct muxer_finish_params finish = {0};
+    struct muxer_read_params read = {0};
+    UINT64 offset;
+    ULONG written;
+    BYTE *chunk;
+    HRESULT hr = S_OK;
+
+    finish.handle = sink->muxer;
+    if (UNIX_CALL(muxer_finish, &finish))
+    {
+        ERR("The MPEG-4 writer could not finish the file.\n");
+        return E_FAIL;
+    }
+    if (!(chunk = malloc(1 << 20))) return E_OUTOFMEMORY;
+    read.handle = sink->muxer;
+    read.data = (UINT_PTR)chunk;
+    read.capacity = 1 << 20;
+    IMFByteStream_SetCurrentPosition(sink->bytestream, 0);
+    for (offset = 0; offset < finish.size && SUCCEEDED(hr); offset += read.size)
+    {
+        read.offset = offset;
+        if (UNIX_CALL(muxer_read, &read) || !read.size)
+        {
+            hr = E_FAIL;
+            break;
+        }
+        if (SUCCEEDED(hr = IMFByteStream_Write(sink->bytestream, chunk, read.size, &written)) && written != read.size)
+            hr = E_FAIL;
+    }
+    free(chunk);
+    if (SUCCEEDED(hr)) IMFByteStream_Flush(sink->bytestream);
+    TRACE("Wrote %I64u bytes, hr %#lx.\n", finish.size, hr);
+    return hr;
+}
+
+static HRESULT WINAPI finalize_callback_QueryInterface(IMFAsyncCallback *iface, REFIID riid, void **out)
+{
+    if (IsEqualIID(riid, &IID_IMFAsyncCallback) || IsEqualIID(riid, &IID_IUnknown))
+    {
+        *out = iface;
+        IMFAsyncCallback_AddRef(iface);
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI finalize_callback_AddRef(IMFAsyncCallback *iface)
+{
+    struct mpeg4_sink *sink = impl_from_finalize_callback(iface);
+    return IMFFinalizableMediaSink_AddRef(&sink->IMFFinalizableMediaSink_iface);
+}
+
+static ULONG WINAPI finalize_callback_Release(IMFAsyncCallback *iface)
+{
+    struct mpeg4_sink *sink = impl_from_finalize_callback(iface);
+    return IMFFinalizableMediaSink_Release(&sink->IMFFinalizableMediaSink_iface);
+}
+
+static HRESULT WINAPI finalize_callback_GetParameters(IMFAsyncCallback *iface, DWORD *flags, DWORD *queue)
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI finalize_callback_Invoke(IMFAsyncCallback *iface, IMFAsyncResult *work)
+{
+    struct mpeg4_sink *sink = impl_from_finalize_callback(iface);
+    IMFAsyncResult *result = (IMFAsyncResult *)IMFAsyncResult_GetStateNoAddRef(work);
+    HRESULT hr;
+
+    EnterCriticalSection(&sink->cs);
+    if (sink->shutdown) hr = MF_E_SHUTDOWN;
+    else if (!sink->muxer) hr = MF_E_INVALIDREQUEST;
+    else hr = sink_copy_output(sink);
+    sink->state = SINK_FINALIZED;
+    LeaveCriticalSection(&sink->cs);
+
+    IMFAsyncResult_SetStatus(result, hr);
+    MFInvokeCallback(result);
+    return S_OK;
+}
+
+static const IMFAsyncCallbackVtbl finalize_callback_vtbl =
+{
+    finalize_callback_QueryInterface,
+    finalize_callback_AddRef,
+    finalize_callback_Release,
+    finalize_callback_GetParameters,
+    finalize_callback_Invoke,
+};
+
+static HRESULT WINAPI sink_BeginFinalize(IMFFinalizableMediaSink *iface, IMFAsyncCallback *callback, IUnknown *state)
+{
+    struct mpeg4_sink *sink = impl_from_IMFFinalizableMediaSink(iface);
+    IMFAsyncResult *result;
+    HRESULT hr;
+
+    TRACE("iface %p, callback %p, state %p.\n", iface, callback, state);
+
+    EnterCriticalSection(&sink->cs);
+    if (sink->shutdown) hr = MF_E_SHUTDOWN;
+    else if (sink->state == SINK_FINALIZING || sink->state == SINK_FINALIZED) hr = MF_E_INVALIDREQUEST;
+    else if (SUCCEEDED(hr = MFCreateAsyncResult(NULL, callback, state, &result)))
+    {
+        sink->state = SINK_FINALIZING;
+        hr = MFPutWorkItem(MFASYNC_CALLBACK_QUEUE_STANDARD, &sink->finalize_callback, (IUnknown *)result);
+        IMFAsyncResult_Release(result);
+    }
+    LeaveCriticalSection(&sink->cs);
+    return hr;
+}
+
+static HRESULT WINAPI sink_EndFinalize(IMFFinalizableMediaSink *iface, IMFAsyncResult *result)
+{
+    TRACE("iface %p, result %p.\n", iface, result);
+
+    if (!result) return E_INVALIDARG;
+    return IMFAsyncResult_GetStatus(result);
+}
+
+static const IMFFinalizableMediaSinkVtbl sink_vtbl =
+{
+    sink_QueryInterface,
+    sink_AddRef,
+    sink_Release,
+    sink_GetCharacteristics,
+    sink_AddStreamSink,
+    sink_RemoveStreamSink,
+    sink_GetStreamSinkCount,
+    sink_GetStreamSinkByIndex,
+    sink_GetStreamSinkById,
+    sink_SetPresentationClock,
+    sink_GetPresentationClock,
+    sink_Shutdown,
+    sink_BeginFinalize,
+    sink_EndFinalize,
+};
+
+static HRESULT WINAPI clock_sink_QueryInterface(IMFClockStateSink *iface, REFIID riid, void **out)
+{
+    struct mpeg4_sink *sink = impl_from_IMFClockStateSink(iface);
+    return IMFFinalizableMediaSink_QueryInterface(&sink->IMFFinalizableMediaSink_iface, riid, out);
+}
+
+static ULONG WINAPI clock_sink_AddRef(IMFClockStateSink *iface)
+{
+    struct mpeg4_sink *sink = impl_from_IMFClockStateSink(iface);
+    return IMFFinalizableMediaSink_AddRef(&sink->IMFFinalizableMediaSink_iface);
+}
+
+static ULONG WINAPI clock_sink_Release(IMFClockStateSink *iface)
+{
+    struct mpeg4_sink *sink = impl_from_IMFClockStateSink(iface);
+    return IMFFinalizableMediaSink_Release(&sink->IMFFinalizableMediaSink_iface);
+}
+
+/* The AudioSpecificConfig of an AAC type: its user data after the HEAACWAVEINFO
+ * fields, or one made from the rate and channel count. */
+static UINT32 aac_config(IMFMediaType *type, BYTE *config, UINT32 rate, UINT32 channels)
+{
+    static const UINT32 rates[] = {96000, 88200, 64000, 48000, 44100, 32000, 24000, 22050, 16000, 12000, 11025, 8000, 7350};
+    BYTE user_data[64];
+    UINT32 size = 0, index;
+
+    if (SUCCEEDED(IMFMediaType_GetBlob(type, &MF_MT_USER_DATA, user_data, sizeof(user_data), &size)) && size > 12
+            && size - 12 <= 16)
+    {
+        memcpy(config, user_data + 12, size - 12);
+        return size - 12;
+    }
+    for (index = 0; index < ARRAY_SIZE(rates); ++index)
+        if (rates[index] == rate) break;
+    if (index == ARRAY_SIZE(rates)) return 0;
+    config[0] = (2 << 3) | (index >> 1);
+    config[1] = ((index & 1) << 7) | ((channels == 8 ? 7 : channels) << 3);
+    return 2;
+}
+
+static HRESULT sink_start_muxer(struct mpeg4_sink *sink)
+{
+    struct muxer_create_params create = {0};
+    struct muxer_add_track_params track;
+    BYTE config[256];
+    UINT32 size;
+    UINT64 frame_size;
+    DWORD i;
+
+    if (sink->muxer) return S_OK;
+    if (UNIX_CALL(muxer_create, &create)) return E_FAIL;
+    sink->muxer = create.handle;
+
+    for (i = 0; i < sink->stream_count; ++i)
+    {
+        struct mpeg4_stream *stream = sink->streams[i];
+
+        memset(&track, 0, sizeof(track));
+        track.handle = sink->muxer;
+        if (stream->kind == STREAM_H264)
+        {
+            track.type = MACMF_TRACK_H264;
+            IMFMediaType_GetUINT64(stream->type, &MF_MT_FRAME_SIZE, &frame_size);
+            track.width = frame_size >> 32;
+            track.height = (UINT32)frame_size;
+            if (SUCCEEDED(IMFMediaType_GetBlob(stream->type, &MF_MT_MPEG_SEQUENCE_HEADER, config, sizeof(config), &size)))
+            {
+                track.config = (UINT_PTR)config;
+                track.config_size = size;
+            }
+        }
+        else
+        {
+            track.type = MACMF_TRACK_AAC;
+            IMFMediaType_GetUINT32(stream->type, &MF_MT_AUDIO_SAMPLES_PER_SECOND, &track.sample_rate);
+            IMFMediaType_GetUINT32(stream->type, &MF_MT_AUDIO_NUM_CHANNELS, &track.channels);
+            track.config_size = aac_config(stream->type, config, track.sample_rate, track.channels);
+            track.config = (UINT_PTR)config;
+        }
+        if (UNIX_CALL(muxer_add_track, &track))
+        {
+            ERR("The MPEG-4 writer cannot take stream %lu.\n", stream->id);
+            return E_FAIL;
+        }
+        stream->track = track.track;
+    }
+    return S_OK;
+}
+
+static void sink_queue_stream_events(struct mpeg4_sink *sink, MediaEventType type, unsigned int requests)
+{
+    unsigned int i, j;
+
+    for (i = 0; i < sink->stream_count; ++i)
+    {
+        IMFMediaEventQueue_QueueEventParamVar(sink->streams[i]->event_queue, type, &GUID_NULL, S_OK, NULL);
+        for (j = 0; j < requests; ++j)
+            IMFMediaEventQueue_QueueEventParamVar(sink->streams[i]->event_queue, MEStreamSinkRequestSample,
+                    &GUID_NULL, S_OK, NULL);
+    }
+}
+
+static HRESULT WINAPI clock_sink_OnClockStart(IMFClockStateSink *iface, MFTIME systime, LONGLONG offset)
+{
+    struct mpeg4_sink *sink = impl_from_IMFClockStateSink(iface);
+    HRESULT hr = S_OK;
+
+    TRACE("iface %p, systime %s, offset %s.\n", iface, wine_dbgstr_longlong(systime), wine_dbgstr_longlong(offset));
+
+    EnterCriticalSection(&sink->cs);
+    if (sink->shutdown) hr = MF_E_SHUTDOWN;
+    else if (sink->state == SINK_STOPPED)
+    {
+        if (SUCCEEDED(hr = sink_start_muxer(sink)))
+        {
+            sink->state = SINK_STARTED;
+            sink_queue_stream_events(sink, MEStreamSinkStarted, REQUESTS_AHEAD);
+        }
+        else
+        {
+            unsigned int i;
+            for (i = 0; i < sink->stream_count; ++i)
+                IMFMediaEventQueue_QueueEventParamVar(sink->streams[i]->event_queue, MEError, &GUID_NULL, hr, NULL);
+        }
+    }
+    LeaveCriticalSection(&sink->cs);
+    return hr;
+}
+
+static HRESULT WINAPI clock_sink_OnClockStop(IMFClockStateSink *iface, MFTIME systime)
+{
+    struct mpeg4_sink *sink = impl_from_IMFClockStateSink(iface);
+
+    TRACE("iface %p, systime %s.\n", iface, wine_dbgstr_longlong(systime));
+
+    EnterCriticalSection(&sink->cs);
+    if (!sink->shutdown) sink_queue_stream_events(sink, MEStreamSinkStopped, 0);
+    LeaveCriticalSection(&sink->cs);
+    return S_OK;
+}
+
+static HRESULT WINAPI clock_sink_OnClockPause(IMFClockStateSink *iface, MFTIME systime)
+{
+    struct mpeg4_sink *sink = impl_from_IMFClockStateSink(iface);
+
+    EnterCriticalSection(&sink->cs);
+    if (!sink->shutdown) sink_queue_stream_events(sink, MEStreamSinkPaused, 0);
+    LeaveCriticalSection(&sink->cs);
+    return S_OK;
+}
+
+static HRESULT WINAPI clock_sink_OnClockRestart(IMFClockStateSink *iface, MFTIME systime)
+{
+    struct mpeg4_sink *sink = impl_from_IMFClockStateSink(iface);
+
+    EnterCriticalSection(&sink->cs);
+    if (!sink->shutdown) sink_queue_stream_events(sink, MEStreamSinkStarted, 0);
+    LeaveCriticalSection(&sink->cs);
+    return S_OK;
+}
+
+static HRESULT WINAPI clock_sink_OnClockSetRate(IMFClockStateSink *iface, MFTIME systime, float rate)
+{
+    return S_OK;
+}
+
+static const IMFClockStateSinkVtbl clock_sink_vtbl =
+{
+    clock_sink_QueryInterface,
+    clock_sink_AddRef,
+    clock_sink_Release,
+    clock_sink_OnClockStart,
+    clock_sink_OnClockStop,
+    clock_sink_OnClockPause,
+    clock_sink_OnClockRestart,
+    clock_sink_OnClockSetRate,
+};
+
+static HRESULT sink_create(IMFByteStream *bytestream, IMFMediaType *video_type, IMFMediaType *audio_type,
+        IMFMediaSink **out)
+{
+    struct mpeg4_stream *stream;
+    struct mpeg4_sink *sink;
+    HRESULT hr = S_OK;
+
+    if (!(sink = calloc(1, sizeof(*sink)))) return E_OUTOFMEMORY;
+    sink->IMFFinalizableMediaSink_iface.lpVtbl = &sink_vtbl;
+    sink->IMFClockStateSink_iface.lpVtbl = &clock_sink_vtbl;
+    sink->finalize_callback.lpVtbl = &finalize_callback_vtbl;
+    sink->refcount = 1;
+    InitializeCriticalSection(&sink->cs);
+    IMFByteStream_AddRef((sink->bytestream = bytestream));
+
+    /* Windows numbers the streams of a sink created with types 0 (video) and 1 (audio). */
+    if (video_type && SUCCEEDED(hr = stream_create(sink, 0, video_type, &stream)))
+        sink->streams[sink->stream_count++] = stream;
+    if (SUCCEEDED(hr) && audio_type && SUCCEEDED(hr = stream_create(sink, 1, audio_type, &stream)))
+        sink->streams[sink->stream_count++] = stream;
+    sink->fixed_streams = video_type || audio_type;
+
+    if (FAILED(hr))
+    {
+        IMFFinalizableMediaSink_Shutdown(&sink->IMFFinalizableMediaSink_iface);
+        IMFFinalizableMediaSink_Release(&sink->IMFFinalizableMediaSink_iface);
+        return hr;
+    }
+    *out = (IMFMediaSink *)&sink->IMFFinalizableMediaSink_iface;
+    return S_OK;
+}
+
+static struct sink_class_factory *impl_from_IMFSinkClassFactory(IMFSinkClassFactory *iface)
+{
+    return CONTAINING_RECORD(iface, struct sink_class_factory, IMFSinkClassFactory_iface);
+}
+
+static HRESULT WINAPI sink_class_factory_QueryInterface(IMFSinkClassFactory *iface, REFIID riid, void **out)
+{
+    if (IsEqualIID(riid, &IID_IMFSinkClassFactory) || IsEqualIID(riid, &IID_IUnknown))
+    {
+        *out = iface;
+        IMFSinkClassFactory_AddRef(iface);
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI sink_class_factory_AddRef(IMFSinkClassFactory *iface)
+{
+    struct sink_class_factory *factory = impl_from_IMFSinkClassFactory(iface);
+    return InterlockedIncrement(&factory->refcount);
+}
+
+static ULONG WINAPI sink_class_factory_Release(IMFSinkClassFactory *iface)
+{
+    struct sink_class_factory *factory = impl_from_IMFSinkClassFactory(iface);
+    ULONG refcount = InterlockedDecrement(&factory->refcount);
+
+    if (!refcount) free(factory);
+    return refcount;
+}
+
+static HRESULT WINAPI sink_class_factory_CreateMediaSink(IMFSinkClassFactory *iface, IMFByteStream *bytestream,
+        IMFMediaType *video_type, IMFMediaType *audio_type, IMFMediaSink **out)
+{
+    TRACE("iface %p, bytestream %p, video_type %p, audio_type %p, out %p.\n", iface, bytestream, video_type,
+            audio_type, out);
+
+    if (!bytestream || !out) return E_POINTER;
+    return sink_create(bytestream, video_type, audio_type, out);
+}
+
+static const IMFSinkClassFactoryVtbl sink_class_factory_vtbl =
+{
+    sink_class_factory_QueryInterface,
+    sink_class_factory_AddRef,
+    sink_class_factory_Release,
+    sink_class_factory_CreateMediaSink,
+};
+
+HRESULT mpeg4_sink_factory_create(REFIID riid, void **out)
+{
+    struct sink_class_factory *factory;
+    HRESULT hr;
+
+    if (!(factory = calloc(1, sizeof(*factory)))) return E_OUTOFMEMORY;
+    factory->IMFSinkClassFactory_iface.lpVtbl = &sink_class_factory_vtbl;
+    factory->refcount = 1;
+    hr = IMFSinkClassFactory_QueryInterface(&factory->IMFSinkClassFactory_iface, riid, out);
+    IMFSinkClassFactory_Release(&factory->IMFSinkClassFactory_iface);
+    return hr;
+}
