+    HRESULT hr;
+
+    if (index) return MF_E_NO_MORE_TYPES;
+    EnterCriticalSection(&stream->sink->cs);
+    hr = media_type_copy(stream->type, type);
+    LeaveCriticalSection(&stream->sink->cs);
+    return hr;
+}
+
+static HRESULT WINAPI type_handler_SetCurrentMediaType(IMFMediaTypeHandler *iface, IMFMediaType *type)
+{
+    struct mpeg4_stream *stream = impl_from_IMFMediaTypeHandler(iface);
+    enum stream_kind kind;
+    IMFMediaType *copy;
+    HRESULT hr;
+
+    TRACE("iface %p, type %p.\n", iface, type);
+
+    if (!type) return E_POINTER;
+    if (FAILED(hr = stream_kind_from_type(type, &kind))) return hr;
+    if (kind != stream->kind) return MF_E_INVALIDMEDIATYPE;
+
+    EnterCriticalSection(&stream->sink->cs);
+    if (stream->sink->state != SINK_STOPPED) hr = MF_E_INVALIDREQUEST;
+    else if (SUCCEEDED(hr = media_type_copy(type, &copy)))
+    {
+        IMFMediaType_Release(stream->type);
+        stream->type = copy;
+    }
+    LeaveCriticalSection(&stream->sink->cs);
+    return hr;
+}
