+static BOOL buffer_has_idr(const BYTE *data, DWORD size)
+{
+    DWORD i;
+
+    for (i = 0; i + 3 < size; ++i)
+        if (!data[i] && !data[i + 1] && data[i + 2] == 1 && (data[i + 3] & 0x1f) == 5) return TRUE;
+    return FALSE;
+}
+
+static HRESULT WINAPI stream_ProcessSample(IMFStreamSink *iface, IMFSample *sample)
+{
+    struct mpeg4_stream *stream = impl_from_IMFStreamSink(iface);
+    struct mpeg4_sink *sink = stream->sink;
+    struct muxer_write_params params = {0};
+    IMFMediaBuffer *buffer = NULL;
+    LONGLONG time, duration;
+    UINT32 clean_point;
+    UINT64 decode_time;
+    DWORD length;
+    BYTE *data;
+    HRESULT hr;
+
+    TRACE("iface %p, sample %p.\n", iface, sample);
+
+    if (!sample) return E_POINTER;
+
+    EnterCriticalSection(&sink->cs);
+    if (sink->shutdown)
+    {
+        hr = MF_E_STREAMSINK_REMOVED;
+        goto done;
+    }
+    if (sink->state != SINK_STARTED || !sink->muxer)
+    {
+        hr = MF_E_INVALIDREQUEST;
+        goto done;
+    }
+    if (FAILED(hr = IMFSample_GetSampleTime(sample, &time))) goto done;
+    if (FAILED(IMFSample_GetSampleDuration(sample, &duration))) duration = 0;
+    if (FAILED(hr = IMFSample_ConvertToContiguousBuffer(sample, &buffer))) goto done;
+    if (FAILED(hr = IMFMediaBuffer_Lock(buffer, &data, NULL, &length))) goto done;
+
+    params.handle = sink->muxer;
+    params.track = stream->track;
+    params.data = (UINT_PTR)data;
+    params.size = length;
+    params.time = time;
+    params.duration = duration;
+    if (SUCCEEDED(IMFSample_GetUINT64(sample, &MFSampleExtension_DecodeTimestamp_sink, &decode_time)))
+        params.decode_time = (INT64)decode_time;
+    else
+        params.decode_time = stream->kind == STREAM_AAC ? time : (INT64)((UINT64)1 << 63);
+    if (SUCCEEDED(IMFSample_GetUINT32(sample, &MFSampleExtension_CleanPoint, &clean_point)))
+        params.keyframe = !!clean_point;
+    else
+        params.keyframe = stream->kind == STREAM_AAC || buffer_has_idr(data, length);
+
+    if (length && UNIX_CALL(muxer_write, &params))
+    {
+        WARN("The MPEG-4 writer refused a sample of stream %lu.\n", stream->id);
+        hr = E_FAIL;
+    }
+    IMFMediaBuffer_Unlock(buffer);
+    stream->written++;
+
+    if (SUCCEEDED(hr))
+        hr = IMFMediaEventQueue_QueueEventParamVar(stream->event_queue, MEStreamSinkRequestSample,
+                &GUID_NULL, S_OK, NULL);
+
+done:
+    if (buffer) IMFMediaBuffer_Release(buffer);
+    LeaveCriticalSection(&sink->cs);
+    return hr;
+}
