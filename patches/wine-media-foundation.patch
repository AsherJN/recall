+static NTSTATUS read_packet(struct packet_params *params,
+        int (*read)(void *, uint8_t *, uint32_t, struct macmf_packet_info *))
+{
+    struct macmf_packet_info info = {0};
+    int ret;
+
+    ret = read((void *)(UINT_PTR)params->handle, (uint8_t *)(UINT_PTR)params->data, params->capacity, &info);
+    if (ret == MACMF_OK || ret == MACMF_TOO_SMALL)
+    {
+        params->size = info.size;
+        params->time = info.time;
+        params->decode_time = info.decode_time;
+        params->duration = info.duration;
+        params->keyframe = info.keyframe;
+    }
+    return status_from(ret);
+}
+
+static NTSTATUS video_encoder_read(void *args)
+{
+    return read_packet(args, macmf_video_encoder_read);
+}
+
+static NTSTATUS video_encoder_config(void *args)
+{
+    struct video_encoder_config_params *params = args;
+    uint32_t size = 0;
+    int ret;
+
+    ret = macmf_video_encoder_config((void *)(UINT_PTR)params->handle, (uint8_t *)(UINT_PTR)params->data,
+            params->capacity, &size);
+    params->size = size;
+    return status_from(ret);
+}
+
+static NTSTATUS audio_encoder_create(void *args)
+{
+    struct audio_encoder_create_params *params = args;
+    uint32_t priming = 0, config_size = 0;
+    void *encoder;
+
+    if (!(encoder = macmf_audio_encoder_create(params->input_rate, params->channels, params->format,
+            params->output_rate, params->bitrate, &priming, params->config, &config_size)))
+        return STATUS_UNSUCCESSFUL;
+    params->handle = (UINT_PTR)encoder;
+    params->priming = priming;
+    params->config_size = config_size;
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS audio_encoder_destroy(void *args)
+{
+    macmf_handle *handle = args;
+
+    macmf_audio_encoder_destroy((void *)(UINT_PTR)*handle);
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS audio_encoder_encode(void *args)
+{
+    struct audio_encoder_encode_params *params = args;
+
+    return status_from(macmf_audio_encoder_encode((void *)(UINT_PTR)params->handle,
+            (const uint8_t *)(UINT_PTR)params->data, params->size));
+}
+
+static NTSTATUS audio_encoder_drain(void *args)
+{
+    macmf_handle *handle = args;
+
+    return status_from(macmf_audio_encoder_drain((void *)(UINT_PTR)*handle));
+}
+
+static NTSTATUS audio_encoder_flush(void *args)
+{
+    macmf_handle *handle = args;
+
+    macmf_audio_encoder_flush((void *)(UINT_PTR)*handle);
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS audio_encoder_read(void *args)
+{
+    return read_packet(args, macmf_audio_encoder_read);
+}
+
+static NTSTATUS muxer_create(void *args)
+{
+    struct muxer_create_params *params = args;
+    void *muxer;
+
+    if (!(muxer = macmf_muxer_create())) return STATUS_UNSUCCESSFUL;
+    params->handle = (UINT_PTR)muxer;
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS muxer_destroy(void *args)
+{
+    macmf_handle *handle = args;
+
+    macmf_muxer_destroy((void *)(UINT_PTR)*handle);
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS muxer_add_track(void *args)
+{
+    struct muxer_add_track_params *params = args;
+    int track;
+
+    track = macmf_muxer_add_track((void *)(UINT_PTR)params->handle, params->type, params->width, params->height,
+            params->sample_rate, params->channels, params->priming, (const uint8_t *)(UINT_PTR)params->config,
+            params->config_size);
+    if (track < 0) return STATUS_UNSUCCESSFUL;
+    params->track = track;
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS muxer_write(void *args)
+{
+    struct muxer_write_params *params = args;
+
+    return status_from(macmf_muxer_write((void *)(UINT_PTR)params->handle, params->track,
+            (const uint8_t *)(UINT_PTR)params->data, params->size, params->time, params->decode_time,
+            params->duration, params->keyframe));
+}
+
+static NTSTATUS muxer_finish(void *args)
+{
+    struct muxer_finish_params *params = args;
+    uint64_t size = 0;
+    NTSTATUS status;
+
+    status = status_from(macmf_muxer_finish((void *)(UINT_PTR)params->handle, &size));
+    params->size = size;
+    return status;
+}
+
+static NTSTATUS muxer_read(void *args)
+{
+    struct muxer_read_params *params = args;
+    uint32_t size = 0;
+    NTSTATUS status;
+
+    status = status_from(macmf_muxer_read((void *)(UINT_PTR)params->handle, params->offset,
+            (uint8_t *)(UINT_PTR)params->data, params->capacity, &size));
+    params->size = size;
+    return status;
+}
+
+const unixlib_entry_t __wine_unix_call_funcs[] =
+{
+    video_encoder_create,
+    video_encoder_destroy,
+    video_encoder_encode,
+    video_encoder_set_bitrate,
+    video_encoder_drain,
+    video_encoder_flush,
+    video_encoder_read,
+    video_encoder_config,
+    audio_encoder_create,
+    audio_encoder_destroy,
+    audio_encoder_encode,
+    audio_encoder_drain,
+    audio_encoder_flush,
+    audio_encoder_read,
+    muxer_create,
+    muxer_destroy,
+    muxer_add_track,
+    muxer_write,
+    muxer_finish,
+    muxer_read,
+};
+
+C_ASSERT(ARRAY_SIZE(__wine_unix_call_funcs) == unix_funcs_count);
diff --git a/dlls/winemacmf/unixlib.h b/dlls/winemacmf/unixlib.h
new file mode 100644
index 0000000..2dbcf4c
--- /dev/null
+++ b/dlls/winemacmf/unixlib.h
@@ -0,0 +1,216 @@
+/*
+ * Media Foundation encoders and MPEG-4 writer on macOS frameworks
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#ifndef __WINE_WINEMACMF_UNIXLIB_H
+#define __WINE_WINEMACMF_UNIXLIB_H
+
+#include <stdarg.h>
+#include <stddef.h>
+
+#include "ntstatus.h"
+#define WIN32_NO_STATUS
+#include "windef.h"
+#include "winbase.h"
+#include "winternl.h"
+
+#include "wine/unixlib.h"
+
+/* Only the 64-bit side exists: Overwatch, the program this serves, is 64-bit. */
+
+typedef UINT64 macmf_handle;
+
+/* Pixel layouts the H.264 encoder accepts. The client passes the first (top)
+ * scanline and the signed distance between rows of the first plane; chroma
+ * planes follow the luma plane as Media Foundation lays them out. */
+enum macmf_video_format
+{
+    MACMF_VIDEO_BGRA,   /* MFVideoFormat_RGB32 and ARGB32: B, G, R, X/A bytes */
+    MACMF_VIDEO_NV12,
+    MACMF_VIDEO_I420,   /* also IYUV */
+    MACMF_VIDEO_YV12,
+    MACMF_VIDEO_YUY2,
+};
+
+struct video_encoder_create_params
+{
+    UINT32 width;
+    UINT32 height;
+    UINT32 frame_rate_num;
+    UINT32 frame_rate_den;
+    UINT32 format;          /* enum macmf_video_format */
+    UINT32 bitrate;         /* average bits per second, 0 lets the encoder choose */
+    UINT32 max_bitrate;     /* peak bits per second, 0 for none */
+    UINT32 quality;         /* 1-100 asks for quality-based rate control instead */
+    UINT32 profile;         /* eAVEncH264VProfile (66, 77, 100), 0 for High */
+    UINT32 gop_size;        /* frames between key frames, 0 for two seconds */
+    UINT32 b_frames;        /* nonzero allows frame reordering */
+    UINT32 low_latency;
+    UINT32 bt601;           /* nonzero: BT.601 YCbCr matrix instead of BT.709 */
+    UINT32 full_range;      /* YCbCr input uses 0-255 */
+    macmf_handle handle;    /* out */
+};
+
+struct video_encoder_encode_params
+{
+    macmf_handle handle;
+    UINT64 data;            /* first (top) scanline */
+    INT64 stride;           /* bytes from one row of the first plane to the next */
+    UINT64 size;            /* bytes readable from the start of the buffer */
+    UINT64 buffer;          /* start of the buffer, for bounds checks */
+    INT64 time;             /* 100 ns */
+    INT64 duration;         /* 100 ns */
+    UINT32 keyframe;        /* request a key frame */
+};
+
+struct video_encoder_bitrate_params
+{
+    macmf_handle handle;
+    UINT32 bitrate;
+    UINT32 max_bitrate;
+};
+
+/* One encoded packet. With data 0 or a capacity below its size, only size is
+ * set and the packet stays queued (STATUS_BUFFER_TOO_SMALL). Without a packet
+ * the call returns STATUS_PENDING. */
+struct packet_params
+{
+    macmf_handle handle;
+    UINT64 data;
+    UINT32 capacity;
+    UINT32 size;            /* out */
+    INT64 time;             /* out, video only, 100 ns */
+    INT64 decode_time;      /* out, video only, 100 ns */
+    INT64 duration;         /* out, video only, 100 ns */
+    UINT32 keyframe;        /* out */
+};
+
+/* Annex B parameter sets of the stream, once the first frame is encoded. */
+struct video_encoder_config_params
+{
+    macmf_handle handle;
+    UINT64 data;
+    UINT32 capacity;
+    UINT32 size;            /* out */
+};
+
+enum macmf_audio_format
+{
+    MACMF_AUDIO_S16,
+    MACMF_AUDIO_S24,
+    MACMF_AUDIO_S32,
+    MACMF_AUDIO_F32,
+};
+
+struct audio_encoder_create_params
+{
+    UINT32 input_rate;
+    UINT32 channels;
+    UINT32 format;          /* enum macmf_audio_format */
+    UINT32 output_rate;
+    UINT32 bitrate;         /* bits per second */
+    macmf_handle handle;    /* out */
+    UINT32 priming;         /* out: encoder delay in output frames */
+    UINT32 config_size;     /* out */
+    BYTE config[16];        /* out: AudioSpecificConfig */
+};
+
+struct audio_encoder_encode_params
+{
+    macmf_handle handle;
+    UINT64 data;
+    UINT32 size;
+};
+
+enum macmf_track_type
+{
+    MACMF_TRACK_H264,
+    MACMF_TRACK_AAC,
+};
+
+struct muxer_create_params
+{
+    macmf_handle handle;    /* out */
+};
+
+struct muxer_add_track_params
+{
+    macmf_handle handle;
+    UINT32 type;            /* enum macmf_track_type */
+    UINT32 width;
+    UINT32 height;
+    UINT32 sample_rate;
+    UINT32 channels;
+    UINT32 priming;         /* AAC: frames before the first one to present */
+    UINT64 config;          /* H.264: Annex B SPS/PPS, AAC: AudioSpecificConfig; optional for H.264 */
+    UINT32 config_size;
+    UINT32 track;           /* out */
+};
+
+struct muxer_write_params
+{
+    macmf_handle handle;
+    UINT32 track;
+    UINT64 data;            /* H.264: Annex B access unit, AAC: one raw frame */
+    UINT32 size;
+    INT64 time;             /* 100 ns */
+    INT64 decode_time;      /* 100 ns, INT64_MIN when unknown */
+    INT64 duration;         /* 100 ns */
+    UINT32 keyframe;
+};
+
+struct muxer_finish_params
+{
+    macmf_handle handle;
+    UINT64 size;            /* out: bytes of the finished file */
+};
+
+struct muxer_read_params
+{
+    macmf_handle handle;
+    UINT64 offset;
+    UINT64 data;
+    UINT32 capacity;
+    UINT32 size;            /* out */
+};
+
+enum macmf_funcs
+{
+    unix_video_encoder_create,
+    unix_video_encoder_destroy,
+    unix_video_encoder_encode,
+    unix_video_encoder_set_bitrate,
+    unix_video_encoder_drain,
+    unix_video_encoder_flush,
+    unix_video_encoder_read,
+    unix_video_encoder_config,
+    unix_audio_encoder_create,
+    unix_audio_encoder_destroy,
+    unix_audio_encoder_encode,
+    unix_audio_encoder_drain,
+    unix_audio_encoder_flush,
+    unix_audio_encoder_read,
+    unix_muxer_create,
+    unix_muxer_destroy,
+    unix_muxer_add_track,
+    unix_muxer_write,
+    unix_muxer_finish,
+    unix_muxer_read,
+    unix_funcs_count,
+};
+
+#endif /* __WINE_WINEMACMF_UNIXLIB_H */
