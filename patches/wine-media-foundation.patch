+#if 0
+#pragma makedep unix
+#endif
+
+/* The sink's MPEG-4 file, written here rather than by AVFoundation's AVAssetWriter.
+ * Each sample goes to a payload file as it arrives and its size and times stay in
+ * memory; finishing puts the file's index (moov) in front of the samples. Nothing
+ * waits: AVAssetWriter interleaved its tracks on dispatch queues and could hold one
+ * back forever, which left players a 0 MB file after Overwatch had said "saved".
+ * A track that fails drops out and the file keeps the others. */
+
+#include <limits.h>
+#include <pthread.h>
+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+#include <unistd.h>
+
+#include <CoreFoundation/CoreFoundation.h>
+#include <CoreMedia/CoreMedia.h>
+#include <CoreVideo/CoreVideo.h>
+
+#include "macmf_cocoa.h"
+
+#define MF_TIMESCALE 10000000
+#define MOVIE_TIMESCALE 1000
+#define VIDEO_TIMESCALE 90000
+#define AAC_FRAMES 1024
+#define MAX_TRACKS 8
+#define SECONDS_1904_TO_1970 2082844800u
+
+enum
+{
+    TRACK_H264,
+    TRACK_AAC,
+};
+
+struct mp4_sample
+{
+    uint64_t offset;            /* in the payload file */
+    uint32_t size;
+    int keyframe;
+    int64_t time;               /* 100 ns */
+    int64_t decode_time;        /* 100 ns, INT64_MIN when unknown */
+    int64_t duration;           /* 100 ns, 0 when unknown */
+};
+
+struct mp4_track
+{
+    int type;
+    uint32_t width, height, sample_rate, channels;
+    uint8_t *config;            /* H.264: Annex B parameter sets, optional; AAC: AudioSpecificConfig */
+    uint32_t config_size;
+    uint8_t *avcc;              /* H.264: the avcC box's contents once the parameter sets are known */
+    uint32_t avcc_size;
+    uint8_t colr[7];            /* H.264: nclx colour, when the parameter sets give it */
+    int has_colr;
+    int format_error;           /* unusable parameter sets were reported */
+    unsigned int refused;
+    struct mp4_sample *samples;
+    size_t count, capacity;
+};
+
+struct mp4_writer
+{
+    pthread_mutex_t lock;
+    char directory[PATH_MAX];
+    char path[PATH_MAX];
+    FILE *payload;
+    uint64_t payload_size;
+    int failed;                 /* the payload file could not be written */
+    struct mp4_track tracks[MAX_TRACKS];
+    unsigned int track_count;
+    uint8_t *scratch;
+    size_t scratch_capacity;
+    uint8_t *header;            /* ftyp, moov and the mdat header, once finished */
+    size_t header_size;
+};
+
+/* What finishing works out for one track. */
+struct edit
+{
+    uint64_t segment;           /* movie ticks */
+    int64_t media_time;         /* media ticks, -1 for an empty edit */
+};
+
+struct plan
+{
+    struct mp4_track *track;
+    uint32_t id, timescale;
+    uint64_t media_duration;
+    struct edit edits[2];
+    unsigned int edit_count;
+    uint64_t movie_duration;
+    int64_t *decode;            /* video: decode times in media ticks */
+    int64_t *offset;            /* video: composition offsets */
+    uint32_t last_delta;
+    int has_offsets, all_sync;
+    uint32_t max_size, avg_bitrate, max_bitrate;
+};
+
+static void log_error(const char *format, ...) __attribute__((format(printf, 1, 2)));
+static void log_error(const char *format, ...)
+{
+    char message[512];
+    va_list args;
+
+    va_start(args, format);
+    vsnprintf(message, sizeof(message), format, args);
+    va_end(args);
+    macmf_log_error(message);
+}
+
+static void log_trace(const char *format, ...) __attribute__((format(printf, 1, 2)));
+static void log_trace(const char *format, ...)
+{
+    char message[512];
+    va_list args;
+
+    va_start(args, format);
+    vsnprintf(message, sizeof(message), format, args);
+    va_end(args);
+    macmf_log_trace(message);
+}
+
+static const char *track_name(const struct mp4_track *track)
+{
+    return track->type == TRACK_H264 ? "video" : "audio";
+}
+
+/* 100 ns units to another time scale, rounding half away from zero. */
+static int64_t rescale(int64_t value, int64_t scale)
+{
+    __int128 product = (__int128)value * scale;
+
+    if (product >= 0) return (int64_t)((product + MF_TIMESCALE / 2) / MF_TIMESCALE);
+    return -(int64_t)((-product + MF_TIMESCALE / 2) / MF_TIMESCALE);
+}
+
+static uint64_t to_movie(uint64_t ticks, uint32_t timescale)
+{
+    return (uint64_t)(((unsigned __int128)ticks * MOVIE_TIMESCALE + timescale / 2) / timescale);
+}
+
+/* ------------------------------------------------------------------------ */
+/* Box building                                                             */
+/* ------------------------------------------------------------------------ */
+
+struct buffer
+{
+    uint8_t *data;
+    size_t size, capacity;
+    int failed;
+};
+
+static void put_bytes(struct buffer *buffer, const void *data, size_t size)
+{
+    if (buffer->failed || !size) return;
+    if (buffer->size + size > buffer->capacity)
+    {
+        size_t capacity = buffer->capacity ? buffer->capacity : 4096;
+        uint8_t *grown;
+
+        while (capacity < buffer->size + size) capacity *= 2;
+        if (!(grown = realloc(buffer->data, capacity)))
+        {
+            buffer->failed = 1;
+            return;
+        }
+        buffer->data = grown;
+        buffer->capacity = capacity;
+    }
+    memcpy(buffer->data + buffer->size, data, size);
+    buffer->size += size;
+}
+
+static void put_u8(struct buffer *buffer, uint8_t value)
+{
+    put_bytes(buffer, &value, 1);
+}
+
+static void put_u16(struct buffer *buffer, uint16_t value)
+{
+    uint8_t bytes[2] = {(uint8_t)(value >> 8), (uint8_t)value};
+    put_bytes(buffer, bytes, 2);
+}
+
+static void put_u24(struct buffer *buffer, uint32_t value)
+{
+    uint8_t bytes[3] = {(uint8_t)(value >> 16), (uint8_t)(value >> 8), (uint8_t)value};
+    put_bytes(buffer, bytes, 3);
+}
+
+static void put_u32(struct buffer *buffer, uint32_t value)
+{
+    uint8_t bytes[4] = {(uint8_t)(value >> 24), (uint8_t)(value >> 16), (uint8_t)(value >> 8), (uint8_t)value};
+    put_bytes(buffer, bytes, 4);
+}
+
+static void put_u64(struct buffer *buffer, uint64_t value)
+{
+    put_u32(buffer, (uint32_t)(value >> 32));
+    put_u32(buffer, (uint32_t)value);
+}
+
+static void put_zeros(struct buffer *buffer, size_t count)
+{
+    static const uint8_t zeros[32];
+
+    while (count)
+    {
+        size_t size = count < sizeof(zeros) ? count : sizeof(zeros);
+        put_bytes(buffer, zeros, size);
+        count -= size;
+    }
+}
+
+static size_t box_start(struct buffer *buffer, const char *type)
+{
+    size_t start = buffer->size;
+
+    put_u32(buffer, 0);
+    put_bytes(buffer, type, 4);
+    return start;
+}
+
+static size_t full_box_start(struct buffer *buffer, const char *type, uint8_t version, uint32_t flags)
+{
+    size_t start = box_start(buffer, type);
+
+    put_u32(buffer, (uint32_t)version << 24 | flags);
+    return start;
+}
+
+static void box_end(struct buffer *buffer, size_t start)
+{
+    uint32_t size = (uint32_t)(buffer->size - start);
+
+    if (buffer->failed) return;
+    buffer->data[start] = (uint8_t)(size >> 24);
+    buffer->data[start + 1] = (uint8_t)(size >> 16);
+    buffer->data[start + 2] = (uint8_t)(size >> 8);
+    buffer->data[start + 3] = (uint8_t)size;
+}
+
+static void put_matrix(struct buffer *buffer)
+{
+    static const uint32_t unity[9] = {0x00010000, 0, 0, 0, 0x00010000, 0, 0, 0, 0x40000000};
+    unsigned int i;
+
+    for (i = 0; i < 9; ++i) put_u32(buffer, unity[i]);
+}
+
+/* ------------------------------------------------------------------------ */
+/* H.264 access units                                                       */
+/* ------------------------------------------------------------------------ */
+
+static const uint8_t *next_start_code(const uint8_t *data, const uint8_t *end, int *code_size)
+{
+    const uint8_t *p;
+
+    for (p = data; p + 3 <= end; ++p)
+    {
+        if (p[0] || p[1]) continue;
+        if (p[2] == 1)
+        {
+            *code_size = 3;
+            return p;
+        }
+        if (p + 4 <= end && !p[2] && p[3] == 1)
+        {
+            *code_size = 4;
+            return p;
+        }
+    }
+    return end;
+}
+
+struct nal_units
+{
+    const uint8_t *next, *end;
+    int code_size;
+};
+
+static void nal_units_init(struct nal_units *units, const uint8_t *data, uint32_t size)
+{
+    units->end = data + size;
+    units->code_size = 0;
+    units->next = next_start_code(data, units->end, &units->code_size);
+}
+
+/* The next NAL unit of an Annex B access unit. */
+static int nal_units_next(struct nal_units *units, const uint8_t **unit, uint32_t *length)
+{
+    while (units->next < units->end)
+    {
+        const uint8_t *start = units->next + units->code_size, *next;
+        int next_size = 0;
+
+        next = next_start_code(start, units->end, &next_size);
+        units->next = next;
+        units->code_size = next_size;
+        if (next > start)
+        {
+            *unit = start;
+            *length = (uint32_t)(next - start);
+            return 1;
+        }
+    }
+    return 0;
+}
+
+static int16_t colour_code(int code)
+{
+    return code > 0 && code < 256 ? (int16_t)code : 2;   /* 2: unspecified */
+}
+
+/* Takes the stream's format from an access unit's parameter sets: the avcC box Core Media
+ * makes from them (as AVAssetWriter wrote it), the coded size and the colour. */
+static int track_take_h264_format(struct mp4_track *track, const uint8_t *data, uint32_t size)
+{
+    const uint8_t *sps = NULL, *pps = NULL, *unit, *sets[2];
+    uint32_t sps_size = 0, pps_size = 0, length;
+    CMFormatDescriptionRef format = NULL;
+    CFStringRef primaries, transfer, matrix;
+    struct nal_units units;
+    CMVideoDimensions dimensions;
+    CFDictionaryRef atoms;
+    CFBooleanRef full_range;
+    CFDataRef avcc;
+    size_t sizes[2];
+    OSStatus status;
+
+    nal_units_init(&units, data, size);
+    while (nal_units_next(&units, &unit, &length))
+    {
+        int type = unit[0] & 0x1f;
+
+        if (type == 7 && !sps)
+        {
+            sps = unit;
+            sps_size = length;
+        }
+        else if (type == 8 && !pps)
+        {
+            pps = unit;
+            pps_size = length;
+        }
+    }
+    if (!sps || !pps) return 0;
+
+    sets[0] = sps;
+    sizes[0] = sps_size;
+    sets[1] = pps;
+    sizes[1] = pps_size;
+    if ((status = CMVideoFormatDescriptionCreateFromH264ParameterSets(kCFAllocatorDefault, 2, sets, sizes, 4, &format)))
+    {
+        if (!track->format_error++) log_error("Unusable H.264 parameter sets: %d", (int)status);
+        return 0;
+    }
+    atoms = CMFormatDescriptionGetExtension(format, kCMFormatDescriptionExtension_SampleDescriptionExtensionAtoms);
+    avcc = atoms && CFGetTypeID(atoms) == CFDictionaryGetTypeID() ? CFDictionaryGetValue(atoms, CFSTR("avcC")) : NULL;
+    if (!avcc || CFGetTypeID(avcc) != CFDataGetTypeID() || !CFDataGetLength(avcc)
+            || !(track->avcc = malloc(CFDataGetLength(avcc))))
+    {
+        if (!track->format_error++) log_error("No avcC for the H.264 parameter sets");
+        CFRelease(format);
+        return 0;
+    }
+    track->avcc_size = (uint32_t)CFDataGetLength(avcc);
+    memcpy(track->avcc, CFDataGetBytePtr(avcc), track->avcc_size);
+
+    dimensions = CMVideoFormatDescriptionGetDimensions(format);
+    if (dimensions.width > 0 && dimensions.height > 0)
+    {
+        track->width = (uint32_t)dimensions.width;
+        track->height = (uint32_t)dimensions.height;
+    }
+
+    primaries = CMFormatDescriptionGetExtension(format, kCMFormatDescriptionExtension_ColorPrimaries);
+    transfer = CMFormatDescriptionGetExtension(format, kCMFormatDescriptionExtension_TransferFunction);
+    matrix = CMFormatDescriptionGetExtension(format, kCMFormatDescriptionExtension_YCbCrMatrix);
+    full_range = CMFormatDescriptionGetExtension(format, kCMFormatDescriptionExtension_FullRangeVideo);
+    if (primaries && transfer && matrix && CFGetTypeID(primaries) == CFStringGetTypeID()
+            && CFGetTypeID(transfer) == CFStringGetTypeID() && CFGetTypeID(matrix) == CFStringGetTypeID())
+    {
+        int16_t codes[3] = {colour_code(CVColorPrimariesGetIntegerCodePointForString(primaries)),
+                colour_code(CVTransferFunctionGetIntegerCodePointForString(transfer)),
+                colour_code(CVYCbCrMatrixGetIntegerCodePointForString(matrix))};
+        unsigned int i;
+
+        for (i = 0; i < 3; ++i)
+        {
+            track->colr[i * 2] = (uint8_t)(codes[i] >> 8);
+            track->colr[i * 2 + 1] = (uint8_t)codes[i];
+        }
+        track->colr[6] = full_range && CFGetTypeID(full_range) == CFBooleanGetTypeID()
+                && CFBooleanGetValue(full_range) ? 0x80 : 0;
+        track->has_colr = 1;
+    }
+    CFRelease(format);
+    return 1;
+}
+
+/* An access unit as MPEG-4 stores it: each NAL unit after its 4-byte length, without
+ * the parameter sets (they are in avcC), delimiters and filler. */
+static uint32_t avcc_from_annexb(struct mp4_writer *writer, const uint8_t *data, uint32_t size)
+{
+    struct nal_units units;
+    const uint8_t *unit;
+    uint32_t length, used = 0;
+
+    if (writer->scratch_capacity < (size_t)size + 64)
+    {
+        size_t capacity = (size_t)size * 2 + 64;
+        uint8_t *grown = realloc(writer->scratch, capacity);
+
+        if (!grown) return 0;
+        writer->scratch = grown;
+        writer->scratch_capacity = capacity;
+    }
+    nal_units_init(&units, data, size);
+    while (nal_units_next(&units, &unit, &length))
+    {
+        int type = unit[0] & 0x1f;
+
+        if (type == 7 || type == 8 || type == 9 || type == 12) continue;
+        if (used + 4 + (size_t)length > writer->scratch_capacity) return 0;
+        writer->scratch[used++] = (uint8_t)(length >> 24);
+        writer->scratch[used++] = (uint8_t)(length >> 16);
+        writer->scratch[used++] = (uint8_t)(length >> 8);
+        writer->scratch[used++] = (uint8_t)length;
+        memcpy(writer->scratch + used, unit, length);
+        used += length;
+    }
+    return used;
+}
+
+/* ------------------------------------------------------------------------ */
+/* Samples                                                                  */
+/* ------------------------------------------------------------------------ */
+
+static void track_refuse(struct mp4_track *track, unsigned int index, const char *reason)
+{
+    if (!track->refused++) log_error("MPEG-4 writer leaves out %s samples from #%u: %s", track_name(track), index, reason);
+}
+
+static int writer_append(struct mp4_writer *writer, struct mp4_track *track, const uint8_t *data, uint32_t size,
+        int64_t time, int64_t decode_time, int64_t duration, int keyframe)
+{
+    struct mp4_sample *sample;
+
+    if (track->count == track->capacity)
+    {
+        size_t capacity = track->capacity ? track->capacity * 2 : 1024;
+        struct mp4_sample *grown = realloc(track->samples, capacity * sizeof(*grown));
+
+        if (!grown)
+        {
+            track_refuse(track, (unsigned int)track->count, "out of memory");
+            return MACMF_ERROR;
+        }
+        track->samples = grown;
+        track->capacity = capacity;
+    }
+    if (fwrite(data, 1, size, writer->payload) != size)
+    {
+        writer->failed = 1;
+        log_error("MPEG-4 writer could not write its temporary file %s", writer->path);
+        return MACMF_ERROR;
+    }
+    sample = &track->samples[track->count++];
+    sample->offset = writer->payload_size;
+    sample->size = size;
+    sample->keyframe = keyframe;
+    sample->time = time;
+    sample->decode_time = decode_time;
+    sample->duration = duration;
+    writer->payload_size += size;
+    return MACMF_OK;
+}
+
+/* ------------------------------------------------------------------------ */
+/* Finishing                                                                */
+/* ------------------------------------------------------------------------ */
+
+static int64_t sample_decode_time(const struct mp4_sample *sample)
+{
+    return sample->decode_time == INT64_MIN ? sample->time : sample->decode_time;
+}
+
+static int64_t video_length(const struct mp4_track *track, const struct plan *plan, size_t index)
+{
+    if (track->samples[index].duration > 0)
+    {
+        int64_t length = rescale(track->samples[index].duration, plan->timescale);
+        if (length > 0) return length;
+    }
+    if (index + 1 < track->count) return plan->decode[index + 1] - plan->decode[index];
+    if (index) return plan->decode[index] - plan->decode[index - 1];
+    return plan->timescale / 30;
+}
+
+/* Video presents from its earliest frame: an edit skips the decode delay of B-frames. */
+static int plan_video(struct plan *plan, int64_t start)
+{
+    struct mp4_track *track = plan->track;
+    int64_t base = sample_decode_time(&track->samples[0]), least = INT64_MAX, first = INT64_MAX, end = INT64_MIN;
+    size_t i, count = track->count;
+
+    (void)start;    /* the earliest frame is the start */
+    plan->timescale = VIDEO_TIMESCALE;
+    if (!(plan->decode = malloc(count * sizeof(int64_t))) || !(plan->offset = malloc(count * sizeof(int64_t))))
+        return 0;
+    for (i = 0; i < count; ++i)
+    {
+        int64_t decode = rescale(sample_decode_time(&track->samples[i]) - base, VIDEO_TIMESCALE);
+
+        if (i && decode <= plan->decode[i - 1]) decode = plan->decode[i - 1] + 1;
+        plan->decode[i] = decode;
+        plan->offset[i] = rescale(track->samples[i].time - base, VIDEO_TIMESCALE) - decode;
+        if (plan->offset[i] < least) least = plan->offset[i];
+    }
+    plan->all_sync = 1;
+    for (i = 0; i < count; ++i)
+    {
+        int64_t composition;
+
+        if (least < 0) plan->offset[i] -= least;
+        if (plan->offset[i]) plan->has_offsets = 1;
+        if (!track->samples[i].keyframe) plan->all_sync = 0;
+        composition = plan->decode[i] + plan->offset[i];
+        if (composition < first) first = composition;
+        if (composition + video_length(track, plan, i) > end) end = composition + video_length(track, plan, i);
+    }
+    plan->last_delta = (uint32_t)video_length(track, plan, count - 1);
+    plan->media_duration = (uint64_t)(plan->decode[count - 1] + plan->last_delta);
+    plan->edits[0].media_time = first;
+    plan->edits[0].segment = to_movie((uint64_t)(end - first), VIDEO_TIMESCALE);
+    plan->edit_count = 1;
+    return 1;
+}
+
+/* AAC frames are 1024 long and follow each other: the first one's time places the track,
+ * an edit trims the encoder's priming and anything before the picture, and the last
+ * frame's length trims its padding. */
+static int plan_audio(struct plan *plan, int64_t start)
+{
+    struct mp4_track *track = plan->track;
+    size_t i, count = track->count, window = 0;
+    int64_t media_start, end, last;
+    uint64_t total = 0, in_window = 0, peak = 0;
+    uint32_t per_second;
+
+    plan->timescale = track->sample_rate;
+    media_start = rescale(start - track->samples[0].time, track->sample_rate);
+    last = track->samples[count - 1].duration > 0 ? rescale(track->samples[count - 1].duration, track->sample_rate)
+            : AAC_FRAMES;
+    if (last < 1) last = 1;
+    if (last > AAC_FRAMES) last = AAC_FRAMES;
+    end = (int64_t)(count - 1) * AAC_FRAMES + last;
+    if (media_start >= end) return 0;
+
+    plan->media_duration = (uint64_t)count * AAC_FRAMES;
+    plan->last_delta = AAC_FRAMES;
+    plan->all_sync = 1;
+    if (media_start >= 0)
+    {
+        plan->edits[0].segment = to_movie((uint64_t)(end - media_start), track->sample_rate);
+        plan->edits[0].media_time = media_start;
+        plan->edit_count = 1;
+    }
+    else
+    {
+        plan->edits[0].segment = to_movie((uint64_t)-media_start, track->sample_rate);
+        plan->edits[0].media_time = -1;
+        plan->edits[1].segment = to_movie((uint64_t)end, track->sample_rate);
+        plan->edits[1].media_time = 0;
+        plan->edit_count = 2;
+    }
+
+    per_second = (track->sample_rate + AAC_FRAMES - 1) / AAC_FRAMES;
+    for (i = 0; i < count; ++i)
+    {
+        uint32_t size = track->samples[i].size;
+
+        if (size > plan->max_size) plan->max_size = size;
+        total += size;
+        in_window += size;
+        if (++window > per_second) in_window -= track->samples[i - per_second].size;
+        if (in_window > peak) peak = in_window;
+    }
+    plan->avg_bitrate = (uint32_t)(total * 8 * track->sample_rate / ((uint64_t)count * AAC_FRAMES));
+    plan->max_bitrate = (uint32_t)(peak * 8);
+    if (plan->max_bitrate < plan->avg_bitrate) plan->max_bitrate = plan->avg_bitrate;
+    return 1;
+}
+
+static void put_descriptor_header(struct buffer *buffer, uint8_t tag, uint32_t size)
+{
+    put_u8(buffer, tag);
+    put_u8(buffer, (uint8_t)(0x80 | (size >> 21 & 0x7f)));
+    put_u8(buffer, (uint8_t)(0x80 | (size >> 14 & 0x7f)));
+    put_u8(buffer, (uint8_t)(0x80 | (size >> 7 & 0x7f)));
+    put_u8(buffer, (uint8_t)(size & 0x7f));
+}
+
+static void put_sample_entry(struct buffer *buffer, const struct plan *plan)
+{
+    const struct mp4_track *track = plan->track;
+    size_t entry, child;
+
+    if (track->type == TRACK_H264)
+    {
+        static const char name[32] = "\x05H.264";
+
+        entry = box_start(buffer, "avc1");
+        put_zeros(buffer, 6);
+        put_u16(buffer, 1);                 /* data reference */
+        put_zeros(buffer, 16);
+        put_u16(buffer, (uint16_t)track->width);
+        put_u16(buffer, (uint16_t)track->height);
+        put_u32(buffer, 0x00480000);        /* 72 dpi */
+        put_u32(buffer, 0x00480000);
+        put_u32(buffer, 0);
+        put_u16(buffer, 1);                 /* frames per sample */
+        put_bytes(buffer, name, sizeof(name));
+        put_u16(buffer, 0x0018);
+        put_u16(buffer, 0xffff);
+        child = box_start(buffer, "avcC");
+        put_bytes(buffer, track->avcc, track->avcc_size);
+        box_end(buffer, child);
+        if (track->has_colr)
+        {
+            child = box_start(buffer, "colr");
+            put_bytes(buffer, "nclx", 4);
+            put_bytes(buffer, track->colr, sizeof(track->colr));
+            box_end(buffer, child);
+        }
+        box_end(buffer, entry);
+        return;
+    }
+
+    entry = box_start(buffer, "mp4a");
+    put_zeros(buffer, 6);
+    put_u16(buffer, 1);
+    put_zeros(buffer, 8);
+    put_u16(buffer, (uint16_t)track->channels);
+    put_u16(buffer, 16);
+    put_u32(buffer, 0);
+    put_u32(buffer, track->sample_rate <= 0xffff ? track->sample_rate << 16 : 0);
+    child = full_box_start(buffer, "esds", 0, 0);
+    put_descriptor_header(buffer, 0x03, 3 + (5 + 13 + 5 + track->config_size) + (5 + 1));
+    put_u16(buffer, 0);                     /* ES_ID */
+    put_u8(buffer, 0);
+    put_descriptor_header(buffer, 0x04, 13 + 5 + track->config_size);
+    put_u8(buffer, 0x40);                   /* MPEG-4 audio */
+    put_u8(buffer, 0x15);                   /* audio stream */
+    put_u24(buffer, plan->max_size);
+    put_u32(buffer, plan->max_bitrate);
+    put_u32(buffer, plan->avg_bitrate);
+    put_descriptor_header(buffer, 0x05, track->config_size);
+    put_bytes(buffer, track->config, track->config_size);
+    put_descriptor_header(buffer, 0x06, 1);
+    put_u8(buffer, 0x02);
+    box_end(buffer, child);
+    box_end(buffer, entry);
+}
+
+static void patch_u32(struct buffer *buffer, size_t at, uint32_t value)
+{
+    if (buffer->failed) return;
+    buffer->data[at] = (uint8_t)(value >> 24);
+    buffer->data[at + 1] = (uint8_t)(value >> 16);
+    buffer->data[at + 2] = (uint8_t)(value >> 8);
+    buffer->data[at + 3] = (uint8_t)value;
+}
+
+/* Samples next to each other in the payload share a chunk. */
+static void put_chunks(struct buffer *buffer, const struct mp4_track *track, uint64_t base, int co64)
+{
+    uint32_t *counts = malloc(track->count * sizeof(*counts));
+    size_t *firsts = malloc(track->count * sizeof(*firsts));
+    size_t i, chunks = 0, box, at;
+    uint32_t runs = 0;
+
+    if (!counts || !firsts)
+    {
+        buffer->failed = 1;
+        free(counts);
+        free(firsts);
+        return;
+    }
+    for (i = 0; i < track->count; ++i)
+    {
+        if (!i || track->samples[i].offset != track->samples[i - 1].offset + track->samples[i - 1].size)
+        {
+            firsts[chunks] = i;
+            counts[chunks++] = 0;
+        }
+        ++counts[chunks - 1];
+    }
+
+    box = full_box_start(buffer, "stsc", 0, 0);
+    at = buffer->size;
+    put_u32(buffer, 0);
+    for (i = 0; i < chunks; ++i)
+    {
+        if (i && counts[i] == counts[i - 1]) continue;
+        put_u32(buffer, (uint32_t)i + 1);   /* first chunk */
+        put_u32(buffer, counts[i]);
+        put_u32(buffer, 1);                 /* sample description */
+        ++runs;
+    }
+    patch_u32(buffer, at, runs);
+    box_end(buffer, box);
+
+    box = full_box_start(buffer, co64 ? "co64" : "stco", 0, 0);
+    put_u32(buffer, (uint32_t)chunks);
+    for (i = 0; i < chunks; ++i)
+    {
+        uint64_t offset = base + track->samples[firsts[i]].offset;
+
+        if (co64) put_u64(buffer, offset);
+        else put_u32(buffer, (uint32_t)offset);
+    }
+    box_end(buffer, box);
+    free(counts);
+    free(firsts);
+}
+
+static uint32_t sample_delta(const struct plan *plan, size_t index)
+{
+    if (plan->track->type == TRACK_AAC) return AAC_FRAMES;
+    if (index + 1 < plan->track->count) return (uint32_t)(plan->decode[index + 1] - plan->decode[index]);
+    return plan->last_delta;
+}
+
+static void put_sample_tables(struct buffer *buffer, const struct plan *plan, uint64_t base, int co64)
+{
+    const struct mp4_track *track = plan->track;
+    size_t stbl, box, at, i;
+    uint32_t entries, run;
+
+    stbl = box_start(buffer, "stbl");
+
+    box = full_box_start(buffer, "stsd", 0, 0);
+    put_u32(buffer, 1);
+    put_sample_entry(buffer, plan);
+    box_end(buffer, box);
+
+    /* Decode durations, run-length coded. */
+    box = full_box_start(buffer, "stts", 0, 0);
+    at = buffer->size;
+    put_u32(buffer, 0);
+    for (i = 0, entries = 0; i < track->count; i += run, ++entries)
+    {
+        uint32_t delta = sample_delta(plan, i);
+
+        for (run = 1; i + run < track->count && sample_delta(plan, i + run) == delta; ++run) {}
+        put_u32(buffer, run);
+        put_u32(buffer, delta);
+    }
+    patch_u32(buffer, at, entries);
+    box_end(buffer, box);
+
+    /* Composition offsets: B-frames show after frames decoded later. */
+    if (plan->has_offsets)
+    {
+        box = full_box_start(buffer, "ctts", 0, 0);
+        at = buffer->size;
+        put_u32(buffer, 0);
+        for (i = 0, entries = 0; i < track->count; i += run, ++entries)
+        {
+            for (run = 1; i + run < track->count && plan->offset[i + run] == plan->offset[i]; ++run) {}
+            put_u32(buffer, run);
+            put_u32(buffer, (uint32_t)plan->offset[i]);
+        }
+        patch_u32(buffer, at, entries);
+        box_end(buffer, box);
+    }
+
+    if (!plan->all_sync)
+    {
+        box = full_box_start(buffer, "stss", 0, 0);
+        at = buffer->size;
+        put_u32(buffer, 0);
+        for (i = 0, entries = 0; i < track->count; ++i)
+        {
+            if (!track->samples[i].keyframe) continue;
+            put_u32(buffer, (uint32_t)i + 1);
+            ++entries;
+        }
+        patch_u32(buffer, at, entries);
+        box_end(buffer, box);
+    }
+
+    put_chunks(buffer, track, base, co64);
+
+    box = full_box_start(buffer, "stsz", 0, 0);
+    put_u32(buffer, 0);
+    put_u32(buffer, (uint32_t)track->count);
+    for (i = 0; i < track->count; ++i) put_u32(buffer, track->samples[i].size);
+    box_end(buffer, box);
+
+    /* Each AAC frame needs the one before it decoded first (a roll of -1). Without this
+     * group Apple's players drop the encoder's priming a second time, after the edit has,
+     * and the sound runs 44 ms ahead of the picture; with it they take the edit as it is,
+     * like every other player. */
+    if (track->type == TRACK_AAC)
+    {
+        box = full_box_start(buffer, "sgpd", 1, 0);
+        put_bytes(buffer, "roll", 4);
+        put_u32(buffer, 2);                 /* entry length */
+        put_u32(buffer, 1);
+        put_u16(buffer, 0xffff);            /* roll distance -1 */
+        box_end(buffer, box);
+        box = full_box_start(buffer, "sbgp", 0, 0);
+        put_bytes(buffer, "roll", 4);
+        put_u32(buffer, 1);
+        put_u32(buffer, (uint32_t)track->count);
+        put_u32(buffer, 1);                 /* every frame */
+        box_end(buffer, box);
+    }
+
+    box_end(buffer, stbl);
+}
+
+static void put_track(struct buffer *buffer, const struct plan *plan, uint32_t now, uint64_t base, int co64)
+{
+    const struct mp4_track *track = plan->track;
+    int video = track->type == TRACK_H264;
+    size_t trak, box, mdia, minf, child;
+    unsigned int i;
+
+    trak = box_start(buffer, "trak");
+
+    box = full_box_start(buffer, "tkhd", 0, 0x000003);     /* enabled, in the movie */
+    put_u32(buffer, now);
+    put_u32(buffer, now);
+    put_u32(buffer, plan->id);
+    put_u32(buffer, 0);
+    put_u32(buffer, (uint32_t)plan->movie_duration);
+    put_zeros(buffer, 8);
+    put_u16(buffer, 0);                                 /* layer */
+    put_u16(buffer, video ? 0 : 1);                     /* alternate group */
+    put_u16(buffer, video ? 0 : 0x0100);                /* volume */
+    put_u16(buffer, 0);
+    put_matrix(buffer);
+    put_u32(buffer, video ? track->width << 16 : 0);
+    put_u32(buffer, video ? track->height << 16 : 0);
+    box_end(buffer, box);
+
+    box = box_start(buffer, "edts");
+    child = full_box_start(buffer, "elst", 0, 0);
+    put_u32(buffer, plan->edit_count);
+    for (i = 0; i < plan->edit_count; ++i)
+    {
+        put_u32(buffer, (uint32_t)plan->edits[i].segment);
+        put_u32(buffer, (uint32_t)plan->edits[i].media_time);
+        put_u32(buffer, 0x00010000);                    /* rate 1 */
+    }
+    box_end(buffer, child);
+    box_end(buffer, box);
+
+    mdia = box_start(buffer, "mdia");
+    box = full_box_start(buffer, "mdhd", 0, 0);
+    put_u32(buffer, now);
+    put_u32(buffer, now);
+    put_u32(buffer, plan->timescale);
+    put_u32(buffer, (uint32_t)plan->media_duration);
+    put_u16(buffer, 0x55c4);                            /* "und" */
+    put_u16(buffer, 0);
+    box_end(buffer, box);
+
+    box = full_box_start(buffer, "hdlr", 0, 0);
+    put_u32(buffer, 0);
+    put_bytes(buffer, video ? "vide" : "soun", 4);
+    put_zeros(buffer, 12);
+    put_bytes(buffer, video ? "VideoHandler" : "SoundHandler", 13);
+    box_end(buffer, box);
+
+    minf = box_start(buffer, "minf");
+    if (video)
+    {
+        box = full_box_start(buffer, "vmhd", 0, 1);
+        put_zeros(buffer, 8);
+    }
+    else
+    {
+        box = full_box_start(buffer, "smhd", 0, 0);
+        put_zeros(buffer, 4);
+    }
+    box_end(buffer, box);
+    box = box_start(buffer, "dinf");
+    child = full_box_start(buffer, "dref", 0, 0);
+    put_u32(buffer, 1);
+    box_end(buffer, full_box_start(buffer, "url ", 0, 1));  /* in this file */
+    box_end(buffer, child);
+    box_end(buffer, box);
+    put_sample_tables(buffer, plan, base, co64);
+    box_end(buffer, minf);
+    box_end(buffer, mdia);
+
+    box_end(buffer, trak);
+}
+
+static void put_moov(struct buffer *buffer, const struct plan *plans, unsigned int count, uint32_t now,
+        uint64_t base, int co64)
+{
+    uint64_t duration = 0;
+    size_t moov, box;
+    unsigned int i;
+
+    for (i = 0; i < count; ++i)
+        if (plans[i].movie_duration > duration) duration = plans[i].movie_duration;
+
+    moov = box_start(buffer, "moov");
+    box = full_box_start(buffer, "mvhd", 0, 0);
+    put_u32(buffer, now);
+    put_u32(buffer, now);
+    put_u32(buffer, MOVIE_TIMESCALE);
+    put_u32(buffer, (uint32_t)duration);
+    put_u32(buffer, 0x00010000);                        /* rate 1 */
+    put_u16(buffer, 0x0100);                            /* volume 1 */
+    put_zeros(buffer, 10);
+    put_matrix(buffer);
+    put_zeros(buffer, 24);
+    put_u32(buffer, count + 1);                         /* next track ID */
+    box_end(buffer, box);
+    for (i = 0; i < count; ++i) put_track(buffer, &plans[i], now, base, co64);
+    box_end(buffer, moov);
+}
+
+static void put_ftyp(struct buffer *buffer)
+{
+    size_t box = box_start(buffer, "ftyp");
+
+    put_bytes(buffer, "mp42", 4);
+    put_u32(buffer, 1);
+    put_bytes(buffer, "isommp41mp42", 12);
+    box_end(buffer, box);
+}
+
+/* The presentation starts with the earliest frame of the picture, or with the sound
+ * when there is none; whatever comes before is trimmed. */
+static int64_t presentation_start(const struct mp4_writer *writer)
+{
+    int64_t start = INT64_MAX;
+    unsigned int i;
+    size_t j;
+
+    for (i = 0; i < writer->track_count; ++i)
+    {
+        const struct mp4_track *track = &writer->tracks[i];
+
+        if (track->type != TRACK_H264) continue;
+        for (j = 0; j < track->count; ++j)
+            if (track->samples[j].time < start) start = track->samples[j].time;
+    }
+    if (start != INT64_MAX) return start;
+    for (i = 0; i < writer->track_count; ++i)
+        if (writer->tracks[i].count && writer->tracks[i].samples[0].time < start) start = writer->tracks[i].samples[0].time;
+    return start;
+}
+
+static int writer_finish(struct mp4_writer *writer, uint64_t *size)
+{
+    struct plan plans[MAX_TRACKS];
+    struct buffer header = {0};
+    unsigned int i, j, count = 0;
+    uint64_t base = 0, mdat_size;
+    int64_t start;
+    uint32_t now;
+    int co64 = 0, ret = MACMF_ERROR;
+
+    if (writer->failed)
+    {
+        log_error("MPEG-4 writer lost samples to its temporary file; nothing to finish");
+        return MACMF_ERROR;
+    }
+    if (fflush(writer->payload))
+    {
+        log_error("MPEG-4 writer could not write its temporary file %s", writer->path);
+        return MACMF_ERROR;
+    }
+
+    memset(plans, 0, sizeof(plans));
+    start = presentation_start(writer);
+    for (i = 0; i < writer->track_count; ++i)
+    {
+        struct mp4_track *track = &writer->tracks[i];
+        struct plan *plan = &plans[count];
+
+        if (!track->count)
+        {
+            log_error("MPEG-4 writer has no %s samples; the file leaves the track out", track_name(track));
+            continue;
+        }
+        plan->track = track;
+        if (!(track->type == TRACK_H264 ? plan_video(plan, start) : plan_audio(plan, start)))
+        {
+            log_error("MPEG-4 writer leaves out the %s track: nothing of it is in the picture's time", track_name(track));
+            free(plan->decode);
+            free(plan->offset);
+            memset(plan, 0, sizeof(*plan));
+            continue;
+        }
+        plan->id = ++count;
+        for (j = 0; j < plan->edit_count; ++j) plan->movie_duration += plan->edits[j].segment;
+        log_trace("MPEG-4 writer %s track: %zu samples, %.3f s%s", track_name(track), track->count,
+                (double)plan->movie_duration / MOVIE_TIMESCALE, track->refused ? ", some left out" : "");
+    }
+    if (!count)
+    {
+        log_error("MPEG-4 writer has nothing to finish");
+        goto done;
+    }
+
+    /* The index goes first, so players can start before they have the whole file. Its
+     * size does not depend on the offsets it holds, only on their width. */
+    now = (uint32_t)(time(NULL) + SECONDS_1904_TO_1970);
+    mdat_size = writer->payload_size + 8 > 0xffffffffu ? writer->payload_size + 16 : writer->payload_size + 8;
+    for (;;)
+    {
+        header.size = 0;
+        put_ftyp(&header);
+        put_moov(&header, plans, count, now, 0, co64);
+        base = header.size + (mdat_size - writer->payload_size);
+        if (co64 || base + writer->payload_size <= 0xffffffffu) break;
+        co64 = 1;
+    }
+    header.size = 0;
+    put_ftyp(&header);
+    put_moov(&header, plans, count, now, base, co64);
+    if (mdat_size - writer->payload_size == 16)
+    {
+        put_u32(&header, 1);
+        put_bytes(&header, "mdat", 4);
+        put_u64(&header, mdat_size);
+    }
+    else
+    {
+        put_u32(&header, (uint32_t)mdat_size);
+        put_bytes(&header, "mdat", 4);
+    }
+    if (header.failed)
+    {
+        log_error("MPEG-4 writer is out of memory for the file's index");
+        free(header.data);
+        goto done;
+    }
+    free(writer->header);
+    writer->header = header.data;
+    writer->header_size = header.size;
+    *size = header.size + writer->payload_size;
+    log_trace("MPEG-4 writer finished %llu bytes with %u tracks", (unsigned long long)*size, count);
+    ret = MACMF_OK;
+
+done:
+    for (i = 0; i < MAX_TRACKS; ++i)
+    {
+        free(plans[i].decode);
+        free(plans[i].offset);
+    }
+    return ret;
+}
+
+/* ------------------------------------------------------------------------ */
+/* Entry points                                                             */
+/* ------------------------------------------------------------------------ */
+
+static void temporary_directory(char *path, size_t size)
+{
+    const char *variable = getenv("TMPDIR");
+    char user[PATH_MAX];
+
+    if (variable && *variable) snprintf(path, size, "%s", variable);
+    else if (confstr(_CS_DARWIN_USER_TEMP_DIR, user, sizeof(user)) > 0) snprintf(path, size, "%s", user);
+    else snprintf(path, size, "/tmp");
+}
+
+void *macmf_muxer_create(void)
+{
+    struct mp4_writer *writer;
+    char folder[PATH_MAX];
+    size_t length;
+
+    if (!(writer = calloc(1, sizeof(*writer)))) return NULL;
+    temporary_directory(folder, sizeof(folder));
+    length = strlen(folder);
+    while (length > 1 && folder[length - 1] == '/') folder[--length] = 0;
+    snprintf(writer->directory, sizeof(writer->directory), "%s/winemacmf-XXXXXX", folder);
+    if (!mkdtemp(writer->directory))
+    {
+        log_error("No temporary folder for the MPEG-4 writer in %s", folder);
+        free(writer);
+        return NULL;
+    }
+    snprintf(writer->path, sizeof(writer->path), "%s/samples", writer->directory);
+    if (!(writer->payload = fopen(writer->path, "w+b")))
+    {
+        log_error("MPEG-4 writer could not create %s", writer->path);
+        rmdir(writer->directory);
+        free(writer);
+        return NULL;
+    }
+    setvbuf(writer->payload, NULL, _IOFBF, 1 << 20);
+    pthread_mutex_init(&writer->lock, NULL);
+    return writer;
+}
+
+void macmf_muxer_destroy(void *object)
+{
+    struct mp4_writer *writer = object;
+    unsigned int i;
+
+    if (!writer) return;
+    if (writer->payload) fclose(writer->payload);
+    unlink(writer->path);
+    rmdir(writer->directory);
+    for (i = 0; i < writer->track_count; ++i)
+    {
+        free(writer->tracks[i].config);
+        free(writer->tracks[i].avcc);
+        free(writer->tracks[i].samples);
+    }
+    free(writer->scratch);
+    free(writer->header);
+    pthread_mutex_destroy(&writer->lock);
+    free(writer);
+}
+
+int macmf_muxer_add_track(void *object, uint32_t type, uint32_t width, uint32_t height, uint32_t sample_rate,
+        uint32_t channels, uint32_t priming, const uint8_t *config, uint32_t config_size)
+{
+    struct mp4_writer *writer = object;
+    struct mp4_track *track;
+    int index = MACMF_ERROR;
+
+    (void)priming;  /* AAC frame times already place the priming before the sound */
+    if (type != TRACK_H264 && type != TRACK_AAC) return MACMF_ERROR;
+    if (type == TRACK_AAC && (!sample_rate || !channels || config_size < 2))
+    {
+        log_error("MPEG-4 writer cannot take an audio track of %u Hz, %u channels, %u config bytes",
+                sample_rate, channels, config_size);
+        return MACMF_ERROR;
+    }
+    pthread_mutex_lock(&writer->lock);
+    if (writer->track_count < MAX_TRACKS && !writer->header)
+    {
+        track = &writer->tracks[writer->track_count];
+        memset(track, 0, sizeof(*track));
+        track->type = (int)type;
+        track->width = width;
+        track->height = height;
+        track->sample_rate = sample_rate;
+        track->channels = channels;
+        if (config_size && (track->config = malloc(config_size)))
+        {
+            memcpy(track->config, config, config_size);
+            track->config_size = config_size;
+        }
+        if (type != TRACK_AAC || track->config) index = (int)writer->track_count++;
+    }
+    pthread_mutex_unlock(&writer->lock);
+    return index;
+}
+
+int macmf_muxer_write(void *object, uint32_t index, const uint8_t *data, uint32_t size,
+        int64_t time, int64_t decode_time, int64_t duration, int keyframe)
+{
+    struct mp4_writer *writer = object;
+    struct mp4_track *track;
+    uint32_t length;
+    int ret = MACMF_OK;
+
+    pthread_mutex_lock(&writer->lock);
+    if (writer->failed || writer->header || index >= writer->track_count)
+    {
+        pthread_mutex_unlock(&writer->lock);
+        return MACMF_ERROR;
+    }
+    track = &writer->tracks[index];
+    if (!size)
+    {
+        pthread_mutex_unlock(&writer->lock);
+        return MACMF_OK;
+    }
+
+    if (track->type == TRACK_AAC)
+        ret = writer_append(writer, track, data, size, time, time, duration, 1);
+    else
+    {
+        if (!track->avcc)
+        {
+            if (!track->config || !track_take_h264_format(track, track->config, track->config_size))
+                track_take_h264_format(track, data, size);
+        }
+        /* Nothing before the first key frame can be decoded. */
+        if (track->avcc && (track->count || keyframe))
+        {
+            if (!(length = avcc_from_annexb(writer, data, size))) track_refuse(track, (unsigned int)track->count,
+                    "no picture in the access unit");
+            else ret = writer_append(writer, track, writer->scratch, length, time, decode_time, duration, keyframe);
+        }
+    }
+    pthread_mutex_unlock(&writer->lock);
+    return ret;
+}
+
+int macmf_muxer_finish(void *object, uint64_t *size)
+{
+    struct mp4_writer *writer = object;
+    int ret;
+
+    pthread_mutex_lock(&writer->lock);
+    ret = writer_finish(writer, size);
+    pthread_mutex_unlock(&writer->lock);
+    return ret;
+}
+
+int macmf_muxer_read(void *object, uint64_t offset, uint8_t *data, uint32_t capacity, uint32_t *size)
+{
+    struct mp4_writer *writer = object;
+    uint32_t done = 0;
+    ssize_t count;
+
+    *size = 0;
+    pthread_mutex_lock(&writer->lock);
+    if (!writer->header)
+    {
+        pthread_mutex_unlock(&writer->lock);
+        return MACMF_ERROR;
+    }
+    if (offset < writer->header_size)
+    {
+        done = (uint32_t)(writer->header_size - offset < capacity ? writer->header_size - offset : capacity);
+        memcpy(data, writer->header + offset, done);
+        offset += done;
+    }
+    if (done < capacity && offset >= writer->header_size && offset - writer->header_size < writer->payload_size)
+    {
+        count = pread(fileno(writer->payload), data + done, capacity - done, (off_t)(offset - writer->header_size));
+        if (count < 0)
+        {
+            log_error("MPEG-4 writer could not read its temporary file %s", writer->path);
+            pthread_mutex_unlock(&writer->lock);
+            return MACMF_ERROR;
+        }
+        done += (uint32_t)count;
+    }
+    pthread_mutex_unlock(&writer->lock);
+    *size = done;
+    return MACMF_OK;
+}
