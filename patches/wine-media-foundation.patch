+/* Writes the finished file into the client's byte stream. */
+static HRESULT sink_copy_output(struct mpeg4_sink *sink)
+{
+    struct muxer_finish_params finish = {0};
+    struct muxer_read_params read = {0};
+    UINT64 offset;
+    ULONG written;
+    BYTE *chunk;
+    HRESULT hr = S_OK;
+
+    finish.handle = sink->muxer;
+    if (UNIX_CALL(muxer_finish, &finish))
+    {
+        ERR("The MPEG-4 writer could not finish the file.\n");
+        return E_FAIL;
+    }
+    if (FAILED(hr = IMFByteStream_SetCurrentPosition(sink->bytestream, 0)))
+    {
+        ERR("The file cannot be written from its start, hr %#lx.\n", hr);
+        return hr;
+    }
+    if (!(chunk = malloc(1 << 20))) return E_OUTOFMEMORY;
+    read.handle = sink->muxer;
+    read.data = (UINT_PTR)chunk;
+    read.capacity = 1 << 20;
+    for (offset = 0; offset < finish.size && SUCCEEDED(hr); offset += read.size)
+    {
+        read.offset = offset;
+        if (UNIX_CALL(muxer_read, &read) || !read.size)
+        {
+            hr = E_FAIL;
+            break;
+        }
+        if (SUCCEEDED(hr = IMFByteStream_Write(sink->bytestream, chunk, read.size, &written)) && written != read.size)
+            hr = E_FAIL;
+    }
+    free(chunk);
+    /* Wine's file byte streams write at once and do not implement Flush. */
+    if (SUCCEEDED(hr)) IMFByteStream_Flush(sink->bytestream);
+    if (FAILED(hr)) ERR("Could not write the file's %I64u bytes, hr %#lx.\n", finish.size, hr);
+    else TRACE("Wrote %I64u bytes.\n", finish.size);
+    return hr;
+}
+
+struct finalize_work
+{
+    struct mpeg4_sink *sink;
+    IMFAsyncCallback *callback;
+    IMFAsyncResult *result;
+};
+
+/* Finishing runs on a thread of its own and calls back from it. It used to be a work item
+ * on Media Foundation's standard queue, whose single thread also carries the program's
+ * and the sink writer's callbacks: when that thread was held up the file was never
+ * written, although the game had already said the highlight was saved. */
+static DWORD WINAPI finalize_thread(void *arg)
+{
+    struct finalize_work *work = arg;
+    struct mpeg4_sink *sink = work->sink;
+    DWORD start = GetTickCount();
+    HRESULT hr;
+
+    EnterCriticalSection(&sink->cs);
+    if (sink->shutdown) hr = MF_E_SHUTDOWN;
+    else if (!sink->muxer) hr = MF_E_INVALIDREQUEST;
+    else hr = sink_copy_output(sink);
+    sink->state = SINK_FINALIZED;
+    LeaveCriticalSection(&sink->cs);
+
+    if (FAILED(hr)) ERR("The MPEG-4 file was not written, hr %#lx.\n", hr);
+    else TRACE("Finished the file in %lu ms.\n", GetTickCount() - start);
+
+    IMFAsyncResult_SetStatus(work->result, hr);
+    IMFAsyncCallback_Invoke(work->callback, work->result);
+    IMFAsyncResult_Release(work->result);
+    IMFFinalizableMediaSink_Release(&sink->IMFFinalizableMediaSink_iface);
+    free(work);
+    return 0;
+}
+
+static HRESULT WINAPI sink_BeginFinalize(IMFFinalizableMediaSink *iface, IMFAsyncCallback *callback, IUnknown *state)
+{
+    struct mpeg4_sink *sink = impl_from_IMFFinalizableMediaSink(iface);
+    struct finalize_work *work;
+    HANDLE thread;
+    HRESULT hr;
+
+    TRACE("iface %p, callback %p, state %p.\n", iface, callback, state);
+
+    if (!callback) return E_INVALIDARG;
+    if (!(work = calloc(1, sizeof(*work)))) return E_OUTOFMEMORY;
+
+    EnterCriticalSection(&sink->cs);
+    if (sink->shutdown) hr = MF_E_SHUTDOWN;
+    else if (sink->state == SINK_FINALIZING || sink->state == SINK_FINALIZED) hr = MF_E_INVALIDREQUEST;
+    else if (SUCCEEDED(hr = MFCreateAsyncResult(NULL, callback, state, &work->result)))
+    {
+        work->sink = sink;
+        work->callback = callback;
+        IMFFinalizableMediaSink_AddRef(iface);
+        if ((thread = CreateThread(NULL, 0, finalize_thread, work, 0, NULL)))
+        {
+            sink->state = SINK_FINALIZING;
+            CloseHandle(thread);
+            work = NULL;
+        }
+        else
+        {
+            hr = HRESULT_FROM_WIN32(GetLastError());
+            ERR("No thread to finish the file, hr %#lx.\n", hr);
+            IMFAsyncResult_Release(work->result);
+            IMFFinalizableMediaSink_Release(iface);
+        }
+    }
+    LeaveCriticalSection(&sink->cs);
+    free(work);
+    return hr;
+}
+
+static HRESULT WINAPI sink_EndFinalize(IMFFinalizableMediaSink *iface, IMFAsyncResult *result)
+{
+    TRACE("iface %p, result %p.\n", iface, result);
+
+    if (!result) return E_INVALIDARG;
+    return IMFAsyncResult_GetStatus(result);
+}
