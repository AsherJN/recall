+/* The client's frame as the macOS side reads it: top scanline, row step and the
+ * buffer around them. */
+static HRESULT lock_frame(struct h264_encoder *encoder, IMFMediaBuffer *buffer, IMF2DBuffer **buffer_2d,
+        BYTE **scanline0, LONG *stride, BYTE **start, DWORD *size)
+{
+    IMF2DBuffer2 *buffer_2d2;
+    UINT64 rows = frame_rows(encoder->format, encoder->height);
+    BYTE *data;
+    DWORD length;
+    HRESULT hr;
+
+    *buffer_2d = NULL;
+    if (SUCCEEDED(IMFMediaBuffer_QueryInterface(buffer, &IID_IMF2DBuffer2, (void **)&buffer_2d2)))
+    {
+        hr = IMF2DBuffer2_Lock2DSize(buffer_2d2, MF2DBuffer_LockFlags_Read, scanline0, stride, start, size);
+        if (SUCCEEDED(hr))
+        {
+            IMF2DBuffer_AddRef((*buffer_2d = (IMF2DBuffer *)buffer_2d2));
+            IMF2DBuffer2_Release(buffer_2d2);
+            return hr;
+        }
+        IMF2DBuffer2_Release(buffer_2d2);
+    }
+    if (SUCCEEDED(IMFMediaBuffer_QueryInterface(buffer, &IID_IMF2DBuffer, (void **)buffer_2d)))
+    {
+        if (SUCCEEDED(hr = IMF2DBuffer_Lock2D(*buffer_2d, scanline0, stride)))
+        {
+            *start = *stride >= 0 ? *scanline0 : *scanline0 + (LONGLONG)*stride * (encoder->height - 1);
+            *size = (DWORD)min((UINT64)abs(*stride) * rows, 0xffffffff);
+            return hr;
+        }
+        IMF2DBuffer_Release(*buffer_2d);
+        *buffer_2d = NULL;
+    }
+
+    if (FAILED(hr = IMFMediaBuffer_Lock(buffer, &data, NULL, &length))) return hr;
+    *stride = encoder->stride;
+    *start = data;
+    *size = length;
+    /* A negative stride means the rows are stored bottom-up. */
+    *scanline0 = *stride >= 0 ? data : data + (LONGLONG)-*stride * (encoder->height - 1);
+    return S_OK;
+}
+
+static HRESULT WINAPI transform_ProcessInput(IMFTransform *iface, DWORD id, IMFSample *sample, DWORD flags)
+{
+    struct h264_encoder *encoder = impl_from_IMFTransform(iface);
+    struct video_encoder_encode_params params = {0};
+    IMFMediaBuffer *buffer = NULL;
+    IMF2DBuffer *buffer_2d = NULL;
+    BYTE *scanline0, *start;
+    LONGLONG time, duration;
+    NTSTATUS status;
+    LONG stride;
+    DWORD size;
+    HRESULT hr;
+
+    TRACE("iface %p, id %#lx, sample %p, flags %#lx.\n", iface, id, sample, flags);
+
+    if (id) return MF_E_INVALIDSTREAMNUMBER;
+    if (!sample) return E_POINTER;
+
+    EnterCriticalSection(&encoder->cs);
+    if (!encoder->input_type || !encoder->output_type)
+    {
+        hr = MF_E_TRANSFORM_TYPE_NOT_SET;
+        goto done;
+    }
+    if (FAILED(hr = encoder_create_session(encoder))) goto done;
+    encoder->draining = FALSE;
+
+    if (FAILED(IMFSample_GetSampleDuration(sample, &duration)) || duration <= 0)
+        duration = (LONGLONG)MF_UNITS * encoder->rate_den / encoder->rate_num;
+    if (FAILED(IMFSample_GetSampleTime(sample, &time))) time = encoder->next_time;
+    encoder->next_time = time + duration;
+
+    if (FAILED(hr = IMFSample_ConvertToContiguousBuffer(sample, &buffer))) goto done;
+    if (FAILED(hr = lock_frame(encoder, buffer, &buffer_2d, &scanline0, &stride, &start, &size))) goto done;
+
+    params.handle = encoder->handle;
+    params.data = (UINT_PTR)scanline0;
+    params.stride = stride;
+    params.buffer = (UINT_PTR)start;
+    params.size = size;
+    params.time = time;
+    params.duration = duration;
+    params.keyframe = encoder->force_keyframe;
+    encoder->force_keyframe = FALSE;
+    if ((status = UNIX_CALL(video_encoder_encode, &params)))
+    {
+        WARN("Failed to encode a frame, status %#lx.\n", status);
+        hr = E_FAIL;
+    }
+
+    if (buffer_2d)
+    {
+        IMF2DBuffer_Unlock2D(buffer_2d);
+        IMF2DBuffer_Release(buffer_2d);
+    }
+    else IMFMediaBuffer_Unlock(buffer);
+
+done:
+    if (buffer) IMFMediaBuffer_Release(buffer);
+    LeaveCriticalSection(&encoder->cs);
+    return hr;
+}
+
+static HRESULT WINAPI transform_ProcessOutput(IMFTransform *iface, DWORD flags, DWORD count,
+        MFT_OUTPUT_DATA_BUFFER *samples, DWORD *status)
+{
+    struct h264_encoder *encoder = impl_from_IMFTransform(iface);
+    struct packet_params params = {0};
+    IMFMediaBuffer *buffer = NULL;
+    IMFSample *sample = NULL;
+    DWORD capacity;
+    NTSTATUS ret;
+    BYTE *data;
+    HRESULT hr;
+
+    TRACE("iface %p, flags %#lx, count %lu, samples %p, status %p.\n", iface, flags, count, samples, status);
+
+    if (count != 1) return E_INVALIDARG;
+    *status = samples->dwStatus = 0;
+    samples->pEvents = NULL;
+
+    EnterCriticalSection(&encoder->cs);
+    if (!encoder->input_type || !encoder->output_type)
+    {
+        hr = MF_E_TRANSFORM_TYPE_NOT_SET;
+        goto done;
+    }
+    if (!encoder->handle)
+    {
+        hr = MF_E_TRANSFORM_NEED_MORE_INPUT;
+        goto done;
+    }
+
+    params.handle = encoder->handle;
+    ret = UNIX_CALL(video_encoder_read, &params);
+    if (ret == STATUS_PENDING)
+    {
+        encoder->draining = FALSE;
+        hr = MF_E_TRANSFORM_NEED_MORE_INPUT;
+        goto done;
+    }
+    if (ret != STATUS_BUFFER_TOO_SMALL)
+    {
+        hr = E_FAIL;
+        goto done;
+    }
+
+    if ((sample = samples->pSample)) IMFSample_AddRef(sample);
+    else if (FAILED(hr = sample_create(params.size, &sample))) goto done;
+    if (FAILED(hr = IMFSample_ConvertToContiguousBuffer(sample, &buffer))) goto done;
+    if (FAILED(hr = IMFMediaBuffer_Lock(buffer, &data, &capacity, NULL))) goto done;
+    if (capacity < params.size)
+    {
+        IMFMediaBuffer_Unlock(buffer);
+        hr = MF_E_BUFFERTOOSMALL;
+        goto done;
+    }
+    params.data = (UINT_PTR)data;
+    params.capacity = capacity;
+    ret = UNIX_CALL(video_encoder_read, &params);
+    IMFMediaBuffer_Unlock(buffer);
+    if (ret)
+    {
+        hr = E_FAIL;
+        goto done;
+    }
+    IMFMediaBuffer_SetCurrentLength(buffer, params.size);
+
+    IMFSample_SetSampleTime(sample, params.time);
+    if (params.duration <= 0) params.duration = (LONGLONG)MF_UNITS * encoder->rate_den / encoder->rate_num;
+    IMFSample_SetSampleDuration(sample, params.duration);
+    IMFSample_SetUINT32(sample, &MFSampleExtension_CleanPoint, params.keyframe);
+    IMFSample_SetUINT64(sample, &MFSampleExtension_DecodeTimestamp_macmf, params.decode_time);
+
+    if (!samples->pSample) IMFSample_AddRef((samples->pSample = sample));
+    hr = S_OK;
+
+done:
+    if (buffer) IMFMediaBuffer_Release(buffer);
+    if (sample) IMFSample_Release(sample);
+    LeaveCriticalSection(&encoder->cs);
+    return hr;
+}
+
+static const IMFTransformVtbl transform_vtbl =
+{
+    transform_QueryInterface,
+    transform_AddRef,
