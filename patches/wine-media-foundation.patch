+
+static HRESULT WINAPI transform_GetOutputCurrentType(IMFTransform *iface, DWORD id, IMFMediaType **type)
+{
+    struct h264_encoder *encoder = impl_from_IMFTransform(iface);
+    struct video_encoder_config_params params = {0};
+    BYTE config[256];
+    HRESULT hr;
+
+    TRACE("iface %p, id %#lx, type %p.\n", iface, id, type);
+
+    if (id) return MF_E_INVALIDSTREAMNUMBER;
+    EnterCriticalSection(&encoder->cs);
+    if (!encoder->output_type) hr = MF_E_TRANSFORM_TYPE_NOT_SET;
+    else if (SUCCEEDED(hr = media_type_copy(encoder->output_type, type)) && encoder->handle)
+    {
+        /* Once the first frame is encoded, the type carries its parameter sets, as on Windows. */
+        params.handle = encoder->handle;
+        params.data = (UINT_PTR)config;
+        params.capacity = sizeof(config);
+        if (!UNIX_CALL(video_encoder_config, &params))
+            IMFMediaType_SetBlob(*type, &MF_MT_MPEG_SEQUENCE_HEADER, config, params.size);
+    }
+    LeaveCriticalSection(&encoder->cs);
+    return hr;
+}
