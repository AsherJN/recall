+static HRESULT WINAPI transform_GetInputStreamInfo(IMFTransform *iface, DWORD id, MFT_INPUT_STREAM_INFO *info)
+{
+    struct h264_encoder *encoder = impl_from_IMFTransform(iface);
+
+    TRACE("iface %p, id %#lx, info %p.\n", iface, id, info);
+
+    if (id) return MF_E_INVALIDSTREAMNUMBER;
+    memset(info, 0, sizeof(*info));
+    info->dwFlags = MFT_INPUT_STREAM_WHOLE_SAMPLES | MFT_INPUT_STREAM_SINGLE_SAMPLE_PER_BUFFER
+            | MFT_INPUT_STREAM_FIXED_SAMPLE_SIZE;
+    EnterCriticalSection(&encoder->cs);
+    if (encoder->input_type)
+        info->cbSize = (DWORD)(minimum_stride(encoder->format, encoder->width) * frame_rows(encoder->format, encoder->height));
+    LeaveCriticalSection(&encoder->cs);
+    return S_OK;
+}
