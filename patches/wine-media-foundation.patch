+/* Drains the encoders, waits until the sink has every sample, lets the sink finish
+ * its file and shuts it down. */
+static HRESULT sink_writer_finalize(struct sink_writer *writer)
+{
+    IMFFinalizableMediaSink *finalizable;
+    struct finalize_wait wait;
+    DWORD start = GetTickCount();
+    unsigned int i;
+    HRESULT hr = S_OK;
+
+    EnterCriticalSection(&writer->cs);
+    for (i = 0; i < writer->streams.count && SUCCEEDED(hr); ++i)
+    {
+        struct stream *stream = &writer->streams.items[i];
+
+        if (SUCCEEDED(hr = stream_drain(stream)))
+            hr = sink_writer_process_pending(writer, stream);
+    }
+    while (SUCCEEDED(hr) && writer->status == S_OK && sink_writer_has_pending(writer))
+    {
+        if (GetTickCount() - start > FINALIZE_TIMEOUT)
+        {
+            ERR("The sink did not take the last samples.\n");
+            hr = HRESULT_FROM_WIN32(ERROR_TIMEOUT);
+            break;
+        }
+        SleepConditionVariableCS(&writer->drained, &writer->cs, 100);
+    }
+    if (SUCCEEDED(hr)) hr = writer->status;
+    LeaveCriticalSection(&writer->cs);
+
+    if (SUCCEEDED(hr) && SUCCEEDED(IMFMediaSink_QueryInterface(writer->sink, &IID_IMFFinalizableMediaSink,
+            (void **)&finalizable)))
+    {
+        wait.IMFAsyncCallback_iface.lpVtbl = &finalize_wait_vtbl;
+        wait.sink = finalizable;
+        wait.hr = E_FAIL;
+        wait.event = CreateEventW(NULL, TRUE, FALSE, NULL);
+        if (SUCCEEDED(hr = IMFFinalizableMediaSink_BeginFinalize(finalizable, &wait.IMFAsyncCallback_iface, NULL)))
+        {
+            if (WaitForSingleObject(wait.event, FINALIZE_TIMEOUT * 5) == WAIT_OBJECT_0)
+                hr = wait.hr;
+            else
+            {
+                ERR("The sink did not finish its file.\n");
+                hr = HRESULT_FROM_WIN32(ERROR_TIMEOUT);
+            }
+        }
+        CloseHandle(wait.event);
+        IMFFinalizableMediaSink_Release(finalizable);
+    }
+
+    if (writer->clock) IMFPresentationClock_Stop(writer->clock);
+    IMFMediaSink_Shutdown(writer->sink);
+
+    EnterCriticalSection(&writer->cs);
+    writer->state = SINK_WRITER_STATE_FINALIZED;
+    LeaveCriticalSection(&writer->cs);
+
+    if (FAILED(hr)) WARN("Finalize failed, hr %#lx.\n", hr);
+    return hr;
+}
+
+static DWORD WINAPI sink_writer_finalize_thread(void *arg)
+{
+    struct sink_writer *writer = arg;
+    HRESULT hr = sink_writer_finalize(writer);
+
+    IMFSinkWriterCallback_OnFinalize(writer->callback, hr);
+    IMFSinkWriterEx_Release(&writer->IMFSinkWriterEx_iface);
+    return 0;
+}
+
+static HRESULT WINAPI sink_writer_Finalize(IMFSinkWriterEx *iface)
+{
+    struct sink_writer *writer = impl_from_IMFSinkWriterEx(iface);
+    HRESULT hr = S_OK;
+
+    TRACE("%p.\n", iface);
+
+    EnterCriticalSection(&writer->cs);
+    if (writer->state != SINK_WRITER_STATE_WRITING)
+        hr = MF_E_INVALIDREQUEST;
+    else
+        writer->state = SINK_WRITER_STATE_FINALIZING;
+    LeaveCriticalSection(&writer->cs);
+    if (FAILED(hr)) return hr;
+
+    /* With a callback, Finalize returns at once and the callback hears the result. It runs on
+     * its own thread: it waits for the sink, whose requests arrive on the work queues. */
+    if (writer->callback)
+    {
+        HANDLE thread;
+
+        IMFSinkWriterEx_AddRef(iface);
+        if (!(thread = CreateThread(NULL, 0, sink_writer_finalize_thread, writer, 0, NULL)))
+        {
+            IMFSinkWriterEx_Release(iface);
+            return HRESULT_FROM_WIN32(GetLastError());
+        }
+        CloseHandle(thread);
+        return S_OK;
+    }
+    return sink_writer_finalize(writer);
+}
