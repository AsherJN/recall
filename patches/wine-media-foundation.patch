index 0000000..4437231
--- /dev/null
+++ b/dlls/winemacmf/macmf_cocoa.m
@@ -0,0 +1,1757 @@
+/*
+ * Media Foundation encoders and MPEG-4 writer on macOS frameworks
+ *
+ * H.264 through VideoToolbox (the Mac's hardware encoder), AAC through
+ * AudioToolbox, and MPEG-4 files through AVFoundation's writer, which takes
+ * the already encoded samples as they are.
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#if 0
+#pragma makedep unix
+#endif
+
+#import <Foundation/Foundation.h>
+#import <AVFoundation/AVFoundation.h>
+#import <AudioToolbox/AudioToolbox.h>
+#import <CoreMedia/CoreMedia.h>
+#import <CoreVideo/CoreVideo.h>
+#import <VideoToolbox/VideoToolbox.h>
+#include <math.h>
+#include <pthread.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <time.h>
+#include <unistd.h>
+
+#include "macmf_cocoa.h"
+
+/* Media Foundation's time unit is 100 ns. */
+#define MF_TIMESCALE 10000000
+/* Frames the video encoder may hold before encode waits for it. */
+#define VIDEO_PENDING_LIMIT 8
+
+enum
+{
+    FORMAT_BGRA,
+    FORMAT_NV12,
+    FORMAT_I420,
+    FORMAT_YV12,
+    FORMAT_YUY2,
+};
+
+enum
+{
+    AUDIO_S16,
+    AUDIO_S24,
+    AUDIO_S32,
+    AUDIO_F32,
+};
+
+enum
+{
+    TRACK_H264,
+    TRACK_AAC,
+};
+
+static void log_error(const char *format, ...) __attribute__((format(printf, 1, 2)));
+static void log_error(const char *format, ...)
+{
+    char message[512];
+    va_list args;
+
+    va_start(args, format);
+    vsnprintf(message, sizeof(message), format, args);
+    va_end(args);
+    macmf_log_error(message);
+}
+
+static void log_trace(const char *format, ...) __attribute__((format(printf, 1, 2)));
+static void log_trace(const char *format, ...)
+{
+    char message[512];
+    va_list args;
+
+    va_start(args, format);
+    vsnprintf(message, sizeof(message), format, args);
+    va_end(args);
+    macmf_log_trace(message);
+}
+
+static CMTime mf_time(int64_t value)
+{
+    return CMTimeMake(value, MF_TIMESCALE);
+}
+
+static int64_t time_from_cm(CMTime time, int64_t fallback)
+{
+    if (!CMTIME_IS_NUMERIC(time)) return fallback;
+    return CMTimeConvertScale(time, MF_TIMESCALE, kCMTimeRoundingMethod_RoundHalfAwayFromZero).value;
+}
+
+struct packet
+{
+    struct packet *next;
+    uint8_t *data;
+    struct macmf_packet_info info;
+};
+
+struct packet_queue
+{
+    struct packet *head;
+    struct packet *tail;
+};
+
+static void queue_push(struct packet_queue *queue, struct packet *packet)
+{
+    packet->next = NULL;
+    if (queue->tail) queue->tail->next = packet;
+    else queue->head = packet;
+    queue->tail = packet;
+}
+
+static void queue_clear(struct packet_queue *queue)
+{
+    struct packet *packet, *next;
+
+    for (packet = queue->head; packet; packet = next)
+    {
+        next = packet->next;
+        free(packet->data);
+        free(packet);
+    }
+    queue->head = queue->tail = NULL;
+}
+
+/* Copies the oldest packet out, as described for the read calls. */
+static int queue_read(struct packet_queue *queue, uint8_t *data, uint32_t capacity, struct macmf_packet_info *info)
+{
+    struct packet *packet = queue->head;
+
+    if (!packet) return MACMF_NONE;
+    *info = packet->info;
+    if (!data || capacity < packet->info.size) return MACMF_TOO_SMALL;
+    memcpy(data, packet->data, packet->info.size);
+    queue->head = packet->next;
+    if (!queue->head) queue->tail = NULL;
+    free(packet->data);
+    free(packet);
+    return MACMF_OK;
+}
+
+/* ------------------------------------------------------------------------ */
+/* H.264 encoder                                                             */
+/* ------------------------------------------------------------------------ */
+
+struct video_encoder
+{
+    VTCompressionSessionRef session;
+    struct macmf_video_settings settings;
+    OSType pixel_format;
+    CFStringRef matrix;
+    pthread_mutex_t lock;
+    pthread_cond_t cond;
+    struct packet_queue packets;
+    unsigned int pending;
+    OSStatus error;
+    int error_logged;
+    int missing_config;
+    int discard;
+    uint8_t *config;
+    uint32_t config_size;
+};
+
+/* The encoder calls back on its own threads, which are not Wine's and must not
+ * log; what they find is logged by the next call from the client. Called with
+ * the lock held. */
+static void video_report(struct video_encoder *encoder)
+{
+    if (encoder->error && !encoder->error_logged)
+    {
+        encoder->error_logged = 1;
+        log_error("H.264 encoder failed a frame: %d", (int)encoder->error);
+    }
+    if (encoder->missing_config == 1)
+    {
+        encoder->missing_config = 2;
+        log_error("H.264 encoder output has no parameter sets");
+    }
+}
+
+static const uint8_t start_code[4] = {0, 0, 0, 1};
+
+/* Annex B parameter sets from the encoder's format description. */
+static int video_parameter_sets(CMFormatDescriptionRef format, uint8_t **out, uint32_t *out_size, int *header_length)
+{
+    size_t count = 0, i, total = 0, size;
+    const uint8_t *set;
+    uint8_t *data;
+    int length = 4;
+
+    if (CMVideoFormatDescriptionGetH264ParameterSetAtIndex(format, 0, NULL, NULL, &count, &length) || !count)
+        return 0;
+    for (i = 0; i < count; ++i)
+    {
+        if (CMVideoFormatDescriptionGetH264ParameterSetAtIndex(format, i, &set, &size, NULL, NULL)) return 0;
+        total += sizeof(start_code) + size;
+    }
+    if (!(data = malloc(total))) return 0;
+    total = 0;
+    for (i = 0; i < count; ++i)
+    {
+        CMVideoFormatDescriptionGetH264ParameterSetAtIndex(format, i, &set, &size, NULL, NULL);
+        memcpy(data + total, start_code, sizeof(start_code));
+        memcpy(data + total + sizeof(start_code), set, size);
+        total += sizeof(start_code) + size;
+    }
+    *out = data;
+    *out_size = total;
+    *header_length = length;
+    return 1;
+}
+
+/* An encoded frame as Media Foundation's encoder gives it: an Annex B access
+ * unit, led by the parameter sets when it is a key frame. */
+static struct packet *video_packet(struct video_encoder *encoder, CMSampleBufferRef sample)
+{
+    CMFormatDescriptionRef format = CMSampleBufferGetFormatDescription(sample);
+    CMBlockBufferRef block = CMSampleBufferGetDataBuffer(sample);
+    uint8_t *config = NULL, *avcc = NULL, *out;
+    uint32_t config_size = 0, nal_size;
+    size_t length, offset, written;
+    struct packet *packet = NULL;
+    CFArrayRef attachments;
+    int header_length = 4, keyframe = 1, i;
+
+    if (!format || !block) return NULL;
+
+    attachments = CMSampleBufferGetSampleAttachmentsArray(sample, false);
+    if (attachments && CFArrayGetCount(attachments))
+    {
+        CFDictionaryRef dict = CFArrayGetValueAtIndex(attachments, 0);
+        CFBooleanRef not_sync;
+
+        if (CFDictionaryGetValueIfPresent(dict, kCMSampleAttachmentKey_NotSync, (const void **)&not_sync))
+            keyframe = !CFBooleanGetValue(not_sync);
+    }
+
+    if (!video_parameter_sets(format, &config, &config_size, &header_length)
+            || (header_length != 1 && header_length != 2 && header_length != 4))
+    {
+        pthread_mutex_lock(&encoder->lock);
+        if (!encoder->missing_config) encoder->missing_config = 1;
+        pthread_mutex_unlock(&encoder->lock);
+        free(config);
+        return NULL;
+    }
+
+    length = CMBlockBufferGetDataLength(block);
+    if (!(avcc = malloc(length))) goto done;
+    if (CMBlockBufferCopyDataBytes(block, 0, length, avcc)) goto done;
+
+    /* Each length field becomes a four-byte start code. */
+    written = keyframe ? config_size : 0;
+    for (offset = 0; offset + header_length <= length;)
+    {
+        nal_size = 0;
+        for (i = 0; i < header_length; ++i) nal_size = (nal_size << 8) | avcc[offset + i];
+        offset += header_length;
+        if (nal_size > length - offset) break;
+        written += sizeof(start_code) + nal_size;
+        offset += nal_size;
+    }
+
+    if (!(packet = calloc(1, sizeof(*packet)))) goto done;
+    if (!(packet->data = malloc(written ? written : 1)))
+    {
+        free(packet);
+        packet = NULL;
+        goto done;
+    }
+    out = packet->data;
+    written = 0;
+    if (keyframe)
+    {
+        memcpy(out, config, config_size);
+        written = config_size;
+    }
+    for (offset = 0; offset + header_length <= length;)
+    {
+        nal_size = 0;
+        for (i = 0; i < header_length; ++i) nal_size = (nal_size << 8) | avcc[offset + i];
+        offset += header_length;
+        if (nal_size > length - offset) break;
+        memcpy(out + written, start_code, sizeof(start_code));
+        memcpy(out + written + sizeof(start_code), avcc + offset, nal_size);
+        written += sizeof(start_code) + nal_size;
+        offset += nal_size;
+    }
+    packet->info.size = written;
+    packet->info.time = time_from_cm(CMSampleBufferGetPresentationTimeStamp(sample), 0);
+    packet->info.decode_time = time_from_cm(CMSampleBufferGetDecodeTimeStamp(sample), packet->info.time);
+    packet->info.duration = time_from_cm(CMSampleBufferGetDuration(sample), 0);
+    packet->info.keyframe = keyframe;
+
+    pthread_mutex_lock(&encoder->lock);
+    free(encoder->config);
+    encoder->config = config;
+    encoder->config_size = config_size;
+    config = NULL;
+    pthread_mutex_unlock(&encoder->lock);
+
+done:
+    free(avcc);
+    free(config);
+    return packet;
+}
+
+static void video_output(void *refcon, void *frame_refcon, OSStatus status, VTEncodeInfoFlags flags,
+        CMSampleBufferRef sample)
+{
+    struct video_encoder *encoder = refcon;
+    struct packet *packet = NULL;
+
+    if (!status && sample && !(flags & kVTEncodeInfo_FrameDropped))
+        packet = video_packet(encoder, sample);
+
+    pthread_mutex_lock(&encoder->lock);
+    if (status && !encoder->error) encoder->error = status;
+    if (packet && !encoder->discard) queue_push(&encoder->packets, packet);
+    else if (packet)
+    {
+        free(packet->data);
+        free(packet);
+    }
+    if (encoder->pending) encoder->pending--;
+    pthread_cond_broadcast(&encoder->cond);
+    pthread_mutex_unlock(&encoder->lock);
+}
+
+static void set_property(VTCompressionSessionRef session, CFStringRef key, CFTypeRef value, const char *name)
+{
+    OSStatus status = VTSessionSetProperty(session, key, value);
+    if (status) log_trace("H.264 encoder ignored %s: %d", name, (int)status);
+}
+
+static void video_set_bitrate(struct video_encoder *encoder, uint32_t bitrate, uint32_t max_bitrate)
+{
+    VTCompressionSessionRef session = encoder->session;
+
+    if (bitrate)
+        set_property(session, kVTCompressionPropertyKey_AverageBitRate, (__bridge CFTypeRef)@(bitrate), "bitrate");
+    if (max_bitrate >= bitrate && max_bitrate)
+        set_property(session, kVTCompressionPropertyKey_DataRateLimits,
+                (__bridge CFTypeRef)@[@(max_bitrate / 8), @1.0], "peak bitrate");
+}
+
+static void *body_video_encoder_create(const struct macmf_video_settings *settings)
+{
+    struct video_encoder *encoder;
+    NSDictionary *specification, *source;
+    double frame_rate = 0.0;
+    CFStringRef profile;
+    uint32_t bitrate;
+    OSStatus status;
+
+    if (!settings->width || !settings->height) return NULL;
+    if (!(encoder = calloc(1, sizeof(*encoder)))) return NULL;
+    encoder->settings = *settings;
+    pthread_mutex_init(&encoder->lock, NULL);
+    pthread_cond_init(&encoder->cond, NULL);
+
+    if (settings->format == FORMAT_BGRA)
+        encoder->pixel_format = kCVPixelFormatType_32BGRA;
+    else
+        encoder->pixel_format = settings->full_range ? kCVPixelFormatType_420YpCbCr8BiPlanarFullRange
+                : kCVPixelFormatType_420YpCbCr8BiPlanarVideoRange;
+    encoder->matrix = settings->bt601 ? kCVImageBufferYCbCrMatrix_ITU_R_601_4 : kCVImageBufferYCbCrMatrix_ITU_R_709_2;
+
+    specification = @{(__bridge NSString *)kVTVideoEncoderSpecification_EnableHardwareAcceleratedVideoEncoder: @YES};
+    source = @{(__bridge NSString *)kCVPixelBufferPixelFormatTypeKey: @(encoder->pixel_format),
+               (__bridge NSString *)kCVPixelBufferWidthKey: @(settings->width),
+               (__bridge NSString *)kCVPixelBufferHeightKey: @(settings->height),
+               (__bridge NSString *)kCVPixelBufferIOSurfacePropertiesKey: @{}};
+    status = VTCompressionSessionCreate(kCFAllocatorDefault, settings->width, settings->height, kCMVideoCodecType_H264,
+            (__bridge CFDictionaryRef)specification, (__bridge CFDictionaryRef)source, kCFAllocatorDefault,
+            video_output, encoder, &encoder->session);
+    if (status)
+    {
+        log_error("Could not create the H.264 encoder (%ux%u): %d", settings->width, settings->height, (int)status);
+        macmf_video_encoder_destroy(encoder);
+        return NULL;
+    }
+
+    switch (settings->profile)
+    {
+        case 66: profile = kVTProfileLevel_H264_Baseline_AutoLevel; break;
+        case 77: profile = kVTProfileLevel_H264_Main_AutoLevel; break;
+        default: profile = kVTProfileLevel_H264_High_AutoLevel; break;
+    }
+    if (settings->frame_rate_num && settings->frame_rate_den)
+        frame_rate = (double)settings->frame_rate_num / settings->frame_rate_den;
+    if (frame_rate <= 0.0 || frame_rate > 480.0) frame_rate = 60.0;
+
+    set_property(encoder->session, kVTCompressionPropertyKey_ProfileLevel, profile, "profile");
+    set_property(encoder->session, kVTCompressionPropertyKey_RealTime,
+            settings->low_latency ? kCFBooleanTrue : kCFBooleanFalse, "real time");
+    set_property(encoder->session, kVTCompressionPropertyKey_AllowFrameReordering,
+            settings->b_frames ? kCFBooleanTrue : kCFBooleanFalse, "frame reordering");
+    set_property(encoder->session, kVTCompressionPropertyKey_ExpectedFrameRate,
+            (__bridge CFTypeRef)@(frame_rate), "frame rate");
+    if (settings->gop_size)
+        set_property(encoder->session, kVTCompressionPropertyKey_MaxKeyFrameInterval,
+                (__bridge CFTypeRef)@(settings->gop_size), "key frame interval");
+    else
+        set_property(encoder->session, kVTCompressionPropertyKey_MaxKeyFrameIntervalDuration,
+                (__bridge CFTypeRef)@2.0, "key frame interval duration");
+
+    bitrate = settings->bitrate;
+    if (!bitrate && settings->quality)
+        set_property(encoder->session, kVTCompressionPropertyKey_Quality,
+                (__bridge CFTypeRef)@(settings->quality / 100.0), "quality");
+    else
+    {
+        /* About what Windows' encoder picks when given nothing: 0.1 bit per pixel. */
+        if (!bitrate) bitrate = (uint32_t)fmin(4.0e9, settings->width * (double)settings->height * frame_rate * 0.1);
+        video_set_bitrate(encoder, bitrate, settings->max_bitrate);
+    }
+
+    set_property(encoder->session, kVTCompressionPropertyKey_ColorPrimaries,
+            kCVImageBufferColorPrimaries_ITU_R_709_2, "color primaries");
+    set_property(encoder->session, kVTCompressionPropertyKey_TransferFunction,
+            kCVImageBufferTransferFunction_ITU_R_709_2, "transfer function");
+    set_property(encoder->session, kVTCompressionPropertyKey_YCbCrMatrix, encoder->matrix, "matrix");
+
+    if ((status = VTCompressionSessionPrepareToEncodeFrames(encoder->session)))
+        log_trace("H.264 encoder could not prepare: %d", (int)status);
+
+    log_trace("H.264 encoder %ux%u at %.3f fps, %u bit/s, format %u, profile %u",
+            settings->width, settings->height, frame_rate, bitrate, settings->format, settings->profile);
+    return encoder;
+}
+
+static void body_video_encoder_destroy(void *object)
+{
+    struct video_encoder *encoder = object;
+
+    if (!encoder) return;
+    if (encoder->session)
+    {
+        VTCompressionSessionCompleteFrames(encoder->session, kCMTimeInvalid);
+        VTCompressionSessionInvalidate(encoder->session);
+        CFRelease(encoder->session);
+    }
+    queue_clear(&encoder->packets);
+    free(encoder->config);
+    pthread_cond_destroy(&encoder->cond);
+    pthread_mutex_destroy(&encoder->lock);
+    free(encoder);
+}
+
+static int in_bounds(const uint8_t *buffer, uint64_t size, const uint8_t *start, int64_t stride,
+        uint32_t rows, uint64_t row_bytes)
+{
+    const uint8_t *first = start, *last = start;
+
+    if (!rows) return 1;
+    if (stride >= 0) last = start + stride * (int64_t)(rows - 1);
+    else first = start + stride * (int64_t)(rows - 1);
+    return first >= buffer && last + row_bytes <= buffer + size && first <= last;
+}
+
+static void copy_rows(uint8_t *dst, size_t dst_stride, const uint8_t *src, int64_t src_stride,
+        uint32_t rows, size_t bytes)
+{
+    uint32_t y;
+
+    for (y = 0; y < rows; ++y)
+        memcpy(dst + y * dst_stride, src + y * src_stride, bytes);
+}
+
+/* Fills the encoder's pixel buffer from the client's frame. */
+static int fill_pixels(struct video_encoder *encoder, CVPixelBufferRef pixels, const uint8_t *data,
+        int64_t stride, const uint8_t *buffer, uint64_t size)
+{
+    uint32_t width = encoder->settings.width, height = encoder->settings.height, x, y;
+    uint32_t chroma_width = (width + 1) / 2, chroma_height = (height + 1) / 2;
+    const uint8_t *u, *v, *row0, *row1;
+    uint8_t *dst, *dst_uv;
+    size_t dst_stride, dst_uv_stride;
+    int64_t chroma_stride;
+
+    if (CVPixelBufferLockBaseAddress(pixels, 0)) return 0;
+
+    if (encoder->settings.format == FORMAT_BGRA)
+    {
+        if (!in_bounds(buffer, size, data, stride, height, (uint64_t)width * 4)) goto bounds;
+        copy_rows(CVPixelBufferGetBaseAddress(pixels), CVPixelBufferGetBytesPerRow(pixels), data, stride,
+                height, (size_t)width * 4);
+        CVPixelBufferUnlockBaseAddress(pixels, 0);
+        return 1;
+    }
+
+    /* Planar layouts are top-down with the chroma planes after the luma plane. */
+    if (stride <= 0) goto bounds;
+    dst = CVPixelBufferGetBaseAddressOfPlane(pixels, 0);
+    dst_stride = CVPixelBufferGetBytesPerRowOfPlane(pixels, 0);
+    dst_uv = CVPixelBufferGetBaseAddressOfPlane(pixels, 1);
+    dst_uv_stride = CVPixelBufferGetBytesPerRowOfPlane(pixels, 1);
+
+    switch (encoder->settings.format)
+    {
+    case FORMAT_NV12:
+        if (!in_bounds(buffer, size, data, stride, height, width)
+                || !in_bounds(buffer, size, data + stride * height, stride, chroma_height, chroma_width * 2))
+            goto bounds;
+        copy_rows(dst, dst_stride, data, stride, height, width);
+        copy_rows(dst_uv, dst_uv_stride, data + stride * height, stride, chroma_height, chroma_width * 2);
+        break;
+
+    case FORMAT_I420:
+    case FORMAT_YV12:
+        chroma_stride = stride / 2;
+        u = data + stride * height;
+        v = u + chroma_stride * chroma_height;
+        if (encoder->settings.format == FORMAT_YV12)
+        {
+            const uint8_t *swap = u;
+            u = v;
+            v = swap;
+        }
+        if (!in_bounds(buffer, size, data, stride, height, width)
+                || !in_bounds(buffer, size, u, chroma_stride, chroma_height, chroma_width)
+                || !in_bounds(buffer, size, v, chroma_stride, chroma_height, chroma_width))
+            goto bounds;
+        copy_rows(dst, dst_stride, data, stride, height, width);
+        for (y = 0; y < chroma_height; ++y)
+        {
+            uint8_t *out = dst_uv + y * dst_uv_stride;
+            const uint8_t *u_row = u + y * chroma_stride, *v_row = v + y * chroma_stride;
+
+            for (x = 0; x < chroma_width; ++x)
+            {
+                out[2 * x] = u_row[x];
+                out[2 * x + 1] = v_row[x];
+            }
+        }
+        break;
+
+    case FORMAT_YUY2:
+        if (!in_bounds(buffer, size, data, stride, height, (uint64_t)chroma_width * 4)) goto bounds;
+        for (y = 0; y < height; ++y)
+        {
+            const uint8_t *in = data + stride * y;
+            uint8_t *out = dst + y * dst_stride;
+
+            for (x = 0; x < width; ++x) out[x] = in[2 * x];
+        }
+        for (y = 0; y < chroma_height; ++y)
+        {
+            uint8_t *out = dst_uv + y * dst_uv_stride;
+
+            row0 = data + stride * (2 * y);
+            row1 = (2 * y + 1 < height) ? row0 + stride : row0;
+            for (x = 0; x < chroma_width; ++x)
+            {
+                out[2 * x] = (row0[4 * x + 1] + row1[4 * x + 1] + 1) / 2;
+                out[2 * x + 1] = (row0[4 * x + 3] + row1[4 * x + 3] + 1) / 2;
+            }
+        }
+        break;
+
+    default:
+        goto bounds;
+    }
+
+    CVPixelBufferUnlockBaseAddress(pixels, 0);
+    return 1;
+
+bounds:
+    CVPixelBufferUnlockBaseAddress(pixels, 0);
+    log_error("Video frame does not fit its buffer (%ux%u, stride %lld, %llu bytes)",
+            width, height, (long long)stride, (unsigned long long)size);
+    return 0;
+}
+
+static int body_video_encoder_encode(void *object, const uint8_t *data, int64_t stride,
+        const uint8_t *buffer, uint64_t size, int64_t time, int64_t duration, int keyframe)
+{
+    struct video_encoder *encoder = object;
+    CVPixelBufferPoolRef pool;
+    CVPixelBufferRef pixels = NULL;
+    NSDictionary *options = nil;
+    VTEncodeInfoFlags flags = 0;
+    struct timespec deadline;
+    OSStatus status;
+
+    pthread_mutex_lock(&encoder->lock);
+    while (encoder->pending >= VIDEO_PENDING_LIMIT && !encoder->error)
+    {
+        clock_gettime(CLOCK_REALTIME, &deadline);
+        deadline.tv_sec += 1;
+        pthread_cond_timedwait(&encoder->cond, &encoder->lock, &deadline);
+    }
+    status = encoder->error;
+    video_report(encoder);
+    pthread_mutex_unlock(&encoder->lock);
+    if (status) return MACMF_ERROR;
+
+    if ((pool = VTCompressionSessionGetPixelBufferPool(encoder->session)))
+        status = CVPixelBufferPoolCreatePixelBuffer(kCFAllocatorDefault, pool, &pixels);
+    else
+        status = kCVReturnInvalidPixelBufferAttributes;
+    if (status)
+    {
+        NSDictionary *attributes = @{(__bridge NSString *)kCVPixelBufferIOSurfacePropertiesKey: @{}};
+        status = CVPixelBufferCreate(kCFAllocatorDefault, encoder->settings.width, encoder->settings.height,
+                encoder->pixel_format, (__bridge CFDictionaryRef)attributes, &pixels);
+    }
+    if (status || !pixels)
+    {
+        log_error("No pixel buffer for the H.264 encoder: %d", (int)status);
+        return MACMF_ERROR;
+    }
+    if (!fill_pixels(encoder, pixels, data, stride, buffer, size))
+    {
+        CVPixelBufferRelease(pixels);
+        return MACMF_ERROR;
+    }
+    if (encoder->pixel_format != kCVPixelFormatType_32BGRA)
+    {
+        CVBufferSetAttachment(pixels, kCVImageBufferYCbCrMatrixKey, encoder->matrix, kCVAttachmentMode_ShouldPropagate);
+        CVBufferSetAttachment(pixels, kCVImageBufferColorPrimariesKey, kCVImageBufferColorPrimaries_ITU_R_709_2,
+                kCVAttachmentMode_ShouldPropagate);
+        CVBufferSetAttachment(pixels, kCVImageBufferTransferFunctionKey, kCVImageBufferTransferFunction_ITU_R_709_2,
+                kCVAttachmentMode_ShouldPropagate);
+    }
+    if (keyframe) options = @{(__bridge NSString *)kVTEncodeFrameOptionKey_ForceKeyFrame: @YES};
+
+    pthread_mutex_lock(&encoder->lock);
+    encoder->pending++;
+    pthread_mutex_unlock(&encoder->lock);
+
+    status = VTCompressionSessionEncodeFrame(encoder->session, pixels, mf_time(time),
+            duration > 0 ? mf_time(duration) : kCMTimeInvalid, (__bridge CFDictionaryRef)options, NULL, &flags);
+    CVPixelBufferRelease(pixels);
+    if (status)
+    {
+        pthread_mutex_lock(&encoder->lock);
+        if (encoder->pending) encoder->pending--;
+        if (!encoder->error) encoder->error = status;
+        pthread_mutex_unlock(&encoder->lock);
+        log_error("H.264 encoder refused a frame: %d", (int)status);
+        return MACMF_ERROR;
+    }
+    return MACMF_OK;
+}
+
+static int body_video_encoder_set_bitrate(void *object, uint32_t bitrate, uint32_t max_bitrate)
+{
+    struct video_encoder *encoder = object;
+
+    video_set_bitrate(encoder, bitrate, max_bitrate);
+    return MACMF_OK;
+}
+
+static int body_video_encoder_drain(void *object)
+{
+    struct video_encoder *encoder = object;
+    OSStatus status = VTCompressionSessionCompleteFrames(encoder->session, kCMTimeInvalid);
+    struct timespec deadline;
+
+    pthread_mutex_lock(&encoder->lock);
+    while (encoder->pending && !encoder->error)
+    {
+        clock_gettime(CLOCK_REALTIME, &deadline);
+        deadline.tv_sec += 1;
+        if (pthread_cond_timedwait(&encoder->cond, &encoder->lock, &deadline)) break;
+    }
+    if (!status) status = encoder->error;
+    video_report(encoder);
+    pthread_mutex_unlock(&encoder->lock);
+    if (status) log_error("H.264 encoder could not finish its frames: %d", (int)status);
+    return status ? MACMF_ERROR : MACMF_OK;
+}
+
+static void body_video_encoder_flush(void *object)
+{
+    struct video_encoder *encoder = object;
+
+    pthread_mutex_lock(&encoder->lock);
+    encoder->discard = 1;
+    pthread_mutex_unlock(&encoder->lock);
+    VTCompressionSessionCompleteFrames(encoder->session, kCMTimeInvalid);
+    pthread_mutex_lock(&encoder->lock);
+    queue_clear(&encoder->packets);
+    encoder->pending = 0;
+    encoder->discard = 0;
+    pthread_mutex_unlock(&encoder->lock);
+}
+
+static int body_video_encoder_read(void *object, uint8_t *data, uint32_t capacity, struct macmf_packet_info *info)
+{
+    struct video_encoder *encoder = object;
+    int ret;
+
+    pthread_mutex_lock(&encoder->lock);
+    ret = queue_read(&encoder->packets, data, capacity, info);
+    if (ret == MACMF_NONE && encoder->error) ret = MACMF_ERROR;
+    video_report(encoder);
+    pthread_mutex_unlock(&encoder->lock);
+    return ret;
+}
+
+static int body_video_encoder_config(void *object, uint8_t *data, uint32_t capacity, uint32_t *size)
+{
+    struct video_encoder *encoder = object;
+    int ret = MACMF_NONE;
+
+    pthread_mutex_lock(&encoder->lock);
+    if (encoder->config)
+    {
+        *size = encoder->config_size;
+        if (!data || capacity < encoder->config_size) ret = MACMF_TOO_SMALL;
+        else
+        {
+            memcpy(data, encoder->config, encoder->config_size);
+            ret = MACMF_OK;
+        }
+    }
+    pthread_mutex_unlock(&encoder->lock);
+    return ret;
+}
+
+/* ------------------------------------------------------------------------ */
+/* AAC encoder                                                               */
+/* ------------------------------------------------------------------------ */
+
+/* The input procedure's answer when it has nothing more for now. */
+#define NEED_MORE_INPUT 'mmfn'
+
+struct audio_encoder
+{
+    AudioConverterRef converter;
+    AudioStreamBasicDescription input;
+    uint32_t channels;
+    uint8_t *fifo;              /* PCM not yet handed to the converter */
+    size_t fifo_used;
+    size_t fifo_capacity;
+    uint8_t *lent;              /* PCM the converter is reading */
+    size_t lent_capacity;
+    int draining;
+    uint8_t *output;
+    uint32_t max_packet_size;
+    struct packet_queue packets;
+};
+
+static OSStatus audio_input(AudioConverterRef converter, UInt32 *packets, AudioBufferList *data,
+        AudioStreamPacketDescription **descriptions, void *user)
+{
+    struct audio_encoder *encoder = user;
+    size_t frame = encoder->input.mBytesPerFrame, available = encoder->fifo_used / frame, bytes;
+
+    if (descriptions) *descriptions = NULL;
+    if (!available)
+    {
+        *packets = 0;
+        data->mBuffers[0].mData = NULL;
+        data->mBuffers[0].mDataByteSize = 0;
+        return encoder->draining ? noErr : NEED_MORE_INPUT;
+    }
+    if (*packets > available) *packets = (UInt32)available;
+    bytes = *packets * frame;
+    if (bytes > encoder->lent_capacity)
+    {
+        uint8_t *lent = realloc(encoder->lent, bytes);
+        if (!lent)
+        {
+            *packets = 0;
+            return kAudio_MemFullError;
+        }
+        encoder->lent = lent;
+        encoder->lent_capacity = bytes;
+    }
+    /* The converter may read this until it calls again, so it gets its own copy. */
+    memcpy(encoder->lent, encoder->fifo, bytes);
+    memmove(encoder->fifo, encoder->fifo + bytes, encoder->fifo_used - bytes);
+    encoder->fifo_used -= bytes;
+
+    data->mNumberBuffers = 1;
+    data->mBuffers[0].mNumberChannels = encoder->channels;
+    data->mBuffers[0].mData = encoder->lent;
+    data->mBuffers[0].mDataByteSize = (UInt32)bytes;
+    return noErr;
+}
+
+/* Encodes everything the converter can make from the PCM it has. */
+static int audio_pump(struct audio_encoder *encoder)
+{
+    AudioStreamPacketDescription description;
+    AudioBufferList output;
+    struct packet *packet;
+    OSStatus status;
+    UInt32 count;
+
+    for (;;)
+    {
+        count = 1;
+        output.mNumberBuffers = 1;
+        output.mBuffers[0].mNumberChannels = encoder->channels;
+        output.mBuffers[0].mDataByteSize = encoder->max_packet_size;
+        output.mBuffers[0].mData = encoder->output;
+        memset(&description, 0, sizeof(description));
+        status = AudioConverterFillComplexBuffer(encoder->converter, audio_input, encoder, &count, &output, &description);
+        if (count)
+        {
+            uint32_t size = description.mDataByteSize ? description.mDataByteSize : output.mBuffers[0].mDataByteSize;
+            uint32_t start = (uint32_t)description.mStartOffset;
+
+            if (start + size > encoder->max_packet_size) return MACMF_ERROR;
+            if (!(packet = calloc(1, sizeof(*packet))) || !(packet->data = malloc(size ? size : 1)))
+            {
+                free(packet);
+                return MACMF_ERROR;
+            }
+            memcpy(packet->data, encoder->output + start, size);
+            packet->info.size = size;
+            packet->info.keyframe = 1;
+            queue_push(&encoder->packets, packet);
+        }
+        if (status == NEED_MORE_INPUT || (!status && !count)) return MACMF_OK;
+        if (status)
+        {
+            log_error("AAC encoder failed: %d", (int)status);
+            return MACMF_ERROR;
+        }
+    }
+}
+
+static int aac_frequency_index(uint32_t rate)
+{
+    static const uint32_t rates[] = {96000, 88200, 64000, 48000, 44100, 32000, 24000, 22050, 16000, 12000, 11025, 8000, 7350};
+    int i;
+
+    for (i = 0; i < (int)(sizeof(rates) / sizeof(rates[0])); ++i)
+        if (rates[i] == rate) return i;
+    return -1;
+}
+
+/* AudioSpecificConfig for AAC-LC, the one object type this encoder makes. */
+static uint32_t aac_config(uint32_t rate, uint32_t channels, uint8_t *config)
+{
+    int index = aac_frequency_index(rate);
+    uint32_t channel_config = channels == 8 ? 7 : channels;
+
+    if (index < 0) return 0;
+    config[0] = (2 << 3) | (index >> 1);
+    config[1] = ((index & 1) << 7) | (channel_config << 3);
+    return 2;
+}
+
+static void audio_set_layouts(AudioConverterRef converter, uint32_t channels)
+{
+    AudioChannelLayout input = {0}, output = {0};
+
+    if (channels == 6)
+    {
+        input.mChannelLayoutTag = kAudioChannelLayoutTag_MPEG_5_1_A;
+        output.mChannelLayoutTag = kAudioChannelLayoutTag_AAC_5_1;
+    }
+    else if (channels == 8)
+    {
+        input.mChannelLayoutTag = kAudioChannelLayoutTag_MPEG_7_1_C;
+        output.mChannelLayoutTag = kAudioChannelLayoutTag_AAC_7_1;
+    }
+    else return;
+    AudioConverterSetProperty(converter, kAudioConverterInputChannelLayout, sizeof(input), &input);
+    AudioConverterSetProperty(converter, kAudioConverterOutputChannelLayout, sizeof(output), &output);
+}
+
+static void audio_set_bitrate(AudioConverterRef converter, uint32_t channels, uint32_t bitrate)
+{
+    AudioValueRange *ranges = NULL;
+    UInt32 value, size = 0, i, count;
+    double best = -1.0, distance;
+
+    if (!bitrate) bitrate = channels <= 1 ? 96000 : channels == 2 ? 192000 : 64000 * channels;
+    value = bitrate;
+    if (!AudioConverterSetProperty(converter, kAudioConverterEncodeBitRate, sizeof(value), &value)) return;
+
+    /* Take the nearest rate the encoder offers for this format. */
+    if (AudioConverterGetPropertyInfo(converter, kAudioConverterApplicableEncodeBitRates, &size, NULL) || !size) return;
+    if (!(ranges = malloc(size))) return;
+    if (!AudioConverterGetProperty(converter, kAudioConverterApplicableEncodeBitRates, &size, ranges))
+    {
+        count = size / sizeof(*ranges);
+        for (i = 0; i < count; ++i)
+        {
+            double candidate = fmin(fmax(bitrate, ranges[i].mMinimum), ranges[i].mMaximum);
+            distance = fabs(candidate - bitrate);
+            if (best < 0.0 || distance < fabs(best - bitrate)) best = candidate;
+        }
+        if (best > 0.0)
+        {
+            value = (UInt32)best;
+            AudioConverterSetProperty(converter, kAudioConverterEncodeBitRate, sizeof(value), &value);
+        }
+    }
+    free(ranges);
+}
+
+static void *body_audio_encoder_create(uint32_t input_rate, uint32_t channels, uint32_t format, uint32_t output_rate,
+        uint32_t bitrate, uint32_t *priming, uint8_t *config, uint32_t *config_size)
+{
+    AudioStreamBasicDescription output = {0};
+    struct audio_encoder *encoder;
+    AudioConverterPrimeInfo prime = {0};
+    UInt32 size, bytes;
+    OSStatus status;
+
+    if (!input_rate || !output_rate || !(channels == 1 || channels == 2 || channels == 6 || channels == 8))
+        return NULL;
+    if (aac_frequency_index(output_rate) < 0) return NULL;
+    if (!(encoder = calloc(1, sizeof(*encoder)))) return NULL;
+    encoder->channels = channels;
+
+    switch (format)
+    {
+        case AUDIO_S16: bytes = 2; encoder->input.mFormatFlags = kLinearPCMFormatFlagIsSignedInteger; break;
+        case AUDIO_S24: bytes = 3; encoder->input.mFormatFlags = kLinearPCMFormatFlagIsSignedInteger; break;
+        case AUDIO_S32: bytes = 4; encoder->input.mFormatFlags = kLinearPCMFormatFlagIsSignedInteger; break;
+        case AUDIO_F32: bytes = 4; encoder->input.mFormatFlags = kLinearPCMFormatFlagIsFloat; break;
+        default: free(encoder); return NULL;
+    }
+    encoder->input.mFormatFlags |= kLinearPCMFormatFlagIsPacked;
+    encoder->input.mSampleRate = input_rate;
+    encoder->input.mFormatID = kAudioFormatLinearPCM;
+    encoder->input.mChannelsPerFrame = channels;
+    encoder->input.mBitsPerChannel = bytes * 8;
+    encoder->input.mFramesPerPacket = 1;
+    encoder->input.mBytesPerFrame = bytes * channels;
+    encoder->input.mBytesPerPacket = bytes * channels;
+
+    output.mSampleRate = output_rate;
+    output.mFormatID = kAudioFormatMPEG4AAC;
+    output.mFormatFlags = kMPEG4Object_AAC_LC;
+    output.mChannelsPerFrame = channels;
+    output.mFramesPerPacket = 1024;
+
+    if ((status = AudioConverterNew(&encoder->input, &output, &encoder->converter)))
+    {
+        log_error("Could not create the AAC encoder (%u Hz, %u channels): %d", output_rate, channels, (int)status);
+        free(encoder);
+        return NULL;
+    }
+    audio_set_layouts(encoder->converter, channels);
+    audio_set_bitrate(encoder->converter, channels, bitrate);
+
+    size = sizeof(encoder->max_packet_size);
+    if (AudioConverterGetProperty(encoder->converter, kAudioConverterPropertyMaximumOutputPacketSize,
+            &size, &encoder->max_packet_size) || !encoder->max_packet_size)
+        encoder->max_packet_size = 6144 * channels / 8 + 64;
+    if (!(encoder->output = malloc(encoder->max_packet_size)))
+    {
+        macmf_audio_encoder_destroy(encoder);
+        return NULL;
+    }
+
+    size = sizeof(prime);
+    if (AudioConverterGetProperty(encoder->converter, kAudioConverterPrimeInfo, &size, &prime))
+        prime.leadingFrames = 2112;
+    *priming = prime.leadingFrames;
+    *config_size = aac_config(output_rate, channels, config);
+
+    size = sizeof(bytes);
+    if (!AudioConverterGetProperty(encoder->converter, kAudioConverterEncodeBitRate, &size, &bytes))
+        log_trace("AAC encoder %u Hz -> %u Hz, %u channels, %u bit/s, priming %u",
+                input_rate, output_rate, channels, (unsigned int)bytes, *priming);
+    return encoder;
+}
+
+static void body_audio_encoder_destroy(void *object)
+{
+    struct audio_encoder *encoder = object;
+
+    if (!encoder) return;
+    if (encoder->converter) AudioConverterDispose(encoder->converter);
+    queue_clear(&encoder->packets);
+    free(encoder->fifo);
+    free(encoder->lent);
+    free(encoder->output);
+    free(encoder);
+}
+
+static int body_audio_encoder_encode(void *object, const uint8_t *data, uint32_t size)
+{
+    struct audio_encoder *encoder = object;
+    size_t needed = encoder->fifo_used + size;
+
+    if (needed > encoder->fifo_capacity)
+    {
+        size_t capacity = encoder->fifo_capacity ? encoder->fifo_capacity : 65536;
+        uint8_t *fifo;
+
+        while (capacity < needed) capacity *= 2;
+        if (!(fifo = realloc(encoder->fifo, capacity))) return MACMF_ERROR;
+        encoder->fifo = fifo;
+        encoder->fifo_capacity = capacity;
+    }
+    memcpy(encoder->fifo + encoder->fifo_used, data, size);
+    encoder->fifo_used += size;
+    return audio_pump(encoder);
+}
+
+static int body_audio_encoder_drain(void *object)
+{
+    struct audio_encoder *encoder = object;
+    int ret;
+
+    encoder->draining = 1;
+    ret = audio_pump(encoder);
+    encoder->draining = 0;
+    /* The converter has ended its stream; the next input starts a new one. */
+    AudioConverterReset(encoder->converter);
+    encoder->fifo_used = 0;
+    return ret;
+}
+
+static void body_audio_encoder_flush(void *object)
+{
+    struct audio_encoder *encoder = object;
+
+    AudioConverterReset(encoder->converter);
+    encoder->fifo_used = 0;
+    queue_clear(&encoder->packets);
+}
+
+static int body_audio_encoder_read(void *object, uint8_t *data, uint32_t capacity, struct macmf_packet_info *info)
+{
+    struct audio_encoder *encoder = object;
+
+    return queue_read(&encoder->packets, data, capacity, info);
+}
+
+/* ------------------------------------------------------------------------ */
+/* MPEG-4 writer                                                             */
+/* ------------------------------------------------------------------------ */
+
+/* Media before the first track has samples is kept until every track has one,
+ * up to this much, so each gets its format before writing starts. */
+#define MUXER_WAIT_LIMIT (3 * (int64_t)MF_TIMESCALE)
+
+@interface MacmfTrack : NSObject
+{
+@public
+    int type;
+    uint32_t width, height, sample_rate, channels, priming;
+    NSData *config;
+    CMFormatDescriptionRef format;
+    AVAssetWriterInput *input;
+    dispatch_queue_t queue;
+    NSMutableArray *waiting;
+    BOOL has_first;
+    int64_t first_time;
+    int64_t last_time;
+    unsigned int written;
+    unsigned int failed;
+    NSString *failure;
+}
+@end
+
+@implementation MacmfTrack
+- (void)dealloc
+{
+    if (format) CFRelease(format);
+}
+@end
+
+@interface MacmfMuxer : NSObject
+{
+@public
+    NSString *directory;
+    NSString *path;
+    NSMutableArray<MacmfTrack *> *tracks;
+    AVAssetWriter *writer;
+    BOOL started;
+    BOOL failed;
+    NSLock *lock;
+}
+@end
+
+@implementation MacmfMuxer
+@end
+
+static const uint8_t *next_start_code(const uint8_t *data, const uint8_t *end, int *code_size)
+{
+    const uint8_t *p;
+
+    for (p = data; p + 3 <= end; ++p)
+    {
+        if (p[0] || p[1]) continue;
+        if (p[2] == 1)
+        {
+            *code_size = 3;
+            return p;
+        }
+        if (p + 4 <= end && !p[2] && p[3] == 1)
+        {
+            *code_size = 4;
+            return p;
+        }
+    }
+    return end;
+}
+
+/* Calls back with each NAL unit of an Annex B access unit. */
+static void annexb_units(const uint8_t *data, uint32_t size, void (^unit)(const uint8_t *nal, uint32_t length))
+{
+    const uint8_t *end = data + size, *start, *next;
+    int code_size = 0, next_size = 0;
+
+    start = next_start_code(data, end, &code_size);
+    while (start < end)
+    {
+        start += code_size;
+        next = next_start_code(start, end, &next_size);
+        if (next > start) unit(start, (uint32_t)(next - start));
+        start = next;
+        code_size = next_size;
+    }
+}
+
+static CMFormatDescriptionRef h264_format(const uint8_t *data, uint32_t size)
+{
+    __block NSData *sps = nil, *pps = nil;
+    CMFormatDescriptionRef format = NULL;
+    const uint8_t *sets[2];
+    size_t sizes[2];
+    OSStatus status;
+
+    annexb_units(data, size, ^(const uint8_t *nal, uint32_t length) {
+        int type = nal[0] & 0x1f;
+        if (type == 7 && !sps) sps = [NSData dataWithBytes:nal length:length];
+        else if (type == 8 && !pps) pps = [NSData dataWithBytes:nal length:length];
+    });
+    if (!sps || !pps) return NULL;
+    sets[0] = sps.bytes;
+    sizes[0] = sps.length;
+    sets[1] = pps.bytes;
+    sizes[1] = pps.length;
+    if ((status = CMVideoFormatDescriptionCreateFromH264ParameterSets(kCFAllocatorDefault, 2, sets, sizes, 4, &format)))
+    {
+        log_error("Unusable H.264 parameter sets: %d", (int)status);
+        return NULL;
+    }
+    return format;
+}
+
+static void put_descriptor(NSMutableData *data, uint8_t tag, NSData *body)
+{
+    uint8_t header[2] = {tag, (uint8_t)body.length};
+
+    [data appendBytes:header length:2];
+    [data appendData:body];
+}
+
+/* The magic cookie Core Media wants for AAC: an MPEG-4 ES descriptor holding
+ * the AudioSpecificConfig. */
+static NSData *aac_cookie(NSData *config, uint32_t channels)
+{
+    NSMutableData *decoder = [NSMutableData data], *es = [NSMutableData data], *cookie = [NSMutableData data];
+    uint32_t buffer = 6144 * channels / 8;
+    uint8_t fields[13] = {0x40, 0x15, (uint8_t)(buffer >> 16), (uint8_t)(buffer >> 8), (uint8_t)buffer, 0, 0, 0, 0, 0, 0, 0, 0};
+    uint8_t es_header[3] = {0, 0, 0}, sl = 2;
+
+    [decoder appendBytes:fields length:sizeof(fields)];
+    put_descriptor(decoder, 0x05, config);
+    [es appendBytes:es_header length:sizeof(es_header)];
+    put_descriptor(es, 0x04, decoder);
+    put_descriptor(es, 0x06, [NSData dataWithBytes:&sl length:1]);
+    put_descriptor(cookie, 0x03, es);
+    return cookie;
+}
+
+static CMFormatDescriptionRef aac_format(MacmfTrack *track)
+{
+    AudioStreamBasicDescription description = {0};
+    CMFormatDescriptionRef format = NULL;
+    AudioChannelLayout layout = {0};
+    NSData *cookie;
+    OSStatus status;
+
+    if (!track->config.length) return NULL;
+    description.mSampleRate = track->sample_rate;
+    description.mFormatID = kAudioFormatMPEG4AAC;
+    description.mFormatFlags = kMPEG4Object_AAC_LC;
+    description.mFramesPerPacket = 1024;
+    description.mChannelsPerFrame = track->channels;
+    switch (track->channels)
+    {
+        case 1: layout.mChannelLayoutTag = kAudioChannelLayoutTag_Mono; break;
+        case 2: layout.mChannelLayoutTag = kAudioChannelLayoutTag_Stereo; break;
+        case 6: layout.mChannelLayoutTag = kAudioChannelLayoutTag_AAC_5_1; break;
+        case 8: layout.mChannelLayoutTag = kAudioChannelLayoutTag_AAC_7_1; break;
+    }
+    cookie = aac_cookie(track->config, track->channels);
+    status = CMAudioFormatDescriptionCreate(kCFAllocatorDefault, &description,
+            layout.mChannelLayoutTag ? sizeof(layout) : 0, layout.mChannelLayoutTag ? &layout : NULL,
+            cookie.length, cookie.bytes, NULL, &format);
+    if (status) log_error("Unusable AAC configuration: %d", (int)status);
+    return format;
+}
+
+static CMSampleBufferRef h264_sample(MacmfTrack *track, const uint8_t *data, uint32_t size,
+        int64_t time, int64_t decode_time, int64_t duration, int keyframe)
+{
+    NSMutableData *avcc = [NSMutableData dataWithCapacity:size + 16];
+    CMSampleTimingInfo timing;
+    CMBlockBufferRef block = NULL;
+    CMSampleBufferRef sample = NULL;
+    size_t sample_size;
+    void *memory;
+
+    annexb_units(data, size, ^(const uint8_t *nal, uint32_t length) {
+        int type = nal[0] & 0x1f;
+        uint8_t prefix[4] = {(uint8_t)(length >> 24), (uint8_t)(length >> 16), (uint8_t)(length >> 8), (uint8_t)length};
+
+        /* Parameter sets live in the format description; delimiters and filler are dropped. */
+        if (type == 7 || type == 8 || type == 9 || type == 12) return;
+        [avcc appendBytes:prefix length:4];
+        [avcc appendBytes:nal length:length];
+    });
+    if (!avcc.length) return NULL;
+
+    sample_size = avcc.length;
+    if (!(memory = malloc(sample_size))) return NULL;
+    memcpy(memory, avcc.bytes, sample_size);
+    if (CMBlockBufferCreateWithMemoryBlock(kCFAllocatorDefault, memory, sample_size, kCFAllocatorMalloc, NULL,
+            0, sample_size, 0, &block))
+    {
+        free(memory);
+        return NULL;
+    }
+    timing.presentationTimeStamp = mf_time(time);
+    timing.decodeTimeStamp = decode_time == INT64_MIN ? kCMTimeInvalid : mf_time(decode_time);
+    timing.duration = duration > 0 ? mf_time(duration) : kCMTimeInvalid;
+    if (CMSampleBufferCreateReady(kCFAllocatorDefault, block, track->format, 1, 1, &timing, 1, &sample_size, &sample))
+        sample = NULL;
+    CFRelease(block);
+    if (sample)
+    {
+        CFArrayRef attachments = CMSampleBufferGetSampleAttachmentsArray(sample, true);
+        CFMutableDictionaryRef dict = (CFMutableDictionaryRef)CFArrayGetValueAtIndex(attachments, 0);
+
+        CFDictionarySetValue(dict, kCMSampleAttachmentKey_NotSync, keyframe ? kCFBooleanFalse : kCFBooleanTrue);
+        CFDictionarySetValue(dict, kCMSampleAttachmentKey_DependsOnOthers, keyframe ? kCFBooleanFalse : kCFBooleanTrue);
+    }
+    return sample;
+}
+
+static CMSampleBufferRef aac_sample(MacmfTrack *track, const uint8_t *data, uint32_t size, int64_t time,
+        int64_t duration)
+{
+    AudioStreamPacketDescription description = {0, 0, size};
+    CMBlockBufferRef block = NULL;
+    CMSampleBufferRef sample = NULL;
+    void *memory;
+
+    if (!size || !(memory = malloc(size))) return NULL;
+    memcpy(memory, data, size);
+    if (CMBlockBufferCreateWithMemoryBlock(kCFAllocatorDefault, memory, size, kCFAllocatorMalloc, NULL,
+            0, size, 0, &block))
+    {
+        free(memory);
+        return NULL;
+    }
+    /* Presentation in the track's own sample rate keeps every frame exactly 1024 long. */
+    if (CMAudioSampleBufferCreateReadyWithPacketDescriptions(kCFAllocatorDefault, block, track->format, 1,
+            CMTimeConvertScale(mf_time(time), track->sample_rate, kCMTimeRoundingMethod_RoundHalfAwayFromZero),
+            &description, &sample))
+        sample = NULL;
+    CFRelease(block);
+    /* The encoder gives its last frame the length of the sound it holds; the rest is padding. */
+    if (sample && duration > 0)
+    {
+        int64_t frames = (duration * track->sample_rate + MF_TIMESCALE / 2) / MF_TIMESCALE;
+
+        if (frames < 1024)
+        {
+            CFDictionaryRef trim = CMTimeCopyAsDictionary(CMTimeMake(1024 - frames, track->sample_rate),
+                    kCFAllocatorDefault);
+            CMSetAttachment(sample, kCMSampleBufferAttachmentKey_TrimDurationAtEnd, trim, kCMAttachmentMode_ShouldPropagate);
+            CFRelease(trim);
+        }
+    }
+    return sample;
+}
+
+static void append_sample(MacmfMuxer *muxer, MacmfTrack *track, id sample)
+{
+    dispatch_async(track->queue, ^{
+        AVAssetWriterInput *input = track->input;
+        AVAssetWriter *writer = muxer->writer;
+
+        if (!input) return;
+        /* The writer interleaves its tracks and holds one back until the others catch up. */
+        while (!input.readyForMoreMediaData)
+        {
+            if (writer.status != AVAssetWriterStatusWriting) return;
+            usleep(1000);
+        }
+        if (writer.status != AVAssetWriterStatusWriting) return;
+        /* This runs on a dispatch thread, which must not log through Wine. */
+        @try
+        {
+            if ([input appendSampleBuffer:(__bridge CMSampleBufferRef)sample]) track->written++;
+            else if (!track->failed++) track->failure = writer.error.description ?: @"unknown error";
+        }
+        @catch (NSException *exception)
+        {
+            if (!track->failed++) track->failure = exception.reason ?: @"exception";
+        }
+    });
+}
+
+/* Creates the writer once each track has its format, or once waiting is pointless. */
+static BOOL muxer_start_body(MacmfMuxer *muxer, BOOL force);
+
+/* AVFoundation reports misuse with exceptions; in a game they would end the process. */
+static BOOL muxer_start(MacmfMuxer *muxer, BOOL force)
+{
+    @try
+    {
+        return muxer_start_body(muxer, force);
+    }
+    @catch (NSException *exception)
+    {
+        log_error("MPEG-4 writer could not start: %s", exception.reason.UTF8String);
+        muxer->failed = YES;
+        return NO;
+    }
+}
+
+static BOOL muxer_start_body(MacmfMuxer *muxer, BOOL force)
+{
+    int64_t start = INT64_MAX, earliest = INT64_MAX, latest = INT64_MIN;
+    MacmfTrack *video = nil;
+    NSURL *url;
+    NSError *error = nil;
+    BOOL waiting = NO;
+
+    for (MacmfTrack *track in muxer->tracks)
+    {
+        if (!track->has_first)
+        {
+            waiting = YES;
+            continue;
+        }
+        if (track->type == TRACK_H264 && !video) video = track;
+        if (track->first_time < earliest) earliest = track->first_time;
+        if (track->last_time > latest) latest = track->last_time;
+    }
+    if (earliest == INT64_MAX) return NO;
+    if (waiting && !force && latest - earliest < MUXER_WAIT_LIMIT) return NO;
+
+    url = [NSURL fileURLWithPath:muxer->path];
+    muxer->writer = [[AVAssetWriter alloc] initWithURL:url fileType:AVFileTypeMPEG4 error:&error];
+    if (!muxer->writer)
+    {
+        log_error("Could not create the MPEG-4 writer: %s", error.description.UTF8String);
+        muxer->failed = YES;
+        return NO;
+    }
+    muxer->writer.shouldOptimizeForNetworkUse = YES;
+
+    for (MacmfTrack *track in muxer->tracks)
+    {
+        AVAssetWriterInput *input;
+
+        if (!track->has_first)
+        {
+            log_error("MPEG-4 writer starts without its %s track", track->type == TRACK_H264 ? "video" : "audio");
+            continue;
+        }
+        input = [AVAssetWriterInput assetWriterInputWithMediaType:track->type == TRACK_H264 ? AVMediaTypeVideo
+                : AVMediaTypeAudio outputSettings:nil sourceFormatHint:track->format];
+        input.expectsMediaDataInRealTime = NO;
+        /* Audio keeps its sample rate as its time scale; video gets the usual 90 kHz. */
+        if (track->type == TRACK_H264) input.mediaTimeScale = 90000;
+        if (![muxer->writer canAddInput:input])
+        {
+            log_error("MPEG-4 writer cannot take the %s track", track->type == TRACK_H264 ? "video" : "audio");
+            continue;
+        }
+        [muxer->writer addInput:input];
+        track->input = input;
+    }
+    if (![muxer->writer startWriting])
+    {
+        log_error("MPEG-4 writer did not start: %s", muxer->writer.error.description.UTF8String);
+        muxer->failed = YES;
+        return NO;
+    }
+
+    /* Video starts the file; audio before it (such as the AAC encoder's priming) is trimmed. */
+    if (video) start = video->first_time;
+    else
+    {
+        for (MacmfTrack *track in muxer->tracks)
+        {
+            int64_t first;
+
+            if (!track->has_first) continue;
+            first = track->first_time;
+            if (track->type == TRACK_AAC && track->sample_rate)
+                first += (int64_t)track->priming * MF_TIMESCALE / track->sample_rate;
+            if (first < start) start = first;
+        }
+    }
+    [muxer->writer startSessionAtSourceTime:mf_time(start)];
+    muxer->started = YES;
+    log_trace("MPEG-4 writer started at %lld with %u tracks", (long long)start, (unsigned int)muxer->writer.inputs.count);
+
+    for (MacmfTrack *track in muxer->tracks)
+    {
+        for (id sample in track->waiting) append_sample(muxer, track, sample);
+        [track->waiting removeAllObjects];
+    }
+    return YES;
+}
+
+static void *body_muxer_create(void)
+{
+    MacmfMuxer *muxer = [[MacmfMuxer alloc] init];
+    NSString *template = [NSTemporaryDirectory() stringByAppendingPathComponent:@"winemacmf-XXXXXX"];
+    char *path = strdup(template.fileSystemRepresentation);
+
+    if (!path || !mkdtemp(path))
+    {
+        log_error("No temporary folder for the MPEG-4 writer");
+        free(path);
+        return NULL;
+    }
+    muxer->directory = [[NSFileManager defaultManager] stringWithFileSystemRepresentation:path length:strlen(path)];
+    free(path);
+    muxer->path = [muxer->directory stringByAppendingPathComponent:@"video.mp4"];
+    muxer->tracks = [NSMutableArray array];
+    muxer->lock = [[NSLock alloc] init];
+    return (__bridge_retained void *)muxer;
+}
+
+static void body_muxer_destroy(void *object)
+{
+    MacmfMuxer *muxer = (__bridge_transfer MacmfMuxer *)object;
+
+    if (!muxer) return;
+    @try
+    {
+        if (muxer->writer && muxer->writer.status == AVAssetWriterStatusWriting) [muxer->writer cancelWriting];
+    }
+    @catch (NSException *exception) {}
+    for (MacmfTrack *track in muxer->tracks) dispatch_sync(track->queue, ^{});
+    [[NSFileManager defaultManager] removeItemAtPath:muxer->directory error:nil];
+}
+
+static int body_muxer_add_track(void *object, uint32_t type, uint32_t width, uint32_t height, uint32_t sample_rate,
+        uint32_t channels, uint32_t priming, const uint8_t *config, uint32_t config_size)
+{
+    MacmfMuxer *muxer = (__bridge MacmfMuxer *)object;
+    MacmfTrack *track;
+    int index;
+
+    if (type != TRACK_H264 && type != TRACK_AAC) return MACMF_ERROR;
+    if (type == TRACK_AAC && (!sample_rate || !channels || !config_size)) return MACMF_ERROR;
+    [muxer->lock lock];
+    if (muxer->started)
+    {
+        [muxer->lock unlock];
+        return MACMF_ERROR;
+    }
+    track = [[MacmfTrack alloc] init];
+    track->type = type;
+    track->width = width;
+    track->height = height;
+    track->sample_rate = sample_rate;
+    track->channels = channels;
+    track->priming = priming;
+    track->config = config_size ? [NSData dataWithBytes:config length:config_size] : [NSData data];
+    track->queue = dispatch_queue_create("org.winehq.winemacmf.track", DISPATCH_QUEUE_SERIAL);
+    track->waiting = [NSMutableArray array];
+    index = (int)muxer->tracks.count;
+    [muxer->tracks addObject:track];
+    [muxer->lock unlock];
+    return index;
+}
+
+static int body_muxer_write(void *object, uint32_t index, const uint8_t *data, uint32_t size,
+        int64_t time, int64_t decode_time, int64_t duration, int keyframe)
+{
+    MacmfMuxer *muxer = (__bridge MacmfMuxer *)object;
+    CMSampleBufferRef sample = NULL;
+    MacmfTrack *track;
+    int ret = MACMF_OK;
+
+    [muxer->lock lock];
+    if (muxer->failed || index >= muxer->tracks.count)
+    {
+        [muxer->lock unlock];
+        return MACMF_ERROR;
+    }
+    track = muxer->tracks[index];
+
+    if (!track->format)
+    {
+        if (track->type == TRACK_H264)
+        {
+            if (track->config.length) track->format = h264_format(track->config.bytes, (uint32_t)track->config.length);
+            if (!track->format) track->format = h264_format(data, size);
+            /* Nothing before the first key frame can be decoded. */
+            if (!track->format || !keyframe)
+            {
+                [muxer->lock unlock];
+                return MACMF_OK;
+            }
+        }
+        else if (!(track->format = aac_format(track)))
+        {
+            muxer->failed = YES;
+            [muxer->lock unlock];
+            return MACMF_ERROR;
+        }
+    }
+
+    sample = track->type == TRACK_H264 ? h264_sample(track, data, size, time, decode_time, duration, keyframe)
+            : aac_sample(track, data, size, time, duration);
+    if (!sample)
+    {
+        [muxer->lock unlock];
+        return track->type == TRACK_H264 ? MACMF_OK : MACMF_ERROR;
+    }
+    if (!track->has_first)
+    {
+        track->has_first = YES;
+        track->first_time = time;
+    }
+    track->last_time = time;
+
+    if (muxer->started) append_sample(muxer, track, (__bridge_transfer id)sample);
+    else
+    {
+        [track->waiting addObject:(__bridge_transfer id)sample];
+        muxer_start(muxer, NO);
+        if (muxer->failed) ret = MACMF_ERROR;
+    }
+    [muxer->lock unlock];
+    return ret;
+}
+
+static int body_muxer_finish(void *object, uint64_t *size)
+{
+    MacmfMuxer *muxer = (__bridge MacmfMuxer *)object;
+    dispatch_semaphore_t done = dispatch_semaphore_create(0);
+    NSDictionary *attributes;
+    AVAssetWriter *writer;
+    unsigned int failed = 0;
+
+    [muxer->lock lock];
+    if (!muxer->started && !muxer->failed) muxer_start(muxer, YES);
+    writer = muxer->writer;
+    [muxer->lock unlock];
+    if (!writer || muxer->failed || !muxer->started)
+    {
+        log_error("MPEG-4 writer has nothing to finish");
+        return MACMF_ERROR;
+    }
+
+    /* Each track ends after its last sample; one waiting for the others moves on once they end. */
+    for (MacmfTrack *track in muxer->tracks)
+    {
+        if (!track->input) continue;
+        dispatch_async(track->queue, ^{
+            @try { [track->input markAsFinished]; }
+            @catch (NSException *exception) { if (!track->failed++) track->failure = exception.reason; }
+        });
+    }
+    for (MacmfTrack *track in muxer->tracks)
+    {
+        dispatch_sync(track->queue, ^{});
+        failed += track->failed;
+        if (track->failure)
+            log_error("MPEG-4 writer refused a %s sample: %s", track->type == TRACK_H264 ? "video" : "audio",
+                    track->failure.UTF8String);
+        log_trace("MPEG-4 writer %s track: %u samples", track->type == TRACK_H264 ? "video" : "audio", track->written);
+    }
+
+    @try
+    {
+        [writer finishWritingWithCompletionHandler:^{ dispatch_semaphore_signal(done); }];
+    }
+    @catch (NSException *exception)
+    {
+        log_error("MPEG-4 writer could not finish: %s", exception.reason.UTF8String);
+        return MACMF_ERROR;
+    }
+    if (dispatch_semaphore_wait(done, dispatch_time(DISPATCH_TIME_NOW, 300 * NSEC_PER_SEC)))
+    {
+        log_error("MPEG-4 writer did not finish in time");
+        return MACMF_ERROR;
+    }
+    if (writer.status != AVAssetWriterStatusCompleted)
+    {
+        log_error("MPEG-4 writer failed: %s", writer.error.description.UTF8String);
+        return MACMF_ERROR;
+    }
+    if (failed) log_error("MPEG-4 writer refused %u samples", failed);
+
+    attributes = [[NSFileManager defaultManager] attributesOfItemAtPath:muxer->path error:nil];
+    *size = [attributes fileSize];
+    return MACMF_OK;
+}
+
+static int body_muxer_read(void *object, uint64_t offset, uint8_t *data, uint32_t capacity, uint32_t *size)
+{
+    MacmfMuxer *muxer = (__bridge MacmfMuxer *)object;
+    FILE *file = fopen(muxer->path.fileSystemRepresentation, "rb");
+    size_t count;
+
+    *size = 0;
+    if (!file) return MACMF_ERROR;
+    if (fseeko(file, (off_t)offset, SEEK_SET))
+    {
+        fclose(file);
+        return MACMF_ERROR;
+    }
+    count = fread(data, 1, capacity, file);
+    fclose(file);
+    *size = (uint32_t)count;
+    return MACMF_OK;
+}
+
+/* ------------------------------------------------------------------------ */
+/* Entry points: Wine's threads have no autorelease pool of their own.       */
+/* ------------------------------------------------------------------------ */
+
+void *macmf_video_encoder_create(const struct macmf_video_settings *settings)
+{
+    @autoreleasepool { return body_video_encoder_create(settings); }
+}
+
