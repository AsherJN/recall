+/* Fixed logical game canvas inside native macOS fullscreen.
+ * The normal Wine coordinate system and native display mode remain unchanged
+ * for unregistered windows. All geometry state is owned by the Cocoa thread.
+ */
+#include "config.h"
+#import "cocoa_v1.h"
+#import "cocoa_window.h"
+#import "cocoa_app.h"
+#import "cocoa_event.h"
+#import <QuartzCore/QuartzCore.h>
+#import <objc/runtime.h>
+#include <math.h>
+#include <stdio.h>
+#include <unistd.h>
+
+@interface OWCanvas : NSObject {
+@public
+    NSView *client;
+    NSSize pixels;
+    NSRect savedBounds, savedClientFrame;
+    NSUInteger savedAutoresizing;
+    NSColor *savedBackground;
+    CGRect physical;
+    BOOL active, layingOut, requested, transitioning;
+    unsigned transitions, windowsPid;
+    /* Overlay presentation window state (see overlayAttach). */
+    NSWindow *overlay;
+    NSView *metalView;
+    NSRect savedMetalFrame;
+    NSUInteger savedMetalAutoresizing;
+    BOOL overlayActive;
+}
+@end
+@implementation OWCanvas
+- (void)dealloc { [client release]; [savedBackground release]; [overlay release]; [metalView release]; [super dealloc]; }
+@end
+
+/* Overlay presentation window. Wine's own window is always composited by the
+ * window server (3-6 ms from GPU completion to the panel, with vsync-grid runs
+ * on about 30% of game frames), while a plain borderless window hosting a
+ * plain Metal layer in the same process is flipped directly (0.1 ms; measured
+ * with tests/presentation/display_path_probe.m, arm64 and x86_64 alike). While
+ * the canvas is fullscreen the game's Metal view is therefore hosted in such a
+ * window, placed over the Wine window's content area: never key, ignoring
+ * mouse events, so the Wine window keeps focus, input, cursor clipping and the
+ * input mapping. It is a standalone window above the menu bar level that joins
+ * the fullscreen space (a child window or a normal-level auxiliary window in
+ * the space is displayed but Core Animation reports no presentation times for
+ * it, measured 2026-09-13), shown only while the Wine window has focus. The
+ * first such window created for a fullscreen space never reports presentation
+ * times while every later one does (probe and fixture, 2026-09-13), so a
+ * throwaway window is created first and each attach uses a fresh overlay. The view returns to the Wine
+ * client view when the canvas leaves fullscreen.
+ * Opt-in with DXMT_CANVAS_OVERLAY=1 (the launcher sets it). */
+@interface OWOverlayWindow : NSWindow
+@end
+@implementation OWOverlayWindow
+- (BOOL)canBecomeKeyWindow { return NO; }
+- (BOOL)canBecomeMainWindow { return NO; }
+@end
+
+static BOOL overlayEnabled(void) {
+    static int enabled = -1;
+    if (enabled < 0) {
+        const char *value = getenv("DXMT_CANVAS_OVERLAY");
+        enabled = (value && *value && strcmp(value, "0") != 0) ? 1 : 0;
+    }
+    return enabled > 0;
+}
+
+static NSWindow *makeOverlayWindow(NSRect content) {
+    OWOverlayWindow *overlay = [[OWOverlayWindow alloc] initWithContentRect:content styleMask:NSWindowStyleMaskBorderless
+                                                                     backing:NSBackingStoreBuffered defer:NO];
+    [overlay setReleasedWhenClosed:NO];
+    [overlay setOpaque:YES];
+    [overlay setBackgroundColor:NSColor.blackColor];
+    [overlay setHasShadow:NO];
+    [overlay setIgnoresMouseEvents:YES];
+    [overlay setAnimationBehavior:NSWindowAnimationBehaviorNone];
+    [overlay setLevel:NSMainMenuWindowLevel + 1];
+    [overlay setCollectionBehavior:NSWindowCollectionBehaviorCanJoinAllSpaces | NSWindowCollectionBehaviorFullScreenAuxiliary |
+                                    NSWindowCollectionBehaviorStationary | NSWindowCollectionBehaviorIgnoresCycle];
+    overlay.contentView.wantsLayer = YES;
+    overlay.contentView.layer.backgroundColor = NSColor.blackColor.CGColor;
+    return overlay;
+}
+
+/* Per attach: the first overlay window created for a fullscreen space reports
+ * no presentation times (probe and fixture, 2026-09-13); a throwaway window
+ * takes that slot every time the canvas enters a space. */
+static NSWindow *warmupOverlay;
+static void overlayWarmUp(NSRect content) {
+    [warmupOverlay orderOut:nil];
+    [warmupOverlay release];
+    warmupOverlay = makeOverlayWindow(content);
+    [warmupOverlay orderFrontRegardless];
+    [warmupOverlay orderOut:nil];
+}
+
+static char canvasKey;
+static OWCanvas *canvas(WineWindow *window) {
+    return window ? objc_getAssociatedObject(window, &canvasKey) : nil;
+}
+
+static void record(WineWindow *window, const char *event) {
+    OWCanvas *state = canvas(window);
+    const char *prefix = getenv("DXMT_CANVAS_LOG");
+    if (!state || !prefix || !*prefix || state->transitions++ >= 256) return;
+    char path[PATH_MAX];
+    if (snprintf(path, sizeof(path), "%s-%d.jsonl", prefix, getpid()) >= sizeof(path)) return;
+    FILE *file = fopen(path, "a");
+    if (!file) return;
+    fprintf(file, "{\"schema\":1,\"native_pid\":%d,\"windows_pid\":%u,\"unix_ms\":%.0f,\"host_s\":%.9f,\"event\":\"%s\",\"active\":%s,"
+        "\"logical\":[%.0f,%.0f],\"physical\":[%.0f,%.0f],\"focused\":%s}\n",
+        getpid(), state->windowsPid, NSDate.date.timeIntervalSince1970*1000, CACurrentMediaTime(), event, state->active ? "true" : "false",
+        state->pixels.width, state->pixels.height, state->physical.size.width, state->physical.size.height,
+        window.isKeyWindow ? "true" : "false");
+    fclose(file);
+}
+
+BOOL macdrv_v1_canvas_active(WineWindow *window) {
+    OWCanvas *state = canvas(window);
+    return state && state->active;
+}
+
+BOOL macdrv_v1_canvas_requested(WineWindow *window) {
+    OWCanvas *state = canvas(window);
+    return state && state->requested;
+}
+
+/* Drawable pool depth for the registered canvas layer. Two drawables force the
+ * translator's encoding thread to wait for the on-screen drawable to be released
+ * at every refresh; measured 2026-09-12 gameplay spent about 7% of wall time in
+ * that wait and locked presentation to the display's slower refresh steps. Three
+ * is Core Animation's default and matches the windowed path. The Direct3D
+ * frame-latency limit still bounds CPU run-ahead. DXMT_CANVAS_DRAWABLES=2 keeps
+ * the previous behaviour for a controlled comparison. */
+static NSUInteger canvasDrawableCount(void) {
+    static NSUInteger count;
+    if (!count) {
+        const char *value = getenv("DXMT_CANVAS_DRAWABLES");
+        long parsed = value && *value ? strtol(value, NULL, 10) : 0;
+        count = (parsed == 2 || parsed == 3) ? (NSUInteger)parsed : 3;
+    }
+    return count;
+}
+
+static NSView *clientMetalView(OWCanvas *state) {
+    for (NSView *view in state->client.subviews)
+        if ([view.layer isKindOfClass:CAMetalLayer.class]) return view;
+    return nil;
+}
+
+/* Same on-screen placement as the scaled Wine client view: the game image
+ * aspect-fitted and centred in the window's content area, drawn at display
+ * pixels. The input mapping (macdrv_v1_canvas_point) is unchanged by design. */
+static void overlayLayout(WineWindow *window, OWCanvas *state) {
+    if (!state->overlayActive) return;
+    NSRect content = [window contentRectForFrameRect:window.frame];
+    if (!NSEqualRects(state->overlay.frame, content)) [state->overlay setFrame:content display:NO];
+    NSRect bounds = state->overlay.contentView.bounds;
+    double scale = fmin(bounds.size.width/state->pixels.width, bounds.size.height/state->pixels.height);
+    if (!isfinite(scale) || scale <= 0) return;
+    double w = floor(state->pixels.width*scale), h = floor(state->pixels.height*scale);
+    NSRect frame = NSMakeRect(floor((bounds.size.width-w)/2), floor((bounds.size.height-h)/2), w, h);
+    NSView *view = state->metalView;
+    if (!NSEqualRects(view.frame, frame)) [view setFrame:frame];
+    CAMetalLayer *layer = (CAMetalLayer *)view.layer;
+    double backing = state->overlay.backingScaleFactor;
+    layer.contentsScale = backing;
+    layer.drawableSize = CGSizeMake(llround(w*backing), llround(h*backing));
+    layer.maximumDrawableCount = canvasDrawableCount();
+}
+
+static void overlayObserve(void);
+
+static void overlayDetach(WineWindow *window, OWCanvas *state) {
+    if (!state->overlayActive) return;
+    NSView *view = state->metalView;
+    [state->overlay orderOut:nil];
+    if (view.window == state->overlay) {
+        /* Still owned by the translator: return it to the Wine client view. */
+        [view removeFromSuperview];
+        [view setFrame:state->savedMetalFrame];
+        [view setAutoresizingMask:state->savedMetalAutoresizing];
+        [state->client addSubview:view positioned:NSWindowBelow relativeTo:nil];
+    }
+    state->overlayActive = NO;
+    [view release];
+    state->metalView = nil;
+    record(window, "overlay_detached");
+}
+
+static void overlayAttach(WineWindow *window, OWCanvas *state) {
+    if (!overlayEnabled() || !state->active || state->transitioning) return;
+    NSView *view = clientMetalView(state);
+    if (state->overlayActive) {
+        if (!view) return;
+        /* A new swapchain view appeared while the overlay held the old one. */
+        overlayDetach(window, state);
+    }
+    if (!view || view.superview != state->client) return;
+    NSRect content = [window contentRectForFrameRect:window.frame];
+    overlayWarmUp(content);
+    [state->overlay release];
+    state->overlay = makeOverlayWindow(content);
+    overlayObserve();
+    state->metalView = [view retain];
+    state->savedMetalFrame = view.frame;
+    state->savedMetalAutoresizing = view.autoresizingMask;
+    [view removeFromSuperview];
+    [view setAutoresizingMask:NSViewNotSizable];
+    [state->overlay.contentView addSubview:view];
+    state->overlayActive = YES;
+    overlayLayout(window, state);
+    if (window.isKeyWindow) [state->overlay orderFrontRegardless];
+    record(window, "overlay_attached");
+}
+
+static void overlayFocus(WineWindow *window, OWCanvas *state, BOOL focused) {
+    if (!state->overlayActive) return;
+    if (focused) { overlayLayout(window, state); [state->overlay orderFrontRegardless]; }
+    else [state->overlay orderOut:nil];
+}
+
+/* Cmd-Tab and hide/unhide: the overlay is removed when the application
+ * deactivates. AppKit restores the key window some time after activation (the
+ * probe measured about a second) and with the overlay present the Wine window
+ * was measured not to get it back at all, so after activation the canvas
+ * window is made key again if nothing is, and the overlay returns only once
+ * the Wine window is key. */
+static void overlayReactivate(void) {
+    for (NSWindow *candidate in NSApp.windows) {
+        OWCanvas *state = [candidate isKindOfClass:WineWindow.class] ? canvas((WineWindow *)candidate) : nil;
+        if (!state || !state->overlayActive) continue;
+        if (NSApp.isActive && NSApp.keyWindow == nil && candidate.isVisible) [candidate makeKeyAndOrderFront:nil];
+        overlayFocus((WineWindow *)candidate, state, NSApp.isActive && candidate.isKeyWindow);
+    }
+}
+
+static void overlayDeactivate(void) {
+    for (NSWindow *candidate in NSApp.windows) {
+        OWCanvas *state = [candidate isKindOfClass:WineWindow.class] ? canvas((WineWindow *)candidate) : nil;
+        if (state && state->overlayActive) overlayFocus((WineWindow *)candidate, state, NO);
+    }
+}
+
+static void overlayReactivateLater(void) {
+    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.7 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{ overlayReactivate(); });
+    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(1.6 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{ overlayReactivate(); });
+}
+
+static void overlayObserve(void) {
+    static BOOL observing;
+    if (observing) return;
+    observing = YES;
+    NSNotificationCenter *center = NSNotificationCenter.defaultCenter;
+    [center addObserverForName:NSApplicationDidBecomeActiveNotification object:nil queue:NSOperationQueue.mainQueue
+                    usingBlock:^(NSNotification *note) { overlayReactivateLater(); }];
+    [center addObserverForName:NSApplicationDidUnhideNotification object:nil queue:NSOperationQueue.mainQueue
+                    usingBlock:^(NSNotification *note) { overlayReactivateLater(); }];
+    [center addObserverForName:NSApplicationDidResignActiveNotification object:nil queue:NSOperationQueue.mainQueue
+                    usingBlock:^(NSNotification *note) { overlayDeactivate(); }];
+    [center addObserverForName:NSApplicationDidHideNotification object:nil queue:NSOperationQueue.mainQueue
+                    usingBlock:^(NSNotification *note) { overlayDeactivate(); }];
+}
+
+NSWindow *macdrv_v1_canvas_owner(NSWindow *window) {
+    if (!window || ![window isKindOfClass:OWOverlayWindow.class]) return window;
+    for (NSWindow *candidate in NSApp.windows) {
+        OWCanvas *state = [candidate isKindOfClass:WineWindow.class] ? canvas((WineWindow *)candidate) : nil;
+        if (state && state->overlay == window) return candidate;
+    }
+    return window;
+}
+
+static void updateLayers(WineWindow *window, OWCanvas *state) {
+    double scale = state->active ? fmin(state->physical.size.width/state->pixels.width,
+                                      state->physical.size.height/state->pixels.height) : 1.0;
+    if (!isfinite(scale) || scale <= 0) return;
+    for (NSView *view in state->client.subviews) {
+        if (![view.layer isKindOfClass:CAMetalLayer.class]) continue;
+        CAMetalLayer *layer = (CAMetalLayer *)view.layer;
+        // Render the final enlargement at display pixels, rather than leaving
+        // Core Animation to magnify a low-resolution finished drawable.
+        layer.drawableSize = CGSizeMake(llround(state->pixels.width*scale), llround(state->pixels.height*scale));
+        layer.contentsScale = (retina_on ? 2.0 : 1.0)*scale;
+        layer.maximumDrawableCount = canvasDrawableCount();
+    }
+    if (state->active) overlayAttach(window, state);
+    overlayLayout(window, state);
+}
+
+__attribute__((visibility("default"))) void macdrv_v1_update_metal_layer(void *object) {
+    for (WineWindow *window in NSApp.windows) {
+        OWCanvas *state = canvas(window);
+        if (!state || !state->active) continue;
+        for (NSView *view in state->client.subviews)
+            if (view.layer == object) { updateLayers(window, state); return; }
+        if (state->metalView && state->metalView.layer == object) { overlayLayout(window, state); return; }
+    }
+}
+
+void macdrv_v1_canvas_layout(WineWindow *window) {
+    OWCanvas *state = canvas(window);
+    if (!state || !state->active || state->layingOut) return;
+    NSView *root = window.contentView;
+    NSRect frame = [window contentRectForFrameRect:window.frame];
+    [[WineApplicationController sharedController] flipRect:&frame];
+    state->physical = cgrect_win_from_mac(NSRectToCGRect(frame));
+    double retina = retina_on ? 2.0 : 1.0;
+    double width = root.frame.size.width, height = root.frame.size.height;
+    NSSize logical = NSMakeSize(state->pixels.width/retina, state->pixels.height/retina);
+    double scale = fmin(width/logical.width, height/logical.height);
+    if (!isfinite(scale) || scale <= 0) return;
+    state->layingOut = YES;
+    // Root coordinates stay in logical points. Its extra bounds surround the
+    // fixed-size client with equal bars; subviews inherit the uniform transform.
+    [root setBounds:NSMakeRect(-(width/scale-logical.width)/2, -(height/scale-logical.height)/2,
+                              width/scale, height/scale)];
+    [state->client setAutoresizingMask:NSViewNotSizable];
+    [state->client setFrame:NSMakeRect(0, 0, logical.width, logical.height)];
+    [window setBackgroundColor:NSColor.blackColor];
+    updateLayers(window, state);
+    state->layingOut = NO;
+}
+
+CGRect macdrv_v1_canvas_frame(WineWindow *window, CGRect physical) {
+    OWCanvas *state = canvas(window);
+    if (!state || !state->active) return physical;
+    state->physical = physical;
+    physical.size = NSSizeToCGSize(state->pixels);
+    return physical;
+}
+
+void macdrv_v1_canvas_restore(WineWindow *window) {
+    OWCanvas *state = canvas(window);
+    if (!state || state->active) return;
+    overlayDetach(window, state);
+    // Cocoa resizes bounds proportionally during the exit animation. Restore
+    // after the final physical frame, otherwise each toggle compounds scaling.
+    [window.contentView setBounds:state->savedBounds];
+    [state->client setFrame:state->savedClientFrame];
+    [state->client setAutoresizingMask:state->savedAutoresizing];
+    updateLayers(window, state);
+}
+
+void macdrv_v1_canvas_transition(WineWindow *window, BOOL entering) {
+    OWCanvas *state = canvas(window);
+    if (!state) return;
+    if (!state->transitioning) state->requested = entering;
+    state->transitioning = YES;
+    if (entering && !state->active) {
+        state->savedBounds = window.contentView.bounds;
+        state->savedClientFrame = state->client.frame;
+        state->savedAutoresizing = state->client.autoresizingMask;
+        [state->savedBackground release];
+        state->savedBackground = [window.backgroundColor retain];
+    }
+    state->active = entering;
+    if (entering) macdrv_v1_canvas_layout(window);
+    else {
+        overlayDetach(window, state);
+        [window.contentView setBounds:state->savedBounds];
+        [state->client setFrame:state->savedClientFrame];
+        [state->client setAutoresizingMask:state->savedAutoresizing];
+        [window setBackgroundColor:state->savedBackground];
+    }
+    record(window, entering ? "enter_fullscreen" : "exit_fullscreen");
+}
+
+CGPoint macdrv_v1_canvas_point(WineWindow *window, CGPoint point, BOOL to_physical) {
+    OWCanvas *state = canvas(window);
+    if (!state || !state->active) return point;
+    double scale = fmin(state->physical.size.width/state->pixels.width,
+                        state->physical.size.height/state->pixels.height);
+    if (!isfinite(scale) || scale <= 0) return point;
+    double pad_x = (state->physical.size.width-state->pixels.width*scale)/2;
+    double pad_y = (state->physical.size.height-state->pixels.height*scale)/2;
+    CGPoint origin = state->physical.origin;
+    if (to_physical)
+        return CGPointMake(origin.x+pad_x+(point.x-origin.x)*scale,
+                           origin.y+pad_y+(point.y-origin.y)*scale);
+    return CGPointMake(origin.x+(point.x-origin.x-pad_x)/scale,
+                       origin.y+(point.y-origin.y-pad_y)/scale);
+}
+
+CGRect macdrv_v1_canvas_clip(CGRect rect) {
+    WineWindow *window = (WineWindow *)NSApp.keyWindow;
+    if (CGRectIsInfinite(rect) || !macdrv_v1_canvas_active(window)) return rect;
+    CGPoint a = macdrv_v1_canvas_point(window, rect.origin, YES);
+    CGPoint b = macdrv_v1_canvas_point(window, CGPointMake(CGRectGetMaxX(rect), CGRectGetMaxY(rect)), YES);
+    return CGRectMake(a.x, a.y, b.x-a.x, b.y-a.y);
+}
+
+void macdrv_v1_canvas_event(macdrv_event *event) {
+    // Absolute positions are in Wine screen pixels already. Relative motion is
+    // intentionally unchanged so raw mouse sensitivity is independent of scale.
+    WineWindow *window = (WineWindow *)event->window;
+    if (![NSThread isMainThread] || !macdrv_v1_canvas_active(window)) return;
+    int *x = NULL, *y = NULL;
+    switch (event->type) {
+    case MOUSE_MOVED_ABSOLUTE: x=&event->mouse_moved.x; y=&event->mouse_moved.y; break;
+    case MOUSE_BUTTON: x=&event->mouse_button.x; y=&event->mouse_button.y; break;
+    case MOUSE_SCROLL: x=&event->mouse_scroll.x; y=&event->mouse_scroll.y; break;
+    default: return;
+    }
+    CGPoint p = macdrv_v1_canvas_point(window, CGPointMake(*x,*y), NO);
+    *x = floor(p.x); *y = floor(p.y);
+}
+
+void macdrv_v1_canvas_focus(WineWindow *window, BOOL focused) {
+    OWCanvas *state = canvas(window);
+    if (!state) return;
+    if (focused) macdrv_v1_canvas_layout(window);
+    overlayFocus(window, state, focused);
+    record(window, focused ? "focus_gained" : "focus_lost");
+}
+
+/* Explicit bridge registration is per-window and preserves the existing
+ * macdrv_functions ABI. Older drivers report unavailable through dlsym. */
+__attribute__((visibility("default"))) unsigned
+macdrv_v1_configure_canvas(void *client_view, unsigned width, unsigned height, unsigned windows_pid) {
+    __block unsigned result = 0;
+    dispatch_block_t configure = ^{
+        NSView *view = (NSView *)client_view;
+        WineWindow *window = (WineWindow *)macdrv_v1_canvas_owner(view.window);
+        if (!view || ![window isKindOfClass:WineWindow.class] ||
+            width != 1920 || (height != 1080 && height != 1200)) return;
+        OWCanvas *state = canvas(window);
+        if (!state) {
+            state = [[[OWCanvas alloc] init] autorelease];
+            state->client = [view retain];
+            objc_setAssociatedObject(window, &canvasKey, state, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
+        }
+        if (state->client != view) {
+            [state->client release];
+            state->client = [view retain];
+        }
+        state->pixels = NSMakeSize(width,height);
+        state->windowsPid = windows_pid;
+        if (!state->active) state->savedBounds = window.contentView.bounds;
+        updateLayers(window, state);
+        record(window, "registered");
+        result = 1;
+    };
+    if ([NSThread isMainThread]) configure();
+    else OnMainThread(configure);
+    return result;
+}
+
+/* Called only through the explicit DXMT bridge. Never changes display modes.
+ * Cocoa transitions are asynchronous; requests received during an animation
+ * are reconciled by the did-enter/did-exit callbacks, without blocking Wine. */
+static void requestTransition(WineWindow *window, OWCanvas *state) {
+    if (state->transitioning) return;
+    BOOL actual = (window.styleMask & NSWindowStyleMaskFullScreen) != 0;
+    if (actual == state->requested) return;
+    [window setCollectionBehavior:(window.collectionBehavior | NSWindowCollectionBehaviorFullScreenPrimary)
+                                   & ~NSWindowCollectionBehaviorFullScreenAuxiliary];
+    [window toggleFullScreen:nil];
+}
+
+void macdrv_v1_canvas_settled(WineWindow *window) {
+    OWCanvas *state = canvas(window);
+    if (!state) return;
+    state->transitioning = NO;
+    if (state->active) overlayAttach(window, state);
+    else overlayDetach(window, state);
+    // A green-button transition remains supported. Reconciliation is needed
+    // only when a subsequent explicit game request arrived during animation.
+    if (state->requested != state->active) requestTransition(window, state);
+}
+
+void macdrv_v1_canvas_failed(WineWindow *window) {
+    OWCanvas *state = canvas(window);
+    if (!state) return;
+    state->transitioning = NO;
+    state->requested = state->active;
+    if (!state->active) overlayDetach(window, state);
+    record(window, "fullscreen_transition_failed");
+}
+
+__attribute__((visibility("default"))) unsigned
+macdrv_v1_set_fullscreen(void *client_view, unsigned width, unsigned height, unsigned enable) {
+    __block unsigned result = 0;
+    dispatch_block_t action = ^{
+        NSView *view = (NSView *)client_view;
+        WineWindow *window = (WineWindow *)macdrv_v1_canvas_owner(view.window);
+        OWCanvas *state = [window isKindOfClass:WineWindow.class] ? canvas(window) : nil;
+        if (!state || enable > 2 || width < 640 || width > 3840 || height < 480 || height > 2160) return;
+        if (enable == 2) { result = state->requested || state->active; return; }
+        state->pixels = NSMakeSize(width, height);
+        state->requested = enable != 0;
+        if (state->active) macdrv_v1_canvas_layout(window);
+        requestTransition(window, state);
+        record(window, enable ? "game_fullscreen_requested" : "game_windowed_requested");
+        result = 1;
+    };
+    if ([NSThread isMainThread]) action(); else OnMainThread(action);
+    return result;
+}
