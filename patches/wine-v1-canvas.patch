+/* Soju: apps listed in WINE_CUSTOM_FRAME (semicolon-separated exe names) draw
+ * their own title bar inside the client area (Qt/Electron style custom frames,
+ * e.g. GOG GALAXY). Adding a macOS title bar on top of that hides the first
+ * rows of their UI, so such windows get no Cocoa title bar or buttons. */
+static BOOL is_custom_frame_app(void)
+{
+    static int result = -1;
+
+    if (result == -1)
+    {
+        const char *list = getenv("WINE_CUSTOM_FRAME");
+        WCHAR *name = NtCurrentTeb()->Peb->ProcessParameters->ImagePathName.Buffer;
+        WCHAR *exe = wcsrchr(name, '\\');
+        char exe_a[MAX_PATH];
+        int i;
+
+        result = 0;
+        exe = exe ? exe + 1 : name;
+        for (i = 0; exe[i] && i < MAX_PATH - 1; i++) exe_a[i] = (char)exe[i];
+        exe_a[i] = 0;
+        while (list && *list)
+        {
+            const char *end = strchr(list, ';');
+            size_t len = end ? (size_t)(end - list) : strlen(list);
+            if (len == strlen(exe_a) && !strncasecmp(list, exe_a, len)) { result = 1; break; }
+            list = end ? end + 1 : NULL;
+        }
+    }
+    return result;
+}
