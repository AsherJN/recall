+/* write the dirty branches in a child process; returns 0 if it could not be started */
+static int start_save_process(void)
+{
+    sigset_t all;
+    pid_t pid;
+    int i, ok = 1;
+
+    if ((pid = fork()) == -1) return 0;
+    if (pid)
+    {
+        save_pid = pid;
+        save_start = monotonic_time;
+        for (i = 0; i < save_branch_count; i++)
+        {
+            /* the child writes the branch as it is now; later changes dirty it again */
+            save_branch_info[i].in_child = !!(save_branch_info[i].key->flags & KEY_DIRTY);
+            make_clean( save_branch_info[i].key );
+        }
+        return 1;
+    }
+
+    /* child: only write files, then leave without running exit handlers */
+    sigfillset( &all );
+    sigprocmask( SIG_SETMASK, &all, NULL );
+    if (fchdir( config_dir_fd ) == -1) _exit( 1 );
+    for (i = 0; i < save_branch_count; i++)
+        if (!save_branch( save_branch_info[i].key, save_branch_info[i].filename )) ok = 0;
+    _exit( ok ? 0 : 1 );
+}
+
+/* a child process exited; status is from waitpid, or -1 if it is unknown */
+void registry_child_exited( pid_t pid, int status )
+{
+    int i, saved = status != -1 && WIFEXITED( status ) && !WEXITSTATUS( status );
+
+    if (!save_pid || pid != save_pid) return;
+    save_pid = 0;
+    for (i = 0; i < save_branch_count; i++)
+    {
+        /* a failed save leaves the whole branch to be written again */
+        if (save_branch_info[i].in_child && !saved) save_branch_info[i].key->flags |= KEY_DIRTY;
+        save_branch_info[i].in_child = 0;
+    }
+    if (!saved) fprintf( stderr, "wineserver: periodic registry save failed (status %#x)\n", status );
+}
+
+/* wait for a running periodic save, so that nothing older can replace what is written next */
+static void wait_for_save_process(void)
+{
+    int status;
+
+    if (!save_pid) return;
+    if (waitpid( save_pid, &status, 0 ) != save_pid) status = -1;
+    registry_child_exited( save_pid, status );
+}
