+/* AppKit's button change: whether raw input posted it already.  If not, AppKit
+ * posts it, and it is noted so that a later GCMouse copy is not posted again.
+ * Statistics: how far behind GCMouse's copy it arrived, and the motion in
+ * between, which the game takes before an AppKit click.  Main thread. */
+static BOOL appkit_button_is_raw_copy(int button, BOOL pressed, NSTimeInterval timestamp)
+{
+    unsigned long long now = raw_clock(), at = timestamp * 1e9;
+    struct button_change* copy;
+    BOOL posted = FALSE;
+
+    if (button < 0 || button >= RAW_BUTTONS || !raw_queue) return FALSE;
+
+    os_unfair_lock_lock(&mouselook_lock);
+    if ((copy = button_copy(at, button, pressed, TRUE, FALSE)))
+    {
+        double counts = hypot(__atomic_load_n(&raw_sum_x, __ATOMIC_RELAXED) - copy->sum_x,
+                              __atomic_load_n(&raw_sum_y, __ATOMIC_RELAXED) - copy->sum_y);
+        unsigned long long gap = now > copy->at ? now - copy->at : 0;
+
+        copy->matched = 1;
+        posted = copy->from == BUTTON_RAW;
+        button_stats.gaps++;
+        button_stats.gap_ns += gap;
+        if (gap > button_stats.gap_max_ns) button_stats.gap_max_ns = gap;
+        button_stats.gap_counts += counts;
+        if (counts > button_stats.gap_counts_max) button_stats.gap_counts_max = counts;
+        if (copy->hid && copy->at + button_match_before < at) button_stats.appkit_copies_late_stamp++;
+    }
+    if (posted)
+        button_stats.appkit_copies++;
+    else
+    {
+        if (__atomic_load_n(&hid_active, __ATOMIC_ACQUIRE) && __atomic_load_n(&raw_on, __ATOMIC_ACQUIRE))
+            button_note_unmatched(at, button, pressed);
+        button_remember(at, button, pressed, BUTTON_APPKIT, FALSE);
+        if (input_flags() & INPUT_RAW_BUTTONS) button_stats.appkit_posted++;
+    }
+    os_unfair_lock_unlock(&mouselook_lock);
+    return posted;
+}
