+/* Test only: a system sound, played without waiting on the main thread or
+ * loading an audio output into the process.  The first NSSound froze the game
+ * for 1.5 s in a play-test. */
+static void play_test_sound(NSString* name)
+{
+    static dispatch_queue_t queue;
+    static dispatch_once_t once;
+
+    dispatch_once(&once, ^{
+        queue = dispatch_queue_create("org.winehq.wine.winemac.test-sound", DISPATCH_QUEUE_SERIAL);
+    });
+    name = [name copy];
+    dispatch_async(queue, ^{
+        static OSStatus (*create)(CFURLRef, UInt32*);
+        static OSStatus (*set_property)(UInt32, UInt32, const void*, UInt32, const void*);
+        static void (*play)(UInt32);
+        static NSMutableDictionary* sounds;
+
+        @autoreleasepool
+        {
+            NSNumber* sound;
+
+            if (!sounds)
+            {
+                void* toolbox = dlopen("/System/Library/Frameworks/AudioToolbox.framework/AudioToolbox",
+                                       RTLD_LAZY | RTLD_LOCAL);
+
+                create = toolbox ? dlsym(toolbox, "AudioServicesCreateSystemSoundID") : NULL;
+                set_property = toolbox ? dlsym(toolbox, "AudioServicesSetProperty") : NULL;
+                play = toolbox ? dlsym(toolbox, "AudioServicesPlaySystemSound") : NULL;
+                sounds = [[NSMutableDictionary alloc] init];
+            }
+            sound = sounds[name];
+            if (!sound && create)
+            {
+                NSURL* url = [NSURL fileURLWithPath:[NSString stringWithFormat:@"/System/Library/Sounds/%@.aiff", name]];
+                UInt32 soundID;
+
+                if (create((CFURLRef)url, &soundID) == noErr)
+                {
+                    /* kAudioServicesPropertyIsUISound: play even with "Play user
+                       interface sound effects" off. */
+                    UInt32 always = 0;
+
+                    if (set_property)
+                        set_property('isui', sizeof(soundID), &soundID, sizeof(always), &always);
+                    sounds[name] = sound = [NSNumber numberWithUnsignedInt:soundID];
+                }
+            }
+            if (sound && play)
+                play([sound unsignedIntValue]);
+        }
+        [name release];
+    });
+}
