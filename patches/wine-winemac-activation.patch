+/* Statistics: how long the main thread took to start a request from another
+ * thread (OnMainThreadAsync, as OnMainThread uses), probed every 10 ms.  A key
+ * press waits that long for macdrv_using_input_method.  Main thread. */
+static struct
+{
+    unsigned long long probes, lag_ns, lag_max_ns, over_4ms, over_16ms;
+} main_lag;
+static int main_lag_pending;
+
+static void start_main_lag_probe(void)
+{
+    dispatch_queue_attr_t attributes = dispatch_queue_attr_make_with_qos_class(DISPATCH_QUEUE_SERIAL,
+                                                                               QOS_CLASS_USER_INTERACTIVE, 0);
+    dispatch_queue_t queue = dispatch_queue_create("org.winehq.wine.winemac.main-lag", attributes);
+    dispatch_source_t timer = dispatch_source_create(DISPATCH_SOURCE_TYPE_TIMER, 0, 0, queue);
+
+    dispatch_source_set_event_handler(timer, ^{
+        unsigned long long sent;
+
+        /* A probe still waiting is a stall in progress, and measures it. */
+        if (__atomic_exchange_n(&main_lag_pending, 1, __ATOMIC_ACQ_REL)) return;
+        sent = clock_gettime_nsec_np(CLOCK_UPTIME_RAW);
+        OnMainThreadAsync(^{
+            unsigned long long lag = clock_gettime_nsec_np(CLOCK_UPTIME_RAW) - sent;
+
+            main_lag.probes++;
+            main_lag.lag_ns += lag;
+            if (lag > main_lag.lag_max_ns) main_lag.lag_max_ns = lag;
+            if (lag > 4000000) main_lag.over_4ms++;
+            if (lag > 16000000) main_lag.over_16ms++;
+            __atomic_store_n(&main_lag_pending, 0, __ATOMIC_RELEASE);
+        });
+    });
+    dispatch_source_set_timer(timer, dispatch_time(DISPATCH_TIME_NOW, 10000000), 10000000, 1000000);
+    dispatch_resume(timer);
+}
