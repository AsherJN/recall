+/* Notes a button change: posted to Wine by AppKit or raw input, or only seen by
+ * GCMouse.  Called with mouselook_lock held. */
+static void button_remember(unsigned long long at, int button, int pressed, int from, BOOL hid)
+{
+    struct button_change* change = &button_recent[button_recent_next++ % BUTTON_RECENT];
+
+    change->at = at;
+    change->sum_x = __atomic_load_n(&raw_sum_x, __ATOMIC_RELAXED);
+    change->sum_y = __atomic_load_n(&raw_sum_y, __ATOMIC_RELAXED);
+    change->button = button;
+    change->pressed = pressed;
+    change->from = from;
+    change->matched = 0;
+    change->hid = hid;
+}
+
+/* The other path's unmatched copy of a button change: for AppKit's change with
+ * hardware time at, raw input's (posted or only seen); for raw input's arriving
+ * at at (from HID if hid), AppKit's.  Raw input's copy arrives from
+ * button_match_before (hid_match_before for HID's) ahead of AppKit's hardware
+ * time to button_match_after behind it.  The earliest wins, so quick repeated
+ * clicks pair in order.  Called with mouselook_lock held. */
+static struct button_change* button_copy(unsigned long long at, int button, int pressed, BOOL want_raw, BOOL hid)
+{
+    struct button_change* best = NULL;
+    unsigned int i;
+
+    for (i = 0; i < BUTTON_RECENT; i++)
+    {
+        struct button_change* change = &button_recent[i];
+        unsigned long long raw_at, hardware_at;
+
+        if (!change->at || change->matched || change->button != button || change->pressed != pressed) continue;
+        if ((change->from != BUTTON_APPKIT) != want_raw) continue;
+        raw_at = want_raw ? change->at : at;
+        hardware_at = want_raw ? at : change->at;
+        if (raw_at + ((want_raw ? change->hid : hid) ? hid_match_before : button_match_before) < hardware_at ||
+            raw_at > hardware_at + button_match_after)
+            continue;
+        if (!best || change->at < best->at) best = change;
+    }
+    return best;
+}
