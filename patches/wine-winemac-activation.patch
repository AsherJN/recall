+/* How raw input and key presses behave.  Variant 0 is what drivers up to
+ * Recall 1.3.1 did with input statistics off, as players run them: they timed
+ * raw input with macdrv_stat_clock(), which reads 0 then, so every move carries
+ * event time ticksForEventTime:0, every delivery waits for the timer and
+ * pointer events never stand in.  Righting all three ("fixed") seemed to make
+ * Overwatch hitch more in an October 2026 play-test (a blind test then found no
+ * difference), so test builds switch the parts one at a time
+ * (WINEMAC_INPUT_VARIANT, WINEMAC_INPUT_VARIANTS).  "precise" adds mouse
+ * buttons from raw input to "fixed".  "classic" is Recall's Classic mouse
+ * setting: legacy's clicks and timing, as in Recall 1.4, with the stand-in and
+ * re-arming that end 1.4's dead camera after an app switch. */
+enum
+{
+    INPUT_REAL_TIME   = 1,  /* moves carry the uptime of their delivery */
+    INPUT_AT_ONCE     = 2,  /* a report goes out at once when raw_interval has passed */
+    INPUT_FALLBACK    = 4,  /* pointer events stand in while GCMouse is silent, in its units, and its handlers are re-armed */
+    INPUT_KEYS_CACHED = 8,  /* key presses read input_method_cached, not the main thread */
+    INPUT_RAW_BUTTONS = 16, /* mouse buttons come from GCMouse, in order with its motion (raw_button) */
+};
+static const struct { const char* name; int flags; } input_variants[] =
+{
+    { "legacy", 0 },
+    { "stamps", INPUT_REAL_TIME },
+    { "at-once", INPUT_AT_ONCE },
+    { "fixed", INPUT_REAL_TIME | INPUT_AT_ONCE | INPUT_FALLBACK },
+    { "keys", INPUT_KEYS_CACHED },
+    { "clicks", INPUT_RAW_BUTTONS },
+    { "precise", INPUT_REAL_TIME | INPUT_AT_ONCE | INPUT_FALLBACK | INPUT_RAW_BUTTONS },
+    { "classic", INPUT_FALLBACK },
+};
+enum { INPUT_LEGACY = 0, INPUT_FIXED = 3 };
