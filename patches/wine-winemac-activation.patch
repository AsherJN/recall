+{
+    long long nearest = 0;
+    BOOL near = FALSE;
+    unsigned int i;
+
+    for (i = 0; i < BUTTON_RECENT; i++)
+    {
+        const struct button_change* change = &button_recent[i];
+        long long offset = (long long)change->at - (long long)at;
+
+        if (!change->at || change->from == BUTTON_APPKIT || change->button != button || change->pressed != pressed)
+            continue;
+        if (!near || llabs(offset) < llabs(nearest)) nearest = offset;
+        near = TRUE;
+    }
+    button_stats.appkit_unmatched++;
+    button_stats.appkit_unmatched_nearest_ns = nearest;
+    button_stats.appkit_unmatched_near = near;
+}
+
+/* Whether raw input posted this change within the last 5 ms: the mouse's other
+ * interface reporting it too.  Called with mouselook_lock held. */
+static BOOL button_repeat(unsigned long long at, int button, int pressed)
+{
+    unsigned int i;
+
+    for (i = 0; i < BUTTON_RECENT; i++)
+    {
+        const struct button_change* change = &button_recent[i];
+
+        if (change->from == BUTTON_RAW && change->button == button && change->pressed == pressed &&
+            change->at <= at && at - change->at < 5000000)
+            return TRUE;
+    }
+    return FALSE;
+}
+
+/* A GCMouse or HID button change.  With INPUT_RAW_BUTTONS it goes to Wine now,
+ * after the motion pending before it, unless AppKit's copy got there first; the
+ * press is where Wine's cursor is, as mouselook clicks are.  Otherwise it is
+ * only noted. */
+static void raw_button(int button, BOOL pressed, BOOL hid)
+{
+    unsigned long long now = raw_clock();
+    BOOL post = (input_flags() & INPUT_RAW_BUTTONS) != 0;
+    struct button_change* copy;
+
+    if (button < 0 || button >= RAW_BUTTONS || !__atomic_load_n(&raw_on, __ATOMIC_ACQUIRE)) return;
+    if (post) raw_flush();
+
+    os_unfair_lock_lock(&mouselook_lock);
+    if (!post)
+    {
+        if (macdrv_input_stats_on) button_remember(now, button, pressed, BUTTON_OBSERVED, hid);
+    }
+    else if ((copy = button_copy(now, button, pressed, FALSE, hid)))
+        copy->matched = 1;
+    else if (!raw_window)
+        ;   /* mouselook just ended: AppKit posts it */
+    else if (button_repeat(now, button, pressed))
+        button_stats.raw_duplicates++;
+    else
+    {
+        macdrv_event* event = macdrv_create_event(MOUSE_BUTTON, raw_window);
+
+        event->mouse_button.button = button;
+        event->mouse_button.pressed = pressed;
+        event->mouse_button.x = floor(mouselook_position.x);
+        event->mouse_button.y = floor(mouselook_position.y);
+        event->mouse_button.time_ms = [[WineApplicationController sharedController] ticksForEventTime:now / 1e9];
+        event->mouse_button.no_move = TRUE;
+        [raw_window.queue postEvent:event];
+        macdrv_release_event(event);
+        button_remember(now, button, pressed, BUTTON_RAW, hid);
+        button_stats.raw_posted++;
+    }
+    os_unfair_lock_unlock(&mouselook_lock);
+}
+
+/* A HID report's motion, as GCMouse would give it (Y up), once all of the report's
+ * values have arrived: they arrive together, so this runs right after them. */
+static void hid_report_done(void* context)
+{
+    double dx = hid_pending_x, dy = hid_pending_y;
+
+    hid_report_scheduled = FALSE;
+    hid_pending_x = hid_pending_y = 0;
+    if (dx || dy) raw_motion(dx, -dy, hid_pending_source);
+}
+
+/* Whether macOS gives this process mouse input, so that HID's may go to the game. */
+static BOOL hid_confirmed(void)
+{
+    unsigned long long now = raw_clock(), seen = __atomic_load_n(&macos_mouse_last, __ATOMIC_RELAXED);
+
+    if (seen + hid_confirm_window > now)
+    {
+        hid_unconfirmed_since = 0;
+        return TRUE;
+    }
+    if (!hid_unconfirmed_since || seen > hid_unconfirmed_since) hid_unconfirmed_since = now;
+    return now - hid_unconfirmed_since < hid_confirm_window;
+}
+
+/* Motion macOS hasn't confirmed: held, or dropped once held for hid_hold_limit. */
+static void hid_hold(int device, uint32_t usage, CFIndex amount, BOOL fresh)
+{
+    unsigned long long now = raw_clock();
+
+    if (!hid_held_since)
+    {
+        hid_held_since = now;
+        __atomic_store_n(&hid_holding, 1, __ATOMIC_RELAXED);
+    }
+    if (now - hid_held_since > hid_hold_limit)
+    {
+        hid_stats.withheld += hid_held_reports + (fresh ? 1 : 0);
+        hid_held_reports = 0;
+        hid_held_x = hid_held_y = 0;
+        return;
+    }
+    if (usage == kHIDUsage_GD_X) hid_held_x += amount;
+    else hid_held_y += amount;
+    if (fresh) hid_held_reports++;
+    hid_held_source = HID_SOURCE + device;
+}
+
+/* Once macOS confirms HID's input again: the motion held goes with the next report,
+ * unless it was held for longer than hid_hold_limit (raw input stopped meanwhile). */
+static void hid_release_held(void)
+{
+    if (!hid_held_since) return;
+    if (raw_clock() - hid_held_since <= hid_hold_limit)
+    {
+        hid_pending_x += hid_held_x;
+        hid_pending_y += hid_held_y;
+        if (hid_held_x || hid_held_y) hid_pending_source = hid_held_source;
+        hid_stats.released += hid_held_reports;
+    }
+    else hid_stats.withheld += hid_held_reports;
+    hid_held_since = hid_held_reports = 0;
+    hid_held_x = hid_held_y = 0;
+    __atomic_store_n(&hid_holding, 0, __ATOMIC_RELAXED);
+}
+
+/* macOS's input arrived (GCMouse's handlers, on raw_queue too, or AppKit's through
+ * hid_hand_over): the motion held goes at once, even when the mouse has stopped since. */
+static void hid_deliver_held(void* context)
+{
+    if (!hid_held_since) return;
+    hid_release_held();
+    if ((hid_pending_x || hid_pending_y) && !hid_report_scheduled)
+    {
+        hid_report_scheduled = TRUE;
+        dispatch_async_f(raw_queue, NULL, hid_report_done);
+    }
+}
+
+/* AppKit's mouse event (main thread), once its time is recorded: only while motion is
+ * held does it cost more than a load. */
+static inline void hid_hand_over(void)
+{
+    if (__atomic_load_n(&hid_holding, __ATOMIC_RELAXED)) dispatch_async_f(raw_queue, NULL, hid_deliver_held);
+}
+
+static void hid_value(void* context, IOReturn result, void* sender, IOHIDValueRef value)
+{
+    IOHIDElementRef element = IOHIDValueGetElement(value);
+    IOHIDDeviceRef device = IOHIDElementGetDevice(element);
+    uint32_t page = IOHIDElementGetUsagePage(element), usage = IOHIDElementGetUsage(element);
+    CFIndex amount = IOHIDValueGetIntegerValue(value);
+    uint64_t stamp = IOHIDValueGetTimeStamp(value);
+    BOOL fresh;
+    int i;
+
+    for (i = 0; i < hid_device_count && hid_devices[i].device != device; i++);
+    if (i == hid_device_count || hid_devices[i].ignored || !__atomic_load_n(&raw_on, __ATOMIC_ACQUIRE))
+        return;
+    if (page == kHIDPage_Button)
+    {
+        unsigned int bit;
+
+        hid_stats.buttons++;
+        if (usage < 1 || usage > RAW_BUTTONS) return;
+        bit = 1u << (usage - 1);
+        if (!(amount ? hid_confirmed() : (hid_buttons_down & bit) != 0))
+        {
+            hid_stats.withheld++;
+            return;
+        }
+        if (amount) hid_buttons_down |= bit;
+        else hid_buttons_down &= ~bit;
+        /* The motion before the change goes first, as GCMouse's does. */
+        if (amount || hid_confirmed()) hid_release_held();
+        hid_report_done(NULL);
+        raw_button(usage - 1, amount != 0, TRUE);
+        return;
+    }
+    if (page != kHIDPage_GenericDesktop || (usage != kHIDUsage_GD_X && usage != kHIDUsage_GD_Y) || !amount)
+        return;
+    fresh = stamp != hid_devices[i].last_stamp;
+    if (fresh)
+    {
+        hid_devices[i].last_stamp = stamp;
+        hid_stats.reports++;
+    }
+    if (!hid_confirmed())
+    {
+        hid_hold(i, usage, amount, fresh);
+        return;
+    }
+    hid_release_held();
+    /* HID becomes the source with its first motion, not when a mouse opens: an
+       opened mouse that never reports leaves GCMouse delivering. */
+    if (!__atomic_load_n(&hid_active, __ATOMIC_RELAXED))
+        __atomic_store_n(&hid_active, 1, __ATOMIC_RELEASE);
+    if (usage == kHIDUsage_GD_X) hid_pending_x += amount;
+    else hid_pending_y += amount;
+    hid_pending_source = HID_SOURCE + i;
+    if (!hid_report_scheduled)
+    {
+        hid_report_scheduled = TRUE;
+        dispatch_async_f(raw_queue, NULL, hid_report_done);
+    }
+}
+
+static BOOL hid_is_trackpad(IOHIDDeviceRef device)
+{
+    CFTypeRef product = IOHIDDeviceGetProperty(device, CFSTR(kIOHIDProductKey));
+    CFTypeRef builtIn = IOHIDDeviceGetProperty(device, CFSTR(kIOHIDBuiltInKey));
+
+    if (builtIn && CFGetTypeID(builtIn) == CFBooleanGetTypeID() && CFBooleanGetValue(builtIn))
+        return TRUE;
+    return product && CFGetTypeID(product) == CFStringGetTypeID() &&
+           CFStringFind(product, CFSTR("Trackpad"), kCFCompareCaseInsensitive).location != kCFNotFound;
+}
+
+static void hid_device_matched(void* context, IOReturn result, void* sender, IOHIDDeviceRef device)
+{
+    int i, slot = -1;
+
+    for (i = 0; i < hid_device_count; i++)
+    {
+        if (hid_devices[i].device == device) return;
+        if (!hid_devices[i].device && slot < 0) slot = i;
+    }
+    if (slot < 0)
+    {
+        if (hid_device_count == HID_DEVICES) return;
+        slot = hid_device_count++;
+    }
+    hid_devices[slot].device = device;
+    hid_devices[slot].ignored = hid_is_trackpad(device);
+    hid_devices[slot].last_stamp = 0;
+    if (!hid_devices[slot].ignored) __atomic_add_fetch(&hid_mice, 1, __ATOMIC_RELAXED);
+}
+
+static void hid_device_removed(void* context, IOReturn result, void* sender, IOHIDDeviceRef device)
+{
+    int i;
+
+    for (i = 0; i < hid_device_count; i++)
+    {
+        if (hid_devices[i].device != device) continue;
+        hid_devices[i].device = NULL;
+        if (!hid_devices[i].ignored && __atomic_sub_fetch(&hid_mice, 1, __ATOMIC_RELAXED) == 0)
+            __atomic_store_n(&hid_active, 0, __ATOMIC_RELEASE);
+        return;
+    }
+}
+
+/* Opens the mice on raw_queue, so the game's main thread doesn't wait for it, if
+ * Recall has Input Monitoring. */
+static void hid_start(void)
+{
+    dispatch_async(raw_queue, ^{
+        NSDictionary* devices = @{@kIOHIDDeviceUsagePageKey: @(kHIDPage_GenericDesktop),
+                                  @kIOHIDDeviceUsageKey: @(kHIDUsage_GD_Mouse)};
+        NSArray* elements = @[@{@kIOHIDElementUsagePageKey: @(kHIDPage_GenericDesktop), @kIOHIDElementUsageKey: @(kHIDUsage_GD_X)},
+                              @{@kIOHIDElementUsagePageKey: @(kHIDPage_GenericDesktop), @kIOHIDElementUsageKey: @(kHIDUsage_GD_Y)},
+                              @{@kIOHIDElementUsagePageKey: @(kHIDPage_Button)}];
+        IOHIDAccessType access = IOHIDCheckAccess(kIOHIDRequestTypeListenEvent);
+
+        __atomic_store_n(&hid_access, access, __ATOMIC_RELAXED);
+        if (access != kIOHIDAccessTypeGranted) return;
+        hid_manager = IOHIDManagerCreate(kCFAllocatorDefault, kIOHIDOptionsTypeNone);
+        IOHIDManagerSetDeviceMatching(hid_manager, (CFDictionaryRef)devices);
+        IOHIDManagerSetInputValueMatchingMultiple(hid_manager, (CFArrayRef)elements);
+        IOHIDManagerRegisterDeviceMatchingCallback(hid_manager, hid_device_matched, NULL);
+        IOHIDManagerRegisterDeviceRemovalCallback(hid_manager, hid_device_removed, NULL);
+        IOHIDManagerRegisterInputValueCallback(hid_manager, hid_value, NULL);
+        IOHIDManagerSetDispatchQueue(hid_manager, raw_queue);
+        __atomic_store_n(&hid_open_result, IOHIDManagerOpen(hid_manager, kIOHIDOptionsTypeNone), __ATOMIC_RELAXED);
+        IOHIDManagerActivate(hid_manager);
+    });
+}
