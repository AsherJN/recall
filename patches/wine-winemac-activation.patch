+/* Game resolutions that the fullscreen canvas (cocoa_v1.m) shows on any display
+ * without changing its mode. Each display also lists those that fit inside its Wine
+ * rectangle, at each refresh rate it has, so a game can choose them where the monitor
+ * itself lacks the mode (a 16:10 size on a 16:9 monitor, 1440p on a MacBook). Changing
+ * the display to one of them still fails, as for any size the display lacks
+ * (find_best_display_mode). Larger sizes are left out: Wine keeps the pointer inside
+ * the display's rectangle, so part of the game's window would be out of reach. */
+static const struct { DWORD width, height; } canvas_sizes[] =
+{
+    {1920, 1080}, {1920, 1200}, {2560, 1440}, {2560, 1600}, {3840, 2160}, {3840, 2400},
+};
+
+static int add_canvas_modes(CGDirectDisplayID display_id, DEVMODEW *devmodes, int count, int default_bpp,
+                            const struct display_mode_descriptor *desc)
+{
+    CGDisplayModeRef current = CGDisplayCopyDisplayMode(display_id);
+    DWORD width = 0, height = 0;
+    int added = 0, i, j, k;
+
+    if (current)
+    {
+        width = CGDisplayModeGetWidth(current);
+        height = CGDisplayModeGetHeight(current);
+        if (retina_enabled && display_mode_matches_descriptor(current, desc))
+        {
+            width *= 2;
+            height *= 2;
+        }
+        CGDisplayModeRelease(current);
+    }
+    if (width < height)
+        return 0;
+
+    for (i = 0; i < ARRAY_SIZE(canvas_sizes); i++)
+    {
+        if (canvas_sizes[i].width > width || canvas_sizes[i].height > height)
+            continue;
+        /* At each refresh rate of the display's own modes at the default depth. */
+        for (j = 0; j < count; j++)
+        {
+            BOOL present = FALSE;
+
+            if (devmodes[j].dmBitsPerPel != default_bpp ||
+                (devmodes[j].dmDisplayFlags & (DM_INTERLACED | WINE_DM_UNSUPPORTED)))
+                continue;
+            for (k = 0; k < count + added && !present; k++)
+                present = devmodes[k].dmPelsWidth == canvas_sizes[i].width &&
+                          devmodes[k].dmPelsHeight == canvas_sizes[i].height &&
+                          devmodes[k].dmBitsPerPel == default_bpp &&
+                          devmodes[k].dmDisplayFrequency == devmodes[j].dmDisplayFrequency &&
+                          !(devmodes[k].dmDisplayFlags & WINE_DM_UNSUPPORTED);
+            if (present)
+                continue;
+            devmodes[count + added] = devmodes[j];
+            devmodes[count + added].dmPelsWidth = canvas_sizes[i].width;
+            devmodes[count + added].dmPelsHeight = canvas_sizes[i].height;
+            devmodes[count + added].dmDisplayFixedOutput = DMDFO_CENTER;
+            TRACE("canvas mode %ux%u @%u Hz\n", (unsigned)canvas_sizes[i].width,
+                  (unsigned)canvas_sizes[i].height, (unsigned)devmodes[j].dmDisplayFrequency);
+            added++;
+        }
+    }
+    return added;
+}
