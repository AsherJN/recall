+    /*
+     * Mouselook
+     *
+     * A Windows game aims by hiding the cursor, confining it (ClipCursor) or
+     * moving it back to the centre every frame (SetCursorPos), and reading
+     * motion.  Done literally on macOS, every re-centre is a synchronous
+     * CGWarpMouseCursorPosition on this thread while the game thread waits,
+     * and each warp discards the mouse motion queued behind it.
+     *
+     * Instead, while the client hides the cursor and confines or re-centres
+     * it, freeze the Mac pointer (CGAssociateMouseAndMouseCursorPosition) and
+     * deliver motion to Wine purely as relative movement.  Wine's own cursor
+     * position is then authoritative: re-centring and position queries are
+     * handled by Wine threads without this thread, clicks and scrolls happen
+     * at Wine's position, and the pointer reappears there when the mode ends.
+     *
+     * The motion is raw input from GCMouse (see raw_motion): mouse counts,
+     * as on Windows.  Without it (WINEMAC_MOUSELOOK_RAW=0, the test hotkey,
+     * a trackpad, or a mouse GCMouse does not report), pointer events stand in, scaled
+     * like absolute movement over the window, including the fullscreen
+     * canvas scale.
+     */
+    - (WineWindow*) mouselookTarget
+    {
+        WineWindow* window;
+
+        if (!mouselook_allowed || ![NSApp isActive])
+            return nil;
+        if (!clientWantsCursorHidden && !cursorTransparent)
+            return nil;
+        if (!self.clippingCursor && !mouselookHiddenWarp)
+            return nil;
+        // The event tap clipping handler moves the pointer itself.
+        if (clipCursorHandler && ![clipCursorHandler isKindOfClass:[WineConfinementClipCursorHandler class]])
+            return nil;
+        if ([windowsBeingDragged count])
+            return nil;
+
+        window = (WineWindow*)[NSApp keyWindow];
+        if (![window isKindOfClass:[WineWindow class]] || ![window isVisible] || [window isMiniaturized])
+            return nil;
+        return window;
+    }
