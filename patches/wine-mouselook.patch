+    - (void) enterMouselook:(WineWindow*)window
+    {
+        NSRect content = [window contentRectForFrameRect:[window frame]];
+        NSPoint location = [NSEvent mouseLocation];
+        CGPoint position;
+
+        mouselookWarpDelta = CGPointZero;
+        if (!NSMouseInRect(location, NSInsetRect(content, 1, 1), NO))
+        {
+            // Freeze the pointer over the window, so clicks go to it.  The
+            // warp shows up in the next event's delta; subtract it there.
+            NSPoint center = NSMakePoint(NSMidX(content), NSMidY(content));
+            CGPoint from = NSPointToCGPoint([self flippedMouseLocation:location]);
+            CGPoint to = NSPointToCGPoint([self flippedMouseLocation:center]);
+
+            CGSetLocalEventsSuppressionInterval(0);
+            if (CGWarpMouseCursorPosition(to) == kCGErrorSuccess)
+            {
+                mouselookWarpDelta = CGPointMake(to.x - from.x, to.y - from.y);
+                location = center;
+            }
+            CGSetLocalEventsSuppressionInterval(0.25);
+        }
+
+        if (CGAssociateMouseAndMouseCursorPosition(false) != kCGErrorSuccess)
+        {
+            mouselookWarpDelta = CGPointZero;
+            return;
+        }
+
+        position = cgpoint_win_from_mac(NSPointToCGPoint([self flippedMouseLocation:location]));
+        position = macdrv_v1_canvas_point(window, position, FALSE);
+
+        mouselookWindow = [window retain];
+        mouselookRemainderX = mouselookRemainderY = 0;
+        os_unfair_lock_lock(&mouselook_lock);
+        mouselook_position = CGPointMake(floor(position.x), floor(position.y));
+        __atomic_store_n(&mouselook_on, 1, __ATOMIC_RELEASE);
+        os_unfair_lock_unlock(&mouselook_lock);
+        [self updateRawInput];
+        cocoa_stats.mouselook_enters++;
+    }
