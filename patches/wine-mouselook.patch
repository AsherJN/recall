+    - (void) handleMouselookMove:(NSEvent*)anEvent
+    {
+        static int unscaled = -1;
+        double scale = retina_on ? 2.0 : 1.0;
+        NSTimeInterval now;
+
+        // Raw input carries this motion.  Pointer events stand in only while
+        // GCMouse is silent, for example for a mouse it does not report.
+        if (__atomic_load_n(&raw_on, __ATOMIC_ACQUIRE))
+        {
+            if (macdrv_stat_clock() - __atomic_load_n(&raw_last_motion, __ATOMIC_RELAXED) < raw_silence)
+            {
+                mouselookWarpDelta = CGPointZero;
+                cocoa_stats.pointer_ignored++;
+                return;
+            }
+            cocoa_stats.pointer_fallback++;
+        }
+
+        // By default, keep the fullscreen canvas scale that absolute motion
+        // over the window has.  WINEMAC_MOUSELOOK_UNSCALED=1 uses the scale of
+        // edge-pinned relative motion instead, for comparison.
+        if (unscaled < 0)
+        {
+            const char* value = getenv("WINEMAC_MOUSELOOK_UNSCALED");
+            unscaled = value && *value == '1';
+        }
+        if (!unscaled)
+            scale /= macdrv_v1_canvas_scale(mouselookWindow);
+
+        // deltaY is already top-down, like Windows.
+        mouselookRemainderX += ([anEvent deltaX] - mouselookWarpDelta.x) * scale;
+        mouselookRemainderY += ([anEvent deltaY] - mouselookWarpDelta.y) * scale;
+        mouselookWarpDelta = CGPointZero;
+        mouselookPendingTime = [anEvent timestamp];
+        mouselookPendingDrag = [anEvent type] != NSEventTypeMouseMoved;
+        cocoa_stats.mouselook_moves++;
+
+        if (mouselookInterval <= 0)
+        {
+            [self postMouselookMotion];
+            return;
+        }
+
+        // Optional cap on the delivery rate (WINEMAC_MOUSELOOK_INTERVAL_US);
+        // motion in between accumulates and is never dropped.
+        now = [[NSProcessInfo processInfo] systemUptime];
+        if (now - mouselookLastPost >= mouselookInterval)
+            [self postMouselookMotion];
+        else if (!mouselookFlushScheduled)
+        {
+            mouselookFlushScheduled = TRUE;
+            dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)((mouselookLastPost + mouselookInterval - now) * NSEC_PER_SEC)),
+                           dispatch_get_main_queue(), ^{
+                mouselookFlushScheduled = FALSE;
+                [self postMouselookMotion];
+            });
+        }
