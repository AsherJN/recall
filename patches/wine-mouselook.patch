+        [self updateRawInput];
+        os_unfair_lock_lock(&mouselook_lock);
+        __atomic_store_n(&mouselook_on, 0, __ATOMIC_RELEASE);
+        position = mouselook_position;
+        os_unfair_lock_unlock(&mouselook_lock);
