+        if (mouselookUpdateScheduled)
+            return;
+        mouselookUpdateScheduled = TRUE;
+        dispatch_async(dispatch_get_main_queue(), ^{
+            WineWindow* target;
+
+            mouselookUpdateScheduled = FALSE;
+            [self startRawInput];
+            target = [self mouselookTarget];
+            if (mouselookWindow && target != mouselookWindow)
+                [self leaveMouselook];
+            if (target && !mouselookWindow)
