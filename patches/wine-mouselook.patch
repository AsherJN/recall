+/* Follows Wine's cursor, as Wine clips it, for placing the pointer when
+ * mouselook ends.  Called with mouselook_lock held. */
+static void mouselook_move_position(int x, int y)
+{
+    mouselook_position.x += x;
+    mouselook_position.y += y;
+    if (!CGRectIsInfinite(mouselook_clip))
