+/* A service's security descriptor is kept where Windows keeps it: the Security value of the
+ * service key's Security subkey, self-relative. A service without one has Windows' default.
+ * Handles are still granted without checking it, but programs read back what they set
+ * (Battle.net's update agent checks the descriptor it gave its helper service). */
+static const WCHAR default_service_sd[] = L"O:SYG:SYD:(A;;CCLCSWRPWPDTLOCRRC;;;SY)"
+        L"(A;;CCDCLCSWRPWPDTLOCRSDRCWDWO;;;BA)(A;;CCLCSWLOCRRC;;;IU)(A;;CCLCSWLOCRRC;;;SU)";
+
+static PSECURITY_DESCRIPTOR load_service_sd(struct service_entry *service)
+{
+    PSECURITY_DESCRIPTOR sd = NULL;
+    SECURITY_DESCRIPTOR_CONTROL control;
+    DWORD size = 0, revision;
+    HKEY key;
+
+    if (!RegOpenKeyExW(service->db->root_key, service->name, 0, KEY_READ, &key))
+    {
+        if (!RegGetValueW(key, L"Security", L"Security", RRF_RT_REG_BINARY, NULL, NULL, &size) &&
+            (sd = LocalAlloc(LMEM_FIXED, size)) &&
+            (RegGetValueW(key, L"Security", L"Security", RRF_RT_REG_BINARY, NULL, sd, &size) ||
+             !IsValidSecurityDescriptor(sd) || !GetSecurityDescriptorControl(sd, &control, &revision) ||
+             !(control & SE_SELF_RELATIVE) || GetSecurityDescriptorLength(sd) > size))
+        {
+            LocalFree(sd);
+            sd = NULL;
+        }
+        RegCloseKey(key);
+    }
+    if (!sd) ConvertStringSecurityDescriptorToSecurityDescriptorW(default_service_sd, SDDL_REVISION_1, &sd, NULL);
+    return sd;
+}
+
+static DWORD save_service_sd(struct service_entry *service, PSECURITY_DESCRIPTOR sd, DWORD len)
+{
+    DWORD err;
+    HKEY key;
+
+    if ((err = RegCreateKeyExW(service->db->root_key, service->name, 0, NULL, 0, KEY_ALL_ACCESS, NULL, &key, NULL)))
+        return err;
+    err = RegSetKeyValueW(key, L"Security", L"Security", REG_BINARY, sd, len);
+    RegCloseKey(key);
+    return err;
+}
+
+/* A self-relative descriptor with the parts named in info taken from new_sd and the
+ * others from old_sd, if given. */
+static PSECURITY_DESCRIPTOR combine_sd(PSECURITY_DESCRIPTOR old_sd, PSECURITY_DESCRIPTOR new_sd,
+                                       SECURITY_INFORMATION info, DWORD *len)
+{
+    PSECURITY_DESCRIPTOR source, result;
+    SECURITY_DESCRIPTOR sd;
+    BOOL present, defaulted;
+    PSID sid;
+    PACL acl;
+
+    InitializeSecurityDescriptor(&sd, SECURITY_DESCRIPTOR_REVISION);
+    source = (info & OWNER_SECURITY_INFORMATION) ? new_sd : old_sd;
+    if (source && GetSecurityDescriptorOwner(source, &sid, &defaulted))
+        SetSecurityDescriptorOwner(&sd, sid, defaulted);
+    source = (info & GROUP_SECURITY_INFORMATION) ? new_sd : old_sd;
+    if (source && GetSecurityDescriptorGroup(source, &sid, &defaulted))
+        SetSecurityDescriptorGroup(&sd, sid, defaulted);
+    source = (info & DACL_SECURITY_INFORMATION) ? new_sd : old_sd;
+    if (source && GetSecurityDescriptorDacl(source, &present, &acl, &defaulted))
+        SetSecurityDescriptorDacl(&sd, present, acl, defaulted);
+    source = (info & SACL_SECURITY_INFORMATION) ? new_sd : old_sd;
+    if (source && GetSecurityDescriptorSacl(source, &present, &acl, &defaulted))
+        SetSecurityDescriptorSacl(&sd, present, acl, defaulted);
+
+    *len = 0;
+    MakeSelfRelativeSD(&sd, NULL, len);
+    if (!(result = LocalAlloc(LMEM_FIXED, *len))) return NULL;
+    if (!MakeSelfRelativeSD(&sd, result, len))
+    {
+        LocalFree(result);
+        return NULL;
+    }
+    return result;
+}
+
+static void trace_sd(const char *what, const struct service_entry *service, PSECURITY_DESCRIPTOR sd)
+{
+    WCHAR *text = NULL;
+
+    if (!WINE_TRACE_ON(service)) return;
+    if (sd && ConvertSecurityDescriptorToStringSecurityDescriptorW(sd, SDDL_REVISION_1,
+            OWNER_SECURITY_INFORMATION | GROUP_SECURITY_INFORMATION | DACL_SECURITY_INFORMATION, &text, NULL))
+    {
+        WINE_TRACE("%s %s: %s\n", what, wine_dbgstr_w(service->name), wine_dbgstr_w(text));
+        LocalFree(text);
+    }
+}
+
+/* The rights a handle needs to read, or change, these parts of a descriptor. */
+static DWORD sd_access(SECURITY_INFORMATION info, BOOL change)
+{
+    DWORD access = 0;
+
+    if (info & (OWNER_SECURITY_INFORMATION | GROUP_SECURITY_INFORMATION))
+        access |= change ? WRITE_OWNER : READ_CONTROL;
+    if (info & DACL_SECURITY_INFORMATION)
+        access |= change ? WRITE_DAC : READ_CONTROL;
+    if (info & SACL_SECURITY_INFORMATION)
+        access |= ACCESS_SYSTEM_SECURITY;
+    return access;
+}
+
