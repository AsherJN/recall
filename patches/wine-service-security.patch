+
+    trace_sd("stored", handle->service_entry, stored);
+    result = combine_sd(NULL, stored, info, &len);
+    LocalFree(stored);
+    if (!result) return ERROR_NOT_ENOUGH_MEMORY;
+
+    *needed_size = len;
+    if (len <= buf_size) memcpy(descriptor, result, len);
+    else err = ERROR_INSUFFICIENT_BUFFER;
+    LocalFree(result);
+    return err;
 }
 
 DWORD __cdecl svcctl_SetServiceObjectSecurity(
@@ -1912,8 +2060,35 @@ DWORD __cdecl svcctl_SetServiceObjectSecurity(
     BYTE *descriptor,
     DWORD buf_size)
 {
-    WINE_FIXME("\n");
-    return ERROR_CALL_NOT_IMPLEMENTED;
+    PSECURITY_DESCRIPTOR stored = NULL, result = NULL;
+    struct sc_service_handle *handle;
+    DWORD err, len;
+
+    WINE_TRACE("(%p, %#lx, %p, %lu)\n", service, info, descriptor, buf_size);
+
+    if ((err = validate_service_handle(service, sd_access(info, TRUE), &handle)) != 0)
