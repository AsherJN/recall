+        trace_sd("given", handle->service_entry, descriptor);
+        trace_sd("saved", handle->service_entry, result);
+        err = save_service_sd(handle->service_entry, result, len);
+    }
+    service_unlock(handle->service_entry);
+
+    LocalFree(stored);
+    LocalFree(result);
+    return err;
 }
 
