+/* A copy of a service's command line with the program's path in Windows' form: a program
+ * named with forward slashes ("C:/dir/app.exe") is stored as C:\dir\app.exe, as programs read
+ * it back on Windows. Battle.net's update agent names its helper service's program with forward
+ * slashes and, on the next start, finds its helper broken unless the path reads back with
+ * backslashes, so it reinstalls itself on every other start. Arguments are left alone. */
+static WCHAR *image_path_dup(const WCHAR *path)
+{
+    WCHAR *copy = wcsdup(path), *p, *end;
+
+    if (!copy) return NULL;
+    p = copy[0] == '"' ? copy + 1 : copy;
+    if (!((p[0] >= 'A' && p[0] <= 'Z') || (p[0] >= 'a' && p[0] <= 'z')) || p[1] != ':' || (p[2] != '/' && p[2] != '\\'))
+        return copy;
+    end = p == copy ? wcschr(p, ' ') : wcschr(p, '"');
+    if (!end) end = p + wcslen(p);
+    for (; p < end; p++) if (*p == '/') *p = '\\';
+    return copy;
+}
