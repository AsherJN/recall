+/* WINE_APP_DPI=<dpi>:<name.exe>[;<name.exe>...] gives the programs with these file names
+ * (any case) that DPI, from 96 to 480. Child processes inherit the variable, so a program
+ * it does not name keeps the session's DPI even when a named one starts it. */
+static UINT get_app_dpi(void)
+{
+    const char *value = getenv( "WINE_APP_DPI" ), *name, *next;
+    const WCHAR *image = NtCurrentTeb()->Peb->ProcessParameters->ImagePathName.Buffer, *p;
+    unsigned long dpi;
+    char *end;
+    size_t i, len;
+
+    if (!value || !image) return 0;
+    dpi = strtoul( value, &end, 10 );
+    if (*end != ':' || dpi < USER_DEFAULT_SCREEN_DPI || dpi > 480) return 0;
+    if ((p = wcsrchr( image, '\\' ))) image = p + 1;
+    if ((p = wcsrchr( image, '/' ))) image = p + 1;
+    for (name = end + 1; *name; name = next + 1)
+    {
+        len = (next = strchr( name, ';' )) ? next - name : strlen( name );
+        for (i = 0; i < len && image[i] && RtlDowncaseUnicodeChar( image[i] ) ==
+             RtlDowncaseUnicodeChar( (unsigned char)name[i] ); i++);
+        if (len && i == len && !image[i]) return dpi;
+        if (!next) break;
+    }
+    return 0;
+}
