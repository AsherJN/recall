+/* WINE_DISPLAY_LOG=<file> (diagnostics): every forced display-device update (a full query
+ * of the display driver that rewrites the display registry keys) and every display mode
+ * change notification, with the reason, a native backtrace and the time it took. */
+static FILE *display_log_file;
+static pthread_mutex_t display_log_mutex = PTHREAD_MUTEX_INITIALIZER;
+
+static FILE *display_log(void)
+{
+    static int initialized;
+    const char *value;
+    char path[1024];
+
+    if (initialized) return display_log_file;
+    pthread_mutex_lock( &display_log_mutex );
+    if (!initialized)
+    {
+        if ((value = getenv( "WINE_DISPLAY_LOG" )) && *value)
+        {
+            snprintf( path, sizeof(path), "%s.%d", value, (int)getpid() );
+            if ((display_log_file = fopen( path, "a" ))) setvbuf( display_log_file, NULL, _IOLBF, 0 );
+        }
+        initialized = 1;
+    }
+    pthread_mutex_unlock( &display_log_mutex );
+    return display_log_file;
+}
+
+static double display_log_now(void)
+{
+    struct timeval now;
+    gettimeofday( &now, NULL );
+    return now.tv_sec + now.tv_usec / 1e6;
+}
+
+static void display_log_event( const char *event, double elapsed_ms )
+{
+    void *frames[12];
+    char line[2048];
+    size_t pos;
+    int count, i;
+    FILE *file = display_log();
+
+    if (!file) return;
+    pos = snprintf( line, sizeof(line), "%.3f tid=%04x %s ms=%.1f |", display_log_now(),
+                    (unsigned int)GetCurrentThreadId(), event, elapsed_ms );
+    count = backtrace( frames, 12 );
+    for (i = 1; i < count && pos < sizeof(line) - 128; i++)
+    {
+        Dl_info info;
+        const char *module = "?", *slash;
+        if (dladdr( frames[i], &info ) && info.dli_fname)
+        {
+            /* offsets from the image base resolve against the unstripped build with atos */
+            module = (slash = strrchr( info.dli_fname, '/' )) ? slash + 1 : info.dli_fname;
+            pos += snprintf( line + pos, sizeof(line) - pos, " %s+%#lx", module,
+                             (unsigned long)((char *)frames[i] - (char *)info.dli_fbase) );
+        }
+        else pos += snprintf( line + pos, sizeof(line) - pos, " %p", frames[i] );
+    }
+    pthread_mutex_lock( &display_log_mutex );
+    fprintf( file, "%s\n", line );
+    pthread_mutex_unlock( &display_log_mutex );
+}
