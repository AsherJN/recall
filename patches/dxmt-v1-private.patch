+  struct State {
+    std::atomic_flag lock = ATOMIC_FLAG_INIT;
+    std::atomic_bool closing{false}, done{false};
+    std::atomic_uint64_t next{0}, dropped{0}, owners{0};
+    std::array<Event, Capacity> ring{};
+    unsigned head = 0, count = 0;
+    std::string path;
+  };
+  struct Output { std::string path; const char *header; FILE *file = nullptr; uint64_t bytes = 0, rotations = 0; };
