+      std::this_thread::sleep_for(std::chrono::milliseconds(100));
+    }
+    summary();
+    if (frames.file) std::fclose(frames.file);
+    if (events.file) std::fclose(events.file);
+    s->done.store(true, std::memory_order_release);
+  }
+  explicit FrameTelemetry(const char *prefix, uint64_t generation) : state_(std::make_shared<State>()) {
+    state_->path = std::string(prefix) + "-" + std::to_string(getpid());
+    if (generation > 1) state_->path += "-run" + std::to_string(generation);
+#ifdef _WIN32
+    // A timed-out writer may outlive its last queue, including DLL unload.
+    HMODULE pin = nullptr;
+    if (!GetModuleHandleExA(GET_MODULE_HANDLE_EX_FLAG_PIN | GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS,
+          reinterpret_cast<LPCSTR>(&FrameTelemetry::stamp), &pin)) {
+      state_->closing.store(true); state_->done.store(true); return;
+    }
+#endif
+    worker_ = dxmt::thread([state = state_] {
+      try { run(state); }
+      catch (...) {
+        // Optional diagnostics must never terminate gameplay after an allocation
+        // or library failure. A blocked/open stream can remain process-lifetime.
+        state->closing.store(true, std::memory_order_release);
+        state->done.store(true, std::memory_order_release);
+      }
+    });
+#ifdef _WIN32
+    worker_.set_priority(ThreadPriority::Lowest);
+#endif
+  }
+};
+} // namespace dxmt
