+- (void)persistArchive:(id<MTLBinaryArchive>)archive {
+  if (!_writeOwner || _diskBytes > DiskByteLimit - ArchiveByteLimit || _archiveFiles >= 64) return;
+  // A compact replacement is only valid if it preserves ALL existing archive
+  // coverage. The launcher prepares a cloned cache and verifies this again in
+  // a fresh process before publishing it; original archive files remain intact.
+  if (_offline && ![_archivedKeys isSubsetOfSet:_capturedKeys]) {
+    atomic_fetch_add(&_archiveFailures, 1);
+    [self event:@"archive_serialize" values:@{@"success": @NO, @"failure_stage": @"incomplete_previous_coverage"}];
+    return;
+  }
+  NSString *temporary = [_archiveDirectory stringByAppendingPathComponent:[NSString stringWithFormat:@"capture-%d.tmp", getpid()]];
+  @try {
+    NSError *error = nil;
+    BOOL serialized = [archive serializeToURL:[NSURL fileURLWithPath:temporary] error:&error];
+    NSData *bytes = serialized ? readBounded(temporary, ArchiveByteLimit) : nil;
+    NSString *hash = digest(bytes);
+    BOOL saved = NO;
+    if (bytes && hash && _diskBytes <= DiskByteLimit - bytes.length &&
+        (_offline || _activeArchiveBytes <= ArchiveByteLimit - bytes.length)) {
+      NSString *target = [_archiveDirectory stringByAppendingPathComponent:[hash stringByAppendingString:@".metallib"]];
+      struct stat prior;
+      BOOL exists = !lstat(target.fileSystemRepresentation, &prior);
+      if (exists && S_ISREG(prior.st_mode) && [digest(readBounded(target, ArchiveByteLimit)) isEqual:hash]) saved = YES;
+      else if ((!exists || S_ISREG(prior.st_mode)) &&
+               !rename(temporary.fileSystemRepresentation, target.fileSystemRepresentation)) {
+        uint64_t old = exists ? (uint64_t)prior.st_size : 0;
+        _diskBytes += bytes.length; _diskBytes -= MIN(old, _diskBytes);
+        if (!exists) ++_archiveFiles;
+        saved = YES;
+      }
+      if (saved) {
+        NSMutableArray *entries = _offline ? [NSMutableArray array] : [NSMutableArray arrayWithArray:_archiveEntries];
+        [entries addObject:@{@"sha256": hash, @"bytes": @(bytes.length), @"prepared_keys": _capturedKeys.allObjects}];
+        NSData *manifest = [NSJSONSerialization dataWithJSONObject:@{@"schema": @2, @"archives": entries,
+            @"prepared_keys": _archivedKeys.allObjects} options:0 error:nil];
+        if (manifest.length > 1024 * 1024) saved = NO;
+        else saved = [self writeData:manifest to:[_directory stringByAppendingPathComponent:@"archive.json"]];
+        if (saved) { [_archiveEntries setArray:entries]; _activeArchiveBytes = (_offline ? 0 : _activeArchiveBytes) + bytes.length; }
+      }
+    }
+    if (!saved) atomic_fetch_add(&_archiveFailures, 1);
+    [self event:@"archive_serialize" values:@{@"success": @(saved), @"bytes": @(bytes.length),
+        @"serialized": @(serialized), @"error_domain": error.domain ?: @"", @"error_code": @(error.code),
+        @"failure_stage": saved ? @"none" : !serialized ? @"serialize" : !bytes ? @"readback" : @"publish"}];
+  } @finally {
+    unlink(temporary.fileSystemRepresentation);
+  }
+}
