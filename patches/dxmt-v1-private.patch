+  _libraryDirectory = [[_directory stringByAppendingPathComponent:@"libraries"] copy];
+  _recipeDirectory = [[_directory stringByAppendingPathComponent:@"recipes"] copy];
+  _archiveDirectory = [[_directory stringByAppendingPathComponent:@"archives"] copy];
+  const char *log = getenv("DXMT_PIPELINE_CACHE_LOG");
