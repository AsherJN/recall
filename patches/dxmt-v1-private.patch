+# comparison only; the existing False policy remains the default. Measure
+# drawable presentedTime before drawing conclusions from the FPS counter.
+#
+# Supported values: True, False
+
+# dxgi.displaySyncEnabled = False
+
 # Sanitize NaN sample coordinates to zero. This is an UB anyway, just less broken.
 #
 # Supported values: True, False
