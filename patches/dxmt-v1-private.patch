+  }
+  static void run(std::shared_ptr<State> s) {
+    Output frames{s->path + ".csv",
+      "schema_version,present_boundary,present_interval_us,shader_compile_starts,unix_us,monotonic_us,queue_id,frame_latency_wait_us,event_id,dropped_events,pacing_sleep_us\n"};
+    Output events{s->path + ".events.csv",
+      "schema_version,event_id,event,owner_id,frame_id,chunk_id,unix_us,monotonic_us,duration_us,dropped_events\n"};
+    uint64_t io_errors = !open(frames) + !open(events), written = 0, over25 = 0, over50 = 0, over100 = 0;
+    uint64_t intervals = 0, interval_us = 0, max_us = 0, disk_lost = 0;
+    std::array<uint64_t, KindCount> counts{};
+    int64_t first = 0, last = 0;
+    const char *names[] = {"boundary", "frame_latency", "coherence_wait", "chunk_capacity_wait", "encode", "submit", "completion_wait", "next_drawable", "layer_sync_wait", "initializer_flush", "command_buffer_acquire"};
+    auto summary = [&] {
+      auto target = s->path + ".summary.json", temporary = target + ".tmp";
+      FILE *f = std::fopen(temporary.c_str(), "w");
+      if (!f) { ++io_errors; return; }
+      int n = std::fprintf(f,
+        "{\"schema_version\":1,\"first_unix_us\":%lld,\"last_unix_us\":%lld,\"events_written\":%llu,\"boundary_intervals\":%llu,"
+        "\"interval_us\":%llu,\"max_interval_us\":%llu,\"over25ms\":%llu,\"over50ms\":%llu,\"over100ms\":%llu,"
+        "\"dropped_events\":%llu,\"disk_events_lost\":%llu,\"io_errors\":%llu,\"frame_rotations\":%llu,\"event_rotations\":%llu,\"segment_limit\":%llu,\"segments\":3,\"span_threshold_us\":2000,\"span_counts\":[",
+        (long long)first, (long long)last, (unsigned long long)written, (unsigned long long)intervals,
+        (unsigned long long)interval_us, (unsigned long long)max_us, (unsigned long long)over25,
+        (unsigned long long)over50, (unsigned long long)over100, (unsigned long long)s->dropped.load(),
+        (unsigned long long)disk_lost, (unsigned long long)io_errors, (unsigned long long)frames.rotations,
+        (unsigned long long)events.rotations, (unsigned long long)SegmentBytes);
+      for (unsigned i = 0; i < KindCount; ++i) if (std::fprintf(f, "%s%llu", i ? "," : "", (unsigned long long)counts[i]) < 0) n = -1;
+      if (std::fprintf(f, "],\"interpretation\":\"CPU intervals and sparse local spans; nested spans overlap and must not be summed as exclusive frame time. Counters include rotated-out accepted events.\"}\n") < 0) n = -1;
+      if (std::fclose(f)) n = -1;
+      if (n < 0 || !replace(temporary, target)) ++io_errors;
+    };
+    unsigned ticks = 0;
+    for (;;) {
+      // The writer may retry; producers always try once and never wait.
+      std::array<Event, 256> batch;
+      bool drained = false;
+      for (unsigned pass = 0; pass < Capacity / batch.size(); ++pass) {
+        while (s->lock.test_and_set(std::memory_order_acquire)) std::this_thread::yield();
+        unsigned n = std::min<unsigned>(s->count, batch.size());
+        for (unsigned i = 0; i < n; ++i) batch[i] = s->ring[(s->head + i) % Capacity];
+        s->head = (s->head + n) % Capacity; s->count -= n;
+        s->lock.clear(std::memory_order_release);
+        for (unsigned i = 0; i < n; ++i) {
+          auto &e = batch[i];
+          if (!first) first = e.end.unix_us;
+          last = std::max(last, e.end.unix_us);
+          ++counts[e.kind];
+          if (e.kind == Boundary) {
+            ++intervals; interval_us += e.duration_us; max_us = std::max<uint64_t>(max_us, e.duration_us);
+            over25 += e.duration_us > 25000; over50 += e.duration_us > 50000; over100 += e.duration_us > 100000;
+          }
+          Output &out = e.kind == Boundary ? frames : events;
+          if (!rotate(out)) { ++disk_lost; continue; }
+          int bytes;
+          if (e.kind == Boundary) bytes = std::fprintf(out.file, "4,%llu,%lld,%llu,%lld,%lld,%llu,%lld,%llu,%llu,%lld\n",
+            (unsigned long long)e.frame_id, (long long)e.duration_us, (unsigned long long)e.compile_starts,
+            (long long)e.end.unix_us, (long long)e.end.monotonic_us, (unsigned long long)e.owner_id,
+            (long long)e.latency_wait_us, (unsigned long long)e.event_id, (unsigned long long)s->dropped.load(),
+            (long long)e.pacing_us);
+          else bytes = std::fprintf(out.file, "1,%llu,%s,%llu,%llu,%llu,%lld,%lld,%lld,%llu\n",
+            (unsigned long long)e.event_id, names[e.kind], (unsigned long long)e.owner_id,
+            (unsigned long long)e.frame_id, (unsigned long long)e.chunk_id, (long long)e.end.unix_us,
+            (long long)e.end.monotonic_us, (long long)e.duration_us, (unsigned long long)s->dropped.load());
+          if (bytes > 0) { out.bytes += bytes; ++written; } else { ++io_errors; ++disk_lost; }
+        }
+        if (n < batch.size()) { drained = true; break; }
+      }
+      if (frames.file && std::fflush(frames.file)) ++io_errors;
+      if (events.file && std::fflush(events.file)) ++io_errors;
