+- (void)prewarm {
+  if (!atomic_load(&_accepting) || atomic_load(&globallyStopped)) return;
+  if (_offline && !_writeOwner) return;
+  [self loadArchive];
+  if (!_prewarmLimit || CACurrentMediaTime() >= _startupDeadline) return;
+  double rankingStarted = CACurrentMediaTime();
+  NSArray *recipes = [self rankedRecipes];
+  [self event:@"prewarm_ranked" values:@{@"candidates": @(recipes.count),
+      @"duration_ms": @((CACurrentMediaTime() - rankingStarted) * 1000),
+      @"budget_remaining_ms": @(MAX(0, (_startupDeadline - CACurrentMediaTime()) * 1000))}];
+  MTLBinaryArchiveDescriptor *archiveDescriptor = [[MTLBinaryArchiveDescriptor alloc] init];
+  // Never extend a previously serialized archive. On this Metal runtime,
+  // adding another library to a loaded archive can succeed yet later fail
+  // serialization. A fresh immutable batch preserves prior batches unchanged.
+  NSError *error = nil;
+  id<MTLBinaryArchive> capture = _writeOwner && !_offlineVerify && (_offline || _archiveEntries.count < 32)
+      ? [_device newBinaryArchiveWithDescriptor:archiveDescriptor error:&error] : nil;
+  [archiveDescriptor release];
+  unsigned attempted = 0;
+  for (NSDictionary *entry in recipes) {
+    if (attempted >= _prewarmLimit || (atomic_load(&_stopped) || atomic_load(&globallyStopped)) || CACurrentMediaTime() >= _startupDeadline) break;
+    @autoreleasepool {
+      NSString *path = [_recipeDirectory stringByAppendingPathComponent:[entry[@"key"] stringByAppendingString:@".json"]];
+      NSData *data = readBounded(path, DXMT_RECIPE_ENCODED_MAX_BYTES * 2);
+      NSDictionary *envelope = data ? [NSJSONSerialization JSONObjectWithData:data options:0 error:nil] : nil;
+      NSDictionary *recipe = [envelope isKindOfClass:NSDictionary.class]
+          ? dxmt_recipe_decode(dxmt_recipe_encode(envelope[@"recipe"])) : nil;
+      if (!recipe || ![dxmt_recipe_key(recipe) isEqual:entry[@"key"]]) {
+        atomic_fetch_add(&_prewarmFailures, 1); continue;
+      }
+      NSError *restoreError = nil;
+      MTLRenderPipelineDescriptor *descriptor = dxmt_recipe_restore(_device, recipe, ^NSData *(NSString *key) {
+        return [self library:key];
+      }, &restoreError);
+      if (!descriptor) { atomic_fetch_add(&_prewarmFailures, 1); continue; }
+      if (CACurrentMediaTime() >= _startupDeadline) { [descriptor release]; break; }
+      // Missing library files must not consume the PSO selection budget and
+      // repeatedly starve lower-ranked recipes that can actually be restored.
+      ++attempted;
+      if (_loadedArchives.count) descriptor.binaryArchives = _loadedArchives;
+      double started = CACurrentMediaTime();
+      id<MTLRenderPipelineState> state = nil;
+      BOOL archiveHit = NO;
+      if (_loadedArchives.count) {
+        state = [_device newRenderPipelineStateWithDescriptor:descriptor
+            options:MTLPipelineOptionFailOnBinaryArchiveMiss reflection:nil error:&restoreError];
+        archiveHit = state != nil;
+        [self recordArchiveLookup:archiveHit];
+      }
+      if (!state && !_offlineVerify) {
+        descriptor.binaryArchives = nil;
+        if (CACurrentMediaTime() >= _startupDeadline) { [descriptor release]; break; }
+        state = [_device newRenderPipelineStateWithDescriptor:descriptor
+            options:MTLPipelineOptionNone reflection:nil error:&restoreError];
+      }
+      if (state) {
+        [self remember:state key:entry[@"key"] cost:[entry[@"cost_us"] doubleValue]];
+        atomic_fetch_add(&_prewarmed, 1);
+        // Archive population is startup-only, and only begun while budget remains.
+        // An in-flight Metal call cannot be canceled and may finish after deadline.
+        if (capture && (_offline || !archiveHit || ![_archivedKeys containsObject:entry[@"key"]]) &&
+            ![_capturedKeys containsObject:entry[@"key"]] &&
+            !(atomic_load(&_stopped) || atomic_load(&globallyStopped)) && CACurrentMediaTime() < _startupDeadline) {
+          descriptor.binaryArchives = nil;
+          if ([capture addRenderPipelineFunctionsWithDescriptor:descriptor error:&restoreError]) {
+            atomic_fetch_add(&_archiveAdds, 1);
+            if (_archivedKeys.count < RecipeCapacity || [_archivedKeys containsObject:entry[@"key"]]) {
+              [_archivedKeys addObject:entry[@"key"]]; [_capturedKeys addObject:entry[@"key"]];
+            }
+          } else atomic_fetch_add(&_archiveFailures, 1);
+        }
+      } else atomic_fetch_add(&_prewarmFailures, 1);
+      [self event:@"prewarm" values:@{@"key": entry[@"key"], @"success": @(state != nil),
+          @"duration_us": @((CACurrentMediaTime() - started) * 1000000)}];
+      [state release]; [descriptor release];
+    }
+  }
+  if (capture && _capturedKeys.count) [self persistArchive:capture];
+  [capture release];
+  [self event:@"prewarm_complete" values:@{@"attempted": @(attempted), @"completed": @(atomic_load(&_prewarmed)),
+      @"deadline_exceeded": @(CACurrentMediaTime() > _startupDeadline)}];
+}
