+- (BOOL)enqueuePrimary:(BOOL)library key:(NSString *)key data:(NSData *)data cost:(double)cost {
+  if (!atomic_load(&_accepting) || (atomic_load(&_stopped) || atomic_load(&globallyStopped)) || !validKey(key) || !data.length ||
+      data.length > (library ? DXMT_RECIPE_LIBRARY_MAX_BYTES : DXMT_RECIPE_ENCODED_MAX_BYTES) || !isfinite(cost) || cost < 0) return NO;
+  if (atomic_load_explicit(&_startupDone, memory_order_acquire) && !_writeOwner) {
+    atomic_fetch_add(&_readonlyRejects, 1); return NO;
+  }
+  if (!os_unfair_lock_trylock(&_recordLock)) {
+    atomic_fetch_add(&_queueContention, 1); return NO;
+  }
+  BOOL accepted = NO;
+  @try {
+    if (atomic_load(&globallyStopped)) return NO;
+    NSNumber *saved = (library ? _savedLibraryKeys : _savedRecipeCosts)[key];
+    if (saved && (library || cost <= saved.doubleValue)) {
+      atomic_fetch_add(&_duplicates, 1); return YES;
+    }
+    if (_inflight.data && _inflight.library == library && [_inflight.key isEqualToString:key]) {
+      atomic_fetch_add(&_duplicates, 1); return YES;
+    }
+    // The bounded scan covers pending records only; no disk, JSON or Metal work
+    // takes place under this lock. State lookup has an entirely separate lock.
+    for (unsigned i = 0; i < _count; ++i) {
+      CacheRecord *pending = &_records[(_head + i) % QueueCapacity];
+      if (pending->library == library && [pending->key isEqualToString:key]) {
+        pending->cost_us = MAX(pending->cost_us, cost);
+        atomic_fetch_add(&_duplicates, 1); return YES;
+      }
+    }
+    if (_count + (_inflight.data != nil) + _retiringCount >= QueueCapacity) {
+      atomic_fetch_add(&_queueFull, 1); return NO;
+    }
+    if (_queuedBytes > QueueByteLimit - data.length) {
+      atomic_fetch_add(&_queueBytesFull, 1); return NO;
+    }
+    CacheRecord record = {.cost_us = cost, .library = library};
+    @try { record.key = [key retain]; record.data = [data retain]; }
+    @catch (NSException *exception) { [record.key release]; [record.data release]; @throw; }
+    _records[(_head + _count) % QueueCapacity] = record;
+    _queuedBytes += data.length; ++_count;
+    _queueHighWater = MAX(_queueHighWater, _count + (_inflight.data != nil) + _retiringCount);
+    _byteHighWater = MAX(_byteHighWater, _queuedBytes);
+    accepted = YES;
+  } @finally { os_unfair_lock_unlock(&_recordLock); }
+  if (accepted) dispatch_source_merge_data(_drainSource, 1);
+  return accepted;
+}
