+  _offline = YES;
+  _offlineVerify = envUnsigned("DXMT_PIPELINE_CACHE_VERIFY_ONLY", 0, 1) != 0;
+  _prewarmLimit = envUnsigned("DXMT_PIPELINE_CACHE_PREWARM_LIMIT", 4096, 8192);
+  budget = envUnsigned("DXMT_PIPELINE_CACHE_PREWARM_MS", 180000, 600000);
