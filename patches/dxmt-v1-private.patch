+// Three fixed segments; only the utility writer performs file operations.
+static FILE *display_open_segment(NSString *path, const char *header, uint64_t *bytes) {
+  FILE *file = fopen(path.fileSystemRepresentation, "w");
+  if (!file) return NULL;
+  setvbuf(file, NULL, _IOFBF, 64 * 1024);
+  int n = fprintf(file, "%s", header);
+  if (n < 0) { fclose(file); return NULL; }
+  *bytes = n;
+  return file;
+}
+static BOOL display_rotate(FILE **file, NSString *path, const char *header, uint64_t *bytes) {
+  if (*file) { fclose(*file); *file = NULL; }
+  NSString *base = [path stringByDeletingPathExtension];
+  NSString *one = [base stringByAppendingString:@".1.csv"];
+  NSString *two = [base stringByAppendingString:@".2.csv"];
+  if (rename(one.fileSystemRepresentation, two.fileSystemRepresentation) && errno != ENOENT) return NO;
+  if (rename(path.fileSystemRepresentation, one.fileSystemRepresentation) && errno != ENOENT) return NO;
+  *file = display_open_segment(path, header, bytes);
+  return *file != NULL;
