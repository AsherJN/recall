diff --git a/src/d3d11/d3d11_pipeline_ready.hpp b/src/d3d11/d3d11_pipeline_ready.hpp
new file mode 100644
index 0000000..e2341ca
--- /dev/null
+++ b/src/d3d11/d3d11_pipeline_ready.hpp
@@ -0,0 +1,53 @@
+#pragma once
+
+#include "thread.hpp"
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+
+namespace dxmt {
+
+// One-shot CPU pipeline completion. The successful acquire publishes the
+// pipeline result, including a null result when compilation failed. Windows
+// condition variables make the slow path wakeable in Wine; libc++ atomic::wait
+// can instead remain asleep in its polling backoff after notify_all().
+class PipelineReady {
+public:
+  bool isReady() const { return ready_.load(std::memory_order_acquire); }
+
+  uint64_t wait() {
+    if (!isReady()) {
+      std::unique_lock<dxmt::mutex> lock(mutex_);
+      changed_.wait(lock, [this] { return isReady(); });
+    }
+    // Written once before the release store. No clock read or lock is needed
+    // when obtaining an already completed pipeline.
+    return published_us_;
+  }
+
+  void publish(bool capture_timestamp = false) {
+    {
+      std::lock_guard<dxmt::mutex> lock(mutex_);
+      if (ready_.load(std::memory_order_relaxed))
+        return;
+      published_us_ = capture_timestamp ? monotonicUs() : 0;
+      // The same mutex guards both the predicate change and the waiter's
+      // predicate-check / wait registration, preventing a lost notification.
+      ready_.store(true, std::memory_order_release);
+    }
+    changed_.notify_all();
+  }
+
+  static uint64_t monotonicUs() {
+    return std::chrono::duration_cast<std::chrono::microseconds>(
+        std::chrono::steady_clock::now().time_since_epoch()).count();
+  }
+
+private:
+  std::atomic_bool ready_{false};
+  dxmt::mutex mutex_;
+  dxmt::condition_variable changed_;
+  uint64_t published_us_ = 0;
+};
+
+} // namespace dxmt
