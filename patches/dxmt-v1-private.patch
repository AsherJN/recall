+    @"record_limit": @(QueueCapacity + OverflowCapacity), @"byte_limit": @(QueueByteLimit + OverflowByteLimit),
+    @"primary_record_limit": @(QueueCapacity), @"primary_byte_limit": @(QueueByteLimit),
+    @"overflow_records": @(atomic_load(&_overflowCount)), @"overflow_bytes": @(atomic_load(&_overflowBytes)),
+    @"overflow_accepted": @(atomic_load(&_overflowAccepted)), @"overflow_rejected": @(atomic_load(&_overflowRejected)),
+    @"record_high_water": @(high), @"byte_high_water": @(byteHigh),
+    @"queue_full": @(atomic_load(&_queueFull)), @"queue_bytes_full": @(atomic_load(&_queueBytesFull)),
+    @"queue_contention": @(atomic_load(&_queueContention)), @"deduplicated": @(atomic_load(&_duplicates)),
+    @"diagnostic_drops": @(atomic_load(&_traceDrops)), @"readonly_rejections": @(atomic_load(&_readonlyRejects)),
+    @"invalid_records": @(atomic_load(&_invalidRecords)), @"recipe_limit_rejections": @(atomic_load(&_recipeLimitRejects)),
+    @"library_limit_rejections": @(atomic_load(&_libraryLimitRejects)), @"disk_limit_rejections": @(atomic_load(&_diskLimitRejects)),
+    @"disk_space_rejections": @(atomic_load(&_diskSpaceRejects)), @"io_failures": @(atomic_load(&_ioFailures)),
+    @"dependency_retries": @(atomic_load(&_dependencyRetries)), @"dependency_failures": @(atomic_load(&_dependencyFailures)),
+    @"write_retries": @(atomic_load(&_writeRetries)), @"retry_exhausted": @(atomic_load(&_retryExhausted)),
+    @"recipe_files": @(_recipeFiles), @"library_files": @(_libraryFiles), @"disk_bytes": @(_diskBytes),
+    @"recipe_limit": @(_recipeLimit), @"library_limit": @(_libraryLimit), @"disk_limit": @(_diskLimit),
+    @"write_owner": @(_writeOwner), @"library_retry": dxmt_recipe_retry_stats()};
+}
