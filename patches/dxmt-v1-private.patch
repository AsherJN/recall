+- (void)event:(NSString *)event values:(NSDictionary *)values {
+  if (!_logPath) return;
+  NSMutableDictionary *entry = [NSMutableDictionary dictionaryWithDictionary:values];
+  entry[@"event"] = event;
+  if (!entry[@"unix_ms"]) entry[@"unix_ms"] = @((long long)((CFAbsoluteTimeGetCurrent() + kCFAbsoluteTimeIntervalSince1970) * 1000));
+  entry[@"native_pid"] = @(getpid());
+  NSData *json = [NSJSONSerialization dataWithJSONObject:entry options:0 error:nil];
+  if ([event isEqualToString:@"summary"] && json) {
+    // The lifetime counters remain available even after detail segments rotate.
+    NSString *summaryPath = [[_logPath stringByDeletingPathExtension] stringByAppendingString:@".summary.json"];
+    if (![json writeToFile:summaryPath options:NSDataWritingAtomic error:nil]) ++_logErrors;
+  }
+  if (!_log) return;
+  if (_logBytes + json.length + 1 > _diagnosticLimit) {
+    fclose(_log); _log = NULL;
+    NSString *stem = [_logPath stringByDeletingPathExtension];
+    NSString *one = [stem stringByAppendingString:@".1.jsonl"], *two = [stem stringByAppendingString:@".2.jsonl"];
+    unlink(two.fileSystemRepresentation);
+    if (rename(one.fileSystemRepresentation, two.fileSystemRepresentation) && errno != ENOENT) ++_logErrors;
+    if (rename(_logPath.fileSystemRepresentation, one.fileSystemRepresentation)) ++_logErrors;
+    _log = fopen(_logPath.fileSystemRepresentation, "w");
+    _logBytes = 0; ++_logRotations;
+    if (!_log) { ++_logErrors; return; }
+    setvbuf(_log, NULL, _IOFBF, 1 << 16);
+  }
+  if (json && fwrite(json.bytes, 1, json.length, _log) == json.length) {
+    fputc('\n', _log); _logBytes += json.length + 1;
+  }
+  if (![event isEqualToString:@"runtime"] && fflush(_log)) ++_logErrors;
+}
