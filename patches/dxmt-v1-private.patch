+- (BOOL)enqueueLibrary:(BOOL)library key:(NSString *)key data:(NSData *)data cost:(double)cost {
+  if ([self enqueuePrimary:library key:key data:data cost:cost]) return YES;
+  if (!atomic_load(&_accepting) || atomic_load(&globallyStopped) || !validKey(key) || !data.length ||
+      data.length > (library ? DXMT_RECIPE_LIBRARY_MAX_BYTES : DXMT_RECIPE_ENCODED_MAX_BYTES) || !isfinite(cost) || cost < 0 ||
+      (atomic_load_explicit(&_startupDone, memory_order_acquire) && !_writeOwner)) return NO;
+  // Independent lock-free overflow absorbs a preempted producer/worker holding
+  // the primary lock. No waiting and no dispatch block per rejected admission.
+  uint_fast64_t bytes = atomic_load(&_overflowBytes);
+  BOOL reserved = NO;
+  for (unsigned i = 0; i < 8 && bytes <= OverflowByteLimit - data.length; ++i)
+    if (atomic_compare_exchange_weak(&_overflowBytes, &bytes, bytes + data.length)) { reserved = YES; break; }
+  if (reserved) {
+    for (unsigned i = 0; i < OverflowCapacity; ++i) {
+      unsigned empty = 0;
+      if (!atomic_compare_exchange_strong_explicit(&_overflow[i].state, &empty, 1, memory_order_acquire, memory_order_relaxed)) continue;
+      CacheRecord record = {.library = library, .cost_us = cost};
+      @try { record.key = [key retain]; record.data = [data retain]; }
+      @catch (NSException *exception) {
+        [record.key release]; [record.data release]; atomic_store(&_overflow[i].state, 0);
+        atomic_fetch_sub(&_overflowBytes, data.length); @throw;
+      }
+      _overflow[i].record = record;
+      atomic_fetch_add(&_overflowCount, 1); atomic_fetch_add(&_overflowAccepted, 1);
+      atomic_store_explicit(&_overflow[i].state, 2, memory_order_release);
+      dispatch_source_merge_data(_drainSource, 1); return YES;
+    }
+    atomic_fetch_sub(&_overflowBytes, data.length);
+  }
+  atomic_fetch_add(&_overflowRejected, 1); atomic_fetch_add(&_queueDrops, 1); return NO;
+}
