+#include <string.h>
+#include <errno.h>
+
+enum { QueueCapacity = 2048, OverflowCapacity = 256, TraceCapacity = 512, StateCapacity = 256,
+       RecipeCapacity = 32768, LibraryCapacity = 65536, EnumerationCapacity = 131072 };
+static const uint64_t QueueByteLimit = 32u * 1024u * 1024u;
+static const uint64_t OverflowByteLimit = 8u * 1024u * 1024u;
+static const uint64_t DiskByteLimit = 512u * 1024u * 1024u;
+static const uint64_t FreeDiskReserve = 128u * 1024u * 1024u;
+static const uint64_t ArchiveByteLimit = 128u * 1024u * 1024u;
+static atomic_bool globallyStopped;
+static const uint64_t DiagnosticByteLimit = 8u * 1024u * 1024u;
+
+static NSString *digest(NSData *data) {
+  if (!data || data.length > UINT32_MAX) return nil;
+  unsigned char bytes[CC_SHA256_DIGEST_LENGTH];
+  CC_SHA256(data.bytes, (CC_LONG)data.length, bytes);
+  char result[65];
+  for (unsigned i = 0; i < sizeof(bytes); ++i) snprintf(result + i * 2, 3, "%02x", bytes[i]);
+  return [NSString stringWithUTF8String:result];
+}
+
+static BOOL validKey(NSString *key) {
+  if (![key isKindOfClass:[NSString class]] || key.length != 64) return NO;
+  const char *text = key.UTF8String;
+  if (!text || strlen(text) != 64) return NO;
+  for (unsigned i = 0; i < 64; ++i)
+    if (!((text[i] >= '0' && text[i] <= '9') || (text[i] >= 'a' && text[i] <= 'f'))) return NO;
+  return YES;
+}
+
+static NSData *readBounded(NSString *path, uint64_t limit) {
+  int fd = open(path.fileSystemRepresentation, O_RDONLY | O_NOFOLLOW);
+  if (fd < 0) return nil;
+  struct stat st;
+  if (fstat(fd, &st) || !S_ISREG(st.st_mode) || st.st_size <= 0 || (uint64_t)st.st_size > limit) {
+    close(fd); return nil;
+  }
+  @try {
+    NSMutableData *data = [NSMutableData dataWithLength:(NSUInteger)st.st_size];
+    size_t offset = 0;
+    while (offset < data.length) {
+      ssize_t count = read(fd, (char *)data.mutableBytes + offset, data.length - offset);
+      if (count <= 0) return nil;
+      offset += count;
+    }
+    return data;
+  } @finally { close(fd); }
+}
+
+static unsigned envUnsigned(const char *name, unsigned fallback, unsigned maximum) {
+  const char *value = getenv(name);
+  if (!value || !*value) return fallback;
+  char *end = NULL;
+  unsigned long parsed = strtoul(value, &end, 10);
+  return end && !*end ? (unsigned)MIN(parsed, maximum) : fallback;
+}
