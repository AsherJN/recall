+WINEMETAL_API uint32_t
+ConfigureMetalViewCanvas(obj_handle_t view, uint32_t width, uint32_t height) {
+  struct unixcall_generic_obj_uint64_uint64_ret params = {0};
+  params.handle = view;
+  params.arg = ((uint64_t)GetCurrentProcessId() << 32) | ((uint64_t)(width & 0xffff) << 16) | (height & 0xffff);
+  UNIX_CALL(146, &params);
+  return (uint32_t)params.ret;
+}
+
+WINEMETAL_API uint32_t
+SetMetalViewFullscreen(obj_handle_t view, uint32_t width, uint32_t height, uint32_t enable) {
+  struct unixcall_generic_obj_uint64_uint64_ret params;
+  params.handle = view;
+  params.arg = ((uint64_t)enable << 32) | ((uint64_t)(width & 0xffff) << 16) | (height & 0xffff);
+  UNIX_CALL(147, &params);
+  return params.ret;
+}
