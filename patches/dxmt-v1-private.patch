+++ b/src/dxmt/dxmt_map_use.hpp
@@ -0,0 +1,59 @@
+#pragma once
+#include "dxmt_resource_log.hpp"
+
+namespace dxmt {
+// Diagnostic-only timing from successful Map epilogue to Unmap entry. Includes
+// arbitrary application work and scheduling, not just writes to mapped memory.
+// A bounded table handles multiple mapped resources and subresources. It never
+// waits, grows, retains a resource, or reads application memory.
+class MapUseTracker {
+  struct Entry { uintptr_t resource = 0; uint32_t subresource = 0, type = 0, thread = 0; int64_t start = 0; };
+  static constexpr size_t Capacity = 1024, Probes = 8;
+  std::array<Entry, Capacity> entries_{};
+  std::atomic_flag lock_ = ATOMIC_FLAG_INIT;
+  ResourceTelemetry::Op op_;
+  static size_t index(uintptr_t resource, uint32_t sub) noexcept {
+    return ((resource >> 4) * UINT64_C(11400714819323198485) ^ (uint64_t(sub) * 2654435761u)) % Capacity;
+  }
+  static void issue(ResourceTelemetry *trace, uintptr_t resource, unsigned reason) noexcept {
+    auto now = ResourceTelemetry::now();
+    trace->record(ResourceTelemetry::MapPairIssue, now, now, resource, ResourceTelemetry::UnknownBytes, 1, reason);
+  }
+public:
+  explicit MapUseTracker(bool deferred = false) noexcept : op_(deferred ? ResourceTelemetry::MappedUseDeferred : ResourceTelemetry::MappedUseImmediate) {}
+  void begin(const void *resource, uint32_t sub, uint32_t type) noexcept {
+    auto trace = ResourceTelemetry::get();
+    if (!trace || !resource) return;
+    auto key = reinterpret_cast<uintptr_t>(resource);
+    if (lock_.test_and_set(std::memory_order_acquire)) { issue(trace, key, 1); return; }
+    Entry *free = nullptr, *duplicate = nullptr;
+    for (size_t p=0; p<Probes; ++p) {
+      auto &slot = entries_[(index(key,sub)+p)%Capacity];
+      if (slot.resource == key && slot.subresource == sub) duplicate = &slot;
+      if (!slot.resource && !free) free = &slot;
+    }
+    auto slot = duplicate ? duplicate : free;
+    if (slot) *slot = {key, sub, type, uint32_t(ResourceTelemetry::threadId()), ResourceTelemetry::now()};
+    lock_.clear(std::memory_order_release);
+    if (!slot || duplicate) issue(trace, key, duplicate ? 2 : 3);
+  }
+  void end(const void *resource, uint32_t sub, int64_t entered) noexcept {
+    auto trace = ResourceTelemetry::get();
+    if (!trace || !resource) return;
+    auto key = reinterpret_cast<uintptr_t>(resource);
+    if (lock_.test_and_set(std::memory_order_acquire)) { issue(trace, key, 1); return; }
+    Entry found{};
+    for (size_t p=0; p<Probes; ++p) {
+      auto &slot = entries_[(index(key,sub)+p)%Capacity];
+      if (slot.resource == key && slot.subresource == sub) { found=slot; slot={}; break; }
+    }
+    lock_.clear(std::memory_order_release);
+    if (!found.resource || entered < found.start) { issue(trace,key,4); return; }
+    // Low byte: map type; next 24 bits: subresource; high 32 bits: mapping thread.
+    // Event thread_id is the unmapping thread. Large subresource values are
+    // retained in matching but metadata truncation is explicitly bounded here.
+    uint64_t detail = uint64_t(found.thread)<<32 | uint64_t(sub&0xffffff)<<8 | (found.type&0xff);
+    trace->record(op_, found.start, entered, key, ResourceTelemetry::UnknownBytes, 1, detail);
+  }
+};
+}
