new file mode 100644
index 0000000..1c3c30e
--- /dev/null
+++ b/src/d3d11/d3d11_shader_trace.hpp
@@ -0,0 +1,393 @@
+#pragma once
+
+#include "sha1/sha1_util.hpp"
+#include "util_win32_compat.h"
+#include <atomic>
+#include <chrono>
+#include <condition_variable>
+#include <memory>
+#include <new>
+#include <thread>
+#ifdef _WIN32
+#include <windows.h>
+#include <process.h>
+#endif
+#include <cstdio>
+#include <cstdlib>
+#include <mutex>
+#include <string>
+
+namespace dxmt {
+
+// Opt-in diagnostics. Producers only format bounded records and try to enqueue;
+// the persistent writer owns every FILE operation. A 250 ms flush also preserves
+// sparse late-game records when Wine exits without running DLL atexit handlers.
+class ShaderTraceSink {
+public:
+  static ShaderTraceSink &instance() {
+    // Workers can outlive device/static destruction. Never destroy their sink,
+    // mutexes, queue, or writer state; shutdown stops admission and drains within
+    // a bounded deadline. A blocked writer retains its process-lifetime state.
+    static ShaderTraceSink *sink = [] {
+      alignas(ShaderTraceSink) static unsigned char storage[sizeof(ShaderTraceSink)];
+      auto *created = new (storage) ShaderTraceSink;
+      if (std::atexit([] { instance().shutdownAtExit(); }) != 0)
+        created->shutdown();
+      return created;
+    }();
+    return *sink;
+  }
+
+  bool enabled() const { return accepting_.load(std::memory_order_relaxed); }
+
+  void write(const char *record) { enqueue(false, record); }
+
+  void pipeline(uint64_t unix_start, uint64_t id, const char *type, const char *phase,
+                uint64_t duration_us, bool waiting, uint64_t ready_published_us = 0,
+                uint64_t wait_return_us = 0, uint64_t ready_to_return_us = 0) {
+    if (!enabled())
+      return;
+    if (waiting) {
+      wait_samples_.fetch_add(1, std::memory_order_relaxed);
+      wait_total_us_.fetch_add(duration_us, std::memory_order_relaxed);
+      if (duration_us <= 100)
+        return;
+    } else {
+      create_samples_.fetch_add(1, std::memory_order_relaxed);
+      create_total_us_.fetch_add(duration_us, std::memory_order_relaxed);
+    }
+    char line[512];
+    std::snprintf(line, sizeof(line), "%llu,%llu,%s,%s,%llu,%llu,%llu,%llu\n",
+        (unsigned long long)unix_start, (unsigned long long)id, type, phase,
+        (unsigned long long)duration_us, (unsigned long long)ready_published_us,
+        (unsigned long long)wait_return_us, (unsigned long long)ready_to_return_us);
+    enqueue(true, line);
+  }
+
+  void shutdown() {
+    accepting_.store(false, std::memory_order_relaxed);
+    stopping_.store(true, std::memory_order_release);
+    wake_.notify_one();
+    if (!started_)
+      return;
+    // Never join an I/O-blocked thread, especially during DLL/process teardown.
+    // The writer alone closes its streams and remains valid after this returns.
+    auto deadline = std::chrono::steady_clock::now() + std::chrono::milliseconds(500);
+    while (!finished_.load(std::memory_order_acquire) && std::chrono::steady_clock::now() < deadline)
+      std::this_thread::sleep_for(std::chrono::milliseconds(1));
+  }
+
+private:
+  static constexpr size_t capacity_ = 2048, batch_size_ = 128;
+  static constexpr uint64_t record_limit_ = 100000;
+  struct Record { bool pipeline; char text[512]; };
+  struct Counts {
+    std::atomic_uint64_t submitted{0}, records{0}, dropped_limit{0}, dropped_queue{0}, dropped_io{0};
+  };
+
+  ShaderTraceSink() {
+    const char *prefix = std::getenv("DXMT_SHADER_LOG");
+    if (!prefix || !*prefix)
+      return;
+    try {
+      auto suffix = "-" + std::to_string(GetCurrentProcessId()) + ".csv";
+      shader_path_ = std::string(prefix) + suffix;
+      pipeline_path_ = std::string(prefix) + "-pipelines" + suffix;
+      summary_path_ = std::string(prefix) + "-summary" + suffix;
+      summary_temporary_path_ = summary_path_ + ".tmp";
+      queue_.reset(new Record[capacity_]);
+#ifdef _WIN32
+      // A detached diagnostic thread must never execute unmapped DLL code.
+      // Pin before starting it; no pin or worker is created in quiet runs.
+      HMODULE module = nullptr;
+      if (!GetModuleHandleExA(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_PIN,
+                            reinterpret_cast<LPCSTR>(&ShaderTraceSink::writerProc), &module))
+        return;
+      accepting_.store(true, std::memory_order_relaxed);
+      uintptr_t worker = _beginthreadex(nullptr, 0, &ShaderTraceSink::writerProc, this, 0, nullptr);
+      if (!worker) {
+        accepting_.store(false, std::memory_order_relaxed);
+        return;
+      }
+      CloseHandle(reinterpret_cast<HANDLE>(worker));
+#else
+      accepting_.store(true, std::memory_order_relaxed);
+      std::thread([this] { runSafely(); }).detach();
+#endif
+      started_ = true;
+    } catch (...) {
+      accepting_.store(false, std::memory_order_relaxed);
+    }
+  }
+
+#ifdef _WIN32
+  static unsigned __stdcall writerProc(void *context) {
+    static_cast<ShaderTraceSink *>(context)->runSafely();
+    return 0;
+  }
+#endif
+
+  void shutdownAtExit() {
+#ifdef _WIN32
+    // ExitProcess can terminate the writer while it owns a CRT/mutex lock before
+    // DLL atexit runs. Do not touch locks, condition variables, FILEs or handles
+    // here. With responsive I/O, periodic snapshots leave only the latest
+    // 250 ms interval at risk; blocked I/O/scheduling can extend that interval.
+    accepting_.store(false, std::memory_order_relaxed);
+    stopping_.store(true, std::memory_order_release);
+#else
+    shutdown();
+#endif
+  }
+
+  void runSafely() noexcept {
+    try {
+      run();
+    } catch (...) {
+      // Diagnostics must never propagate an allocation/OS-library failure into
+      // gameplay. Any blocked/open streams and sink remain process-lifetime.
+    }
+    accepting_.store(false, std::memory_order_relaxed);
+    finished_.store(true, std::memory_order_release);
+  }
+
+  void enqueue(bool pipeline, const char *text) {
+    if (!enabled())
+      return;
+    auto &counts = pipeline ? pipeline_counts_ : shader_counts_;
+    auto submitted = counts.submitted.fetch_add(1, std::memory_order_relaxed);
+    if (submitted >= record_limit_) {
+      counts.dropped_limit.fetch_add(1, std::memory_order_relaxed);
+      return;
+    }
+    // Never wait behind the writer or another render/compiler thread.
+    std::unique_lock<std::mutex> lock(queue_mutex_, std::try_to_lock);
+    if (!lock.owns_lock() || stopping_.load(std::memory_order_acquire) || size_ == capacity_) {
+      counts.dropped_queue.fetch_add(1, std::memory_order_relaxed);
+      return;
+    }
+    auto &record = queue_[(head_ + size_) % capacity_];
+    record.pipeline = pipeline;
+    std::snprintf(record.text, sizeof(record.text), "%s", text);
+    bool wake = ++size_ == batch_size_;
+    lock.unlock();
+    if (wake)
+      wake_.notify_one();
+  }
+
+  static FILE *openStream(const std::string &path, const char *header) {
+    FILE *stream = std::fopen(path.c_str(), "w");
+    if (stream) {
+      std::setvbuf(stream, nullptr, _IOFBF, 65536);
+      std::fputs(header, stream);
+    }
+    return stream;
+  }
+
+  void summary(bool final) {
+    // Replace a complete snapshot, retaining the last complete one if exit or
+    // an I/O error interrupts the next write. This file does not grow with time.
+    // Counters are sampled separately: live producers can cross the snapshot
+    // boundary, including calls already in flight when final is requested.
+    FILE *file = std::fopen(summary_temporary_path_.c_str(), "w");
+    if (!file)
+      return;
+    std::fputs("stream,records,dropped,wait_samples,wait_total_us,create_samples,create_total_us,submitted,pending,dropped_limit,dropped_queue,dropped_io,flush_errors,final\n", file);
+    auto row = [&](const char *name, Counts &counts, bool pipeline) {
+      auto submitted = counts.submitted.load(std::memory_order_relaxed);
+      auto records = counts.records.load(std::memory_order_relaxed);
+      auto limit = counts.dropped_limit.load(std::memory_order_relaxed);
+      auto queue = counts.dropped_queue.load(std::memory_order_relaxed);
+      auto io = counts.dropped_io.load(std::memory_order_relaxed);
+      auto accounted = records + limit + queue + io;
+      std::fprintf(file, "%s,%llu,%llu,%llu,%llu,%llu,%llu,%llu,%llu,%llu,%llu,%llu,%llu,%u\n",
+          name, (unsigned long long)records, (unsigned long long)(limit + queue + io),
+          (unsigned long long)(pipeline ? wait_samples_.load(std::memory_order_relaxed) : 0),
+          (unsigned long long)(pipeline ? wait_total_us_.load(std::memory_order_relaxed) : 0),
+          (unsigned long long)(pipeline ? create_samples_.load(std::memory_order_relaxed) : 0),
+          (unsigned long long)(pipeline ? create_total_us_.load(std::memory_order_relaxed) : 0),
+          (unsigned long long)submitted, (unsigned long long)(submitted > accounted ? submitted - accounted : 0),
+          (unsigned long long)limit, (unsigned long long)queue, (unsigned long long)io,
+          (unsigned long long)flush_errors_, unsigned(final));
+    };
+    row("shader", shader_counts_, false);
+    row("pipeline", pipeline_counts_, true);
+    bool failed = std::ferror(file);
+    failed = std::fclose(file) != 0 || failed;
+    if (!failed) {
+#ifdef _WIN32
+      MoveFileExA(summary_temporary_path_.c_str(), summary_path_.c_str(), MOVEFILE_REPLACE_EXISTING);
+#else
+      std::rename(summary_temporary_path_.c_str(), summary_path_.c_str());
+#endif
+    }
+  }
+
+  void run() {
+    FILE *shader = openStream(shader_path_, "start_unix_us,shader_sha1,variant_sha1,cache,result,queue_us,cache_read_us,ir_restore_us,translate_us,ir_release_us,metal_us,cache_write_us,total_us\n");
+    FILE *pipeline = openStream(pipeline_path_, "start_unix_us,pipeline_id,type,phase,duration_us,ready_published_monotonic_us,wait_return_monotonic_us,ready_to_return_us\n");
+    if (!shader && !pipeline) {
+      accepting_.store(false, std::memory_order_relaxed);
+      stopping_.store(true, std::memory_order_release);
+    }
+    Record batch[batch_size_];
+    uint64_t unflushed_shader = 0, unflushed_pipeline = 0;
+    auto flush = [&] {
+      auto stream = [&](FILE *file, Counts &counts, uint64_t &pending) {
+        if (file && std::fflush(file) != 0) {
+          ++flush_errors_;
+          counts.dropped_io.fetch_add(pending, std::memory_order_relaxed);
+        } else {
+          counts.records.fetch_add(pending, std::memory_order_relaxed);
+        }
+        pending = 0;
+      };
+      stream(shader, shader_counts_, unflushed_shader);
+      stream(pipeline, pipeline_counts_, unflushed_pipeline);
+    };
+    auto deadline = std::chrono::steady_clock::now() + std::chrono::milliseconds(250);
+    for (;;) {
+      size_t count = 0;
+      bool final = false;
+      {
+        std::unique_lock<std::mutex> lock(queue_mutex_);
+        if (!size_ && !stopping_.load(std::memory_order_acquire))
+          wake_.wait_until(lock, deadline, [this] { return size_ || stopping_.load(std::memory_order_acquire); });
+        while (size_ && count < batch_size_) {
+          batch[count++] = queue_[head_];
+          head_ = (head_ + 1) % capacity_;
+          --size_;
+        }
+        final = !size_ && stopping_.load(std::memory_order_acquire);
+      }
+      // No queue/readiness lock is held across any potentially blocking I/O.
+      for (size_t i = 0; i < count; ++i) {
+        auto &record = batch[i];
+        FILE *file = record.pipeline ? pipeline : shader;
+        auto &counts = record.pipeline ? pipeline_counts_ : shader_counts_;
+        if (!file || std::fputs(record.text, file) < 0)
+          counts.dropped_io.fetch_add(1, std::memory_order_relaxed);
+        else
+          ++(record.pipeline ? unflushed_pipeline : unflushed_shader);
+      }
+      if (final || std::chrono::steady_clock::now() >= deadline) {
+        flush();
+        summary(final);
+        deadline = std::chrono::steady_clock::now() + std::chrono::milliseconds(250);
+      }
+      if (final)
+        break;
+    }
+    if (shader) std::fclose(shader);
+    if (pipeline) std::fclose(pipeline);
+  }
+
+  std::unique_ptr<Record[]> queue_;
+  std::string shader_path_, pipeline_path_, summary_path_, summary_temporary_path_;
+  size_t head_ = 0, size_ = 0;
+  Counts shader_counts_, pipeline_counts_;
+  std::atomic_uint64_t wait_samples_{0}, wait_total_us_{0}, create_samples_{0}, create_total_us_{0};
+  uint64_t flush_errors_ = 0;
+  bool started_ = false;
+  std::atomic_bool accepting_{false}, stopping_{false}, finished_{false};
+  std::mutex queue_mutex_;
+  std::condition_variable wake_;
+};
+
+struct ShaderCompileTrace {
+  static uint64_t timestamp() {
+    if (!ShaderTraceSink::instance().enabled())
+      return 0;
+    return monotonic_now();
+  }
+
+  static uint64_t monotonic_now() {
+    return std::chrono::duration_cast<std::chrono::microseconds>(
+        std::chrono::steady_clock::now().time_since_epoch()).count();
+  }
+
+  uint64_t elapsed(uint64_t start) const { return enabled_ && start ? monotonic_now() - start : 0; }
+
+  ShaderCompileTrace(const Sha1Digest &shader, const Sha1Digest &variant, uint64_t queued_at)
+      : enabled_(ShaderTraceSink::instance().enabled()), shader_(shader), variant_(variant) {
+    if (enabled_) {
+      started_ = timestamp();
+      unix_started_ = std::chrono::duration_cast<std::chrono::microseconds>(
+          std::chrono::system_clock::now().time_since_epoch()).count();
+      queue_us = queued_at ? started_ - queued_at : 0;
+    }
+  }
+
+  ~ShaderCompileTrace() {
+    if (!enabled_)
+      return;
+    char line[512];
+    std::snprintf(line, sizeof(line), "%llu,%s,%s,%s,%s,%llu,%llu,%llu,%llu,%llu,%llu,%llu,%llu\n",
+        (unsigned long long)unix_started_, shader_.string().c_str(), variant_.string().c_str(), cache, result,
+        (unsigned long long)queue_us, (unsigned long long)cache_read_us,
+        (unsigned long long)ir_restore_us, (unsigned long long)translate_us,
+        (unsigned long long)ir_release_us, (unsigned long long)metal_us,
+        (unsigned long long)cache_write_us, (unsigned long long)elapsed(started_));
+    ShaderTraceSink::instance().write(line);
+  }
+
+  const char *cache = "missing";
+  const char *result = "aborted";
+  uint64_t queue_us = 0, cache_read_us = 0, ir_restore_us = 0, translate_us = 0;
+  uint64_t ir_release_us = 0, metal_us = 0, cache_write_us = 0;
+
+private:
+  bool enabled_;
+  const Sha1Digest &shader_, &variant_;
+  uint64_t started_ = 0, unix_started_ = 0;
+};
+
+inline uint64_t nextPipelineTraceId() {
+  if (!ShaderTraceSink::instance().enabled())
+    return 0;
+  static std::atomic_uint64_t next_id{1};
+  return next_id.fetch_add(1, std::memory_order_relaxed);
+}
+
+class PipelineOperationTrace {
+public:
+  PipelineOperationTrace(uint64_t id, const char *type, bool waiting, bool active = true)
+      : id_(id), type_(type), waiting_(waiting),
+        enabled_(active && id && ShaderTraceSink::instance().enabled()) {
+    begin();
+  }
+  void begin() {
+    if (enabled_) {
+      finished_ = false;
+      started_ = ShaderCompileTrace::monotonic_now();
+      unix_started_ = std::chrono::duration_cast<std::chrono::microseconds>(
+          std::chrono::system_clock::now().time_since_epoch()).count();
+    }
+  }
+  void finish(uint64_t ready_published_us = 0) {
+    if (enabled_ && !finished_) {
+      auto returned = ShaderCompileTrace::monotonic_now();
+      duration_us_ = returned - started_;
+      if (waiting_ && ready_published_us && returned >= ready_published_us) {
+        ready_published_us_ = ready_published_us;
+        wait_return_us_ = returned;
+        ready_to_return_us_ = returned - ready_published_us;
+      }
+      finished_ = true;
+    }
+  }
+  ~PipelineOperationTrace() {
+    if (enabled_) {
+      finish();
+      ShaderTraceSink::instance().pipeline(unix_started_, id_, type_, waiting_ ? "wait" : "createMetal",
+          duration_us_, waiting_, ready_published_us_, wait_return_us_, ready_to_return_us_);
+    }
+  }
+private:
+  uint64_t id_, started_ = 0, unix_started_ = 0, duration_us_ = 0;
+  uint64_t ready_published_us_ = 0, wait_return_us_ = 0, ready_to_return_us_ = 0;
+  const char *type_;
+  bool waiting_, enabled_, finished_ = false;
+};
+
