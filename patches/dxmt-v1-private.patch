+- (void)consume:(CacheRecord)record overflow:(int)overflow {
+    @autoreleasepool {
+    BOOL saved = NO, retry = NO, deferred = record.retryAt > CACurrentMediaTime();
+    uint64_t ioBefore = atomic_load(&_ioFailures);
+    @try {
+      if (deferred) retry = YES;
+      else if (!_writeOwner) atomic_fetch_add(&_readonlyRejects, 1);
+      else if (record.library) {
+        NSString *path = [_libraryDirectory stringByAppendingPathComponent:[record.key stringByAppendingString:@".air"]];
+        if ([digest(record.data) isEqual:record.key] &&
+            ([_verifiedLibraries containsObject:record.key] || [self library:record.key] || [self writeData:record.data to:path])) {
+          [_verifiedLibraries addObject:record.key]; saved = YES;
+          atomic_fetch_add(&_persistedLibraries, 1);
+        } else if (![digest(record.data) isEqual:record.key]) atomic_fetch_add(&_invalidRecords, 1);
+      } else {
+        NSDictionary *recipe = dxmt_recipe_decode(record.data);
+        if (recipe && [dxmt_recipe_key(recipe) isEqual:record.key]) {
+          BOOL complete = YES;
+          for (NSString *stage in @[@"vertex", @"fragment"]) {
+            if (recipe[stage] == NSNull.null) continue;
+            NSString *libraryKey = recipe[stage][@"library"];
+            if ([_verifiedLibraries containsObject:libraryKey]) continue;
+            if ([self library:libraryKey]) [_verifiedLibraries addObject:libraryKey];
+            else complete = NO;
+          }
+          if (!complete) {
+            retry = record.retries < 10;
+            atomic_fetch_add(retry ? &_dependencyRetries : &_dependencyFailures, 1);
+          } else {
+          NSString *path = [_recipeDirectory stringByAppendingPathComponent:[record.key stringByAppendingString:@".json"]];
+          NSDictionary *old = nil;
+          NSData *oldData = readBounded(path, DXMT_RECIPE_ENCODED_MAX_BYTES * 2);
+          if (oldData) old = [NSJSONSerialization JSONObjectWithData:oldData options:0 error:nil];
+          double previous = [old isKindOfClass:NSDictionary.class] && [old[@"cost_us"] isKindOfClass:NSNumber.class]
+              ? [old[@"cost_us"] doubleValue] : 0;
+          NSData *data = [NSJSONSerialization dataWithJSONObject:@{@"recipe": recipe,
+              @"cost_us": @(MAX(MIN(record.cost_us, 60000000),
+                  isfinite(previous) && previous >= 0 && previous <= 60000000 ? previous : 0))} options:0 error:nil];
+          if ([self writeData:data to:path]) { atomic_fetch_add(&_persistedRecipes, 1); saved = YES; }
+          }
+        } else atomic_fetch_add(&_invalidRecords, 1);
+      }
+      if (!saved && !retry && atomic_load(&_ioFailures) > ioBefore && record.retries < 3) {
+        retry = YES; atomic_fetch_add(&_writeRetries, 1);
+      }
+    } @catch (NSException *exception) {
+      atomic_fetch_add(&_invalidRecords, 1);
+    } @finally {
+      if (retry && !deferred) { ++record.retries; record.retryAt = CACurrentMediaTime() + 1.0; }
+      os_unfair_lock_lock(&_recordLock);
+      @try {
+        if (saved) (record.library ? _savedLibraryKeys : _savedRecipeCosts)[record.key] = @(record.cost_us);
+      } @catch (NSException *exception) { /* Disk success remains valid if memoization fails. */ }
+      retry = retry && !atomic_load(&globallyStopped);
+      if (overflow < 0) {
+        if (retry) { _records[(_head + _count) % QueueCapacity] = record; ++_count; }
+        else ++_retiringCount;
+        _inflight = (CacheRecord){0};
+      }
+      os_unfair_lock_unlock(&_recordLock);
+      if (overflow >= 0) {
+        if (retry) _overflow[overflow].record = record;
+        if (retry) atomic_store_explicit(&_overflow[overflow].state, 2, memory_order_release);
+      }
+      if (!retry) {
+        if (!saved) {
+          atomic_fetch_add(&_persistFailures, 1);
+          if (record.retries) atomic_fetch_add(&_retryExhausted, 1);
+        }
+        uint64_t releasedBytes = record.data.length;
+        [record.key release]; [record.data release];
+        if (overflow >= 0) {
+          _overflow[overflow].record = (CacheRecord){0};
+          atomic_fetch_sub(&_overflowCount, 1); atomic_fetch_sub(&_overflowBytes, releasedBytes);
+          atomic_store_explicit(&_overflow[overflow].state, 0, memory_order_release);
+        } else {
+          os_unfair_lock_lock(&_recordLock);
+          _queuedBytes -= releasedBytes; --_retiringCount;
+          os_unfair_lock_unlock(&_recordLock);
+        }
+      }
+    }
+    }
+}
