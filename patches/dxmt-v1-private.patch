+- (void)initializeStorage {
+  NSFileManager *fm = NSFileManager.defaultManager;
+  for (NSString *path in @[_directory, _libraryDirectory, _recipeDirectory, _archiveDirectory]) {
+    struct stat st;
+    if (!lstat(path.fileSystemRepresentation, &st) && (!S_ISDIR(st.st_mode) || S_ISLNK(st.st_mode))) {
+      atomic_store(&_accepting, false); return;
+    }
+    if (![fm createDirectoryAtPath:path withIntermediateDirectories:YES attributes:nil error:nil]) {
+      atomic_store(&_accepting, false); return;
+    }
+  }
+  _fileLock = open([[_directory stringByAppendingPathComponent:@"write.lock"] fileSystemRepresentation],
+      O_RDWR | O_CREAT | O_NOFOLLOW, 0600);
+  // Acquire ownership BEFORE measuring the files it will modify. A writer
+  // handoff after a stale scan must not bypass the namespace budget.
+  _writeOwner = _fileLock >= 0 && flock(_fileLock, LOCK_EX | LOCK_NB) == 0;
+  // Bound enumeration even for corrupt/unexpected cache directories.
+  unsigned files = 0;
+  BOOL enumerationExceeded = NO;
+  NSMutableSet *knownRecipes = [NSMutableSet set];
+  NSDirectoryEnumerator *enumerator = [fm enumeratorAtPath:_directory];
+  for (NSString *relative in enumerator) {
+    if (++files > EnumerationCapacity) { enumerationExceeded = YES; break; }
+    struct stat st;
+    NSString *path = [_directory stringByAppendingPathComponent:relative];
+    if (!lstat(path.fileSystemRepresentation, &st) && S_ISREG(st.st_mode)) {
+      _diskBytes += st.st_size;
+      if ([relative hasPrefix:@"recipes/"]) {
+        ++_recipeFiles;
+        if (knownRecipes.count < RecipeCapacity && [relative.pathExtension isEqualToString:@"json"] &&
+            validKey(relative.lastPathComponent.stringByDeletingPathExtension))
+          [knownRecipes addObject:relative.lastPathComponent.stringByDeletingPathExtension];
+      }
+      if ([relative hasPrefix:@"libraries/"]) ++_libraryFiles;
+      if ([relative hasPrefix:@"archives/"]) ++_archiveFiles;
+    }
+  }
+  os_unfair_lock_lock(&_lock);
+  _knownRecipeKeys = [knownRecipes copy];
+  os_unfair_lock_unlock(&_lock);
+  // A nonblocking lifetime lease makes disk accounting exact for the writer.
+  // Other processes may load/reuse the cache, but never replace its files.
+  if (enumerationExceeded) _writeOwner = NO;
+  if (_logPath) _log = fopen(_logPath.fileSystemRepresentation, "a");
+  [self event:@"startup_load" values:@{@"namespace": _identity, @"prewarm_limit": @(_prewarmLimit),
+      @"budget_remaining_ms": @(MAX(0, (_startupDeadline - CACurrentMediaTime()) * 1000))}];
+}
+
+- (BOOL)writeData:(NSData *)data to:(NSString *)path {
+  if (!data || !atomic_load(&_accepting)) { atomic_fetch_add(&_invalidRecords, 1); return NO; }
+  if (!_writeOwner) { atomic_fetch_add(&_readonlyRejects, 1); return NO; }
+  struct stat previous;
+  BOOL exists = !lstat(path.fileSystemRepresentation, &previous);
+  if (exists && !S_ISREG(previous.st_mode)) { atomic_fetch_add(&_ioFailures, 1); return NO; }
+  BOOL recipe = [path hasPrefix:[_recipeDirectory stringByAppendingString:@"/"]];
+  BOOL library = [path hasPrefix:[_libraryDirectory stringByAppendingString:@"/"]];
+  if (!exists && recipe && _recipeFiles >= _recipeLimit) { atomic_fetch_add(&_recipeLimitRejects, 1); return NO; }
+  if (!exists && library && _libraryFiles >= _libraryLimit) { atomic_fetch_add(&_libraryLimitRejects, 1); return NO; }
+  uint64_t old = exists ? previous.st_size : 0;
+  uint64_t retainedBytes = _diskBytes - MIN(old, _diskBytes);
+  if (data.length > _diskLimit || retainedBytes > _diskLimit - data.length) {
+    atomic_fetch_add(&_diskLimitRejects, 1); return NO;
+  }
+  struct statfs fs;
+  if (statfs(_directory.fileSystemRepresentation, &fs)) { atomic_fetch_add(&_ioFailures, 1); return NO; }
+  uint64_t available = (uint64_t)fs.f_bavail * fs.f_bsize;
+#ifdef DXMT_PIPELINE_CACHE_TESTING
+  if (_testFreeBytes >= 0) available = (uint64_t)_testFreeBytes;
+#endif
+  if (available < FreeDiskReserve + data.length) { atomic_fetch_add(&_diskSpaceRejects, 1); return NO; }
+  BOOL result = [data writeToFile:path options:NSDataWritingAtomic error:nil];
+  if (result) {
+    _diskBytes = _diskBytes + data.length - MIN(old, _diskBytes);
+    if (!exists) { if (recipe) ++_recipeFiles; if (library) ++_libraryFiles; }
+  } else atomic_fetch_add(&_ioFailures, 1);
+  return result;
+}
+
+- (NSData *)library:(NSString *)key {
+  if (!validKey(key)) return nil;
+  NSData *data = readBounded([_libraryDirectory stringByAppendingPathComponent:[key stringByAppendingString:@".air"]],
+      DXMT_RECIPE_LIBRARY_MAX_BYTES);
+  return [digest(data) isEqualToString:key] ? data : nil;
+}
+
+- (void)loadArchive {
+  NSData *metadata = readBounded([_directory stringByAppendingPathComponent:@"archive.json"], 1024 * 1024);
+  NSDictionary *manifest = metadata ? [NSJSONSerialization JSONObjectWithData:metadata options:0 error:nil] : nil;
+  if (![manifest isKindOfClass:NSDictionary.class]) return;
+  NSArray *entries = nil;
+  if ([manifest[@"archives"] isKindOfClass:NSArray.class] && [manifest[@"schema"] isEqual:@2])
+    entries = manifest[@"archives"];
+  else if (validKey(manifest[@"sha256"]))
+    entries = @[manifest]; // Preserve and migrate the previous single-archive format.
+  if (!entries || entries.count > 32) return;
+  NSMutableArray *archives = [NSMutableArray array];
+  uint64_t totalBytes = 0;
+  for (id candidate in entries) {
+    if (atomic_load(&globallyStopped)) break;
+    // With preparation disabled, existing archives remain available for cheap
+    // runtime lookup. Otherwise do not start another load after its deadline.
+    if (_startupBudget && CACurrentMediaTime() >= _startupDeadline) break;
+    @autoreleasepool {
+      if (![candidate isKindOfClass:NSDictionary.class] || !validKey(candidate[@"sha256"])) continue;
+      NSString *hash = candidate[@"sha256"];
+      NSString *path = [_archiveDirectory stringByAppendingPathComponent:[hash stringByAppendingString:@".metallib"]];
+      NSData *data = readBounded(path, ArchiveByteLimit - totalBytes);
+      if (![digest(data) isEqual:hash]) { atomic_fetch_add(&_archiveFailures, 1); continue; }
+      MTLBinaryArchiveDescriptor *descriptor = [[MTLBinaryArchiveDescriptor alloc] init];
+      descriptor.url = [NSURL fileURLWithPath:path];
+      NSError *error = nil;
+      id<MTLBinaryArchive> archive = [_device newBinaryArchiveWithDescriptor:descriptor error:&error];
+      [descriptor release];
+      if (archive) {
+        NSMutableArray *keys = [NSMutableArray array];
+        if ([candidate[@"prepared_keys"] isKindOfClass:NSArray.class] && [candidate[@"prepared_keys"] count] <= RecipeCapacity) {
+          for (id key in candidate[@"prepared_keys"]) {
+            if (validKey(key) && _archivedKeys.count < RecipeCapacity) {
+              [keys addObject:key]; [_archivedKeys addObject:key];
+            }
+          }
+        }
+        [archives addObject:archive];
+        [_archiveEntries addObject:@{@"sha256": hash, @"bytes": @(data.length), @"prepared_keys": keys}];
+        totalBytes += data.length;
+      } else atomic_fetch_add(&_archiveFailures, 1);
+      [archive release];
+      [self event:@"archive_load" values:@{@"success": @(archive != nil), @"bytes": @(data.length),
+          @"error_domain": error.domain ?: @"", @"error_code": @(error.code)}];
+    }
+  }
+  // Publish immutable objects exactly once. Neither prewarm nor runtime ever
+  // adds functions to, or serializes, an archive in this array.
+  os_unfair_lock_lock(&_lock);
+  _loadedArchives = [archives copy];
+  _activeArchiveBytes = totalBytes;
+  os_unfair_lock_unlock(&_lock);
+}
+
+- (NSArray *)rankedRecipes {
+  NSMutableArray *recipes = [NSMutableArray array];
+  NSDictionary *selectionRanks = nil;
+#ifdef DXMT_PIPELINE_CACHE_OFFLINE_TOOL
+  const char *selectionPath = getenv("DXMT_PIPELINE_CACHE_SELECTION");
+  if (_offline && !_offlineVerify && selectionPath && *selectionPath) {
+    NSData *data = readBounded([NSString stringWithUTF8String:selectionPath], 1024*1024);
+    id keys = data ? [NSJSONSerialization JSONObjectWithData:data options:0 error:nil] : nil;
+    NSMutableDictionary *ranks = [NSMutableDictionary dictionary];
+    BOOL valid = [keys isKindOfClass:NSArray.class] && [keys count] <= 7168;
+    if (valid) for (id key in keys) {
+      if (!validKey(key) || ranks[key]) { valid = NO; break; }
+      ranks[key] = @(ranks.count);
+    }
+    if (!valid) { atomic_fetch_add(&_prewarmFailures, 1); return @[]; }
+    selectionRanks = ranks;
+  }
+#endif
+  NSDirectoryEnumerator *entries = [NSFileManager.defaultManager enumeratorAtPath:_recipeDirectory];
+  unsigned visited = 0;
+  for (NSString *name in entries) {
+    if (++visited > RecipeCapacity || CACurrentMediaTime() >= _startupDeadline) break;
+    @autoreleasepool {
+      if (![name.pathExtension isEqualToString:@"json"] || !validKey(name.stringByDeletingPathExtension)) continue;
+      if (selectionRanks && !selectionRanks[name.stringByDeletingPathExtension]) continue;
+      NSData *data = readBounded([_recipeDirectory stringByAppendingPathComponent:name], DXMT_RECIPE_ENCODED_MAX_BYTES * 2);
+      NSDictionary *entry = data ? [NSJSONSerialization JSONObjectWithData:data options:0 error:nil] : nil;
+      if (![entry isKindOfClass:NSDictionary.class] || ![entry[@"cost_us"] isKindOfClass:NSNumber.class]) continue;
+      // Ranking needs only bounded cost metadata. Canonicalizing and hashing
+      // every learned descriptor consumed the whole 10-second game budget at
+      // ~12k recipes, leaving zero states prewarmed. prewarm validates the full
+      // selected recipe/key/dependencies immediately before restoring it; bad
+      // metadata can affect priority but can never admit a different pipeline.
+      double cost = [entry[@"cost_us"] doubleValue];
+      if (!isfinite(cost) || cost < 0 || cost > 60000000) continue;
+      BOOL archived = [_archivedKeys containsObject:name.stringByDeletingPathExtension];
+      if (_offlineVerify && !archived) continue;
+      if (_offline && !archived && cost < _minimumPrepareCost) continue;
+      // Only small ranking metadata survives this iteration. Thousands of full
+      // decoded descriptors and their JSON buffers must not accumulate in RAM.
+      [recipes addObject:@{@"key": name.stringByDeletingPathExtension, @"cost_us": @(cost)}];
+    }
+  }
+  [recipes sortUsingComparator:^NSComparisonResult(NSDictionary *a, NSDictionary *b) {
+    if (selectionRanks) return [selectionRanks[a[@"key"]] compare:selectionRanks[b[@"key"]]];
+    BOOL aPrepared = [_archivedKeys containsObject:a[@"key"]], bPrepared = [_archivedKeys containsObject:b[@"key"]];
+    // Offline compaction must cover every previously prepared key before adding
+    // new ones. Gameplay can prioritize expensive objects once the offline
+    // pass has supplied persistent archive coverage.
+    if (_offline && aPrepared != bPrepared) return aPrepared ? NSOrderedAscending : NSOrderedDescending;
+    if (!_offline && !_preferExpensive && aPrepared != bPrepared)
+      return aPrepared ? NSOrderedDescending : NSOrderedAscending;
+    return [b[@"cost_us"] compare:a[@"cost_us"]];
+  }];
+  return recipes;
+}
