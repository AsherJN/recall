+  _path = [[prefix stringByAppendingFormat:@"-%d.csv", getpid()] copy];
+  _hitch_path = [[prefix stringByAppendingFormat:@"-%d.hitches.csv", getpid()] copy];
+  _summary_path = [[prefix stringByAppendingFormat:@"-%d.summary.json", getpid()] copy];
+  // File operations, including initial open/header, stay off rendering and
+  // Metal callback threads. The captured path/self survive until this runs.
+  dispatch_async(_queue, ^{
+    _file = display_open_segment(_path, display_header, &_written_bytes);
+    _hitches = display_open_segment(_hitch_path,
+      "schema_version,native_pid,sequence,layer_ptr,unix_ms,presented_s,interval_ms,dropped_events,dropped_requests\n", &_hitch_bytes);
+    if (!_file) ++_io_errors;
+    if (!_hitches) ++_io_errors;
+  });
+  _timer = dispatch_source_create(DISPATCH_SOURCE_TYPE_TIMER, 0, 0, _queue);
+  dispatch_source_set_timer(_timer, dispatch_time(DISPATCH_TIME_NOW, 250 * NSEC_PER_MSEC),
+                           250 * NSEC_PER_MSEC, 50 * NSEC_PER_MSEC);
+  dispatch_source_set_event_handler(_timer, ^{
+    @autoreleasepool {
+      @try { [self drain]; }
+      @catch (NSException *exception) { (void)exception; ++_io_errors; }
+    }
+  });
+  dispatch_resume(_timer);
+  return self;
+}
+
+- (BOOL)reserveTrace:(uint64_t *)sequence {
+  if (!atomic_load(&_accepting)) return NO;
+  unsigned active = atomic_load(&_active_traces);
+  while (active < DisplayTraceLimit) {
+    if (atomic_compare_exchange_weak(&_active_traces, &active, active + 1)) {
+      if (!atomic_load(&_accepting)) {
+        atomic_fetch_sub(&_active_traces, 1);
+        return NO;
+      }
+      *sequence = atomic_fetch_add(&_next_sequence, 1) + 1;
+      return YES;
+    }
+  }
+  atomic_fetch_add(&_dropped_requests, 1);
+  return NO;
+}
+
+- (void)retireTrace {
+  atomic_fetch_sub(&_active_traces, 1);
+}
+
+- (void)enqueue:(DisplayEvent)event {
+  // A callback never waits for a writer, queue capacity, or disk. Dropping
+  // optional telemetry is preferable to perturbing the timing being measured.
+  if (atomic_load(&_closing) || !os_unfair_lock_trylock(&_ring_lock)) {
+    atomic_fetch_add(&_dropped_events, 1);
+    return;
+  }
+  if (atomic_load(&_closing) || _count == DisplayRingCapacity) {
+    atomic_fetch_add(&_dropped_events, 1);
+  } else {
+    _ring[(_head + _count) % DisplayRingCapacity] = event;
+    ++_count;
+  }
+  os_unfair_lock_unlock(&_ring_lock);
+}
+
+- (void)pairPresentation:(DisplayEvent)current previous:(DisplayEvent)previous slot:(unsigned)slot {
+  if (_paired[slot] || current.sequence != previous.sequence + 1 || !previous.sequence ||
+      current.layer_ptr != previous.layer_ptr || current.presented_state != DisplayValid ||
+      previous.presented_state != DisplayValid) return;
+  _paired[slot] = YES;
+  double interval = current.presented_s - previous.presented_s;
+  if (interval <= 0) { ++_nonincreasing; return; }
+  ++_intervals;
+  _observed_seconds += interval;
+  double ms = interval * 1000.0;
+  _max_interval_ms = fmax(_max_interval_ms, ms);
+  _over25 += ms > 25.0; _over50 += ms > 50.0; _over100 += ms > 100.0;
+  if (ms <= 25.0 || !_hitches) return;
+  const char *header = "schema_version,native_pid,sequence,layer_ptr,unix_ms,presented_s,interval_ms,dropped_events,dropped_requests\n";
+  if (_hitch_bytes >= DXMT_DISPLAY_HITCH_BYTES) {
+    if (!display_rotate(&_hitches, _hitch_path, header, &_hitch_bytes)) { ++_io_errors; return; }
+    ++_hitch_rotations;
+  }
+  // Wall time mapped to the actual presentation, not the later callback time.
+  int64_t presented_unix_ms = current.unix_ms + (int64_t)((current.presented_s - current.event_host_s) * 1000.0);
+  int n = fprintf(_hitches, "1,%d,%llu,%llx,%lld,%.9f,%.6f,%llu,%llu\n", getpid(),
+    (unsigned long long)current.sequence, (unsigned long long)current.layer_ptr,
+    (long long)presented_unix_ms, current.presented_s, ms,
+    (unsigned long long)atomic_load(&_dropped_events), (unsigned long long)atomic_load(&_dropped_requests));
+  if (n > 0) _hitch_bytes += n; else ++_io_errors;
+}
+
+- (void)observeEvent:(DisplayEvent)event {
+  if (event.kind <= DisplaySummary) ++_events[event.kind];
+  if (!_first_unix_ms) _first_unix_ms = event.unix_ms;
+  _last_unix_ms = MAX(_last_unix_ms, event.unix_ms);
+  if (event.kind == DisplayRegistrationFailed) ++_registration_failures;
+  if (event.kind == DisplayRetired && !(event.callbacks_seen & 1)) ++_retired_without_presentation;
+  if (event.kind != DisplayPresented) return;
+  if (event.presented_state == DisplayValid) ++_valid_presentations; else ++_unavailable_presentations;
+  unsigned slot = event.sequence % DisplayRingCapacity;
+  _presentations[slot] = event;
+  _paired[slot] = NO;
+  [self pairPresentation:event previous:_presentations[(event.sequence - 1) % DisplayRingCapacity] slot:slot];
+  unsigned next = (slot + 1) % DisplayRingCapacity;
+  [self pairPresentation:_presentations[next] previous:event slot:next];
+}
+
+- (void)writeLifetimeSummary {
+  NSString *temporary = [_summary_path stringByAppendingString:@".tmp"];
+  FILE *summary = fopen(temporary.fileSystemRepresentation, "w");
+  if (!summary) { ++_io_errors; return; }
+  int n = fprintf(summary,
+    "{\"schema_version\":1,\"native_pid\":%d,\"first_unix_ms\":%lld,\"last_unix_ms\":%lld,"
+    "\"requests_observed\":%llu,\"presentations_observed\":%llu,\"valid_presentations\":%llu,\"unavailable_presentations\":%llu,"
+    "\"adjacent_intervals\":%llu,\"continuous_interval_seconds\":%.9f,\"over25ms\":%llu,\"over50ms\":%llu,\"over100ms\":%llu,\"max_interval_ms\":%.6f,"
+    "\"nonincreasing_pairs\":%llu,\"retired_without_presentation\":%llu,\"registration_failures\":%llu,"
+    "\"dropped_events\":%llu,\"dropped_requests\":%llu,\"active_traces\":%u,\"registry_drops\":%llu,"
+    "\"rotations\":%llu,\"hitch_rotations\":%llu,\"io_errors\":%llu,\"disk_events_lost\":%llu,\"segment_limit\":%d,\"segments\":3,"
+    "\"interpretation\":\"Lifetime counters cover received events, including rotated-out segments. Intervals require adjacent valid sequence IDs and matching layer. Missing/unavailable callbacks are not classified as stutter.\"}\n",
+    getpid(), (long long)_first_unix_ms, (long long)_last_unix_ms,
+    (unsigned long long)_events[DisplayRequest], (unsigned long long)_events[DisplayPresented],
+    (unsigned long long)_valid_presentations, (unsigned long long)_unavailable_presentations,
+    (unsigned long long)_intervals, _observed_seconds, (unsigned long long)_over25, (unsigned long long)_over50,
+    (unsigned long long)_over100, _max_interval_ms, (unsigned long long)_nonincreasing,
+    (unsigned long long)_retired_without_presentation, (unsigned long long)_registration_failures,
+    (unsigned long long)atomic_load(&_dropped_events), (unsigned long long)atomic_load(&_dropped_requests), atomic_load(&_active_traces),
+    (unsigned long long)atomic_load(&display_registry_drops),
+    (unsigned long long)_rotations, (unsigned long long)_hitch_rotations, (unsigned long long)_io_errors,
+    (unsigned long long)_disk_events_lost, DXMT_DISPLAY_SEGMENT_BYTES);
+  BOOL ok = n > 0;
+  if (fclose(summary)) ok = NO;
+  if (!ok || rename(temporary.fileSystemRepresentation, _summary_path.fileSystemRepresentation)) ++_io_errors;
+}
+
+- (void)writeEvent:(DisplayEvent)event {
+  [self observeEvent:event];
+  if (!_file) { ++_disk_events_lost; return; }
+  if (_written_bytes >= DXMT_DISPLAY_SEGMENT_BYTES) {
+    if (!display_rotate(&_file, _path, display_header, &_written_bytes)) {
+      ++_io_errors; ++_disk_events_lost; return;
+    }
+    ++_rotations;
+  }
+  static const char *kinds[] = {"invalid", "request", "presented", "gpu_complete", "retired", "registration_failed", "summary"};
+  static const char *states[] = {"pending", "valid", "zero_or_unavailable", "unsupported"};
+  int bytes = fprintf(_file,
+      "1,%s,%lld,%d,%llu,%llx,%llu,%llx,%.9f,%.9f,%.9f,%.9f,%s,%.9f,%.9f,%s,%u,%lld,%u,%llu,%llu,%u\n",
+      kinds[event.kind], (long long)event.unix_ms, getpid(), (unsigned long long)event.sequence,
+      (unsigned long long)event.layer_ptr, (unsigned long long)event.drawable_id,
+      (unsigned long long)event.command_ptr, event.request_host_s, event.event_host_s,
+      event.minimum_duration_s, event.presented_s, states[event.presented_state],
+      event.gpu_start_s, event.gpu_end_s, states[event.gpu_state], event.command_status,
+      (long long)event.error_code, event.callbacks_seen,
+      (unsigned long long)atomic_load(&_dropped_events), (unsigned long long)atomic_load(&_dropped_requests),
+      atomic_load(&_active_traces));
+  if (bytes > 0) _written_bytes += bytes;
+  else { ++_io_errors; ++_disk_events_lost; }
+}
+
+- (void)drain {
+  DisplayEvent batch[DisplayDrainBatch];
+  // Never chase a producer indefinitely. Producers hold the lock for one
+  // fixed-size copy; no allocation or I/O occurs while the ring is locked.
+  for (unsigned pass = 0; pass < DisplayRingCapacity / DisplayDrainBatch; ++pass) {
+    os_unfair_lock_lock(&_ring_lock);
+    unsigned count = MIN(_count, DisplayDrainBatch);
+    for (unsigned i = 0; i < count; ++i) batch[i] = _ring[(_head + i) % DisplayRingCapacity];
+    _head = (_head + count) % DisplayRingCapacity;
+    _count -= count;
+    os_unfair_lock_unlock(&_ring_lock);
+    for (unsigned i = 0; i < count; ++i) [self writeEvent:batch[i]];
+    if (count < DisplayDrainBatch) break;
+  }
+  if (_file && fflush(_file)) ++_io_errors;
+  if (_hitches && fflush(_hitches)) ++_io_errors;
+  int64_t now = (int64_t)((CFAbsoluteTimeGetCurrent() + kCFAbsoluteTimeIntervalSince1970) * 1000.0);
+  if (now - _last_summary_ms >= 1000) { [self writeLifetimeSummary]; _last_summary_ms = now; }
+}
+
+- (void)finishShutdown {
+  [self drain];
+  DisplayEvent summary = {.kind = DisplaySummary};
+  display_stamp(&summary);
+  [self writeEvent:summary];
+  [self writeLifetimeSummary];
+  if (_file) { fclose(_file); _file = NULL; }
+  if (_hitches) { fclose(_hitches); _hitches = NULL; }
+  dispatch_semaphore_signal(_shutdown_done);
+}
+
+- (void)shutdown {
+  if (atomic_exchange(&_closing, true)) return;
+  atomic_store(&_accepting, false);
+  // Cancelling/releasing the timer breaks its handler's self-retention cycle.
+  dispatch_source_cancel(_timer);
+  dispatch_release(_timer);
+  _timer = NULL;
+  if (dispatch_get_specific(&display_queue_key) == self) {
+    [self finishShutdown];
+  } else {
+    dispatch_async(_queue, ^{ [self finishShutdown]; });
+    // No GPU wait, and disk failure cannot hold process shutdown indefinitely.
+    // A timeout may lose the tail at process exit; queued work retains self.
+    dispatch_semaphore_wait(_shutdown_done, dispatch_time(DISPATCH_TIME_NOW, 500 * NSEC_PER_MSEC));
+  }
+}
+
+- (void)dealloc {
+  [_path release]; [_hitch_path release]; [_summary_path release];
+  dispatch_release(_shutdown_done);
+  dispatch_release(_queue);
+  [super dealloc];
+}
+@end
+
+@interface DXMTDisplayTrace : NSObject {
+  DXMTDisplayLogger *_logger;
+  DisplayEvent _base;
+  atomic_uint _callbacks_seen;
+}
+- (instancetype)initWithLogger:(DXMTDisplayLogger *)logger event:(DisplayEvent)event;
+- (void)presented:(id<MTLDrawable>)drawable;
+- (void)completed:(id<MTLCommandBuffer>)command;
+- (void)registrationFailed;
+@end
+
+@implementation DXMTDisplayTrace
+- (instancetype)initWithLogger:(DXMTDisplayLogger *)logger event:(DisplayEvent)event {
+  if ((self = [super init])) {
+    _logger = [logger retain];
+    _base = event;
+    atomic_init(&_callbacks_seen, 0);
+  }
+  return self;
+}
+- (void)presented:(id<MTLDrawable>)drawable {
+  DisplayEvent event = _base;
+  event.kind = DisplayPresented;
+  event.callbacks_seen = atomic_fetch_or(&_callbacks_seen, 1) | 1;
+  event.presented_s = drawable.presentedTime;
+  // Apple's zero means not presented OR skipped; never invent a display time.
+  event.presented_state = event.presented_s > 0 ? DisplayValid : DisplayZero;
+  display_stamp(&event);
+  [_logger enqueue:event];
+}
+- (void)completed:(id<MTLCommandBuffer>)command {
+  DisplayEvent event = _base;
+  event.kind = DisplayCompleted;
+  event.callbacks_seen = atomic_fetch_or(&_callbacks_seen, 2) | 2;
+  event.command_status = (unsigned)command.status;
+  event.error_code = command.error.code;
+  event.gpu_start_s = command.GPUStartTime;
+  event.gpu_end_s = command.GPUEndTime;
+  event.gpu_state = event.gpu_start_s > 0 && event.gpu_end_s >= event.gpu_start_s ? DisplayValid : DisplayZero;
+  // These GPU times cover only the command buffer that presents this drawable,
+  // not necessarily every command buffer constituting the game's whole frame.
+  display_stamp(&event);
+  [_logger enqueue:event];
+}
+- (void)registrationFailed {
+  DisplayEvent event = _base;
+  event.kind = DisplayRegistrationFailed;
+  event.presented_state = DisplayUnavailable;
+  display_stamp(&event);
+  [_logger enqueue:event];
+}
+- (void)dealloc {
+  DisplayEvent event = _base;
+  event.kind = DisplayRetired;
+  event.callbacks_seen = atomic_load(&_callbacks_seen);
+  display_stamp(&event);
+  [_logger enqueue:event];
+  [_logger retireTrace];
+  [_logger release];
+  [super dealloc];
+}
+@end
+
+static os_unfair_lock display_global_lock = OS_UNFAIR_LOCK_INIT;
+static DXMTDisplayLogger *display_logger;
+static void *display_code_pin;
+static atomic_bool display_available;
+static atomic_bool display_stopped;
+
+void WMTDisplayLogShutdown(void) {
+  os_unfair_lock_lock(&display_global_lock);
+  atomic_store(&display_stopped, true);
+  DXMTDisplayLogger *logger = display_logger;
+  display_logger = nil;
+  void *pin = display_code_pin;
+  display_code_pin = NULL;
+  atomic_store(&display_available, false);
+  os_unfair_lock_unlock(&display_global_lock);
+  [logger shutdown];
+  [logger release];
+  // RTLD_NODELETE explicitly keeps code mapped for any late Metal callbacks.
+  // Do not rely on incidental Objective-C dylib unloading behavior.
+  if (pin) dlclose(pin);
+}
+
+static DXMTDisplayLogger *display_get_logger(void) {
+  if (atomic_load(&display_stopped)) return nil;
+  static dispatch_once_t once;
+  dispatch_once(&once, ^{
+    const char *prefix = getenv("DXMT_DISPLAY_LOG");
+    if (!prefix || prefix[0] != '/') return;
+    Dl_info image;
+    if (!dladdr((void *)&WMTDisplayLogPresent, &image)) return;
+    void *pin = dlopen(image.dli_fname, RTLD_LAZY | RTLD_LOCAL | RTLD_NODELETE);
+    if (!pin) return; // Callback code must remain valid after Wine's dlclose.
+    DXMTDisplayLogger *logger = [[DXMTDisplayLogger alloc] initWithPrefix:[NSString stringWithUTF8String:prefix]];
+    if (!logger) { dlclose(pin); return; }
+    os_unfair_lock_lock(&display_global_lock);
+    if (atomic_load(&display_stopped)) {
+      os_unfair_lock_unlock(&display_global_lock);
+      [logger shutdown];
+      [logger release];
+      dlclose(pin);
+      return;
+    }
+    display_logger = logger;
+    display_code_pin = pin;
+    atomic_store(&display_available, true);
+    os_unfair_lock_unlock(&display_global_lock);
+    atexit(WMTDisplayLogShutdown);
+  });
+  if (!atomic_load(&display_available)) return nil;
+  if (!os_unfair_lock_trylock(&display_global_lock)) { atomic_fetch_add(&display_registry_drops, 1); return nil; }
+  DXMTDisplayLogger *logger = [display_logger retain];
+  os_unfair_lock_unlock(&display_global_lock);
+  return logger;
+}
+
+void WMTDisplayLogPresent(id<MTLCommandBuffer> command, id<MTLDrawable> drawable, double minimum_duration) {
+  DXMTDisplayLogger *logger = display_get_logger();
+  if (!logger) return;
+  uint64_t sequence;
+  if (!command || !drawable || ![logger reserveTrace:&sequence]) { [logger release]; return; }
+  DisplayEvent event = {.kind = DisplayRequest, .sequence = sequence, .minimum_duration_s = minimum_duration,
+                        .command_ptr = (uintptr_t)command, .command_status = (unsigned)command.status};
+  display_stamp(&event);
+  event.request_host_s = event.event_host_s;
+  BOOL supported = [drawable respondsToSelector:@selector(addPresentedHandler:)] &&
+                   [drawable respondsToSelector:@selector(presentedTime)] &&
+                   [drawable respondsToSelector:@selector(drawableID)] &&
+                   [command respondsToSelector:@selector(GPUStartTime)] &&
+                   [command respondsToSelector:@selector(GPUEndTime)] && command.status < MTLCommandBufferStatusCommitted;
+  if (supported) {
+    event.drawable_id = drawable.drawableID;
+    if ([drawable respondsToSelector:@selector(layer)]) event.layer_ptr = (uintptr_t)[(id<CAMetalDrawable>)drawable layer];
+  } else {
+    event.presented_state = DisplayUnavailable;
+    event.gpu_state = DisplayUnavailable;
+  }
+  [logger enqueue:event];
+  DXMTDisplayTrace *trace = [[DXMTDisplayTrace alloc] initWithLogger:logger event:event];
+  if (trace) {
+    if (supported) {
+      @try {
+        // Blocks retain only trace/logger. Capturing command/drawable here
+        // would form a retain cycle with Metal's stored callback blocks.
+        [drawable addPresentedHandler:^(id<MTLDrawable> presented) { [trace presented:presented]; }];
+        [command addCompletedHandler:^(id<MTLCommandBuffer> completed) { [trace completed:completed]; }];
+      } @catch (NSException *exception) {
+        (void)exception;
+        [trace registrationFailed];
+      }
+    }
+    [trace release];
+  } else {
+    [logger retireTrace];
+  }
+  [logger release];
+}
