+  _lock = (os_unfair_lock)OS_UNFAIR_LOCK_INIT;
+  _recordLock = (os_unfair_lock)OS_UNFAIR_LOCK_INIT;
+  _traceLock = (os_unfair_lock)OS_UNFAIR_LOCK_INIT;
