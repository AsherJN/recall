 # d3d11.releaseShaderIR = True
 
+# Private Overwatch experiment: bound shader/pipeline compilation concurrency.
+# 0 preserves the upstream automatic policy. Explicit values are clamped to 1..64.
+# Lower values reduce concurrent compiler memory/CPU use but can extend cold loads.
+# d3d11.shaderCompilerThreads = 0
+
+# Private experiment: request normal rather than time-critical compiler priority.
+# This is a candidate for reducing contention, not a universal performance gain.
+# d3d11.shaderCompilerNormalPriority = False
+
 
 # Force to report a SDR display, in case of unintended behavior in HDR mode
 # This option only affects DXGI, and does not change what games see through nvapi
@@ -100,6 +109,14 @@
 
