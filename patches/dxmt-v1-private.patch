+      &_runtimeCreates, &_prewarmed, &_prewarmFailures, &_archiveAdds, &_archiveFailures, &_persistFailures,
+      &_queueFull, &_queueBytesFull, &_queueContention, &_duplicates, &_traceDrops, &_readonlyRejects,
+      &_invalidRecords, &_recipeLimitRejects, &_libraryLimitRejects, &_diskLimitRejects, &_diskSpaceRejects,
+      &_ioFailures, &_dependencyRetries, &_dependencyFailures, &_writeRetries, &_retryExhausted,
+      &_overflowBytes, &_overflowCount, &_overflowAccepted, &_overflowRejected,
+      &_stateEvictions, &_stateContentions};
+  for (unsigned i = 0; i < sizeof(counters) / sizeof(counters[0]); ++i) atomic_init(counters[i], 0);
