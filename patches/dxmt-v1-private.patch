+      if (totals.file && std::fflush(totals.file)) ++io_errors;
+      if (events.file && std::fflush(events.file)) ++io_errors;
+      auto summary_ns = now();
+      if (!last_summary_ns || summary_ns - last_summary_ns >= 1000000000) {
+        summary(); last_summary_ns = summary_ns;
+      }
+      if (closing_before_scan && drained) break;
+      std::this_thread::sleep_for(std::chrono::milliseconds(100));
+    }
+    summary();
+    if (totals.file) std::fclose(totals.file);
+    if (events.file) std::fclose(events.file);
+    s->done.store(true, std::memory_order_release);
+  }
+  explicit ResourceTelemetry(const char *path) : state_(std::make_shared<State>()) {
+    state_->path = std::string(path) + "-" + std::to_string(getpid()) + "-" +
+      std::to_string(reinterpret_cast<uintptr_t>(&ResourceTelemetry::get));
+#ifdef _WIN32
+    HMODULE pin = nullptr;
+    if (!GetModuleHandleExA(GET_MODULE_HANDLE_EX_FLAG_PIN | GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS,
+          reinterpret_cast<LPCSTR>(&ResourceTelemetry::get), &pin)) {
+      state_->closing.store(true); state_->done.store(true); return;
+    }
+#endif
+    worker_ = dxmt::thread([s = state_] {
+      try { run(s); }
+      catch (...) { s->closing.store(true, std::memory_order_release); s->done.store(true, std::memory_order_release); }
+    });
+#ifdef _WIN32
+    worker_.set_priority(ThreadPriority::Lowest);
+#endif
+  }
+};
+
+class ResourceScope {
+  ResourceTelemetry *trace_;
+  ResourceTelemetry::Op op_;
+  int64_t start_ = 0;
+  uint64_t resource_, bytes_, units_ = 1, detail_;
+public:
+  explicit ResourceScope(ResourceTelemetry::Op op, const void *resource = nullptr,
+                         uint64_t bytes = ResourceTelemetry::UnknownBytes, uint64_t detail = 0) noexcept :
+    trace_(ResourceTelemetry::get()), op_(op), resource_(reinterpret_cast<uintptr_t>(resource)), bytes_(bytes), detail_(detail) {
+    if (trace_) start_ = ResourceTelemetry::now();
+  }
+  ResourceScope(const ResourceScope &) = delete;
+  ResourceScope &operator=(const ResourceScope &) = delete;
+  void bytes(uint64_t value) noexcept { bytes_ = value; }
+  void units(uint64_t value) noexcept { units_ = value; }
+  void finish() noexcept {
+    if (!trace_) return;
+    trace_->record(op_, start_, ResourceTelemetry::now(), resource_, bytes_, units_, detail_);
+    trace_ = nullptr;
+  }
+  ~ResourceScope() { finish(); }
+};
