new file mode 100644
index 0000000..bdca323
--- /dev/null
+++ b/src/winemetal/unix/pipeline_recipe.c
@@ -0,0 +1,529 @@
+#import "pipeline_recipe.h"
+#import <CommonCrypto/CommonDigest.h>
+#import <objc/runtime.h>
+#include <math.h>
+#include <string.h>
+#include <stdatomic.h>
+#include <Block.h>
+#define WINEMETAL_API
+#include "../winemetal.h"
+
+#ifndef DXMT_NO_PRIVATE_API
+@interface MTLRenderPipelineDescriptor (DXMTRecipeLogic)
+- (void)setLogicOperationEnabled:(BOOL)enabled;
+- (void)setLogicOperation:(NSUInteger)operation;
+@end
+#endif
+
+static char library_metadata_key, function_metadata_key;
+static char library_retry_key, function_retry_key;
+static atomic_uint_fast64_t retry_bytes, retry_packets, retry_attempts, retry_successes;
+static atomic_uint_fast64_t retry_rejected_bytes, retry_rejected_packets, retry_contention, retry_busy, retry_exceptions;
+enum { RetryPacketLimit = 1024 };
+static const uint64_t RetryByteLimit = 32u * 1024u * 1024u;
+
+// A rejected producer admission must not permanently orphan a valid identity.
+// Pending payloads follow library/function lifetime and have a separate global
+// budget; callback acceptance transfers retry responsibility to the manager.
+static BOOL reserve_retry(atomic_uint_fast64_t *counter, uint64_t amount, uint64_t limit,
+                          atomic_uint_fast64_t *rejected) {
+  uint_fast64_t old = atomic_load(counter);
+  for (unsigned attempt = 0; attempt < 8; ++attempt) {
+    if (old > limit - amount) { atomic_fetch_add(rejected, 1); return NO; }
+    if (atomic_compare_exchange_weak(counter, &old, old + amount)) return YES;
+  }
+  atomic_fetch_add(&retry_contention, 1); return NO;
+}
+
+@interface DXMTRecipeRetry : NSObject {
+  NSData *_bytes;
+  NSString *_key;
+  DXMTRecipeLibraryStore _store;
+  uint64_t _reservation;
+  atomic_flag _trying;
+}
+- (instancetype)initKey:(NSString *)key bytes:(NSData *)bytes store:(DXMTRecipeLibraryStore)store;
+- (BOOL)attempt;
+@end
+
+@implementation DXMTRecipeRetry
+- (instancetype)initKey:(NSString *)key bytes:(NSData *)bytes store:(DXMTRecipeLibraryStore)store {
+  if (!(self = [super init])) return nil;
+  atomic_flag_clear(&_trying);
+  if (!reserve_retry(&retry_bytes, bytes.length, RetryByteLimit, &retry_rejected_bytes)) {
+    [self release]; return nil;
+  }
+  if (!reserve_retry(&retry_packets, 1, RetryPacketLimit, &retry_rejected_packets)) {
+    atomic_fetch_sub(&retry_bytes, bytes.length); [self release]; return nil;
+  }
+  _reservation = bytes.length;
+  @try { _bytes = [bytes retain]; _key = [key copy]; _store = Block_copy(store); }
+  @catch (NSException *exception) { [self release]; return nil; }
+  if (!_bytes || !_key || !_store) { [self release]; return nil; }
+  return self;
+}
+- (void)releaseReservation {
+  if (_reservation) {
+    atomic_fetch_sub(&retry_bytes, _reservation); atomic_fetch_sub(&retry_packets, 1);
+    _reservation = 0;
+  }
+}
+- (BOOL)attempt {
+  if (atomic_flag_test_and_set_explicit(&_trying, memory_order_acquire)) {
+    atomic_fetch_add(&retry_busy, 1); return NO;
+  }
+  @try {
+    if (!_bytes) return YES;
+    atomic_fetch_add(&retry_attempts, 1);
+    if (!_store(_key, _bytes)) return NO;
+    atomic_fetch_add(&retry_successes, 1);
+    [_bytes release]; _bytes = nil;
+    [_key release]; _key = nil;
+    Block_release(_store); _store = nil;
+    [self releaseReservation];
+    return YES;
+  } @catch (NSException *exception) {
+    atomic_fetch_add(&retry_exceptions, 1); return NO;
+  } @finally { atomic_flag_clear_explicit(&_trying, memory_order_release); }
+}
+- (void)dealloc {
+  [_bytes release]; [_key release]; if (_store) Block_release(_store);
+  [self releaseReservation]; [super dealloc];
+}
+@end
+
+NSDictionary *dxmt_recipe_retry_stats(void) {
+  return @{@"reserved_bytes": @(atomic_load(&retry_bytes)), @"packets": @(atomic_load(&retry_packets)),
+    @"byte_limit": @(RetryByteLimit), @"packet_limit": @(RetryPacketLimit),
+    @"attempts": @(atomic_load(&retry_attempts)), @"successes": @(atomic_load(&retry_successes)),
+    @"rejected_bytes": @(atomic_load(&retry_rejected_bytes)), @"rejected_packets": @(atomic_load(&retry_rejected_packets)),
+    @"reservation_contention": @(atomic_load(&retry_contention)), @"busy": @(atomic_load(&retry_busy)),
+    @"exceptions": @(atomic_load(&retry_exceptions))};
+}
+
+static void retry_function(id<MTLFunction> function) {
+  DXMTRecipeRetry *packet = [objc_getAssociatedObject(function, &function_retry_key) retain];
+  @try { [packet attempt]; } @finally { [packet release]; }
+}
+
+static NSString *sha256(NSData *data) {
+  if (!data || data.length > UINT32_MAX)
+    return nil;
+  unsigned char digest[CC_SHA256_DIGEST_LENGTH];
+  CC_SHA256(data.bytes, (CC_LONG)data.length, digest);
+  char text[CC_SHA256_DIGEST_LENGTH * 2 + 1];
+  const char *hex = "0123456789abcdef";
+  for (unsigned i = 0; i < CC_SHA256_DIGEST_LENGTH; ++i) {
+    text[2 * i] = hex[digest[i] >> 4];
+    text[2 * i + 1] = hex[digest[i] & 15];
+  }
+  text[sizeof(text) - 1] = 0;
+  return [NSString stringWithUTF8String:text];
+}
+
+static BOOL valid_sha(id object) {
+  if (![object isKindOfClass:[NSString class]] || [object length] != 64)
+    return NO;
+  for (NSUInteger i = 0; i < 64; ++i) {
+    unichar c = [object characterAtIndex:i];
+    if (!((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f')))
+      return NO;
+  }
+  return YES;
+}
+
+// Domain/version and UTF-8 byte length make the function identity unambiguous.
+// The library digest covers every byte; no library/address/padding is retained.
+static NSString *function_digest(NSString *library, NSString *name) {
+  if (!valid_sha(library) || ![name isKindOfClass:[NSString class]])
+    return nil;
+  NSData *utf8 = [name dataUsingEncoding:NSUTF8StringEncoding allowLossyConversion:NO];
+  if (!utf8.length || utf8.length > 1024 || memchr(utf8.bytes, 0, utf8.length) != NULL)
+    return nil;
+  NSMutableData *identity = [NSMutableData dataWithData:[@"dxmt-function-v1:" dataUsingEncoding:NSASCIIStringEncoding]];
+  [identity appendData:[library dataUsingEncoding:NSASCIIStringEncoding]];
+  uint32_t size = CFSwapInt32HostToBig((uint32_t)utf8.length);
+  [identity appendBytes:&size length:sizeof(size)];
+  [identity appendData:utf8];
+  return sha256(identity);
+}
+
+BOOL dxmt_recipe_register_library(id<MTLLibrary> library, dispatch_data_t data,
+                                  DXMTRecipeLibraryStore store) {
+  if (!library || !data || !store)
+    return NO;
+  // Re-registration first revokes prior eligibility, including failure paths.
+  dxmt_recipe_forget_library(library);
+  size_t length = dispatch_data_get_size(data);
+  if (!length || length > DXMT_RECIPE_LIBRARY_MAX_BYTES)
+    return NO;
+  dispatch_data_t mapped = NULL;
+  @try {
+    const void *bytes = NULL;
+    size_t mapped_size = 0;
+    mapped = dispatch_data_create_map(data, &bytes, &mapped_size);
+    if (!mapped || !bytes || mapped_size != length) {
+      if (mapped) dispatch_release(mapped);
+      return NO;
+    }
+    NSData *content = [NSData dataWithBytes:bytes length:length];
+    NSString *digest = sha256(content);
+    // Identity describes this already-created library, independently of whether
+    // the bounded persistence queue can accept its bytes. Missing saved bytes
+    // make later restoration fail safely; they must not disable current reuse.
+    BOOL accepted = digest != nil;
+    if (accepted) {
+      objc_setAssociatedObject(library, &library_metadata_key, digest, OBJC_ASSOCIATION_COPY);
+      BOOL stored = NO;
+      @try { stored = store(digest, content); }
+      @catch (NSException *exception) { atomic_fetch_add(&retry_exceptions, 1); }
+      if (!stored) {
+        DXMTRecipeRetry *packet = [[DXMTRecipeRetry alloc] initKey:digest bytes:content store:store];
+        @try { objc_setAssociatedObject(library, &library_retry_key, packet, OBJC_ASSOCIATION_RETAIN); }
+        @finally { [packet release]; }
+      }
+    }
+    dispatch_release(mapped);
+    return accepted;
+  } @catch (NSException *exception) {
+    (void)exception;
+    if (mapped) dispatch_release(mapped);
+    return NO;
+  }
+}
+
+void dxmt_recipe_forget_library(id<MTLLibrary> library) {
+  @try {
+    if (library) {
+      objc_setAssociatedObject(library, &library_metadata_key, nil, OBJC_ASSOCIATION_RETAIN);
+      objc_setAssociatedObject(library, &library_retry_key, nil, OBJC_ASSOCIATION_RETAIN);
+    }
+  } @catch (NSException *exception) { (void)exception; }
+}
+
+void dxmt_recipe_forget_function(id<MTLFunction> function) {
+  @try {
+    if (function) {
+      objc_setAssociatedObject(function, &function_metadata_key, nil, OBJC_ASSOCIATION_RETAIN);
+      objc_setAssociatedObject(function, &function_retry_key, nil, OBJC_ASSOCIATION_RETAIN);
+    }
+  } @catch (NSException *exception) { (void)exception; }
+}
+
+BOOL dxmt_recipe_register_function(id<MTLFunction> function, id<MTLLibrary> library,
+                                   NSString *name) {
+  dxmt_recipe_forget_function(function);
+  if (!function || !library || !name)
+    return NO;
+  @try {
+    NSString *library_digest = objc_getAssociatedObject(library, &library_metadata_key);
+    NSString *digest = function_digest(library_digest, name);
+    if (!digest || ![[function name] isEqualToString:name])
+      return NO;
+    NSDictionary *metadata = @{@"library": library_digest, @"name": [[name copy] autorelease],
+                               @"sha256": digest, @"type": @((unsigned)[function functionType])};
+    objc_setAssociatedObject(function, &function_metadata_key, metadata, OBJC_ASSOCIATION_COPY);
+    DXMTRecipeRetry *packet = [objc_getAssociatedObject(library, &library_retry_key) retain];
+    @try {
+      if (packet && ![packet attempt])
+        objc_setAssociatedObject(function, &function_retry_key, packet, OBJC_ASSOCIATION_RETAIN);
+    } @finally { [packet release]; }
+    return YES;
+  } @catch (NSException *exception) {
+    (void)exception;
+    return NO;
+  }
+}
+
+static BOOL exact_keys(NSDictionary *dictionary, NSArray *keys) {
+  if (![dictionary isKindOfClass:[NSDictionary class]] || dictionary.count != keys.count)
+    return NO;
+  for (NSString *key in keys)
+    if (![dictionary objectForKey:key])
+      return NO;
+  return YES;
+}
+
+static BOOL uint_value(id value, uint64_t minimum, uint64_t maximum) {
+  if (![value isKindOfClass:[NSNumber class]] || CFGetTypeID((CFTypeRef)value) == CFBooleanGetTypeID())
+    return NO;
+  double number = [value doubleValue];
+  return isfinite(number) && number >= minimum && number <= maximum && floor(number) == number;
+}
+
+static BOOL valid_function(id object, MTLFunctionType type) {
+  if (!exact_keys(object, @[@"library", @"name", @"sha256", @"type"]))
+    return NO;
+  NSDictionary *function = object;
+  if (!uint_value(function[@"type"], type, type) || !valid_sha(function[@"library"]) || !valid_sha(function[@"sha256"]))
+    return NO;
+  return [function_digest(function[@"library"], function[@"name"]) isEqualToString:function[@"sha256"]];
+}
+
+static NSArray *scalar_keys(void) {
+  return @[@"schema", @"private_logic", @"logic_enabled", @"logic_op", @"alpha_to_coverage", @"alpha_to_one",
+           @"rasterization", @"sample_count", @"depth_format", @"stencil_format", @"primitive_topology",
+           @"tess_partition", @"tess_factor_step", @"tess_winding", @"tess_max_factor", @"tess_factor_scale",
+           @"tess_factor_format", @"tess_control_point_index", @"indirect_commands", @"vertex_amplification",
+           @"add_vertex_binary", @"add_fragment_binary", @"vertex_call_stack", @"fragment_call_stack",
+           @"shader_validation"];
+}
+
+static NSArray *color_keys(void) {
+  return @[@"format", @"blend", @"write_mask", @"rgb_op", @"alpha_op", @"src_rgb", @"dst_rgb", @"src_alpha", @"dst_alpha"];
+}
+
+static BOOL valid_recipe(NSDictionary *recipe) {
+  NSMutableArray *keys = [NSMutableArray arrayWithArray:scalar_keys()];
+  [keys addObjectsFromArray:@[@"vertex", @"fragment", @"colors", @"vertex_buffers", @"fragment_buffers"]];
+  if (!exact_keys(recipe, keys) || !uint_value(recipe[@"schema"], 1, 1) || !valid_function(recipe[@"vertex"], MTLFunctionTypeVertex))
+    return NO;
+  if (recipe[@"fragment"] != [NSNull null] && !valid_function(recipe[@"fragment"], MTLFunctionTypeFragment))
+    return NO;
+  for (NSString *key in @[@"private_logic", @"logic_enabled", @"alpha_to_coverage", @"alpha_to_one", @"rasterization",
+                          @"tess_factor_scale", @"indirect_commands", @"add_vertex_binary", @"add_fragment_binary"])
+    if (!uint_value(recipe[key], 0, 1)) return NO;
+  if (!uint_value(recipe[@"logic_op"], 0, 15) || !uint_value(recipe[@"sample_count"], 1, 8) ||
+      !uint_value(recipe[@"depth_format"], 0, 65535) || !uint_value(recipe[@"stencil_format"], 0, 65535) ||
+      !uint_value(recipe[@"primitive_topology"], 0, 3) || !uint_value(recipe[@"tess_partition"], 0, 3) ||
+      !uint_value(recipe[@"tess_factor_step"], 0, 3) || !uint_value(recipe[@"tess_winding"], 0, 1) ||
+      !uint_value(recipe[@"tess_max_factor"], 0, 64) || !uint_value(recipe[@"tess_factor_format"], 0, 0) ||
+      !uint_value(recipe[@"tess_control_point_index"], 0, 2) || !uint_value(recipe[@"vertex_amplification"], 1, 16) ||
+      !uint_value(recipe[@"vertex_call_stack"], 0, 64) || !uint_value(recipe[@"fragment_call_stack"], 0, 64) ||
+      !uint_value(recipe[@"shader_validation"], 0, 2))
+    return NO;
+  if (recipe[@"private_logic"] && ![recipe[@"private_logic"] unsignedIntValue] &&
+      ([recipe[@"logic_enabled"] unsignedIntValue] || [recipe[@"logic_op"] unsignedIntValue]))
+    return NO;
+  NSArray *colors = recipe[@"colors"];
+  if (![colors isKindOfClass:[NSArray class]] || colors.count != 8)
+    return NO;
+  for (NSDictionary *color in colors) {
+    if (!exact_keys(color, color_keys()) || !uint_value(color[@"format"], 0, 65535) ||
+        !uint_value(color[@"blend"], 0, 1) || !uint_value(color[@"write_mask"], 0, 15) ||
+        !uint_value(color[@"rgb_op"], 0, 4) || !uint_value(color[@"alpha_op"], 0, 4))
+      return NO;
+    for (NSString *key in @[@"src_rgb", @"dst_rgb", @"src_alpha", @"dst_alpha"])
+      if (!uint_value(color[key], 0, 18)) return NO;
+  }
+  for (NSString *key in @[@"vertex_buffers", @"fragment_buffers"]) {
+    NSArray *buffers = recipe[key];
+    if (![buffers isKindOfClass:[NSArray class]] || buffers.count != 31)
+      return NO;
+    for (NSNumber *value in buffers)
+      if (!uint_value(value, 0, 2)) return NO;
+  }
+  return YES;
+}
+
+static BOOL vertex_descriptor_empty(MTLVertexDescriptor *descriptor) {
+  if (!descriptor) return YES;
+  // Metal may lazily return a nonnil default descriptor even when no layout was
+  // assigned. Accept that exact empty state; reject every nondefault component.
+  for (unsigned i = 0; i < 31; ++i) {
+    MTLVertexAttributeDescriptor *attribute = descriptor.attributes[i];
+    MTLVertexBufferLayoutDescriptor *layout = descriptor.layouts[i];
+    if (attribute.format != MTLVertexFormatInvalid || attribute.offset || attribute.bufferIndex ||
+        layout.stride || layout.stepFunction != MTLVertexStepFunctionPerVertex || layout.stepRate != 1)
+      return NO;
+  }
+  return YES;
+}
+
+static BOOL linked_functions_empty(MTLLinkedFunctions *linked) {
+  return !linked.functions.count && !linked.binaryFunctions.count && !linked.groups.count && !linked.privateFunctions.count;
+}
+
+NSDictionary *dxmt_recipe_capture(const struct WMTRenderPipelineInfo *info,
+                                  MTLRenderPipelineDescriptor *descriptor) {
+  if (!info || !descriptor || info->binary_archive_for_serialization || info->binary_archives_for_lookup.ptr ||
+      info->num_binary_archives_for_lookup || info->fail_on_binary_archive_miss)
+    return nil;
+  @try {
+    if (descriptor.vertexFunction != (id<MTLFunction>)info->vertex_function ||
+        descriptor.fragmentFunction != (id<MTLFunction>)info->fragment_function || !vertex_descriptor_empty(descriptor.vertexDescriptor) ||
+        descriptor.binaryArchives.count || descriptor.vertexPreloadedLibraries.count || descriptor.fragmentPreloadedLibraries.count ||
+        !linked_functions_empty(descriptor.vertexLinkedFunctions) || !linked_functions_empty(descriptor.fragmentLinkedFunctions))
+      return nil;
+    NSDictionary *vertex = objc_getAssociatedObject(descriptor.vertexFunction, &function_metadata_key);
+    NSDictionary *fragment = descriptor.fragmentFunction ? objc_getAssociatedObject(descriptor.fragmentFunction, &function_metadata_key) : nil;
+    if (!valid_function(vertex, MTLFunctionTypeVertex) || (descriptor.fragmentFunction && !valid_function(fragment, MTLFunctionTypeFragment)))
+      return nil;
+    retry_function(descriptor.vertexFunction);
+    if (descriptor.fragmentFunction) retry_function(descriptor.fragmentFunction);
+    NSMutableArray *colors = [NSMutableArray arrayWithCapacity:8];
+    for (unsigned i = 0; i < 8; ++i) {
+      MTLRenderPipelineColorAttachmentDescriptor *color = descriptor.colorAttachments[i];
+      [colors addObject:@{@"format": @((unsigned)color.pixelFormat), @"blend": @((unsigned)color.blendingEnabled),
+                          @"write_mask": @((unsigned)color.writeMask), @"rgb_op": @((unsigned)color.rgbBlendOperation),
+                          @"alpha_op": @((unsigned)color.alphaBlendOperation), @"src_rgb": @((unsigned)color.sourceRGBBlendFactor),
+                          @"dst_rgb": @((unsigned)color.destinationRGBBlendFactor), @"src_alpha": @((unsigned)color.sourceAlphaBlendFactor),
+                          @"dst_alpha": @((unsigned)color.destinationAlphaBlendFactor)}];
+    }
+    NSMutableArray *vertex_buffers = [NSMutableArray arrayWithCapacity:31], *fragment_buffers = [NSMutableArray arrayWithCapacity:31];
+    for (unsigned i = 0; i < 31; ++i) {
+      [vertex_buffers addObject:@((unsigned)descriptor.vertexBuffers[i].mutability)];
+      [fragment_buffers addObject:@((unsigned)descriptor.fragmentBuffers[i].mutability)];
+    }
+#ifdef DXMT_NO_PRIVATE_API
+    unsigned private_logic = 0, logic_enabled = 0, logic_op = 0;
+#else
+    unsigned private_logic = 1, logic_enabled = info->logic_operation_enabled, logic_op = info->logic_operation;
+#endif
+    NSDictionary *recipe = @{
+      @"schema": @1, @"private_logic": @(private_logic), @"logic_enabled": @(logic_enabled), @"logic_op": @(logic_op),
+      @"vertex": vertex, @"fragment": fragment ?: [NSNull null], @"colors": [[colors copy] autorelease],
+      @"vertex_buffers": [[vertex_buffers copy] autorelease], @"fragment_buffers": [[fragment_buffers copy] autorelease],
+      @"alpha_to_coverage": @((unsigned)descriptor.alphaToCoverageEnabled), @"alpha_to_one": @((unsigned)descriptor.alphaToOneEnabled),
+      @"rasterization": @((unsigned)descriptor.rasterizationEnabled), @"sample_count": @(descriptor.rasterSampleCount),
+      @"depth_format": @((unsigned)descriptor.depthAttachmentPixelFormat), @"stencil_format": @((unsigned)descriptor.stencilAttachmentPixelFormat),
+      @"primitive_topology": @((unsigned)descriptor.inputPrimitiveTopology), @"tess_partition": @((unsigned)descriptor.tessellationPartitionMode),
+      @"tess_factor_step": @((unsigned)descriptor.tessellationFactorStepFunction), @"tess_winding": @((unsigned)descriptor.tessellationOutputWindingOrder),
+      @"tess_max_factor": @(descriptor.maxTessellationFactor), @"tess_factor_scale": @((unsigned)descriptor.tessellationFactorScaleEnabled),
+      @"tess_factor_format": @((unsigned)descriptor.tessellationFactorFormat), @"tess_control_point_index": @((unsigned)descriptor.tessellationControlPointIndexType),
+      @"indirect_commands": @((unsigned)descriptor.supportIndirectCommandBuffers), @"vertex_amplification": @(descriptor.maxVertexAmplificationCount),
+      @"add_vertex_binary": @((unsigned)descriptor.supportAddingVertexBinaryFunctions), @"add_fragment_binary": @((unsigned)descriptor.supportAddingFragmentBinaryFunctions),
+      @"vertex_call_stack": @(descriptor.maxVertexCallStackDepth), @"fragment_call_stack": @(descriptor.maxFragmentCallStackDepth),
+      @"shader_validation": @((unsigned)descriptor.shaderValidation)
+    };
+    return valid_recipe(recipe) ? recipe : nil;
+  } @catch (NSException *exception) {
+    (void)exception;
+    return nil;
+  }
+}
+
+NSData *dxmt_recipe_encode(NSDictionary *recipe) {
+  @try {
+    if (!valid_recipe(recipe)) return nil;
+    NSData *data = [NSJSONSerialization dataWithJSONObject:recipe options:NSJSONWritingSortedKeys error:nil];
+    return data.length <= DXMT_RECIPE_ENCODED_MAX_BYTES ? data : nil;
+  } @catch (NSException *exception) { (void)exception; return nil; }
+}
+
+NSDictionary *dxmt_recipe_decode(NSData *data) {
+  if (![data isKindOfClass:[NSData class]] || !data.length || data.length > DXMT_RECIPE_ENCODED_MAX_BYTES)
+    return nil;
+  @try {
+    NSDictionary *recipe = [NSJSONSerialization JSONObjectWithData:data options:0 error:nil];
+    return valid_recipe(recipe) ? recipe : nil;
+  } @catch (NSException *exception) { (void)exception; return nil; }
+}
+
+NSString *dxmt_recipe_key(NSDictionary *recipe) { return sha256(dxmt_recipe_encode(recipe)); }
+
+static NSError *recipe_error(NSString *message) {
+  return [NSError errorWithDomain:@"DXMTPipelineRecipe" code:1 userInfo:@{NSLocalizedDescriptionKey: message}];
+}
+
+static id<MTLFunction> restore_function(id<MTLDevice> device, NSDictionary *metadata,
+                                      DXMTRecipeLibraryLoad load, NSError **error) {
+  NSData *bytes = load(metadata[@"library"]);
+  if (![bytes isKindOfClass:[NSData class]] || !bytes.length || bytes.length > DXMT_RECIPE_LIBRARY_MAX_BYTES ||
+      ![sha256(bytes) isEqualToString:metadata[@"library"]]) {
+    if (error) *error = recipe_error(@"Missing or corrupt pipeline library");
+    return nil;
+  }
+  dispatch_data_t data = dispatch_data_create(bytes.bytes, bytes.length, NULL, DISPATCH_DATA_DESTRUCTOR_DEFAULT);
+  if (!data) return nil;
+  id<MTLLibrary> library = [device newLibraryWithData:data error:error];
+  dispatch_release(data);
+  if (!library) return nil;
+  id<MTLFunction> function = [library newFunctionWithName:metadata[@"name"]];
+  [library release];
+  if (!function || [function functionType] != [metadata[@"type"] unsignedIntValue]) {
+    [function release];
+    if (error) *error = recipe_error(@"Pipeline function is missing or has an unexpected stage");
+    return nil;
+  }
+  // Reconstructed functions carry the same bounded metadata, enabling round-trip
+  // verification without retaining their source library bytes in the descriptor.
+  objc_setAssociatedObject(function, &function_metadata_key, metadata, OBJC_ASSOCIATION_COPY);
+  return function;
+}
+
+MTLRenderPipelineDescriptor *dxmt_recipe_restore(id<MTLDevice> device,
+                                               NSDictionary *recipe,
+                                               DXMTRecipeLibraryLoad load,
+                                               NSError **error) {
+  if (error) *error = nil;
+  MTLRenderPipelineDescriptor *descriptor = nil;
+  @try {
+    if (!device || !load || !valid_recipe(recipe)) {
+      if (error) *error = recipe_error(@"Invalid pipeline recipe");
+      return nil;
+    }
+#ifdef DXMT_NO_PRIVATE_API
+    if ([recipe[@"private_logic"] unsignedIntValue]) {
+      if (error) *error = recipe_error(@"Pipeline logic-operation mode does not match this build");
+      return nil;
+    }
+#endif
+    descriptor = [[MTLRenderPipelineDescriptor alloc] init];
+    id<MTLFunction> vertex = restore_function(device, recipe[@"vertex"], load, error);
+    if (!vertex) { [descriptor release]; return nil; }
+    descriptor.vertexFunction = vertex;
+    [vertex release];
+    if (recipe[@"fragment"] != [NSNull null]) {
+      id<MTLFunction> fragment = restore_function(device, recipe[@"fragment"], load, error);
+      if (!fragment) { [descriptor release]; return nil; }
+      descriptor.fragmentFunction = fragment;
+      [fragment release];
+    }
+    NSArray *colors = recipe[@"colors"];
+    for (unsigned i = 0; i < 8; ++i) {
+      NSDictionary *state = colors[i];
+      MTLRenderPipelineColorAttachmentDescriptor *color = descriptor.colorAttachments[i];
+      color.pixelFormat = [state[@"format"] unsignedIntValue];
+      color.blendingEnabled = [state[@"blend"] unsignedIntValue];
+      color.writeMask = [state[@"write_mask"] unsignedIntValue];
+      color.rgbBlendOperation = [state[@"rgb_op"] unsignedIntValue];
+      color.alphaBlendOperation = [state[@"alpha_op"] unsignedIntValue];
+      color.sourceRGBBlendFactor = [state[@"src_rgb"] unsignedIntValue];
+      color.destinationRGBBlendFactor = [state[@"dst_rgb"] unsignedIntValue];
+      color.sourceAlphaBlendFactor = [state[@"src_alpha"] unsignedIntValue];
+      color.destinationAlphaBlendFactor = [state[@"dst_alpha"] unsignedIntValue];
+    }
+    for (unsigned i = 0; i < 31; ++i) {
+      descriptor.vertexBuffers[i].mutability = [recipe[@"vertex_buffers"][i] unsignedIntValue];
+      descriptor.fragmentBuffers[i].mutability = [recipe[@"fragment_buffers"][i] unsignedIntValue];
+    }
+#ifndef DXMT_NO_PRIVATE_API
+    if ([recipe[@"private_logic"] unsignedIntValue]) {
+      if (![descriptor respondsToSelector:@selector(setLogicOperationEnabled:)] || ![descriptor respondsToSelector:@selector(setLogicOperation:)]) {
+        if (error) *error = recipe_error(@"Pipeline logic-operation API is unavailable");
+        [descriptor release]; return nil;
+      }
+      [descriptor setLogicOperationEnabled:[recipe[@"logic_enabled"] unsignedIntValue]];
+      [descriptor setLogicOperation:[recipe[@"logic_op"] unsignedIntValue]];
+    }
+#endif
+    descriptor.alphaToCoverageEnabled = [recipe[@"alpha_to_coverage"] unsignedIntValue];
+    descriptor.alphaToOneEnabled = [recipe[@"alpha_to_one"] unsignedIntValue];
+    descriptor.rasterizationEnabled = [recipe[@"rasterization"] unsignedIntValue];
+    descriptor.rasterSampleCount = [recipe[@"sample_count"] unsignedIntValue];
+    descriptor.depthAttachmentPixelFormat = [recipe[@"depth_format"] unsignedIntValue];
+    descriptor.stencilAttachmentPixelFormat = [recipe[@"stencil_format"] unsignedIntValue];
+    descriptor.inputPrimitiveTopology = [recipe[@"primitive_topology"] unsignedIntValue];
+    descriptor.tessellationPartitionMode = [recipe[@"tess_partition"] unsignedIntValue];
+    descriptor.tessellationFactorStepFunction = [recipe[@"tess_factor_step"] unsignedIntValue];
+    descriptor.tessellationOutputWindingOrder = [recipe[@"tess_winding"] unsignedIntValue];
+    descriptor.maxTessellationFactor = [recipe[@"tess_max_factor"] unsignedIntValue];
+    descriptor.tessellationFactorScaleEnabled = [recipe[@"tess_factor_scale"] unsignedIntValue];
+    descriptor.tessellationFactorFormat = [recipe[@"tess_factor_format"] unsignedIntValue];
+    descriptor.tessellationControlPointIndexType = [recipe[@"tess_control_point_index"] unsignedIntValue];
+    descriptor.supportIndirectCommandBuffers = [recipe[@"indirect_commands"] unsignedIntValue];
+    descriptor.maxVertexAmplificationCount = [recipe[@"vertex_amplification"] unsignedIntValue];
+    descriptor.supportAddingVertexBinaryFunctions = [recipe[@"add_vertex_binary"] unsignedIntValue];
+    descriptor.supportAddingFragmentBinaryFunctions = [recipe[@"add_fragment_binary"] unsignedIntValue];
+    descriptor.maxVertexCallStackDepth = [recipe[@"vertex_call_stack"] unsignedIntValue];
+    descriptor.maxFragmentCallStackDepth = [recipe[@"fragment_call_stack"] unsignedIntValue];
+    descriptor.shaderValidation = [recipe[@"shader_validation"] unsignedIntValue];
+    return descriptor;
+  } @catch (NSException *exception) {
+    (void)exception;
+    [descriptor release];
+    if (error) *error = recipe_error(@"Pipeline recipe reconstruction failed");
+    return nil;
+  }
+}
