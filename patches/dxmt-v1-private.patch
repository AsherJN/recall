+  unsigned budget = envUnsigned("DXMT_PIPELINE_CACHE_PREWARM_MS", 10000, 10000);
+  _preferExpensive = envUnsigned("DXMT_PIPELINE_CACHE_PREFER_EXPENSIVE", 0, 1) != 0;
