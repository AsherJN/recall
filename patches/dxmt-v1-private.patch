+- (id<MTLRenderPipelineState>)lookup:(NSString *)key descriptor:(MTLRenderPipelineDescriptor *)descriptor cost:(double *)cost
+    reason:(unsigned *)reason known:(BOOL *)known {
+  // Startup waiting is bounded from cache initialization, shared by concurrent
+  // callers. A normal frame never waits for persistence or an archive mutation.
+  while (!atomic_load_explicit(&_startupDone, memory_order_acquire) && !atomic_load(&globallyStopped)) {
+    double remaining = _startupDeadline - CACurrentMediaTime();
+    if (remaining <= 0) break;
+    dispatch_semaphore_wait(_startupFinished, dispatch_time(DISPATCH_TIME_NOW, (int64_t)(MIN(remaining, 0.05) * NSEC_PER_SEC)));
+  }
+  id<MTLRenderPipelineState> result = nil;
+  const char *text = key.UTF8String;
+  if (os_unfair_lock_trylock(&_lock)) {
+    if (known) *known = [_knownRecipeKeys containsObject:key];
+    // A zero-budget caller can arrive before the worker inventories disk.
+    // Distinguish unknown historical membership from a genuinely new recipe.
+    if (reason) *reason = _knownRecipeKeys ? 2 : 4;
+    for (unsigned i = 0; i < StateCapacity; ++i) {
+      if (_states[i].state && !strcmp(_states[i].key, text)) {
+        result = [_states[i].state retain]; _states[i].tick = ++_tick;
+        if (cost) *cost = _states[i].cost_us;
+        if (reason) *reason = 1;
+        break;
+      }
+    }
+    NSArray *archives = [_loadedArchives retain];
+    os_unfair_lock_unlock(&_lock);
+    if (!result && archives.count) descriptor.binaryArchives = archives;
+    [archives release];
+  } else { if (reason) *reason = 3; atomic_fetch_add(&_stateContentions, 1); }
+  atomic_fetch_add(result ? &_hits : &_misses, 1);
+  return result;
+}
+
+- (void)remember:(id<MTLRenderPipelineState>)state key:(NSString *)key cost:(double)cost {
+  if (!state || !validKey(key) || (atomic_load(&_stopped) || atomic_load(&globallyStopped))) return;
+  const char *text = key.UTF8String;
+  id<MTLRenderPipelineState> retained = [state retain], retired = nil;
+  if (!os_unfair_lock_trylock(&_lock)) { atomic_fetch_add(&_stateContentions, 1); [retained release]; return; }
+  unsigned selected = 0;
+  for (unsigned i = 0; i < StateCapacity; ++i) {
+    if (!_states[i].state || !strcmp(_states[i].key, text)) { selected = i; break; }
+    if (_states[i].cost_us < _states[selected].cost_us ||
+        (_states[i].cost_us == _states[selected].cost_us && _states[i].tick < _states[selected].tick)) selected = i;
+  }
+  if (!_states[selected].state || !strcmp(_states[selected].key, text) || cost >= _states[selected].cost_us) {
+    retired = _states[selected].state;
+    if (retired && strcmp(_states[selected].key, text)) atomic_fetch_add(&_stateEvictions, 1);
+    _states[selected] = (CachedState){.state = retained, .cost_us = cost, .tick = ++_tick};
+    memcpy(_states[selected].key, text, 64); retained = nil;
+  }
+  os_unfair_lock_unlock(&_lock);
+  [retired release]; [retained release]; // Metal object destruction outside lock.
+}
+
+- (void)unsupported { atomic_fetch_add(&_unsupported, 1); }
+- (void)recordArchiveLookup:(BOOL)hit { atomic_fetch_add(hit ? &_archiveLookupHits : &_archiveLookupMisses, 1); }
+- (void)traceRuntime:(NSString *)key result:(NSString *)result cost:(double)cost {
+  [self traceRuntime:key result:result cost:cost started:0 reason:0 known:NO archive:0];
+}
+- (void)traceRuntime:(NSString *)key result:(NSString *)result cost:(double)cost
+    started:(double)started reason:(unsigned)reason known:(BOOL)known archive:(unsigned)archive {
+  if ([result isEqualToString:@"created"]) atomic_fetch_add(&_runtimeCreates, 1);
+  if (!_logPath || !validKey(key) || atomic_load(&globallyStopped)) return;
+  double observed = CACurrentMediaTime() * 1000000;
+  long long wall = (long long)((CFAbsoluteTimeGetCurrent() + kCFAbsoluteTimeIntervalSince1970) * 1000000);
+  RuntimeRecord record = {.cost_us = cost, .created = [result isEqualToString:@"created"],
+    .unix_ms = wall / 1000, .unix_us = wall, .observed_us = observed,
+    .start_us = started ? started * 1000000 : observed, .end_us = started ? started * 1000000 + cost : observed,
+    .known_at_launch = known, .lookup_reason = reason, .archive_result = archive};
+  memcpy(record.key, key.UTF8String, 64);
+  if (!os_unfair_lock_trylock(&_traceLock)) { atomic_fetch_add(&_traceDrops, 1); return; }
+  if (_traceCount < TraceCapacity) { _traces[(_traceHead + _traceCount) % TraceCapacity] = record; ++_traceCount; }
+  else atomic_fetch_add(&_traceDrops, 1);
+  os_unfair_lock_unlock(&_traceLock);
+  dispatch_source_merge_data(_drainSource, 1);
+}
+#ifdef DXMT_PIPELINE_CACHE_OFFLINE_TOOL
+- (NSDictionary *)offlineResult {
+  // This API exists only in the standalone helper, never on a render thread.
+  // Joining here permits safe cache validation/publication after all Metal and
+  // archive work completes. The supervising process supplies a wall timeout.
+  __block NSDictionary *result;
+  dispatch_sync(_worker, ^{
+    [self drain]; [self summary];
+    result = [@{@"namespace_directory": _directory, @"write_owner": @(_writeOwner),
+      @"prepared": @(atomic_load(&_prewarmed)), @"failures": @(atomic_load(&_prewarmFailures)),
+      @"archive_failures": @(atomic_load(&_archiveFailures)), @"archive_adds": @(atomic_load(&_archiveAdds)),
+      @"prepared_keys": _archivedKeys.allObjects, @"captured_keys": _capturedKeys.allObjects,
+      @"verify_only": @(_offlineVerify), @"deadline_exceeded": @(CACurrentMediaTime() > _startupDeadline),
+      @"archive_bytes": @(_activeArchiveBytes), @"archive_batches": @(_archiveEntries.count)} retain];
+  });
+  return [result autorelease];
+}
+#endif
+#ifdef DXMT_PIPELINE_CACHE_TESTING
+- (void)testPause:(BOOL)paused {
+  dispatch_sync(_worker, ^{ atomic_store(&_testPause, paused); });
+  if (!paused) dispatch_source_merge_data(_drainSource, 1);
+}
+- (NSDictionary *)testStats {
+  __block NSDictionary *result;
+  dispatch_sync(_worker, ^{ result = [[self recorderStats] retain]; });
+  return [result autorelease];
+}
+- (void)testLimits:(unsigned)recipes libraries:(unsigned)libraries disk:(uint64_t)disk freeBytes:(int64_t)freeBytes {
+  dispatch_sync(_worker, ^{ _recipeLimit = recipes; _libraryLimit = libraries; _diskLimit = disk; _testFreeBytes = freeBytes; });
+}
+- (void)testDrain { dispatch_sync(_worker, ^{ [self drain]; [self summary]; }); }
+#endif
+@end
+
+static os_unfair_lock managerLock = OS_UNFAIR_LOCK_INIT;
+static DXMTPipelineCache *managers[4];
+static id<MTLDevice> managerDevices[4];
+static atomic_uintptr_t publishedManagers[4], publishedDevices[4];
+static NSString *cacheRoot;
+static void *codePin;
+
+BOOL dxmt_pipeline_cache_enabled(void) {
+  static dispatch_once_t once;
+  dispatch_once(&once, ^{
+    @autoreleasepool {
+      @try {
+        const char *path = getenv("DXMT_PIPELINE_CACHE_PATH");
+        if (!path || path[0] != '/') return;
+        Dl_info info;
+        if (!dladdr((const void *)&dxmt_pipeline_cache_enabled, &info)) return;
+        codePin = dlopen(info.dli_fname, RTLD_LAZY | RTLD_LOCAL | RTLD_NODELETE);
+        if (!codePin) return;
+        cacheRoot = [[NSString stringWithUTF8String:path] copy];
+        if (atexit(dxmt_pipeline_cache_shutdown)) atomic_store(&globallyStopped, true);
+      } @catch (NSException *exception) { atomic_store(&globallyStopped, true); }
+    }
+  });
+  return cacheRoot && !atomic_load(&globallyStopped);
+}
+
+static DXMTPipelineCache *manager(id<MTLDevice> device) {
+  if (!dxmt_pipeline_cache_enabled() || !device) return nil;
+  for (unsigned i = 0; i < 4; ++i) {
+    uintptr_t ready = atomic_load_explicit(&publishedManagers[i], memory_order_acquire);
+    if (ready && atomic_load_explicit(&publishedDevices[i], memory_order_relaxed) == (uintptr_t)device)
+      return (DXMTPipelineCache *)ready;
+  }
+  if (!os_unfair_lock_trylock(&managerLock)) return nil;
+  DXMTPipelineCache *result = nil;
+  @try {
+    for (unsigned i = 0; i < 4; ++i) {
+      if (managers[i] && managerDevices[i] == device) { result = managers[i]; break; }
+      if (!managers[i]) {
+        result = [[DXMTPipelineCache alloc] initWithDevice:device root:cacheRoot];
+        managers[i] = result; managerDevices[i] = device; break;
+      }
+    }
+    for (unsigned i = 0; i < 4; ++i) if (managers[i]) {
+      atomic_store_explicit(&publishedDevices[i], (uintptr_t)managerDevices[i], memory_order_relaxed);
+      atomic_store_explicit(&publishedManagers[i], (uintptr_t)managers[i], memory_order_release);
+    }
+  } @finally { os_unfair_lock_unlock(&managerLock); }
+  return result;
+}
+
+#ifdef DXMT_PIPELINE_CACHE_OFFLINE_TOOL
+NSDictionary *dxmt_pipeline_cache_prepare_saved(id<MTLDevice> device) {
+  return [manager(device) offlineResult];
+}
+#endif
+
+BOOL dxmt_pipeline_cache_store_library(id<MTLDevice> device, NSString *sha256, NSData *bytes) {
+  @autoreleasepool {
+    @try { return [manager(device) enqueueLibrary:YES key:sha256 data:bytes cost:0]; }
+    @catch (NSException *exception) { return NO; }
+  }
+}
+
+#ifdef DXMT_PIPELINE_CACHE_TESTING
+void dxmt_pipeline_cache_test_pause(id<MTLDevice> device, BOOL pause) { [manager(device) testPause:pause]; }
+NSDictionary *dxmt_pipeline_cache_test_stats(id<MTLDevice> device) { return [manager(device) testStats]; }
+void dxmt_pipeline_cache_test_drain(id<MTLDevice> device) { [manager(device) testDrain]; }
+void dxmt_pipeline_cache_test_limits(id<MTLDevice> device, unsigned recipes, unsigned libraries, uint64_t disk, int64_t freeBytes) {
+  [manager(device) testLimits:recipes libraries:libraries disk:disk freeBytes:freeBytes];
+}
+BOOL dxmt_pipeline_cache_test_recipe(id<MTLDevice> device, NSString *key, NSData *data, double cost) {
+  return [manager(device) enqueueLibrary:NO key:key data:data cost:cost];
+}
+void dxmt_pipeline_cache_test_trace(id<MTLDevice> device, NSString *key) {
+  [manager(device) traceRuntime:key result:@"memory_hit" cost:0];
+}
+#endif
+
+id<MTLRenderPipelineState> dxmt_pipeline_cache_new_render_pipeline(id<MTLDevice> device,
+    MTLRenderPipelineDescriptor *descriptor, const struct WMTRenderPipelineInfo *info,
+    MTLPipelineOption options, NSError **error) {
+  DXMTPipelineCache *cache = nil;
+  NSDictionary *recipe = nil;
+  NSString *key = nil;
+  id<MTLRenderPipelineState> existing = nil;
+  BOOL managedArchive = NO;
+  unsigned lookupReason = 0, archiveResult = 0;
+  BOOL knownAtLaunch = NO;
+  // Wine compiler threads do not necessarily have an outer autorelease pool.
+  // Keep codec temporaries bounded while preserving Metal's existing error
+  // ownership by making the ordinary Metal call outside these local pools.
+  @autoreleasepool {
+    @try {
+      cache = manager(device);
+      if (cache && options == MTLPipelineOptionNone) {
+        recipe = [dxmt_recipe_capture(info, descriptor) retain];
+        key = recipe ? [dxmt_recipe_key(recipe) copy] : nil;
+        if (key) {
+          double rememberedCost = 0;
+          existing = [cache lookup:key descriptor:descriptor cost:&rememberedCost reason:&lookupReason known:&knownAtLaunch];
+          managedArchive = descriptor.binaryArchives.count != 0;
+          if (existing) {
+            [cache traceRuntime:key result:@"memory_hit" cost:0 started:0 reason:lookupReason known:knownAtLaunch archive:0];
+            // A previous bounded admission may have failed. In-memory reuse
+            // must offer another persistence opportunity until disk success.
+            [cache enqueueLibrary:NO key:key data:dxmt_recipe_encode(recipe) cost:rememberedCost];
+          }
+        } else [cache unsupported];
+      }
+    } @catch (NSException *exception) {
+      if (recipe) descriptor.binaryArchives = nil;
+      cache = nil; [key release]; key = nil;
+    }
+  }
+  if (existing) {
+    [recipe release]; [key release];
+    if (error) *error = nil;
+    return existing;
+  }
+  double started = cache && key ? CACurrentMediaTime() : 0;
+  id<MTLRenderPipelineState> state = nil;
+  if (managedArchive && cache && key) {
+    // Strict lookup makes archive success observable. Any miss/error returns
+    // to the caller's original compilation path without the managed archive.
+    @autoreleasepool {
+      NSError *lookupError = nil;
+      @try {
+        state = [device newRenderPipelineStateWithDescriptor:descriptor
+            options:MTLPipelineOptionFailOnBinaryArchiveMiss reflection:nil error:&lookupError];
+      } @catch (NSException *exception) { state = nil; }
+      [cache recordArchiveLookup:state != nil];
+      archiveResult = state ? 1 : 2;
+    }
+    if (!state) descriptor.binaryArchives = nil;
+  }
+  if (!state)
+    state = [device newRenderPipelineStateWithDescriptor:descriptor options:options reflection:nil error:error];
+  else if (error) *error = nil;
+  // Preserve Metal's ordinary failure result. A cache operation can never turn
+  // a successful create into a failure or change the caller's error contract.
+  @autoreleasepool {
+    if (state && cache && key) {
+      @try {
+        double elapsed = (CACurrentMediaTime() - started) * 1000000;
+        [cache remember:state key:key cost:elapsed];
+        NSData *encoded = dxmt_recipe_encode(recipe);
+        [cache enqueueLibrary:NO key:key data:encoded cost:elapsed];
+        [cache traceRuntime:key result:@"created" cost:elapsed started:started reason:lookupReason known:knownAtLaunch archive:archiveResult];
+      } @catch (NSException *exception) {}
+    }
+    [recipe release]; [key release];
+  }
+  return state;
+}
+
+void dxmt_pipeline_cache_shutdown(void) {
+  atomic_store(&globallyStopped, true);
+  // Managers, queues, retained states and module pin have process lifetime.
+  // At exit no mutex, file, queue barrier, or Metal operation is touched.
+
+}
