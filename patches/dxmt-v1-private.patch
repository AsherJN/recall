+- (void)drain {
+#ifdef DXMT_PIPELINE_CACHE_TESTING
+  if (atomic_load(&_testPause)) return;
+#endif
+  // A short batch lets timers/diagnostics run even while producers remain busy.
+  for (unsigned i = 0; i < 64; ++i) {
+    CacheRecord record = {0};
+    os_unfair_lock_lock(&_recordLock);
+    if (_count) {
+      record = _records[_head]; _records[_head] = (CacheRecord){0};
+      _head = (_head + 1) % QueueCapacity; --_count; _inflight = record;
+    }
+    os_unfair_lock_unlock(&_recordLock);
+    if (!record.data) break;
+    [self consume:record overflow:-1];
+  }
+  // Process overflow directly; missing-dependency recipes in the primary queue
+  // must never prevent their retained AIR bytes from reaching the worker.
+  for (unsigned i = 0; i < OverflowCapacity; ++i) {
+    unsigned ready = 2;
+    if (atomic_compare_exchange_strong_explicit(&_overflow[i].state, &ready, 3, memory_order_acquire, memory_order_relaxed))
+      [self consume:_overflow[i].record overflow:(int)i];
+  }
+  // Optional telemetry is isolated in a fixed-size POD ring. It cannot consume
+  // recipe/AIR admission capacity and does no JSON allocation on producers.
+  for (unsigned i = 0; i < TraceCapacity; ++i) {
+    RuntimeRecord record = {0}; BOOL have = NO;
+    os_unfair_lock_lock(&_traceLock);
+    if (_traceCount) {
+      record = _traces[_traceHead]; _traceHead = (_traceHead + 1) % TraceCapacity; --_traceCount; have = YES;
+    }
+    os_unfair_lock_unlock(&_traceLock);
+    if (!have) break;
+    [self event:@"runtime" values:@{@"key": @(record.key), @"result": record.created ? @"created" : @"memory_hit",
+      @"cost_us": @(record.cost_us), @"unix_ms": @(record.unix_ms), @"unix_us": @(record.unix_us),
+      @"start_monotonic_us": @(record.start_us), @"end_monotonic_us": @(record.end_us),
+      @"observed_monotonic_us": @(record.observed_us),
+      @"start_unix_us": @(record.unix_us + record.start_us - record.observed_us),
+      @"end_unix_us": @(record.unix_us + record.end_us - record.observed_us),
+      @"known_at_launch": (record.lookup_reason == 1 || record.lookup_reason == 2) ? @(record.known_at_launch) : NSNull.null,
+      @"lookup_reason": @(record.lookup_reason),
+      @"archive_result": @(record.archive_result)}];
+  }
+  if (_log) fflush(_log);
+  BOOL ready = NO;
+  double now = CACurrentMediaTime();
+  os_unfair_lock_lock(&_recordLock);
+  for (unsigned i = 0; i < _count; ++i)
+    if (_records[(_head + i) % QueueCapacity].retryAt <= now) { ready = YES; break; }
+  os_unfair_lock_unlock(&_recordLock);
+  if (ready && !atomic_load(&globallyStopped)) dispatch_source_merge_data(_drainSource, 1);
+}
