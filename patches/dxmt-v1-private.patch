+
+// Optional diagnostics only. Each producer submits one fixed POD without waiting
+// for another producer or disk. All formatting, rotation and flushing is on the
+// utility writer. Never read the asynchronous FrameStatistics ring here.
+class FrameTelemetry {
+public:
+  enum Kind : uint32_t { Boundary, FrameLatency, Coherence, ChunkCapacity, Encode, Submit, Completion, Drawable, LayerSync, InitializerFlush, CommandBuffer, KindCount };
+  struct Stamp { int64_t unix_us, monotonic_us; };
+  struct Event {
+    Stamp end{};
+    uint64_t event_id = 0, owner_id = 0, frame_id = 0, chunk_id = 0;
+    int64_t duration_us = 0, latency_wait_us = 0;
+    uint64_t compile_starts = 0;
+    Kind kind = Boundary;
+    int64_t pacing_us = 0;
+  };
+  static Stamp stamp() {
+    auto mono = std::chrono::steady_clock::now();
+    auto utc = std::chrono::system_clock::now();
+    return {std::chrono::duration_cast<std::chrono::microseconds>(utc.time_since_epoch()).count(),
+            std::chrono::duration_cast<std::chrono::microseconds>(mono.time_since_epoch()).count()};
+  }
+  static std::shared_ptr<FrameTelemetry> acquire() {
+    // Initialization/destruction only; rendering never enters this registry.
+    static std::mutex mutex;
+    static std::weak_ptr<FrameTelemetry> current;
+    static uint64_t generation = 0;
+    std::lock_guard<std::mutex> lock(mutex);
+    auto result = current.lock();
+    if (!result && std::getenv("DXMT_FRAME_LOG")) {
+      try { result.reset(new FrameTelemetry(std::getenv("DXMT_FRAME_LOG"), ++generation)); }
+      catch (...) { return nullptr; } // Optional diagnostics cannot prevent device creation.
+      current = result;
+    }
+    return result;
+  }
+  uint64_t newOwner() { return state_->owners.fetch_add(1, std::memory_order_relaxed) + 1; }
+  void push(Event event) {
+    auto &s = *state_;
+    event.event_id = s.next.fetch_add(1, std::memory_order_relaxed) + 1;
+    if (s.closing.load(std::memory_order_acquire) || s.lock.test_and_set(std::memory_order_acquire)) {
+      s.dropped.fetch_add(1, std::memory_order_relaxed); return;
+    }
+    if (s.count == Capacity || s.closing.load(std::memory_order_relaxed)) s.dropped.fetch_add(1, std::memory_order_relaxed);
+    else { s.ring[(s.head + s.count) % Capacity] = event; ++s.count; }
+    s.lock.clear(std::memory_order_release);
+  }
+  void span(Kind kind, uint64_t owner, uint64_t frame, uint64_t chunk, Stamp start) {
+    auto end = stamp();
+    auto duration = end.monotonic_us - start.monotonic_us;
+    if (duration < 2000) return; // Sparse timings, including nested spans explicitly.
+    push({end, 0, owner, frame, chunk, duration, 0, 0, kind});
+  }
+  ~FrameTelemetry() {
+    state_->closing.store(true, std::memory_order_release);
+    // Process/module detachment cannot safely wait for another Windows thread.
+    if (!dxmt::this_thread::isInModuleDetachment()) {
+      auto deadline = std::chrono::steady_clock::now() + std::chrono::milliseconds(500);
+      while (!state_->done.load(std::memory_order_acquire) && std::chrono::steady_clock::now() < deadline)
+        std::this_thread::sleep_for(std::chrono::milliseconds(1));
+    }
