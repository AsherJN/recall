+/* Recall 1.7 (REC-76): GPU errors (winemetal.h). */
+static NTSTATUS
+_MTLCommandQueue_commandBufferWithErrorOptions(void *obj) {
+  struct unixcall_generic_obj_uint64_obj_ret *params = obj;
+  MTLCommandBufferDescriptor *desc = [[MTLCommandBufferDescriptor alloc] init];
+  // retainedReferences stays YES, as with -[MTLCommandQueue commandBuffer].
+  desc.errorOptions = (MTLCommandBufferErrorOption)params->arg;
+  params->ret = (obj_handle_t)[(id<MTLCommandQueue>)params->handle commandBufferWithDescriptor:desc];
+  [desc release];
+  return STATUS_SUCCESS;
+}
+
+static void
+error_detail_append(char *out, size_t size, const char *format, ...) {
+  size_t used = strnlen(out, size);
+  if (used + 1 >= size)
+    return;
+  va_list args;
+  va_start(args, format);
+  vsnprintf(out + used, size - used, format, args);
+  va_end(args);
+}
+
+// An encoder as "#index 'label'": labels cut to 40 characters, and up to two of its debug signposts.
+static void
+error_detail_encoder(char *out, size_t size, NSUInteger index, id<MTLCommandBufferEncoderInfo> encoder) {
+  NSString *label = encoder.label;
+  const char *text = label.length ? label.UTF8String : NULL;
+  if (text)
+    error_detail_append(out, size, "#%lu '%.40s'", (unsigned long)index, text);
+  else
+    error_detail_append(out, size, "#%lu (no label)", (unsigned long)index);
+  NSArray<NSString *> *signposts = encoder.debugSignposts;
+  if (signposts.count) {
+    error_detail_append(out, size, " [");
+    for (NSUInteger i = 0; i < signposts.count && i < 2; i++)
+      error_detail_append(out, size, "%s'%.32s'", i ? ", " : "", signposts[i].UTF8String ?: "");
+    error_detail_append(out, size, "%s]", signposts.count > 2 ? ", ..." : "");
+  }
+}
+
+static NTSTATUS
+_MTLCommandBuffer_errorInfo(void *obj) {
+  struct unixcall_mtlcommandbuffer_errorinfo *params = obj;
+  struct WMTCommandBufferErrorInfo *info = params->info.ptr;
+  memset(info, 0, sizeof(*info));
+  params->ret = 0;
+  @autoreleasepool {
+    NSError *error = [(id<MTLCommandBuffer>)params->cmdbuf error];
+    if (!error)
+      return STATUS_SUCCESS;
+    params->ret = 1;
+    info->code = [error.domain isEqualToString:MTLCommandBufferErrorDomain] ? (uint64_t)error.code : ~0ull;
+    NSError *underlying = error.userInfo[NSUnderlyingErrorKey];
+    if ([underlying isKindOfClass:NSError.class])
+      info->gpu_code = (uint64_t)underlying.code;
+    NSArray *encoders = error.userInfo[MTLCommandBufferEncoderInfoErrorKey];
+    if (![encoders isKindOfClass:NSArray.class])
+      return STATUS_SUCCESS;
+    info->encoders = (uint32_t)encoders.count;
+    NSUInteger first_unfinished = NSNotFound, listed = 0;
+    for (NSUInteger i = 0; i < encoders.count; i++) {
+      id<MTLCommandBufferEncoderInfo> encoder = encoders[i];
+      switch (encoder.errorState) {
+      case MTLCommandEncoderErrorStateCompleted: info->completed++; break;
+      case MTLCommandEncoderErrorStateFaulted: info->faulted++; break;
+      case MTLCommandEncoderErrorStateAffected: info->affected++; break;
+      case MTLCommandEncoderErrorStatePending: info->pending++; break;
+      default: info->unknown++; break;
+      }
+      if (encoder.errorState != MTLCommandEncoderErrorStateCompleted && first_unfinished == NSNotFound)
+        first_unfinished = i;
+    }
+    char *out = info->detail;
+    size_t size = sizeof(info->detail);
+    for (NSUInteger i = 0; i < encoders.count && listed < 4; i++) {
+      id<MTLCommandBufferEncoderInfo> encoder = encoders[i];
+      if (encoder.errorState != MTLCommandEncoderErrorStateFaulted)
+        continue;
+      error_detail_append(out, size, listed++ ? ", " : "faulted ");
+      error_detail_encoder(out, size, i, encoder);
+    }
+    if (info->faulted > listed)
+      error_detail_append(out, size, " and %u more", info->faulted - (uint32_t)listed);
+    if (first_unfinished != NSNotFound) {
+      static const char *states[] = {"unknown", "completed", "affected", "not run", "faulted"};
+      id<MTLCommandBufferEncoderInfo> encoder = encoders[first_unfinished];
+      NSUInteger state = encoder.errorState < 5 ? encoder.errorState : 0;
+      error_detail_append(out, size, "%sfirst unfinished ", out[0] ? "; " : "");
+      error_detail_encoder(out, size, first_unfinished, encoder);
+      error_detail_append(out, size, " (%s)", states[state]);
+      if (first_unfinished > 0) {
+        error_detail_append(out, size, ", after ");
+        error_detail_encoder(out, size, first_unfinished - 1, encoders[first_unfinished - 1]);
+      }
+    }
+  }
+  return STATUS_SUCCESS;
+}
+
+static NTSTATUS
+_WMTSetMetalFXForceGPU(void *obj) {
+  struct unixcall_generic_obj_uint64_noret *params = obj;
+  const char wanted = params->arg ? '1' : '0';
+  // A one-character value the launch set is changed in place: setenv can move the environment
+  // while another thread reads it.
+  char *value = getenv("MTLFX_FORCE_GPU");
+  if (value && (value[0] == '0' || value[0] == '1') && value[1] == 0)
+    value[0] = wanted;
+  else
+    setenv("MTLFX_FORCE_GPU", wanted == '1' ? "1" : "0", 1);
+  return STATUS_SUCCESS;
+}
+
+static NTSTATUS
+_WMTWriteHostFile(void *obj) {
+  struct unixcall_write_host_file *params = obj;
+  const char *path = params->path.ptr, *text = params->text.ptr;
+  params->ret = 0;
+  if (!path || !path[0] || !text)
+    return STATUS_SUCCESS;
+  // "{pid}" in the path becomes this process's Mac process ID.
+  char resolved[4000], temp[4096];
+  const char *mark = strstr(path, "{pid}");
+  int length = mark ? snprintf(resolved, sizeof(resolved), "%.*s%d%s", (int)(mark - path), path, (int)getpid(), mark + 5)
+                    : snprintf(resolved, sizeof(resolved), "%s", path);
+  if (length < 0 || length >= (int)sizeof(resolved))
+    return STATUS_SUCCESS;
+  path = resolved;
+  if (snprintf(temp, sizeof(temp), "%s.%d.tmp", path, (int)getpid()) >= (int)sizeof(temp))
+    return STATUS_SUCCESS;
+  int fd = open(temp, O_WRONLY | O_CREAT | O_TRUNC | O_CLOEXEC | O_NOFOLLOW, 0644);
+  if (fd < 0)
+    return STATUS_SUCCESS;
+  uint64_t done = 0;
+  while (done < params->length) {
+    ssize_t n = write(fd, text + done, params->length - done);
+    if (n <= 0)
+      break;
+    done += (uint64_t)n;
+  }
+  close(fd);
+  if (done == params->length && rename(temp, path) == 0)
+    params->ret = 1;
+  else
+    unlink(temp);
+  return STATUS_SUCCESS;
+}
