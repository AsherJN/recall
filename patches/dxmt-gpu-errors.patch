+namespace {
+
+// UTC now, as 2026-11-02T15:52:51Z.
+std::string
+gpu_error_time() {
+  SYSTEMTIME t;
+  GetSystemTime(&t);
+  char text[32];
+  std::snprintf(text, sizeof(text), "%04u-%02u-%02uT%02u:%02u:%02uZ", t.wYear, t.wMonth, t.wDay, t.wHour, t.wMinute,
+                t.wSecond);
+  return text;
+}
+
+std::string
+json_string(const std::string &text) {
+  std::string out = "\"";
+  for (unsigned char c : text) {
+    if (c == '"' || c == '\\') {
+      out += '\\';
+      out += (char)c;
+    } else if (c < 0x20) {
+      char escaped[8];
+      std::snprintf(escaped, sizeof(escaped), "\\u%04x", c);
+      out += escaped;
+    } else {
+      out += (char)c;
+    }
+  }
+  return out + "\"";
+}
+
+constexpr const char *kGpuErrorNames[] = {"hang", "timeout", "page_fault", "victim", "internal", "revoked", "other"};
+
+} // namespace
+
+void
+CommandQueue::InitGpuErrorHandling() {
+  started_time_ = gpu_error_time();
+  if (env::getEnvVar("DXMT_GPU_ERROR_DETAIL") == "1") {
+    error_options_ = WMTCommandBufferErrorOptionEncoderExecutionStatus;
+    argument_encoding_ctx.pass_labels = true;
+  }
+  metalfx_gpu_after_hang_ = env::getEnvVar("DXMT_METALFX_GPU_AFTER_HANG") == "1";
+  auto exit_on = env::getEnvVar("DXMT_GPU_LOST_EXIT");
+  auto exe = env::getExeName();
+  exit_on_revoked_ = exit_on == "1" || (!exit_on.empty() && _stricmp(exit_on.c_str(), exe.c_str()) == 0);
+  auto report_dir = env::getEnvVar("DXMT_GPU_REPORT");
+  if (!report_dir.empty()) {
+    if (report_dir.back() != '/')
+      report_dir += '/';
+    // {pid} becomes the Mac process ID (WMTWriteHostFile): the app knows the game by it.
+    report_path_ = report_dir + "gpu-" + exe + "-{pid}.json";
+  }
+  auto simulate = env::getEnvVar("DXMT_SIMULATE_GPU_ERROR");
+  size_t at = 0;
+  while (at < simulate.size()) {
+    size_t end = simulate.find(',', at);
+    if (end == std::string::npos)
+      end = simulate.size();
+    auto item = simulate.substr(at, end - at);
+    auto sign = item.find('@');
+    if (sign != std::string::npos) {
+      try {
+        simulated_errors_.emplace_back(std::stoull(item.substr(sign + 1)), std::stoull(item.substr(0, sign)));
+      } catch (const std::exception &) {
+      }
+    }
+    at = end + 1;
+  }
+  std::sort(simulated_errors_.begin(), simulated_errors_.end());
+  if (!simulated_errors_.empty())
+    WARN("DXMT_SIMULATE_GPU_ERROR: ", simulated_errors_.size(), " simulated GPU errors");
+}
+
+bool
+CommandQueue::SimulatedGpuError(uint64_t frame, WMTCommandBufferErrorInfo &info) {
+  uint64_t code;
+  if (simulating_revoked_) {
+    code = 4;
+  } else if (!simulated_errors_.empty() && simulated_errors_.front().first <= frame) {
+    code = simulated_errors_.front().second;
+    simulated_errors_.erase(simulated_errors_.begin());
+    simulating_revoked_ = code == 4;
+  } else {
+    return false;
+  }
+  info = {};
+  info.code = code;
+  // The IOGPU reasons macOS gives under these codes (kIOGPUCommandBufferCallbackError...).
+  info.gpu_code = code == 2 ? 3 : code == 3 ? 11 : code == 4 ? 4 : 0;
+  std::snprintf(info.detail, sizeof(info.detail), "simulated (DXMT_SIMULATE_GPU_ERROR)");
+  return true;
+}
+
+void
+CommandQueue::HandleGpuError(CommandChunk &chunk, const WMTCommandBufferErrorInfo &info, bool simulated) {
+  // The reason under the Metal code tells a hang from a discarded bystander (both can be Metal's
+  // code 1 or 2); without one, the Metal code alone.
+  GpuErrorKind kind = GpuErrorKind::Other;
+  if (info.code == 4 || info.gpu_code == 4)
+    kind = GpuErrorKind::Revoked;
+  else if (info.gpu_code == 3)
+    kind = GpuErrorKind::Hang;
+  else if (info.gpu_code == 2)
+    kind = GpuErrorKind::Timeout;
+  else if (info.gpu_code == 5)
+    kind = GpuErrorKind::Victim;
+  else if (info.gpu_code == 11)
+    kind = GpuErrorKind::PageFault;
+  else if (info.gpu_code == 1)
+    kind = GpuErrorKind::Internal;
+  else if (!info.gpu_code && info.code == 2)
+    kind = GpuErrorKind::Timeout;
+  else if (!info.gpu_code && info.code == 3)
+    kind = GpuErrorKind::PageFault;
+  else if (!info.gpu_code && info.code == 1)
+    kind = GpuErrorKind::Internal;
+  const char *name = kGpuErrorNames[(unsigned)kind];
+
+  if (kind == GpuErrorKind::Revoked && access_revoked_) {
+    // Every later command buffer is ignored too: count them, and log at 10, 100, 1000, ...
+    ignored_after_revoked_++;
+    uint64_t power = 10;
+    while (power < ignored_after_revoked_)
+      power *= 10;
+    if (power == ignored_after_revoked_)
+      ERR("GPU access still revoked at frame ", chunk.frame_, ": ", ignored_after_revoked_,
+          " more command buffers ignored");
+    return;
+  }
+
+  // The full description can be long (with encoder status it lists every encoder); Wine's debug
+  // output takes lines of about 1000 bytes, and a longer one raises an exception in the game.
+  std::string description;
+  if (simulated) {
+    description = std::string("simulated MTLCommandBufferError code ") + std::to_string(info.code);
+  } else if (auto error = chunk.attached_cmdbuf.error()) {
+    description = error.description().getUTF8String();
+    if (description.size() > 600)
+      description = description.substr(0, 600) + "...";
+  }
+  ERR("Device error at frame ", chunk.frame_, ": ", description);
+  if (info.encoders)
+    ERR("GPU error at frame ", chunk.frame_, ": ", name, "; ", info.encoders, " encoders: ", info.completed,
+        " completed, ", info.faulted, " faulted, ", info.affected, " affected, ", info.pending, " not run; ",
+        info.detail);
+
+  auto now = gpu_error_time();
+  if (kind == GpuErrorKind::Revoked) {
+    access_revoked_ = true;
+    revoked_frame_ = chunk.frame_;
+    revoked_time_ = now;
+    uint64_t total = 0;
+    for (unsigned i = 0; i < gpu_errors_.size(); i++)
+      if (i != (unsigned)GpuErrorKind::Revoked)
+        total += gpu_errors_[i];
+    ERR("GPU access revoked at frame ", chunk.frame_, ": macOS ignores this process's GPU work after repeated GPU "
+        "errors (before this: ", total, " GPU errors, hangs ", gpu_errors_[(unsigned)GpuErrorKind::Hang],
+        "); nothing can be drawn again until it restarts");
+    gpu_errors_[(unsigned)kind]++;
+    WriteGpuReport();
+    if (exit_on_revoked_) {
+      ERR("Ending ", env::getExeName(), " (DXMT_GPU_LOST_EXIT): its picture can't change any more");
+      // DXGI_ERROR_DEVICE_HUNG: what Windows reports for a device that stopped responding.
+      TerminateProcess(GetCurrentProcess(), 0x887A0006);
+    }
+    return;
+  }
+
+  gpu_errors_[(unsigned)kind]++;
+  if (first_error_time_.empty()) {
+    first_error_frame_ = chunk.frame_;
+    first_error_time_ = now;
+  }
+  last_error_frame_ = chunk.frame_;
+  last_error_time_ = now;
+  last_error_kind_ = name;
+  last_error_detail_ = info.detail;
+  // The work that failed never finished: whatever it drew, MetalFX must not build on.
+  gpu_error_epoch_.fetch_add(1, std::memory_order_acq_rel);
+  if ((kind == GpuErrorKind::Hang || kind == GpuErrorKind::Timeout) && metalfx_gpu_after_hang_)
+    metalfx_gpu_wanted_.store(true, std::memory_order_release);
+  WriteGpuReport();
+}
+
+void
+CommandQueue::WriteGpuReport() {
+  if (report_path_.empty())
+    return;
+  std::string json = "{\"schema\":1,\"process\":" + json_string(env::getExeName()) +
+                     ",\"windows_pid\":" + std::to_string(GetCurrentProcessId()) +
+                     ",\"started\":" + json_string(started_time_) + ",\"updated\":" + json_string(gpu_error_time()) +
+                     ",\"encoder_status\":" + (error_options_ ? "true" : "false") +
+                     ",\"metalfx\":" + (metalfx_used_.load() ? "true" : "false") +
+                     ",\"metalfx_gpu_mode\":" + (metalfx_gpu_mode_.load() ? "true" : "false") + ",\"errors\":{";
+  for (unsigned i = 0; i < gpu_errors_.size(); i++)
+    if (i != (unsigned)GpuErrorKind::Revoked)
+      json += std::string(i ? "," : "") + "\"" + kGpuErrorNames[i] + "\":" + std::to_string(gpu_errors_[i]);
+  json += "}";
+  if (!first_error_time_.empty())
+    json += ",\"first_error\":{\"frame\":" + std::to_string(first_error_frame_) +
+            ",\"time\":" + json_string(first_error_time_) + "},\"last_error\":{\"frame\":" +
+            std::to_string(last_error_frame_) + ",\"time\":" + json_string(last_error_time_) +
+            ",\"kind\":" + json_string(last_error_kind_) + ",\"detail\":" + json_string(last_error_detail_) + "}";
+  if (access_revoked_)
+    json += ",\"access_revoked\":{\"frame\":" + std::to_string(revoked_frame_) +
+            ",\"time\":" + json_string(revoked_time_) + "},\"ended_process\":" + (exit_on_revoked_ ? "true" : "false");
+  json += "}\n";
+  if (!WMTWriteHostFile(report_path_.c_str(), json.c_str(), json.size()))
+    WARN("GPU error report not written: ", report_path_);
+}
