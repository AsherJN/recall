+/* Recall 1.7 (REC-76): GPU errors.
+ * After repeated GPU hangs macOS refuses every later command buffer of the process
+ * (MTLCommandBufferErrorAccessRevoked, "Ignored (for causing prior/excessive GPU errors)"); nothing
+ * can be drawn again until the process restarts. Command buffers can record each encoder's
+ * execution status, so a hang names the encoder that was running. */
+enum WMTCommandBufferErrorOption : uint64_t {
+  WMTCommandBufferErrorOptionNone = 0,
+  WMTCommandBufferErrorOptionEncoderExecutionStatus = 1,
+};
+
+WINEMETAL_API obj_handle_t MTLCommandQueue_commandBufferWithErrorOptions(obj_handle_t queue, uint64_t options);
+
+struct WMTCommandBufferErrorInfo {
+  uint64_t code;     // MTLCommandBufferError code, 0 when the command buffer has no error
+  uint64_t gpu_code; // the IOGPU reason under it (kIOGPUCommandBufferCallbackError...), 0 if none
+  uint32_t encoders; // encoders the error reports (with encoder execution status), by state:
+  uint32_t completed;
+  uint32_t faulted;
+  uint32_t affected;
+  uint32_t pending;
+  uint32_t unknown;
+  char detail[480];  // the faulted encoders and the one before the first of them, by index and label
+};
+
+// Fills info for a command buffer whose status is error; returns 0 when it has none.
+WINEMETAL_API uint32_t MTLCommandBuffer_errorInfo(obj_handle_t cmdbuf, struct WMTCommandBufferErrorInfo *info);
+
+// MetalFX runs its temporal scaler's network on the Neural Engine or on the GPU. It reads
+// MTLFX_FORCE_GPU each time a scaler is made, so this decides the mode of scalers made after it.
+WINEMETAL_API void WMTSetMetalFXForceGPU(uint32_t gpu);
+
+// Writes a small text file by its Mac path, replacing it whole (written aside, then renamed);
+// "{pid}" in the path becomes the Mac process ID.
+WINEMETAL_API uint32_t WMTWriteHostFile(const char *path, const char *text, uint64_t length);
+
 #endif
