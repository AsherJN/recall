+WINEMETAL_API obj_handle_t
+MTLCommandQueue_commandBufferWithErrorOptions(obj_handle_t queue, uint64_t options) {
+  struct unixcall_generic_obj_uint64_obj_ret params;
+  params.handle = queue;
+  params.arg = options;
+  params.ret = 0;
+  UNIX_CALL(149, &params);
+  return params.ret;
+}
+
+WINEMETAL_API uint32_t
+MTLCommandBuffer_errorInfo(obj_handle_t cmdbuf, struct WMTCommandBufferErrorInfo *info) {
+  struct unixcall_mtlcommandbuffer_errorinfo params;
+  params.cmdbuf = cmdbuf;
+  WMT_MEMPTR_SET(params.info, info);
+  params.ret = 0;
+  UNIX_CALL(150, &params);
+  return (uint32_t)params.ret;
+}
+
+WINEMETAL_API void
+WMTSetMetalFXForceGPU(uint32_t gpu) {
+  struct unixcall_generic_obj_uint64_noret params;
+  params.handle = NULL_OBJECT_HANDLE;
+  params.arg = gpu;
+  UNIX_CALL(151, &params);
+}
+
+WINEMETAL_API uint32_t
+WMTWriteHostFile(const char *path, const char *text, uint64_t length) {
+  struct unixcall_write_host_file params;
+  WMT_MEMPTR_SET(params.path, path);
+  WMT_MEMPTR_SET(params.text, text);
+  params.length = length;
+  params.ret = 0;
+  UNIX_CALL(152, &params);
+  return (uint32_t)params.ret;
+}
